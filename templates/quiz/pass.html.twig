{% extends 'base.html.twig' %}

{% block title %}Quiz - {{ course.title }}{% endblock %}

{% block body %}
{% set questionCount = course.quizQuestions|length %}
{% set activeQuizLocale = ((app.request.locale == 'fr' and hasFrench) or (app.request.locale == 'it' and hasItalian)) ? app.request.locale : 'en' %}
{% set optionLabels = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'] %}

<div class="quiz-experience">
  <header class="quiz-experience__header">
    <div class="quiz-experience__header-copy">
      <a href="{{ path('app_course_show', {id: course.id}) }}" class="quiz-experience__back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Back to course
      </a>
      <span class="quiz-experience__eyebrow">
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        Final knowledge check
      </span>
      <h1>{{ course.title }}</h1>
      <p>Take your time, select one answer for each question and review your choices before submitting.</p>
      <div class="quiz-experience__meta">
        <span><i class="fa-regular fa-circle-question" aria-hidden="true"></i>{{ questionCount }} question{{ questionCount == 1 ? '' : 's' }}</span>
        <span><i class="fa-solid fa-bullseye" aria-hidden="true"></i>80% required to pass</span>
        <span><i class="fa-solid fa-award" aria-hidden="true"></i>Certificate on success</span>
      </div>
    </div>

    <div class="quiz-experience__language" aria-label="Quiz language">
      <span><i class="fa-solid fa-language" aria-hidden="true"></i>Language</span>
      <div>
        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}" class="{{ activeQuizLocale == 'en' ? 'is-active' : '' }}" aria-label="English" aria-current="{{ activeQuizLocale == 'en' ? 'true' : 'false' }}">EN</a>
        {% if hasFrench %}
          <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}" class="{{ activeQuizLocale == 'fr' ? 'is-active' : '' }}" aria-label="French" aria-current="{{ activeQuizLocale == 'fr' ? 'true' : 'false' }}">FR</a>
        {% endif %}
        {% if hasItalian %}
          <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'it'})) }}" class="{{ activeQuizLocale == 'it' ? 'is-active' : '' }}" aria-label="Italian" aria-current="{{ activeQuizLocale == 'it' ? 'true' : 'false' }}">IT</a>
        {% endif %}
      </div>
    </div>
  </header>

  {% if questionCount > 0 %}
    <form method="post" action="{{ path('course_quiz_submit', {id: course.id}) }}" class="quiz-player" data-quiz-player>
      <div class="quiz-player__progress-head">
        <div>
          <span>Assessment progress</span>
          <strong><span data-current-question>1</span> of {{ questionCount }}</strong>
        </div>
        <span data-answered-summary>0 answered</span>
      </div>
      <div class="quiz-player__progress" aria-hidden="true"><span data-question-progress></span></div>

      <div class="quiz-player__layout">
        <section class="quiz-player__stage" aria-label="Quiz questions">
          {% for question in course.quizQuestions %}
            <article class="quiz-player__question" data-question-slide="{{ loop.index0 }}" {{ loop.first ? '' : 'hidden' }}>
              <div class="quiz-player__question-heading">
                <span>Question {{ '%02d'|format(loop.index) }}</span>
                <small>Select one answer</small>
              </div>

              <h2>{{ question.getQuestionForLocale(activeQuizLocale) }}</h2>

              <div class="quiz-player__answers">
                {% for answer in question.answers %}
                  <label class="quiz-player__answer" for="answer_{{ question.id }}_{{ answer.id }}">
                    <input
                      type="radio"
                      id="answer_{{ question.id }}_{{ answer.id }}"
                      name="answers[{{ question.id }}]"
                      value="{{ answer.id }}"
                    >
                    <span class="quiz-player__answer-key">{{ optionLabels[loop.index0]|default(loop.index) }}</span>
                    <span class="quiz-player__answer-text">{{ answer.getTextForLocale(activeQuizLocale) }}</span>
                    <span class="quiz-player__answer-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                  </label>
                {% endfor %}
              </div>
            </article>
          {% endfor %}

          <div class="quiz-player__navigation">
            <button type="button" class="quiz-player__button quiz-player__button--secondary" data-quiz-previous disabled>
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              Previous
            </button>

            <div class="quiz-player__navigation-right">
              <small data-submit-help>Select an answer to continue</small>
              <button type="button" class="quiz-player__button quiz-player__button--primary" data-quiz-next disabled>
                Next question
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
              <button type="submit" class="quiz-player__button quiz-player__button--submit" data-quiz-submit hidden disabled>
                Submit answers
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </section>

        <aside class="quiz-player__aside" aria-label="Quiz overview">
          <div class="quiz-player__course-card">
            <div class="quiz-player__course-cover">
              {% if course.thumb %}
                <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="" loading="lazy">
              {% else %}
                <span><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
              {% endif %}
              <span class="quiz-player__course-cover-shade"></span>
              <span class="quiz-player__course-badge"><i class="fa-solid fa-list-check" aria-hidden="true"></i>Knowledge quiz</span>
            </div>
            <div class="quiz-player__course-copy">
              <span>{{ course.category ? course.category.name : 'Professional training' }}</span>
              <strong>{{ course.title }}</strong>
            </div>
          </div>

          <div class="quiz-player__question-map">
            <div class="quiz-player__aside-heading">
              <span>Questions</span>
              <small><strong data-answered-count>0</strong>/{{ questionCount }} answered</small>
            </div>
            <div class="quiz-player__question-dots">
              {% for question in course.quizQuestions %}
                <button type="button" class="{{ loop.first ? 'is-current' : '' }}" data-question-jump="{{ loop.index0 }}" aria-label="Go to question {{ loop.index }}" aria-current="{{ loop.first ? 'step' : 'false' }}">{{ loop.index }}</button>
              {% endfor %}
            </div>
          </div>

          <div class="quiz-player__guidance">
            <span><i class="fa-regular fa-lightbulb" aria-hidden="true"></i></span>
            <div>
              <strong>Before you submit</strong>
              <p>You can revisit any question. All {{ questionCount }} answers are required before final submission.</p>
            </div>
          </div>

          <div class="quiz-player__security">
            <i class="fa-solid fa-lock" aria-hidden="true"></i>
            <span>Your answers are saved only when you submit the quiz.</span>
          </div>
        </aside>
      </div>
    </form>
  {% else %}
    <section class="quiz-experience__empty">
      <span><i class="fa-regular fa-circle-question" aria-hidden="true"></i></span>
      <h2>This quiz is not ready yet</h2>
      <p>No questions have been added to this course. You can return to the course while the assessment is being prepared.</p>
      <a href="{{ path('app_course_show', {id: course.id}) }}"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back to course</a>
    </section>
  {% endif %}
</div>

{% if questionCount > 0 %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const player = document.querySelector('[data-quiz-player]');
  if (!player) return;

  const slides = Array.from(player.querySelectorAll('[data-question-slide]'));
  const dots = Array.from(player.querySelectorAll('[data-question-jump]'));
  const previousButton = player.querySelector('[data-quiz-previous]');
  const nextButton = player.querySelector('[data-quiz-next]');
  const submitButton = player.querySelector('[data-quiz-submit]');
  const currentQuestion = player.querySelector('[data-current-question]');
  const answeredCount = player.querySelector('[data-answered-count]');
  const answeredSummary = player.querySelector('[data-answered-summary]');
  const submitHelp = player.querySelector('[data-submit-help]');
  const progress = player.querySelector('[data-question-progress]');
  let currentIndex = 0;

  const isAnswered = (slide) => Boolean(slide.querySelector('input[type="radio"]:checked'));

  const showQuestion = (index) => {
    currentIndex = Math.max(0, Math.min(index, slides.length - 1));
    const answered = slides.filter(isAnswered).length;
    const isLast = currentIndex === slides.length - 1;
    const currentIsAnswered = isAnswered(slides[currentIndex]);

    slides.forEach((slide, slideIndex) => {
      slide.hidden = slideIndex !== currentIndex;
    });

    dots.forEach((dot, dotIndex) => {
      const answeredDot = isAnswered(slides[dotIndex]);
      dot.classList.toggle('is-current', dotIndex === currentIndex);
      dot.classList.toggle('is-answered', answeredDot);
      dot.setAttribute('aria-current', dotIndex === currentIndex ? 'step' : 'false');
    });

    previousButton.disabled = currentIndex === 0;
    nextButton.hidden = isLast;
    nextButton.disabled = !currentIsAnswered;
    submitButton.hidden = !isLast;
    submitButton.disabled = !isLast || answered !== slides.length;

    currentQuestion.textContent = String(currentIndex + 1);
    answeredCount.textContent = String(answered);
    answeredSummary.textContent = `${answered} answered`;
    progress.style.width = `${((currentIndex + 1) / slides.length) * 100}%`;

    if (isLast) {
      const remaining = slides.length - answered;
      submitHelp.textContent = remaining === 0 ? 'Ready to submit' : `${remaining} answer${remaining === 1 ? '' : 's'} remaining`;
    } else {
      submitHelp.textContent = currentIsAnswered ? 'Answer saved for submission' : 'Select an answer to continue';
    }
  };

  player.addEventListener('change', (event) => {
    if (!event.target.matches('input[type="radio"]')) return;

    const slide = event.target.closest('[data-question-slide]');
    slide.querySelectorAll('.quiz-player__answer').forEach((answer) => answer.classList.remove('is-selected'));
    event.target.closest('.quiz-player__answer').classList.add('is-selected');
    showQuestion(currentIndex);
  });

  previousButton.addEventListener('click', () => showQuestion(currentIndex - 1));
  nextButton.addEventListener('click', () => showQuestion(currentIndex + 1));
  dots.forEach((dot) => dot.addEventListener('click', () => showQuestion(Number(dot.dataset.questionJump))));

  showQuestion(0);
});
</script>
{% endif %}
{% endblock %}
