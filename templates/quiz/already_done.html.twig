{% extends 'base.html.twig' %}

{% block title %}Quiz Attempt - {{ course.title }}{% endblock %}

{% block body %}
{% if attempt %}
  <div class="quiz-outcome quiz-outcome--{{ attempt.passed ? 'success' : 'retry' }}">
    <a href="{{ path('app_course_show', {id: course.id}) }}" class="quiz-outcome__back">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      Back to course
    </a>

    <section class="quiz-outcome__card">
      <div class="quiz-outcome__visual">
        <span class="quiz-outcome__visual-label">Previous attempt</span>
        <div class="quiz-outcome__icon">
          <i class="fa-solid {{ attempt.passed ? 'fa-award' : 'fa-lock' }}" aria-hidden="true"></i>
        </div>
        <div class="quiz-outcome__score-ring" style="--score-value: {{ attempt.score }}">
          <div><strong>{{ attempt.score }}%</strong><span>Recorded score</span></div>
        </div>
        <div class="quiz-outcome__visual-status">
          <i class="fa-solid {{ attempt.passed ? 'fa-circle-check' : 'fa-circle-info' }}" aria-hidden="true"></i>
          <span>{{ attempt.passed ? 'Quiz already passed' : 'Attempt currently locked' }}</span>
        </div>
      </div>

      <div class="quiz-outcome__content">
        <span class="quiz-outcome__eyebrow">
          <i class="fa-solid {{ attempt.passed ? 'fa-shield-halved' : 'fa-clock-rotate-left' }}" aria-hidden="true"></i>
          Your assessment history
        </span>
        <h1>{{ attempt.passed ? 'You already completed this quiz.' : 'Your previous attempt is recorded.' }}</h1>
        <p>
          {% if attempt.passed %}
            You passed the final assessment for <strong>{{ course.title }}</strong>. There is no need to retake it — your achievement is safely stored.
          {% else %}
            Your last score for <strong>{{ course.title }}</strong> was below the 80% pass mark. A new attempt must be unlocked before trying again.
          {% endif %}
        </p>

        <div class="quiz-outcome__details">
          <div><span>Recorded score</span><strong>{{ attempt.score }}%</strong></div>
          <div><span>Pass mark</span><strong>80%</strong></div>
          <div><span>Status</span><strong>{{ attempt.passed ? 'Passed' : 'Locked' }}</strong></div>
        </div>

        {% if attempt.passed %}
          <div class="quiz-outcome__notice quiz-outcome__notice--success">
            <span><i class="fa-solid fa-certificate" aria-hidden="true"></i></span>
            <div><strong>Certificate available</strong><p>Your verified certificate can be downloaded from your collection.</p></div>
          </div>
        {% else %}
          <div class="quiz-outcome__notice quiz-outcome__notice--retry">
            <span><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></span>
            <div><strong>Ready for another try?</strong><p>Review the lessons, then unlock one new attempt for this course.</p></div>
          </div>
        {% endif %}

        <div class="quiz-outcome__actions">
          <a href="{{ path('app_course_show', {id: course.id}) }}" class="quiz-outcome__button quiz-outcome__button--secondary">
            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            Review course
          </a>

          {% if attempt.passed %}
            <a href="{{ path('app_certificates') }}" class="quiz-outcome__button quiz-outcome__button--primary">
              View certificate
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          {% else %}
            <form method="post" action="{{ path('app_course_checkout', {id: course.id}) }}">
              <button type="submit" class="quiz-outcome__button quiz-outcome__button--primary">
                Unlock new attempt
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </form>
          {% endif %}
        </div>
      </div>
    </section>

    <div class="quiz-outcome__footer-note">
      <i class="fa-solid fa-lock" aria-hidden="true"></i>
      <span>Your result is securely stored in your learning history.</span>
      <a href="{{ path('app_progress') }}">View progress <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>
  </div>
{% else %}
  <div class="quiz-outcome quiz-outcome--retry">
    <section class="quiz-outcome__missing">
      <span><i class="fa-regular fa-folder-open" aria-hidden="true"></i></span>
      <h1>No quiz attempt found</h1>
      <p>We could not find a previous result for this course.</p>
      <a href="{{ path('app_course_show', {id: course.id}) }}">Back to course <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </section>
  </div>
{% endif %}
{% endblock %}
