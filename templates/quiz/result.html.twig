{% extends 'base.html.twig' %}

{% block title %}Quiz Results - {{ course.title }}{% endblock %}

{% block body %}
<div class="quiz-outcome quiz-outcome--{{ attempt.passed ? 'success' : 'retry' }}">
  <a href="{{ path('app_course_show', {id: course.id}) }}" class="quiz-outcome__back">
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    Back to course
  </a>

  <section class="quiz-outcome__card">
    <div class="quiz-outcome__visual">
      <span class="quiz-outcome__visual-label">Quiz complete</span>
      <div class="quiz-outcome__icon">
        <i class="fa-solid {{ attempt.passed ? 'fa-trophy' : 'fa-arrow-trend-up' }}" aria-hidden="true"></i>
      </div>
      <div class="quiz-outcome__score-ring" style="--score-value: {{ attempt.score }}">
        <div><strong>{{ attempt.score }}%</strong><span>Your score</span></div>
      </div>
      <div class="quiz-outcome__visual-status">
        <i class="fa-solid {{ attempt.passed ? 'fa-circle-check' : 'fa-circle-info' }}" aria-hidden="true"></i>
        <span>{{ attempt.passed ? 'Assessment passed' : 'Another attempt required' }}</span>
      </div>
    </div>

    <div class="quiz-outcome__content">
      <span class="quiz-outcome__eyebrow">
        <i class="fa-solid {{ attempt.passed ? 'fa-award' : 'fa-chart-line' }}" aria-hidden="true"></i>
        {{ attempt.passed ? 'Achievement unlocked' : 'Keep building your knowledge' }}
      </span>

      <h1>{{ attempt.passed ? 'Excellent work — you passed!' : 'Almost there. Keep going.' }}</h1>
      <p>
        {% if attempt.passed %}
          You reached the required score and completed the final assessment for <strong>{{ course.title }}</strong>.
        {% else %}
          Your score is below the 80% pass mark for <strong>{{ course.title }}</strong>. Review the course before starting a new attempt.
        {% endif %}
      </p>

      <div class="quiz-outcome__details">
        <div><span>Score achieved</span><strong>{{ attempt.score }}%</strong></div>
        <div><span>Pass mark</span><strong>80%</strong></div>
        <div><span>Status</span><strong>{{ attempt.passed ? 'Passed' : 'Not passed' }}</strong></div>
      </div>

      {% if attempt.passed %}
        <div class="quiz-outcome__notice quiz-outcome__notice--success">
          <span><i class="fa-solid fa-certificate" aria-hidden="true"></i></span>
          <div><strong>Your certificate is ready</strong><p>Open your achievement collection to view and download it.</p></div>
        </div>
      {% else %}
        <div class="quiz-outcome__notice quiz-outcome__notice--retry">
          <span><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></span>
          <div><strong>This attempt is now locked</strong><p>Purchase a new attempt when you feel ready to try the quiz again.</p></div>
        </div>
      {% endif %}

      <div class="quiz-outcome__actions">
        <a href="{{ path('app_course_show', {id: course.id}) }}" class="quiz-outcome__button quiz-outcome__button--secondary">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          Review course
        </a>

        {% if attempt.passed %}
          <a href="{{ path('app_certificates') }}" class="quiz-outcome__button quiz-outcome__button--primary">
            View certificate
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        {% else %}
          <form method="post" action="{{ path('app_course_checkout', {id: course.id}) }}">
            <button type="submit" class="quiz-outcome__button quiz-outcome__button--primary">
              Unlock new attempt
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </button>
          </form>
        {% endif %}
      </div>
    </div>
  </section>

  <div class="quiz-outcome__footer-note">
    <i class="fa-solid fa-lock" aria-hidden="true"></i>
    <span>Your result has been securely recorded in your learning history.</span>
    <a href="{{ path('app_progress') }}">View progress <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
  </div>
</div>
{% endblock %}
