<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture {{ invoice_number }}</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; color: #333; }
        h1 { text-align: center; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        th { background: #f5f5f5; }
        .right { text-align: right; }
        .footer { margin-top: 40px; font-size: 11px; text-align: center; color: #777; }
    </style>
</head>
<body>
    <h1>FACTURE SOUSCRIPTION</h1>

    <p><strong>LES CONSULTANTS</strong><br>
    10 Rue du Commerce, L-1234 Luxembourg<br>
    TVA : LU12345678<br>
    contact@les-consultants.com | www.les-consultants.com</p>

    <p>
        <strong>Facture n° :</strong> {{ invoice_number }}<br>
        <strong>Date :</strong> {{ invoice_date|date('d/m/Y') }}
    </p>

    <p>
        <strong>Client :</strong><br>
        {{ user.username ?? user.email }}<br>
        {{ user.email }}<br>
        {{ user.country ?? '—' }}
    </p>

    <table>
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantité</th>
                <th>Prix unitaire</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Abonnement annuel E-Learning (accès illimité 12 mois)</td>
                <td>1</td>
                <td>29,90 €</td>
                <td>29,90 €</td>
            </tr>
        </tbody>
    </table>

    <p class="right">
        <strong>Total TTC : 29,90 €</strong><br><br>
        Mode de paiement : Carte bancaire (Stripe)<br>
        Date de règlement : {{ invoice_date|date('d/m/Y') }}
    </p>

    <p>✅ Accès illimité à toutes les formations pendant 12 mois.<br>
    Renouvellement non automatique.</p>

    <div class="footer">
        © {{ "now"|date("Y") }} Les Consultants — Tous droits réservés
    </div>
</body>
</html>
