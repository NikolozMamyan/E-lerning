<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice {{ invoice_number }}</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; color: #333; margin: 40px; }
        h1 { text-align: center; margin-bottom: 25px; color: #2c3e50; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        th { background: #f5f5f5; }
        .right { text-align: right; }
        .totals { margin-top: 20px; width: 100%; }
        .totals td { padding: 6px 10px; }
        .totals td.label { text-align: right; font-weight: bold; }
        .totals td.amount { text-align: right; width: 100px; }
        .highlight { color: #27ae60; font-weight: bold; }
        .footer { margin-top: 40px; font-size: 11px; text-align: center; color: #777; }
    </style>
</head>
<body>
    <h1>SUBSCRIPTION INVOICE</h1>

    <p><strong>LES CONSULTANTS</strong><br>
    1 Simmerfarm, L-8363 Simmerfarm, Luxembourg<br>
    VAT: LU33807452<br>
    contact@elearning-lesconsultants.com | www.les-consultants.com</p>

    <p>
        <strong>Invoice No.:</strong> {{ invoice_number }}<br>
        <strong>Date:</strong> {{ invoice_date|date('d/m/Y') }}
    </p>

    <p>
        <strong>Client:</strong><br>
        {{ user.username ?? user.email }}<br>
        {{ user.email }}<br>
        {{ user.country ?? '—' }}
    </p>

    {% set amount_ttc = amount %}
    {% set amount_ht = amount_ttc / 1.17 %}
    {% set vat_value = amount_ttc - amount_ht %}

    <table>
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Unit Price (excl. VAT)</th>
                <th>Total (excl. VAT)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Annual E-Learning Subscription (unlimited access for 12 months)</td>
                <td>1</td>
                <td>{{ amount_ht|number_format(2, ',', ' ') }} €</td>
                <td>{{ amount_ht|number_format(2, ',', ' ') }} €</td>
            </tr>
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td class="label">Subtotal (excl. VAT):</td>
            <td class="amount">{{ amount_ht|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="label">VAT (17%):</td>
            <td class="amount">{{ vat_value|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="label">Total (incl. VAT):</td>
            <td class="amount highlight">{{ amount_ttc|number_format(2, ',', ' ') }} €</td>
        </tr>
    </table>

    <p class="right" style="margin-top: 30px;">
        <strong>Payment method:</strong> Credit card (Stripe)<br>
        <strong>Payment date:</strong> {{ invoice_date|date('d/m/Y') }}
    </p>

    <p> Unlimited access to all courses for 12 months.<br>
    Non-recurring renewal.</p>

    <div class="footer">
        © {{ "now"|date("Y") }} Les Consultants — All rights reserved
    </div>
</body>
</html>
