<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 13px;
            color: #333;
            margin: 40px;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #2c3e50;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .header h2 {
            color: #2c3e50;
            margin: 0;
            font-size: 28px;
        }
        .company-info {
            text-align: center;
            font-size: 12px;
            line-height: 1.4;
            margin-bottom: 30px;
        }
        .company-info strong {
            display: block;
            margin-bottom: 5px;
        }
        .client-info {
            margin-bottom: 25px;
        }
        .client-info p {
            margin: 2px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px 10px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .totals {
            margin-top: 20px;
            width: 100%;
        }
        .totals td {
            padding: 6px 10px;
        }
        .totals td.label {
            text-align: right;
            font-weight: bold;
        }
        .totals td.amount {
            text-align: right;
            width: 100px;
        }
        .payment-info {
            margin-top: 25px;
            font-size: 13px;
        }
        .footer {
            margin-top: 40px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        .highlight {
            color: #27ae60;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2>FACTURE</h2>
    </div>

    <div class="company-info">
        <strong>LES CONSULTANTS</strong>
        10 Rue du Commerce, L-1234 Luxembourg<br>
        TVA : LU12345678<br>
        contact@les-consultants.com | www.les-consultants.com
    </div>

    <div class="client-info">
        <p><strong>Facture n° :</strong> {{ date|date('Y') }}-{{ '%04d'|format(invoiceNumber) }}</p>
        <p><strong>Date :</strong> {{ date|date('d/m/Y') }}</p>
        <p><strong>Client :</strong> {{ user.username }}</p>
        <p><strong>Email :</strong> {{ user.email }}</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantité</th>
                <th>Prix unitaire</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Accès au cours : {{ course.title }}</td>
                <td>1</td>
                <td>{{ amount|number_format(2, ',', ' ') }} €</td>
                <td>{{ amount|number_format(2, ',', ' ') }} €</td>
            </tr>
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td class="label">Sous-total :</td>
            <td class="amount">{{ amount|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% if tva is not null %}
            <tr>
                <td class="label">TVA ({{ tva }}%) :</td>
                <td class="amount">{{ (amount * tva / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
        {% endif %}
        <tr>
            <td class="label">Total TTC :</td>
            <td class="amount highlight">
                {{ (amount + (tva ? (amount * tva / 100) : 0))|number_format(2, ',', ' ') }} €
            </td>
        </tr>
    </table>

    <div class="payment-info">
        <p><strong>Mode de paiement :</strong> Carte bancaire (Stripe)</p>
        <p><strong>Date de règlement :</strong> {{ date|date('d/m/Y') }}</p>
        <p>✅ Accès immédiat à la formation en ligne. Aucune livraison physique.</p>
    </div>

    <div class="footer">
        Merci pour votre confiance.<br>
        <em>Les Consultants – E-Learning</em>
    </div>

</body>
</html>