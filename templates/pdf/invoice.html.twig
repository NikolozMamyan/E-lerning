<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 13px;
            color: #333;
            margin: 40px;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #2c3e50;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }
        .header h2 {
            color: #2c3e50;
            margin: 0;
            font-size: 28px;
        }
        .company-info {
            text-align: center;
            font-size: 12px;
            line-height: 1.4;
            margin-bottom: 30px;
        }
        .company-info strong {
            display: block;
            margin-bottom: 5px;
        }
        .client-info {
            margin-bottom: 25px;
        }
        .client-info p {
            margin: 2px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px 10px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .totals {
            margin-top: 20px;
            width: 100%;
        }
        .totals td {
            padding: 6px 10px;
        }
        .totals td.label {
            text-align: right;
            font-weight: bold;
        }
        .totals td.amount {
            text-align: right;
            width: 100px;
        }
        .payment-info {
            margin-top: 25px;
            font-size: 13px;
        }
        .footer {
            margin-top: 40px;
            font-size: 12px;
            color: #666;
            text-align: center;
        }
        .highlight {
            color: #27ae60;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <div class="header">
        <h2>INVOICE</h2>
    </div>

    <div class="company-info">
        <strong>LES CONSULTANTS</strong>
        1 Simmerfarm, L-8363 Simmerfarm, Luxembourg<br>
        VAT: LU33807452<br>
        contact@les-consultants.com | www.les-consultants.com
    </div>

    <div class="client-info">
        <p><strong>Invoice No.:</strong> {{ date|date('Y') }}-{{ '%04d'|format(invoice_number) }}</p>
        <p><strong>Date:</strong> {{ date|date('d/m/Y') }}</p>
        <p><strong>Client:</strong> {{ user.username }}</p>
        <p><strong>Email:</strong> {{ user.email }}</p>
    </div>

    {% set amount_ttc = amount %}
    {% set amount_ht = (amount_ttc / (1 + (tva / 100))) %}
    {% set vat_value = amount_ttc - amount_ht %}

    <table>
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Unit Price (excl. VAT)</th>
                <th>Total (excl. VAT)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Course access: {{ course.title }}</td>
                <td>1</td>
                <td>{{ amount_ht|number_format(2, ',', ' ') }} €</td>
                <td>{{ amount_ht|number_format(2, ',', ' ') }} €</td>
            </tr>
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td class="label">Subtotal (excl. VAT):</td>
            <td class="amount">{{ amount_ht|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="label">VAT ({{ tva }}%):</td>
            <td class="amount">{{ vat_value|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="label">Total (incl. VAT):</td>
            <td class="amount highlight">{{ amount_ttc|number_format(2, ',', ' ') }} €</td>
        </tr>
    </table>

    <div class="payment-info">
        <p><strong>Payment method:</strong> Credit card (Stripe)</p>
        <p><strong>Payment date:</strong> {{ date|date('d/m/Y') }}</p>
        <p> Immediate access to the online course. No physical delivery.</p>
    </div>

    <div class="footer">
        Thank you for your trust.<br>
        <em>Les Consultants – E-Learning</em>
    </div>

</body>
</html>
