{% extends 'base.html.twig' %}

{% block title %}Available Courses{% endblock %}

{% block body %}
{% set accessibleCoursesCount = 0 %}
{% set totalLessons = 0 %}
{% for course in courses %}
  {% set totalLessons = totalLessons + course.videos|length %}
  {% if access[course.id] is defined and access[course.id] %}
    {% set accessibleCoursesCount = accessibleCoursesCount + 1 %}
  {% endif %}
{% endfor %}

<div class="course-catalog" data-course-catalog>
  <section class="course-catalog__hero" aria-labelledby="course-catalog-heading">
    <div class="course-catalog__hero-content">
      <span class="course-catalog__eyebrow">
        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
        Course library
      </span>
      <h1 id="course-catalog-heading">Choose what you want to master next.</h1>
      <p>Explore practical compliance courses, find the right topic and learn at your own pace.</p>
    </div>

    <div class="course-catalog__summary" aria-label="Course library summary">
      <div class="course-catalog__summary-item">
        <span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
        <div>
          <strong>{{ courses|length }}</strong>
          <small>Course{{ courses|length == 1 ? '' : 's' }}</small>
        </div>
      </div>
      <div class="course-catalog__summary-item">
        <span><i class="fa-solid fa-circle-play" aria-hidden="true"></i></span>
        <div>
          <strong>{{ totalLessons }}</strong>
          <small>Lesson{{ totalLessons == 1 ? '' : 's' }}</small>
        </div>
      </div>
      <div class="course-catalog__summary-item">
        <span><i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i></span>
        <div>
          <strong>{{ accessibleCoursesCount }}</strong>
          <small>Available now</small>
        </div>
      </div>
    </div>
  </section>

  <section class="course-catalog__controls" aria-labelledby="catalog-controls-heading">
    <div class="course-catalog__controls-heading">
      <div>
        <span class="course-catalog__section-kicker">Browse the catalogue</span>
        <h2 id="catalog-controls-heading">Find your next course</h2>
      </div>
      <div class="results-count" aria-live="polite">
        <i class="fa-solid fa-circle" aria-hidden="true"></i>
        <span id="results-count">{{ courses|length }} course{{ courses|length == 1 ? '' : 's' }}</span>
      </div>
    </div>

    <div class="course-toolbar">
      <div class="toolbar-left">
        <div class="search-box">
          <label for="course-search" class="course-catalog__sr-only">Search courses</label>
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input
            type="search"
            id="course-search"
            placeholder="Search by title or keyword..."
            autocomplete="off"
          >
          <kbd>Ctrl K</kbd>
          <button type="button" class="clear-search" id="clear-search" aria-label="Clear search" hidden>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>

        <div class="filters">
          <button type="button" class="filter-pill" id="category-filter" aria-expanded="false" aria-controls="category-dropdown">
            <i class="fa-solid fa-sliders" aria-hidden="true"></i>
            <span>Categories</span>
            <i class="fa-solid fa-chevron-down filter-pill__chevron" aria-hidden="true"></i>
          </button>

          <div class="filter-dropdown" id="category-dropdown">
            <div class="filter-dropdown__header">
              <strong>Filter by category</strong>
              <small>Select one or more topics</small>
            </div>
            <label class="filter-option">
              <input type="checkbox" name="category" value="all" checked>
              <span>All categories</span>
            </label>
            {% for category in categories %}
              <label class="filter-option">
                <input type="checkbox" name="category" value="{{ category.slug }}">
                <span>{{ category.name }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="toolbar-right">
        <label class="sort-box" for="sort-select">
          <i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>
          <span class="sort-label">Sort by</span>
          <select id="sort-select" class="sort-select">
            <option value="recent">Most recent</option>
            <option value="title">Title A–Z</option>
            <option value="title-desc">Title Z–A</option>
            <option value="duration">Lesson duration</option>
          </select>
        </label>

        <div class="view-toggle" role="group" aria-label="Course view">
          <button type="button" class="view-btn active" id="view-grid" aria-label="Grid view" aria-pressed="true" title="Grid view">
            <i class="fa-solid fa-grip" aria-hidden="true"></i>
          </button>
          <button type="button" class="view-btn" id="view-list" aria-label="List view" aria-pressed="false" title="List view">
            <i class="fa-solid fa-list" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="active-filters" id="active-filters" aria-live="polite"></div>
  </section>

  <section class="course-catalog__results" aria-label="Available courses">
    <div class="no-results" id="no-results" hidden>
      <span class="no-results-icon"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
      <h2>No courses found</h2>
      <p>Try another keyword or remove some filters to see more courses.</p>
      <button type="button" class="reset-filters-btn" id="reset-filters">
        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
        Reset filters
      </button>
    </div>

    <div class="course-grid" id="course-container">
      {% for course in courses %}
        {% set hasAccess = access[course.id] is defined and access[course.id] %}
        {% set firstVideo = course.videos|first %}
        {% set lessonDuration = firstVideo ? firstVideo.duration : 0 %}

        <article
          class="course-card {{ hasAccess ? 'is-unlocked' : 'is-locked' }}"
          data-category="{{ course.category ? course.category.slug : 'training' }}"
          data-duration="{{ lessonDuration }}"
          data-index="{{ loop.index0 }}"
        >
          <a href="{{ path('app_course_show', { id: course.id }) }}" class="course-thumbnail" aria-label="Open {{ course.title }}">
            {% if course.thumb %}
              <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="" loading="lazy">
            {% else %}
              <span class="course-thumbnail__placeholder"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
            {% endif %}

            <span class="course-thumbnail__shade"></span>

            {% if course.category %}
              <span class="category-badge">{{ course.category.name }}</span>
            {% endif %}

            {% if firstVideo %}
              <span class="duration-badge">
                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                {{ (lessonDuration / 60)|round(0, 'floor') }}:{{ '%02d'|format(lessonDuration % 60) }}
              </span>
            {% endif %}

            {% if not hasAccess %}
              <span class="course-lock-status">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                Locked
              </span>
            {% endif %}
          </a>

          <div class="course-info">
            <div class="course-card__status-row">
              <span class="access-badge {{ hasAccess ? 'unlocked' : 'locked' }}">
                <i class="fa-solid {{ hasAccess ? 'fa-circle-check' : 'fa-lock' }}" aria-hidden="true"></i>
                {{ hasAccess ? 'Available now' : 'Access required' }}
              </span>
              {% if course.updatedAt %}
                <span class="updated-at">
                  <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                  {{ course.updatedAt|date('d M Y') }}
                </span>
              {% endif %}
            </div>

            <h2 class="course-title">{{ course.title }}</h2>
            <p class="course-subtitle">
              {{ course.description|striptags|slice(0, 145) }}{% if course.description|striptags|length > 145 %}&hellip;{% endif %}
            </p>

            <div class="course-footer">
              <span class="video-count">
                <i class="fa-solid fa-circle-play" aria-hidden="true"></i>
                {{ course.videos|length }} lesson{{ course.videos|length == 1 ? '' : 's' }}
              </span>
              <a href="{{ path('app_course_show', { id: course.id }) }}" class="see-course-btn">
                {{ hasAccess ? 'Open course' : 'View options' }}
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const catalog = document.querySelector('[data-course-catalog]');
  if (!catalog) return;

  const container = catalog.querySelector('#course-container');
  const btnGrid = catalog.querySelector('#view-grid');
  const btnList = catalog.querySelector('#view-list');
  const searchInput = catalog.querySelector('#course-search');
  const clearSearch = catalog.querySelector('#clear-search');
  const sortSelect = catalog.querySelector('#sort-select');
  const categoryFilter = catalog.querySelector('#category-filter');
  const categoryDropdown = catalog.querySelector('#category-dropdown');
  const resultsCount = catalog.querySelector('#results-count');
  const noResults = catalog.querySelector('#no-results');
  const resetFiltersBtn = catalog.querySelector('#reset-filters');
  const activeFiltersContainer = catalog.querySelector('#active-filters');
  const courses = Array.from(container.querySelectorAll('.course-card'));
  const categoryCheckboxes = Array.from(catalog.querySelectorAll('input[name="category"]'));
  let activeCategories = new Set(['all']);

  const setView = (view) => {
    const isList = view === 'list';
    container.classList.toggle('is-list', isList);
    btnGrid?.classList.toggle('active', !isList);
    btnList?.classList.toggle('active', isList);
    btnGrid?.setAttribute('aria-pressed', String(!isList));
    btnList?.setAttribute('aria-pressed', String(isList));
    localStorage.setItem('courseView', view);
  };

  btnGrid?.addEventListener('click', () => setView('grid'));
  btnList?.addEventListener('click', () => setView('list'));
  setView(localStorage.getItem('courseView') === 'list' ? 'list' : 'grid');

  const setCategoryMenuOpen = (isOpen) => {
    categoryDropdown?.classList.toggle('show', isOpen);
    categoryFilter?.setAttribute('aria-expanded', String(isOpen));
  };

  categoryFilter?.addEventListener('click', (event) => {
    event.stopPropagation();
    setCategoryMenuOpen(!categoryDropdown?.classList.contains('show'));
  });

  document.addEventListener('click', (event) => {
    if (!event.target.closest('.filters')) setCategoryMenuOpen(false);
  });

  const filterCourses = () => {
    const searchTerm = searchInput?.value.trim().toLowerCase() || '';
    let visibleCount = 0;

    courses.forEach((course) => {
      const title = course.querySelector('.course-title')?.textContent.toLowerCase() || '';
      const description = course.querySelector('.course-subtitle')?.textContent.toLowerCase() || '';
      const category = course.dataset.category || 'training';
      const matchesSearch = title.includes(searchTerm) || description.includes(searchTerm);
      const matchesCategory = activeCategories.has('all') || activeCategories.has(category);
      const isVisible = matchesSearch && matchesCategory;

      course.hidden = !isVisible;
      if (isVisible) visibleCount++;
    });

    if (resultsCount) {
      resultsCount.textContent = `${visibleCount} course${visibleCount === 1 ? '' : 's'}`;
    }

    const hasResults = visibleCount > 0;
    noResults.hidden = hasResults;
    container.hidden = !hasResults;
  };

  const updateActiveFilters = () => {
    activeFiltersContainer.replaceChildren();

    if (activeCategories.has('all')) return;

    activeCategories.forEach((category) => {
      const checkbox = categoryCheckboxes.find((item) => item.value === category);
      const label = checkbox?.closest('.filter-option')?.querySelector('span')?.textContent.trim() || category;
      const tag = document.createElement('span');
      const text = document.createElement('span');
      const removeButton = document.createElement('button');

      tag.className = 'active-filter-tag';
      text.textContent = label;
      removeButton.type = 'button';
      removeButton.setAttribute('aria-label', `Remove ${label} filter`);
      removeButton.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
      removeButton.addEventListener('click', () => {
        checkbox.checked = false;
        checkbox.dispatchEvent(new Event('change'));
      });

      tag.append(text, removeButton);
      activeFiltersContainer.appendChild(tag);
    });
  };

  categoryCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', (event) => {
      const value = event.target.value;
      const allCheckbox = categoryCheckboxes.find((item) => item.value === 'all');

      if (value === 'all') {
        event.target.checked = true;
        activeCategories.clear();
        activeCategories.add('all');
        categoryCheckboxes.forEach((item) => {
          if (item.value !== 'all') item.checked = false;
        });
      } else {
        allCheckbox.checked = false;
        activeCategories.delete('all');

        if (event.target.checked) {
          activeCategories.add(value);
        } else {
          activeCategories.delete(value);
        }

        if (activeCategories.size === 0) {
          activeCategories.add('all');
          allCheckbox.checked = true;
        }
      }

      categoryFilter.classList.toggle('active', !activeCategories.has('all'));
      updateActiveFilters();
      filterCourses();
    });
  });

  const sortCourses = (criteria) => {
    const sortedCourses = [...courses].sort((courseA, courseB) => {
      const titleA = courseA.querySelector('.course-title')?.textContent.trim().toLowerCase() || '';
      const titleB = courseB.querySelector('.course-title')?.textContent.trim().toLowerCase() || '';

      if (criteria === 'title') return titleA.localeCompare(titleB);
      if (criteria === 'title-desc') return titleB.localeCompare(titleA);
      if (criteria === 'duration') return Number(courseB.dataset.duration) - Number(courseA.dataset.duration);

      return Number(courseA.dataset.index) - Number(courseB.dataset.index);
    });

    sortedCourses.forEach((course) => container.appendChild(course));
  };

  sortSelect?.addEventListener('change', (event) => sortCourses(event.target.value));

  searchInput?.addEventListener('input', () => {
    clearSearch.hidden = searchInput.value.length === 0;
    filterCourses();
  });

  clearSearch?.addEventListener('click', () => {
    searchInput.value = '';
    clearSearch.hidden = true;
    searchInput.focus();
    filterCourses();
  });

  resetFiltersBtn?.addEventListener('click', () => {
    searchInput.value = '';
    clearSearch.hidden = true;
    categoryCheckboxes.forEach((checkbox) => {
      checkbox.checked = checkbox.value === 'all';
    });
    activeCategories = new Set(['all']);
    categoryFilter.classList.remove('active');
    sortSelect.value = 'recent';
    updateActiveFilters();
    sortCourses('recent');
    filterCourses();
  });

  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      searchInput?.focus();
    }

    if (event.key === 'Escape') {
      setCategoryMenuOpen(false);
      if (searchInput === document.activeElement && searchInput.value) clearSearch?.click();
    }
  });

  filterCourses();
});
</script>
{% endblock %}
