{% extends 'base.html.twig' %}

{% block title %}Available Courses{% endblock %}

{% block body %}
    {% for course in courses %}
      <section class="course-section">
        <h2 class="section-title">{{ course.title }}</h2>
        <div class="course-grid">
          {% for video in course.videos %}
            <div class="course-card">
              <div class="course-thumbnail bg-aml">
                {% set userProgress = progress|filter(p => p.video.id == video.id)|first %}
                {% if userProgress and userProgress.completed %}
                  <div class="status-badge status-complete">Complete</div>
                {% elseif userProgress %}
                  <div class="status-badge status-progress">In progress</div>
                {% else %}
                  <div class="lock-overlay">
                    <div class="lock-icon">
                      <svg viewBox="0 0 24 24">
                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                      </svg>
                    </div>
                  </div>
                {% endif %}
              </div>
              <div class="course-info">
                <h3 class="course-title">{{ video.title }}</h3>
                <p class="course-subtitle">{{ course.description }}</p>
                <div class="course-footer">
                  <div class="course-duration">
                    <span>00:00</span>
                    <span>{{ (video.duration / 60)|round(0, 'floor') }}:{{ (video.duration % 60)|default('00') }}</span>
                  </div>
                  <a href="{{ path('app_course_show', {id: course.id, videoId: video.id}) }}" class="see-course-btn">See Course</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endfor %}
{% endblock %}