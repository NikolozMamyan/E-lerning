{% extends 'base.html.twig' %}

{% block title %}{{ course.title }} | Online Compliance Course{% endblock %}
{% block meta_description %}{{ course.description|striptags|slice(0, 155) }}{% endblock %}
{% block meta_robots %}index, follow, max-image-preview:large, max-snippet:-1{% endblock %}
{% block canonical_url %}{{ url('app_public_course_show', {id: course.id, slug: course.slug}) }}{% endblock %}
{% block meta_image %}{{ course.thumb ? absolute_url(asset('uploads/courses/' ~ course.thumb)) : absolute_url(asset('images/logo.png')) }}{% endblock %}

{% block structured_data %}
  {% set schemaPrice = (euroPrice|default('0')|replace({' ': '', ',': '.'}) + 0) %}
  {% set courseData = {
    '@context': 'https://schema.org',
    '@type': 'Course',
    'name': course.title,
    'description': course.description|striptags,
    'url': url('app_public_course_show', {id: course.id, slug: course.slug}),
    'provider': {
      '@type': 'Organization',
      'name': 'Les Consultants E-learning',
      'sameAs': url('app_landing_page')
    }
  } %}
  {% if course.thumb %}
    {% set courseData = courseData|merge({'image': absolute_url(asset('uploads/courses/' ~ course.thumb))}) %}
  {% endif %}
  {% if schemaPrice > 0 %}
    {% set courseData = courseData|merge({'offers': {
      '@type': 'Offer',
      'price': schemaPrice|number_format(2, '.', ''),
      'priceCurrency': 'EUR',
      'availability': 'https://schema.org/InStock',
      'url': url('app_public_course_show', {id: course.id, slug: course.slug})
    }}) %}
  {% endif %}
  <script type="application/ld+json">{{ courseData|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/courseLocked.css') }}">
{% endblock %}

{% block body %}
{% set euro = (euroPrice|default('0')|replace({',': '.'}) + 0) %}
{% set priceHT = (euro / 1.17)|round(2, 'ceil') %}
{% set tva = (euro - priceHT)|round(2, 'ceil') %}
{% set totalVideos = course.videos|length %}

<div class="course-purchase">
  <header class="course-purchase__hero">
    <div>
      <a href="{{ path(app.user ? 'app_courses' : 'app_public_catalog') }}" class="course-purchase__back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        All courses
      </a>

      <div class="course-purchase__eyebrow">
        <span class="course-purchase__status">
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          Access required
        </span>
        {% if course.category %}
          <span>{{ course.category.name }}</span>
        {% endif %}
      </div>

      <h1>{{ course.title }}</h1>
      <p>Get immediate access to the complete training, its learning resources and the final certificate.</p>

      <div class="course-purchase__meta" aria-label="Course information">
        <span><i class="fa-solid fa-circle-play" aria-hidden="true"></i>{{ totalVideos }} lesson{{ totalVideos == 1 ? '' : 's' }}</span>
        <span><i class="fa-solid fa-infinity" aria-hidden="true"></i>Full course access</span>
        <span><i class="fa-solid fa-award" aria-hidden="true"></i>Certificate included</span>
        {% if course.updatedAt %}
          <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>Updated {{ course.updatedAt|date('d M Y') }}</span>
        {% endif %}
      </div>
    </div>

    <div class="course-purchase__hero-mark" aria-hidden="true">
      <span><i class="fa-solid fa-lock-open"></i></span>
      <strong>Learn at your pace</strong>
      <small>One secure payment</small>
    </div>
  </header>

  <div class="course-purchase__layout">
    <div class="course-purchase__content">
      <section class="course-purchase__preview">
        <div class="course-purchase__cover">
          {% if course.thumb %}
            <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="" loading="eager">
          {% else %}
            <div class="course-purchase__cover-placeholder"><i class="fa-solid fa-book-open" aria-hidden="true"></i></div>
          {% endif %}
          <div class="course-purchase__cover-shade"></div>
          <span class="course-purchase__cover-lock"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
          <div class="course-purchase__cover-copy">
            <span>Course preview</span>
            <strong>{{ course.title }}</strong>
          </div>
        </div>

        <div class="course-purchase__description">
          <div class="course-purchase__section-heading">
            <span class="course-purchase__section-icon"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></span>
            <div>
              <span>About this training</span>
              <h2>Course overview</h2>
            </div>
          </div>
          <p>{{ course.description }}</p>

          <div class="course-purchase__benefits">
            <div><i class="fa-solid fa-bolt" aria-hidden="true"></i><span><strong>Immediate access</strong><small>Start right after payment</small></span></div>
            <div><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span><strong>Self-paced</strong><small>Learn on your schedule</small></span></div>
            <div><i class="fa-solid fa-headset" aria-hidden="true"></i><span><strong>Support included</strong><small>Help whenever needed</small></span></div>
          </div>
        </div>
      </section>

      <section class="course-purchase__curriculum">
        <div class="course-purchase__section-heading">
          <span class="course-purchase__section-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
          <div>
            <span>Included in this course</span>
            <h2>What you will learn</h2>
          </div>
        </div>

        <div class="course-purchase__lesson-list">
          {% for video in course.videos %}
            {% set mins = (video.duration / 60)|round(0, 'floor') %}
            {% set secs = video.duration % 60 %}
            <div class="course-purchase__lesson">
              <span>{{ loop.index }}</span>
              <div>
                <strong>{{ video.title }}</strong>
                <small>Video lesson <span aria-hidden="true">&bull;</span> {{ '%02d'|format(mins) }}:{{ '%02d'|format(secs) }}</small>
              </div>
              <i class="fa-solid fa-lock" aria-hidden="true"></i>
            </div>
          {% else %}
            <div class="course-purchase__empty-lessons">
              <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
              The detailed curriculum will be available soon.
            </div>
          {% endfor %}
        </div>

        {% if course.planPdf %}
          <a class="course-purchase__plan" href="{{ asset('uploads/course_plans/' ~ course.planPdf) }}" target="_blank" download>
            <span><i class="fa-regular fa-file-pdf" aria-hidden="true"></i></span>
            <div>
              <strong>Training plan</strong>
              <small>Download the complete syllabus</small>
            </div>
            <i class="fa-solid fa-download" aria-hidden="true"></i>
          </a>
        {% endif %}
      </section>

      <section class="course-purchase__requirements">
        <span><i class="fa-solid fa-check" aria-hidden="true"></i></span>
        <div>
          <h2>No specific requirements</h2>
          <p>This training is suitable for beginners and professionals who want to deepen their knowledge.</p>
        </div>
      </section>
    </div>

    <aside class="course-purchase__checkout">
      <section class="course-purchase__checkout-card">
        <div class="course-purchase__checkout-heading">
          <div>
            <span>One-time purchase</span>
            <h2>Unlock this course</h2>
          </div>
          <span class="course-purchase__secure-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
        </div>

        <div class="course-purchase__price">
          {% if euroPrice is not null %}
            <strong><sup>&euro;</sup>{{ priceHT|number_format(2, ',', ' ') }}</strong>
            <span>excluding VAT</span>
          {% else %}
            <strong class="course-purchase__price-unavailable">Price unavailable</strong>
          {% endif %}
        </div>

        <div class="course-purchase__summary">
          <div><span>Course price</span><strong>&euro;{{ priceHT|number_format(2, ',', ' ') }}</strong></div>
          <div><span>VAT</span><strong>&euro;{{ tva|number_format(2, ',', ' ') }}</strong></div>
          <div class="course-purchase__summary-total"><span>Total incl. VAT</span><strong>&euro;{{ euro|number_format(2, ',', ' ') }}</strong></div>
        </div>

        <div class="course-purchase__buyer">
          <span class="course-purchase__buyer-avatar"><i class="fa-regular fa-user" aria-hidden="true"></i></span>
          <div>
            <small>Purchasing as</small>
            <strong>{{ app.user ? app.user.username|default(app.user.email) : 'Guest user' }}</strong>
            {% if app.user %}<span>{{ app.user.email }}</span>{% endif %}
          </div>
        </div>

        <form method="post" action="{{ path('app_catalog_course_checkout', { id: course.id }) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('catalog_checkout_' ~ course.id) }}">
          <button type="submit" class="course-purchase__buy" {% if euroPrice is null %}disabled{% endif %}>
            <span>Buy and start learning</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>

        <div class="course-purchase__security">
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          Secure and encrypted payment
        </div>

        <div class="course-purchase__methods" aria-label="Accepted payment methods">
          <span>VISA</span>
          <span><i class="fa-brands fa-cc-mastercard" aria-label="Mastercard"></i></span>
          <span>CB</span>
          <span>AMEX</span>
        </div>

        <div class="course-purchase__links">
          <a href="/legales/TermsConditions.html">Terms</a>
          <a href="/legales/Privacy.html">Privacy</a>
          <a href="{{ path('app_contact') }}">Need help?</a>
        </div>
      </section>
    </aside>
  </div>
</div>
{% endblock %}
