{% extends 'base.html.twig' %}

{% block title %}{{ course.title }} - Course{% endblock %}

{% block body %}
{% set totalVideos = videos|length %}
{% set completedCount = 0 %}
{% for video in videos %}
  {% set videoProgress = progress[video.id] ?? null %}
  {% if videoProgress and videoProgress.completed %}
    {% set completedCount = completedCount + 1 %}
  {% endif %}
{% endfor %}

{% set currentIndex = -1 %}
{% if currentVideo %}
  {% for video in videos %}
    {% if video.id == currentVideo.id %}
      {% set currentIndex = loop.index0 %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set hasPrev = currentIndex > 0 %}
{% set hasNext = currentIndex + 1 < totalVideos %}
{% set prevVideo = hasPrev ? videos[currentIndex - 1] : null %}
{% set nextVideo = hasNext ? videos[currentIndex + 1] : null %}
{% set activeCourseLocale = ((app.request.locale == 'fr' and hasFrench) or (app.request.locale == 'it' and hasItalian)) ? app.request.locale : 'en' %}

<div class="course-detail">
  <header class="course-detail__hero">
    <div class="course-detail__hero-copy">
      <a href="{{ path('app_courses') }}" class="course-detail__back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        All courses
      </a>

      <div class="course-detail__eyebrow">
        <span class="course-detail__access course-detail__access--open">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          Course open
        </span>
        {% if course.category %}
          <span>{{ course.category.name }}</span>
        {% endif %}
      </div>

      <h1>{{ course.title }}</h1>
      <p>{{ course.description|striptags|slice(0, 220) }}{% if course.description|striptags|length > 220 %}&hellip;{% endif %}</p>

      <div class="course-detail__meta" aria-label="Course information">
        <span><i class="fa-solid fa-circle-play" aria-hidden="true"></i>{{ totalVideos }} lesson{{ totalVideos == 1 ? '' : 's' }}</span>
        {% if course.updatedAt %}
          <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>Updated {{ course.updatedAt|date('d M Y') }}</span>
        {% endif %}
        <span><i class="fa-solid fa-award" aria-hidden="true"></i>Certificate included</span>
      </div>
    </div>

    <div class="course-detail__progress-card">
      <div class="course-detail__progress-head">
        <div>
          <span>Your progress</span>
          <strong>{{ progressPercent }}%</strong>
        </div>
        <span class="course-detail__progress-icon">
          <i class="fa-solid {{ progressPercent == 100 ? 'fa-trophy' : 'fa-chart-line' }}" aria-hidden="true"></i>
        </span>
      </div>
      <div class="course-detail__progress-bar" role="progressbar" aria-label="Course completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progressPercent }}">
        <span style="width: {{ progressPercent }}%"></span>
      </div>
      <p>{{ completedCount }} of {{ totalVideos }} lessons completed</p>
    </div>
  </header>

  <div class="course-detail__layout">
    <div class="course-detail__workspace">
      <section class="course-detail__player-card" aria-label="Current lesson">
        <div class="course-detail__player-heading">
          <div>
            <span>Lesson {{ currentIndex >= 0 ? currentIndex + 1 : 0 }} of {{ totalVideos }}</span>
            <h2>{{ currentVideo ? currentVideo.title : 'No lesson available' }}</h2>
          </div>
          {% if currentVideo %}
            {% set currentMins = (currentVideo.duration / 60)|round(0, 'floor') %}
            {% set currentSecs = currentVideo.duration % 60 %}
            <span class="course-detail__duration"><i class="fa-regular fa-clock" aria-hidden="true"></i>{{ '%02d'|format(currentMins) }}:{{ '%02d'|format(currentSecs) }}</span>
          {% endif %}
        </div>

        <div class="video-container course-detail__video">
          {% if hasFrench or hasItalian %}
            <div
              class="course-detail__player-language"
              aria-label="Course language"
              aria-expanded="true"
              data-controller="language-switcher"
              data-language-switcher-delay-value="4500"
              data-language-switcher-collapse-delay-value="700"
              data-action="mouseenter->language-switcher#expand mouseleave->language-switcher#scheduleCollapse focusin->language-switcher#expand focusout->language-switcher#scheduleCollapse"
            >
              <span class="course-detail__language-label">
                <i class="fa-solid fa-globe" aria-hidden="true"></i>
                <span class="course-detail__language-label-text">Language</span>
              </span>
              <div class="course-detail__language-options">
                <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}"
                   class="{{ activeCourseLocale == 'en' ? 'is-active' : '' }}"
                   aria-current="{{ activeCourseLocale == 'en' ? 'true' : 'false' }}">
                  <span class="course-detail__language-name">English</span>
                  <span class="course-detail__language-code" aria-hidden="true">EN</span>
                  {% if activeCourseLocale == 'en' %}<i class="fa-solid fa-check" aria-hidden="true"></i>{% endif %}
                </a>
                {% if hasFrench %}
                  <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}"
                     class="{{ activeCourseLocale == 'fr' ? 'is-active' : '' }}"
                     aria-current="{{ activeCourseLocale == 'fr' ? 'true' : 'false' }}">
                    <span class="course-detail__language-name">Français</span>
                    <span class="course-detail__language-code" aria-hidden="true">FR</span>
                    {% if activeCourseLocale == 'fr' %}<i class="fa-solid fa-check" aria-hidden="true"></i>{% endif %}
                  </a>
                {% endif %}
                {% if hasItalian %}
                  <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'it'})) }}"
                     class="{{ activeCourseLocale == 'it' ? 'is-active' : '' }}"
                     aria-current="{{ activeCourseLocale == 'it' ? 'true' : 'false' }}">
                    <span class="course-detail__language-name">Italiano</span>
                    <span class="course-detail__language-code" aria-hidden="true">IT</span>
                    {% if activeCourseLocale == 'it' %}<i class="fa-solid fa-check" aria-hidden="true"></i>{% endif %}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
          {% if currentVideo %}
            <iframe
              src="{{ currentVideoUrl }}"
              title="{{ currentVideo.title }}"
              width="100%"
              height="100%"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              data-controller="progress"
              data-progress-video-id-value="{{ currentVideo.id }}"
              data-progress-expected-duration-value="{{ currentVideo.duration|default(0) }}"
              data-progress-update-url-value="{{ path('app_progress_update', { id: currentVideo.id }) }}"
              data-progress-popup-image-value="{{ asset('images/congrats.svg') }}"
              data-progress-last-lesson-value="{{ hasNext ? 'false' : 'true' }}"
            ></iframe>
          {% else %}
            <div class="course-detail__empty-player">
              <i class="fa-solid fa-video-slash" aria-hidden="true"></i>
              <strong>No lesson available yet</strong>
              <span>New content will appear here when it is published.</span>
            </div>
          {% endif %}
        </div>

        <div class="course-detail__lesson-nav">
          <div>
            {% if hasPrev %}
              <a href="{{ path('app_course_show', { id: course.id, videoId: prevVideo.id }) }}" class="course-detail__button course-detail__button--secondary">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                Previous lesson
              </a>
            {% endif %}
          </div>

          <div>
            {% if course.id == 12 %}
              <a href="{{ path('app_course_show', { id: 13 }) }}" class="course-detail__button course-detail__button--primary">
                Continue to part 2
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            {% elseif hasNext %}
              <a href="{{ path('app_course_show', { id: course.id, videoId: nextVideo.id }) }}" class="course-detail__button course-detail__button--primary">
                Next lesson
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            {% elseif progressPercent == 100 and hasPassedQuiz %}
              <a href="{{ path('app_certificates') }}" class="course-detail__button course-detail__button--primary">
                View certificate
                <i class="fa-solid fa-award" aria-hidden="true"></i>
              </a>
            {% elseif progressPercent == 100 and latestQuizAttempt %}
              <form method="post" action="{{ path('app_course_checkout', { id: course.id }) }}">
                <button type="submit" class="course-detail__button course-detail__button--retry">
                  Unlock new attempt
                  <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                </button>
              </form>
            {% elseif progressPercent == 100 %}
              <a href="{{ path('course_quiz', { id: course.id }) }}" class="course-detail__button course-detail__button--primary course-detail__button--quiz">
                Take the quiz
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            {% endif %}
          </div>
        </div>

        {% if progressPercent == 100 and latestQuizAttempt and not hasPassedQuiz %}
          <div class="course-detail__quiz-note">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <span>Your last quiz attempt scored <strong>{{ latestQuizAttempt.score }}%</strong>. Purchase a new attempt to try again.</span>
          </div>
        {% endif %}
      </section>

      <section class="course-detail__overview">
        <div class="course-detail__section-heading">
          <span class="course-detail__section-icon"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></span>
          <div>
            <span>About this training</span>
            <h2>Course overview</h2>
          </div>
        </div>
        <p>{{ course.description }}</p>

        {% if course.planPdf %}
          <a class="course-detail__plan" href="{{ asset('uploads/course_plans/' ~ course.planPdf) }}" target="_blank" download>
            <span><i class="fa-regular fa-file-pdf" aria-hidden="true"></i></span>
            <div>
              <strong>Training plan</strong>
              <small>Download the complete syllabus</small>
            </div>
            <i class="fa-solid fa-download" aria-hidden="true"></i>
          </a>
        {% endif %}
      </section>
    </div>

    <aside class="course-detail__curriculum">
      <div class="course-detail__curriculum-head">
        <div>
          <span>Course content</span>
          <h2>Lessons</h2>
        </div>
        <strong>{{ completedCount }}/{{ totalVideos }}</strong>
      </div>

      <div class="course-detail__lesson-list">
        {% for video in videos %}
          {% set userProgress = progress[video.id] ?? null %}
          {% set isCurrent = currentVideo and currentVideo.id == video.id %}
          {% set mins = (video.duration / 60)|round(0, 'floor') %}
          {% set secs = video.duration % 60 %}
          <a href="{{ path('app_course_show', { id: course.id, videoId: video.id }) }}"
             class="course-detail__lesson {{ isCurrent ? 'is-current' : '' }} {{ userProgress and userProgress.completed ? 'is-complete' : '' }}"
             aria-current="{{ isCurrent ? 'true' : 'false' }}">
            <span class="course-detail__lesson-number">
              {% if userProgress and userProgress.completed %}
                <i class="fa-solid fa-check" aria-hidden="true"></i>
              {% else %}
                {{ loop.index }}
              {% endif %}
            </span>
            <span class="course-detail__lesson-copy">
              <strong>{{ video.title }}</strong>
              <small>
                {% if isCurrent %}Now playing{% elseif userProgress and userProgress.completed %}Completed{% else %}Lesson {{ loop.index }}{% endif %}
                <span aria-hidden="true">&bull;</span>
                {{ '%02d'|format(mins) }}:{{ '%02d'|format(secs) }}
              </small>
            </span>
            <i class="fa-solid {{ isCurrent ? 'fa-volume-high' : 'fa-chevron-right' }} course-detail__lesson-action" aria-hidden="true"></i>
          </a>
        {% else %}
          <div class="course-detail__empty-list">
            <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
            No lessons published yet.
          </div>
        {% endfor %}
      </div>
    </aside>
  </div>
</div>

<script src="https://player.vimeo.com/api/player.js"></script>
{% endblock %}
