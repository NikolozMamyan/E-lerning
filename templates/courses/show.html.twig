{% extends 'base.html.twig' %}

{% block title %}Project Management - Course{% endblock %}

{% block body %}

<style>
  :root{
    --green:#1A6D55;
    --teal:#0D8383;
    --black:#071717;
    --mint:#E7F3F3;
    --grey:#606060;
    --white:#FFFFFF;
    --radius:12px;
    --shadow:0 4px 12px rgba(7,23,23,.08);
  }
  *{box-sizing:border-box}

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f8fafc;
    color: var(--black);
  }

  /* ------- Layout ------- */
  .dashboard-layout {
    display: grid;
    grid-template-columns: 280px 1fr 320px;
    min-height: 100vh;
  }

  /* ------- Sidebar (same as before) ------- */
  .sidebar {
    background: var(--mint);
    padding: 2rem 0;
    border-right: 1px solid #e2e8f0;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 2rem 2rem;
    margin-bottom: 1rem;
  }

  .logo {
    width: 40px;
    height: 40px;
    background: var(--teal);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo svg {
    width: 24px;
    height: 24px;
    fill: white;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--black);
  }

  .nav-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin: 0.25rem 1.5rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    text-decoration: none;
    color: var(--grey);
    border-radius: var(--radius);
    transition: all 0.2s ease;
    font-weight: 500;
  }

  .nav-link:hover {
    background: rgba(26, 109, 85, 0.1);
    color: var(--green);
  }

  .nav-link.active {
    background: var(--green);
    color: white;
  }

  .nav-icon {
    width: 20px;
    height: 20px;
  }

  .notification-badge {
    background: var(--teal);
    color: white;
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    font-weight: 600;
    margin-left: auto;
  }

  /* ------- Main Content ------- */
  .main-content {
    padding: 2rem;
    overflow-y: auto;
  }

  .course-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .back-button {
    width: 48px;
    height: 48px;
    background: var(--teal);
    border: none;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .back-button:hover {
    background: #0a7070;
  }

  .back-button svg {
    width: 24px;
    height: 24px;
    fill: white;
  }

  .course-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--black);
    margin: 0;
  }

  .user-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .user-info h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--black);
  }

  .user-info p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--grey);
  }

  /* ------- Video Player ------- */
  .video-container {
    position: relative;
    background: var(--black);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 2rem;
    aspect-ratio: 16/9;
    box-shadow: var(--shadow);
  }

  .video-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    background-size: cover;
    background-position: center;
    filter: blur(1px);
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lock-icon-large {
    width: 80px;
    height: 80px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lock-icon-large svg {
    width: 40px;
    height: 40px;
    fill: var(--green);
  }

  /* ------- Lesson Info ------- */
  .lesson-info {
    margin-bottom: 2rem;
  }

  .lesson-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--black);
    margin: 0 0 1rem;
  }

  .lesson-description {
    color: var(--grey);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .lesson-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .action-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    background: var(--white);
    border-radius: var(--radius);
    color: var(--grey);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .action-button:hover {
    border-color: var(--teal);
    color: var(--teal);
  }

  .action-button svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .unlock-buttons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .unlock-button {
    background: var(--green);
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }

  .unlock-button:hover {
    background: #155a49;
    transform: translateY(-1px);
  }

  .request-button {
    background: transparent;
    color: var(--teal);
    border: 2px solid var(--teal);
    padding: 1rem 2rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .request-button:hover {
    background: var(--teal);
    color: white;
  }

  /* ------- Overview Section ------- */
  .overview-section {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--black);
    margin: 0 0 1rem;
  }

  .overview-content {
    color: var(--grey);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .key-areas {
    margin-bottom: 1rem;
  }

  .key-areas h4 {
    font-weight: 600;
    color: var(--black);
    margin: 0 0 0.5rem;
  }

  .key-areas ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .key-areas li {
    margin-bottom: 1rem;
    padding-left: 1rem;
    position: relative;
  }

  .key-areas li::before {
    content: '•';
    color: var(--teal);
    font-weight: 700;
    position: absolute;
    left: 0;
  }

  .key-areas strong {
    color: var(--black);
    font-weight: 600;
  }

  /* ------- Right Sidebar ------- */
  .right-sidebar {
    background: var(--white);
    border-left: 1px solid #e2e8f0;
    padding: 2rem;
    overflow-y: auto;
  }

  .sidebar-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--black);
    margin: 0 0 1.5rem;
  }

  .upcoming-videos {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-item {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
  }

  .video-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(7,23,23,.15);
  }

  .video-thumbnail {
    position: relative;
    width: 100%;
    height: 120px;
    background-size: cover;
    background-position: center;
  }

  .video-status-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
  }

  .status-complete { background: var(--green); }
  .status-progress { background: #f59e0b; }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-button {
    width: 40px;
    height: 40px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .play-button svg {
    width: 16px;
    height: 16px;
    fill: var(--green);
    margin-left: 2px;
  }

  .video-info {
    padding: 1rem;
  }

  .video-title {
    font-weight: 600;
    color: var(--black);
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }

  .video-subtitle {
    color: var(--grey);
    font-size: 0.8rem;
    margin: 0 0 0.75rem;
  }

  .video-duration {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--grey);
    font-weight: 500;
  }

  /* ------- Different Video Backgrounds ------- */
  .bg-aml { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
  .bg-project { background: linear-gradient(135deg, var(--green) 0%, var(--teal) 100%); }
  .bg-training { background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); }
  .bg-locked { background: linear-gradient(135deg, #374151 0%, #1f2937 100%); }

  /* ------- Responsive ------- */
  @media (max-width: 1400px) {
    .dashboard-layout {
      grid-template-columns: 280px 1fr 280px;
    }
  }

  @media (max-width: 1024px) {
    .dashboard-layout {
      grid-template-columns: 1fr;
    }
    
    .sidebar, .right-sidebar {
      display: none;
    }
    
    .main-content {
      padding: 1rem;
    }
  }

  @media (max-width: 768px) {
    .course-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .user-profile {
      margin-left: 0;
    }
    
    .unlock-buttons {
      flex-direction: column;
    }
  }

  /*pop*/
  .progress-popup-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.progress-popup {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  text-align: center;
  max-width: 400px;
  width: 90%;
  box-shadow: 0 6px 20px rgba(0,0,0,0.25);
}

.progress-popup h2 {
  margin-bottom: 0.5rem;
  font-size: 1.5rem;
}

.progress-popup p {
  margin-bottom: 1rem;
  color: #606060;
}

.progress-popup .popup-btn {
  background: #1A6D55;
  color: white;
  border: none;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
}

.progress-popup .popup-btn:hover {
  background: #155a49;
}

</style>

 <!-- Video Player -->
<div class="video-container">
  {% if currentVideo %}
    <video
      id="course-video"
      width="100%"
      controls
      preload="metadata"
      data-controller="progress"
      data-progress-video-id-value="{{ currentVideo.id }}"
      data-progress-expected-duration-value="{{ currentVideo.duration|default(0) }}"
      data-progress-update-url-value="{{ path('app_progress_update', { id: currentVideo.id }) }}"
      data-progress-popup-image-value="{{ asset('images/congrats.svg') }}"
    >
      <source src="{{ currentVideo.url }}" type="video/mp4">
    </video>
  {% else %}
    <div class="video-background"></div>
    <div class="video-overlay">
      <div class="lock-icon-large">
        <svg viewBox="0 0 24 24">
          <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
        </svg>
      </div>
    </div>
  {% endif %}
</div>

<!-- Lesson Info -->
<div class="lesson-info">
  <h2 class="lesson-title">{{ course.title }}</h2>
  <p class="lesson-description">{{ course.description }}</p>

  <p><strong>Progression :</strong> {{ progressPercent }}%</p>
</div>

<!-- Right Sidebar -->
<aside class="right-sidebar">
  <h3 class="sidebar-title">Upcoming Videos</h3>
  <div class="upcoming-videos">
    {% for video in videos %}
      <div class="video-item">
        <div class="video-thumbnail bg-project">
          {% set userProgress = progress[video.id] ?? null %}
          {% if userProgress and userProgress.completed %}
            <div class="video-status-badge status-complete">Complete</div>
          {% elseif userProgress %}
            <div class="video-status-badge status-progress">In progress</div>
          {% endif %}
          <div class="video-overlay">
            <a href="{{ path('app_course_show', { id: course.id, videoId: video.id }) }}" class="play-button">
              <svg viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="video-info">
          <h4 class="video-title">{{ video.title }}</h4>
          <p class="video-subtitle">{{ course.description }}</p>
          <div class="video-duration">
            <span>00:00</span>
            <span>{{ (video.duration / 60)|round(0, 'floor') }}:{{ (video.duration % 60)|default('00') }}</span>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</aside>

{% endblock %}