{% extends 'base.html.twig' %}

{% block title %}My Dashboard{% endblock %}

{% block body %}
{% set inProgressCount = 0 %}
{% set completedCount = 0 %}
{% set activeCourse = null %}

{% for course in courses %}
  {% set percent = progressData[course.id] ?? 0 %}
  {% if percent > 0 and percent < 100 %}
    {% set inProgressCount = inProgressCount + 1 %}
    {% if activeCourse is null %}
      {% set activeCourse = course %}
    {% endif %}
  {% elseif percent >= 100 %}
    {% set completedCount = completedCount + 1 %}
  {% endif %}
{% endfor %}

{% set certificateTitles = [] %}
{% for attempt in userAttempts %}
  {% if attempt.passed and attempt.course.title not in certificateTitles %}
    {% set certificateTitles = certificateTitles|merge([attempt.course.title]) %}
  {% endif %}
{% endfor %}

{% set featuredCourse = activeCourse ?? courses|first %}
{% set featuredPercent = featuredCourse ? (progressData[featuredCourse.id] ?? 0) : 0 %}

<div class="learner-dashboard">
  <section class="ld-hero" aria-labelledby="dashboard-heading">
    <div class="ld-hero__content">
      <span class="ld-eyebrow">
        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
        My learning space
      </span>
      <h1 id="dashboard-heading">Keep your learning moving forward.</h1>
      <p>Pick up where you left off, follow your progress and discover your next course.</p>

      <div class="ld-hero__actions">
        <a href="{{ path('app_courses') }}" class="ld-button ld-button--primary">
          Explore courses
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href="{{ path('app_progress') }}" class="ld-button ld-button--ghost">
          <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
          View my progress
        </a>
      </div>
    </div>

    <div class="ld-hero__status" aria-label="Learning status">
      <span class="ld-hero__status-icon">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
      </span>
      <div>
        <span class="ld-hero__status-label">Current focus</span>
        <strong>{{ activeCourse ? activeCourse.title : 'Choose your next course' }}</strong>
      </div>
    </div>
  </section>

  <section class="ld-stats" aria-label="Learning overview">
    <article class="ld-stat-card">
      <span class="ld-stat-card__icon ld-stat-card__icon--green">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
      </span>
      <div>
        <strong>{{ courses|length }}</strong>
        <span>Available courses</span>
      </div>
      <a href="{{ path('app_courses') }}" aria-label="View available courses">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </article>

    <article class="ld-stat-card">
      <span class="ld-stat-card__icon ld-stat-card__icon--blue">
        <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
      </span>
      <div>
        <strong>{{ inProgressCount }}</strong>
        <span>Courses in progress</span>
      </div>
      <a href="{{ path('app_progress') }}" aria-label="View progress tracking">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </article>

    <article class="ld-stat-card">
      <span class="ld-stat-card__icon ld-stat-card__icon--amber">
        <i class="fa-solid fa-award" aria-hidden="true"></i>
      </span>
      <div>
        <strong>{{ certificateTitles|length }}</strong>
        <span>Certificates earned</span>
      </div>
      <a href="{{ path('app_certificates') }}" aria-label="View certificates">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </article>

    <article class="ld-stat-card">
      <span class="ld-stat-card__icon ld-stat-card__icon--violet">
        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
      </span>
      <div>
        <strong>{{ enrollments|length }}</strong>
        <span>Purchased courses</span>
      </div>
      <a href="{{ path('app_transactions') }}" aria-label="View purchased courses">
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </article>
  </section>

  <section class="ld-grid ld-grid--focus" aria-label="Current learning activity">
    <article class="ld-panel ld-continue-card">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Continue learning</span>
          <h2>Your next step</h2>
        </div>
        {% if featuredCourse %}
          <span class="ld-progress-chip">{{ featuredPercent|round }}% complete</span>
        {% endif %}
      </div>

      {% if featuredCourse %}
        <div class="ld-featured-course">
          <a href="{{ path('app_course_show', { id: featuredCourse.id }) }}" class="ld-featured-course__media" aria-label="Open {{ featuredCourse.title }}">
            {% if featuredCourse.thumb %}
              <img src="{{ asset('uploads/courses/' ~ featuredCourse.thumb) }}" alt="" loading="lazy">
            {% else %}
              <span><i class="fa-solid fa-play" aria-hidden="true"></i></span>
            {% endif %}
            <span class="ld-play-button"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
          </a>

          <div class="ld-featured-course__body">
            <div class="ld-course-meta">
              {% if featuredCourse.category %}
                <span>{{ featuredCourse.category.name }}</span>
              {% endif %}
              <span>{{ featuredCourse.videos|length }} lesson{{ featuredCourse.videos|length == 1 ? '' : 's' }}</span>
            </div>
            <h3>{{ featuredCourse.title }}</h3>
            <p>{{ featuredCourse.description|striptags|slice(0, 135) }}{% if featuredCourse.description|striptags|length > 135 %}&hellip;{% endif %}</p>

            <div class="ld-progress" aria-label="{{ featuredPercent|round }}% complete">
              <span style="--progress: {{ featuredPercent }}%"></span>
            </div>

            <div class="ld-featured-course__footer">
              <span>{{ featuredPercent > 0 ? 'Your course is ready when you are.' : 'Start this course at your own pace.' }}</span>
              <a href="{{ path('app_course_show', { id: featuredCourse.id }) }}" class="ld-text-link">
                {{ featuredPercent > 0 ? 'Resume course' : 'Start course' }}
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      {% else %}
        <div class="ld-empty-state">
          <span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
          <h3>No courses available yet</h3>
          <p>Your next learning opportunity will appear here.</p>
        </div>
      {% endif %}
    </article>

    <article class="ld-panel ld-progress-panel">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Progress tracking</span>
          <h2>Course activity</h2>
        </div>
        <a href="{{ path('app_progress') }}" class="ld-icon-link" aria-label="Open progress tracking">
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ld-progress-list">
        {% set shownProgress = 0 %}
        {% for course in courses %}
          {% set percent = progressData[course.id] ?? 0 %}
          {% if percent > 0 and shownProgress < 4 %}
            <a href="{{ path('app_course_show', { id: course.id }) }}" class="ld-progress-item">
              <div class="ld-progress-item__top">
                <span>{{ course.title }}</span>
                <strong>{{ percent|round }}%</strong>
              </div>
              <div class="ld-progress"><span style="--progress: {{ percent }}%"></span></div>
            </a>
            {% set shownProgress = shownProgress + 1 %}
          {% endif %}
        {% endfor %}

        {% if shownProgress == 0 %}
          <div class="ld-empty-state ld-empty-state--compact">
            <span><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
            <h3>No progress yet</h3>
            <p>Start a course and your activity will appear here.</p>
            <a href="{{ path('app_courses') }}" class="ld-text-link">Browse courses</a>
          </div>
        {% endif %}
      </div>

      {% if completedCount > 0 %}
        <div class="ld-completion-note">
          <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          <span><strong>{{ completedCount }}</strong> course{{ completedCount == 1 ? '' : 's' }} completed</span>
        </div>
      {% endif %}
    </article>
  </section>

  <section class="ld-grid ld-grid--content" aria-label="Courses and purchases">
    <article class="ld-panel">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Course library</span>
          <h2>Available courses</h2>
        </div>
        <a href="{{ path('app_courses') }}" class="ld-text-link">
          View all
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ld-course-list">
        {% for course in courses|slice(0, 4) %}
          <a href="{{ path('app_course_show', { id: course.id }) }}" class="ld-course-row">
            <span class="ld-course-row__thumb">
              {% if course.thumb %}
                <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="" loading="lazy">
              {% else %}
                <i class="fa-solid fa-book-open" aria-hidden="true"></i>
              {% endif %}
            </span>
            <span class="ld-course-row__content">
              <strong>{{ course.title }}</strong>
              <small>
                {{ course.category ? course.category.name ~ ' · ' : '' }}
                {{ course.videos|length }} lesson{{ course.videos|length == 1 ? '' : 's' }}
              </small>
            </span>
            <span class="ld-course-row__arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          </a>
        {% else %}
          <div class="ld-empty-state ld-empty-state--compact">
            <span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
            <h3>No courses available</h3>
          </div>
        {% endfor %}
      </div>
    </article>

    <article class="ld-panel">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Recent activity</span>
          <h2>Purchased courses</h2>
        </div>
        <a href="{{ path('app_transactions') }}" class="ld-icon-link" aria-label="View payment history">
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ld-activity-list">
        {% for enrollment in enrollments|slice(0, 4) %}
          <a href="{{ path('app_course_show', { id: enrollment.course.id }) }}" class="ld-activity-item">
            <span class="ld-activity-item__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
            <span>
              <strong>{{ enrollment.course.title }}</strong>
              <small>Purchased {{ enrollment.createdAt|date('d M Y') }}</small>
            </span>
          </a>
        {% else %}
          <div class="ld-empty-state ld-empty-state--compact">
            <span><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
            <h3>No purchases yet</h3>
            <p>Your purchased courses will be listed here.</p>
          </div>
        {% endfor %}
      </div>
    </article>
  </section>

  <section class="ld-grid ld-grid--content" aria-label="Certificates and news">
    <article class="ld-panel">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Achievements</span>
          <h2>My certificates</h2>
        </div>
        <a href="{{ path('app_certificates') }}" class="ld-text-link">
          View all
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ld-certificate-list">
        {% for title in certificateTitles|slice(0, 3) %}
          <div class="ld-certificate-item">
            <span><i class="fa-solid fa-award" aria-hidden="true"></i></span>
            <div>
              <strong>{{ title }}</strong>
              <small>Certificate earned</small>
            </div>
            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
          </div>
        {% else %}
          <div class="ld-empty-state ld-empty-state--compact">
            <span><i class="fa-solid fa-award" aria-hidden="true"></i></span>
            <h3>Your first certificate awaits</h3>
            <p>Complete a course and pass its quiz to unlock it.</p>
          </div>
        {% endfor %}
      </div>
    </article>

    <article class="ld-panel">
      <div class="ld-panel__header">
        <div>
          <span class="ld-panel__kicker">Latest updates</span>
          <h2>From the feed</h2>
        </div>
        <a href="{{ path('article_feed') }}" class="ld-text-link">
          View feed
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="ld-feed-list">
        {% for article in latestArticles|slice(0, 3) %}
          <a href="{{ path('app_public_article', {id: article.id, slug: article.slug}) }}" class="ld-feed-item">
            <span class="ld-feed-item__media">
              {% if article.image %}
                <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="" loading="lazy">
              {% else %}
                <i class="fa-regular fa-newspaper" aria-hidden="true"></i>
              {% endif %}
            </span>
            <span class="ld-feed-item__content">
              <small>{{ article.createdAt|date('d M Y') }}</small>
              <strong>{{ article.titre|striptags|slice(0, 72) }}{% if article.titre|striptags|length > 72 %}&hellip;{% endif %}</strong>
            </span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
        {% else %}
          <div class="ld-empty-state ld-empty-state--compact">
            <span><i class="fa-regular fa-newspaper" aria-hidden="true"></i></span>
            <h3>No news for the moment</h3>
          </div>
        {% endfor %}
      </div>
    </article>
  </section>
</div>
{% endblock %}
