{% extends 'base.html.twig' %}

{% block title %}My Dashboard{% endblock %}

{% block body %}
<div class="dashboard-grid">
  
  <!-- Available Courses -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Available Courses</h2>
    </div>
    <p style="color: var(--grey); margin-bottom: 1.5rem; font-size: 0.9rem;">
      Explore all the courses currently available to you.
    </p>

    <ul class="course-list {{ courses|length > 3 ? 'scrollable' : '' }}">
      {% for course in courses %}
        <li class="course-item">
          <a href="{{ path('app_course_show', { id: course.id }) }}" 
             style="text-decoration:none; color:inherit; display:flex; justify-content:space-between; align-items:center;">
            <span class="course-name">{{ course.title }}</span>
            <svg class="course-arrow" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
            </svg>
          </a>
        </li>
      {% else %}
        <li class="course-item">No courses available</li>
      {% endfor %}
    </ul>
  </div>

  <!-- Progress Tracking -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Progress Tracking</h2>
    </div>

    <div style="margin-bottom: 2rem;">
      {% set hasProgress = false %}
      
      {% for course in courses|slice(0, 3) %}
        {% set percent = progressData[course.id] ?? 0 %}
        
        {% if percent > 0 %}
          {% set hasProgress = true %}
          <div class="progress-item">
            <div class="progress-header">
              <span class="progress-label">{{ course.title }} :</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: {{ percent }}%;"></div>
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% if not hasProgress %}
        <p>No progress yet.</p>
      {% endif %}
    </div>

    <a href="{{ path('app_progress') }}" class="view-courses-btn">VIEW MY PROGRESS</a>
  </div>

  <!-- Transactions -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Purchased Courses</h2>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </div>

    <div>
      {% if enrollments is not empty %}
          {% for e in enrollments|slice(0, 3) %}
          <div class="transaction-item">
            <div class="transaction-info">
              <h4>{{ e.course.title }}</h4>
              <p>{{ e.createdAt|date('d M, H:i') }}</p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p>No transactions yet.</p>
      {% endif %}
    </div>

    <a href="{{ path('app_transactions') }}" class="view-all-btn">View All</a>
  </div>
</div>

<style>
.course-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.course-item {
  padding: .8rem 1rem;
  border-bottom: 1px solid var(--bg);
}

.course-item:last-child {
  border-bottom: none;
}

/* Scrollable version when more than 3 courses */
.course-list.scrollable {
  max-height: 180px; /* environ la hauteur de 3 items */
  overflow-y: auto;
  padding-right: .5rem;
}

/* Scrollbar style (optionnel) */
.course-list.scrollable::-webkit-scrollbar {
  width: 6px;
}

.course-list.scrollable::-webkit-scrollbar-thumb {
  background-color: var(--teal);
  border-radius: var(--radius);
}

.certif-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
}

@media (max-width: 1024px) {
  .certif-card {
    width: 100%;
  }
  .video-card {
    width: 100%;
  }
  .dashboard_bottom {
    display: grid;
    gap: 50px;
    flex-wrap: wrap;
    grid-template-columns: 1fr;
  }
}
/* ------- Articles Section / Feeds ------- */
.articles-section {
    margin-top: 3rem;
}

.articles-section .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.articles-section .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--black);
    margin: 0;
}

.articles-section .section-title i {
    color: var(--teal);
    margin-right: 0.5rem;
}

/* Bouton Voir tous les articles */
.articles-section .btn-view-all {
    background: linear-gradient(135deg, var(--green), var(--teal));
    color: var(--white);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    box-shadow: var(--shadow);
}

.articles-section .btn-view-all:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(13, 131, 131, 0.3);
}

/* Grid Articles */
.articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom:20px;
}

/* Article Card */
.article-card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.article-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 24px rgba(7, 23, 23, 0.15);
}

/* Image Article */
.article-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.article-card:hover .article-image {
    transform: scale(1.05);
}

.article-image-placeholder {
    width: 100%;
    height: 200px;
    background: linear-gradient(135deg, var(--mint), var(--teal));
    display: flex;
    align-items: center;
    justify-content: center;
}

.article-image-placeholder i {
    font-size: 3rem;
    color: var(--white);
    opacity: 0.5;
}

/* Contenu Article */
.article-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.article-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--black);
    margin: 0 0 1rem;
    line-height: 1.4;
}

.article-description {
    color: var(--grey);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    flex: 1;
}

/* Métadonnées Article */
.article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--grey);
    padding-top: 1rem;
    border-top: 1px solid var(--mint);
    margin-top: auto;
}

.article-author,
.article-date {
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.article-meta i {
    color: var(--teal);
}

/* Likes */
.article-likes {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--grey);
    margin-top: 0.75rem;
}

.article-likes i {
    color: #e53e3e;
    font-size: 1.1rem;
}

/* Message vide */
.articles-empty {
    text-align: center;
    padding: 3rem;
    color: var(--grey);
    grid-column: 1 / -1;
}

/* Animation au chargement */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.article-card {
    animation: fadeInUp 0.6s ease forwards;
    opacity: 0;
}

.article-card:nth-child(1) { animation-delay: 0.1s; }
.article-card:nth-child(2) { animation-delay: 0.2s; }
.article-card:nth-child(3) { animation-delay: 0.3s; }
.article-card:nth-child(4) { animation-delay: 0.4s; }
.article-card:nth-child(5) { animation-delay: 0.5s; }
.article-card:nth-child(6) { animation-delay: 0.6s; }

/* ------- Responsive Articles ------- */
@media (max-width: 1200px) {
    .articles-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .articles-section .section-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
    }

    .articles-section .btn-view-all {
        width: 100%;
        justify-content: center;
    }

    .articles-grid {
        grid-template-columns: 1fr;
    }

    .article-image,
    .article-image-placeholder {
        height: 180px;
    }
}
</style>

<div class="dashboard_bottom"> 
  <!-- Certificates -->
  <div class="card certif-card">
    <div class="card-header">
      <h2 class="card-title">My Certificates</h2>
    </div>
    
    <div class="certificates-list">
      {% set seen = [] %}
      {% set hasCertificate = false %}

      {% for attempt in userAttempts %}
        {% if attempt.passed and attempt.course.title not in seen %}
          {% set hasCertificate = true %}
          <div class="certificate-item">
            <div class="certificate-icon">🎓</div>
            <span class="certificate-name">{{ attempt.course.title }}</span>
          </div>
          {% set seen = seen|merge([attempt.course.title]) %}
        {% endif %}
      {% endfor %}

      {% if not hasCertificate %}
        <p>No certificates yet.</p>
      {% endif %}
    </div>

    <a href="{{ path('app_certificates') }}" class="download-all-btn">View All</a>
  </div>

  <!-- Recent Courses -->
  <div class="card video-card">
    <div class="card-header">
      <h2 class="card-title">Recent Courses</h2>
        <a href="https://form.jotform.com/253131874206453"
     class="view-all-link"
      target="_blank"
     rel="noopener noreferrer">
     
    Knowledge Quiz 
      <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3z"/>
      <path d="M5 5h5V3H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-5h-2v5H5V5z"/>
    </svg>
  </a>
      <a href="{{ path('app_courses') }}" class="view-all-link">View All</a>
    </div>
    <div class="video-grid">
      {% for course in latestCourses %}
        <div class="video-card">
          <div class="video-thumbnail">
            <img class="video-thumbnail" src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="{{ course.title }}">
            <div class="video-overlay">
              <a href="{{ path('app_course_show', { id: course.id }) }}" class="play-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--teal)">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="video-info">
            <h3 class="video-title">{{ course.title }}</h3>
            {% if course.videos|length > 0 %}
              <div class="video-duration">
                <span>00:00</span>
                <span>{{ (course.videos|first.duration / 60)|round(0, 'floor') }}:{{ (course.videos|first.duration % 60)|default('00') }}</span>
              </div>
            {% else %}
              <p class="video-subtitle">No videos yet</p>
            {% endif %}
          </div>
        </div>
      {% else %}
        <p>No recent courses.</p>
      {% endfor %}
    </div>
  </div>
</div>
{# Articles Section / Feeds #}
<div class="articles-section">
    <div class="section-header">
        <h2 class="section-title">
            <i class="fas fa-newspaper"></i>E-learning Feed
        </h2>
        <a href="{{ path('article_feed') }}" class="btn-view-all">
            View All
            <i class="fas fa-arrow-right"></i>
        </a>
    </div>

    <div class="articles-grid">
        {% for article in latestArticles %}
        <a href="{{ path('article_feed')}}#article-{{article.id}}" class="article-link-wrapper">
            <div class="article-card">
                {% if article.image %}
                    <img src="{{ asset('uploads/articles/' ~ article.image) }}" 
                         class="article-image" 
                         alt="{{ article.titre }}">
                {% else %}
                    <div class="article-image-placeholder">
                        <i class="fas fa-image"></i>
                    </div>
                {% endif %}
                
                <div class="article-content">
                    <h3 class="article-title">{{ article.titre }}</h3>
<p class="article-description">
    {{ article.description|striptags|length > 120 
        ? article.description|striptags|slice(0, 120) ~ '...' 
        : article.description|striptags 
    }}
</p>

                    
                    <div class="article-meta">
                        <div class="article-author">
                            <i class="fas fa-user"></i>
                            <span>{{ article.author.email|split('@')[0] }}</span>
                        </div>
                        <div class="article-date">
                            <i class="fas fa-calendar"></i>
                            <span>{{ article.createdAt|date('d/m/Y') }}</span>
                        </div>
                    </div>
                </div>
            </div>
            </a>
        {% else %}
            <div class="articles-empty">
                <i class="fas fa-newspaper" style="font-size: 3rem; color: var(--mint); margin-bottom: 1rem;"></i>
                <p>No news for the moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
