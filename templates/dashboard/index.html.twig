{% extends 'base.html.twig' %}

{% block title %}My Dashboard{% endblock %}

{% block body %}

<div class="dashboard-grid">
  <!-- Available Courses -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Available Courses</h2>
    </div>
    <p style="color: var(--grey); margin-bottom: 1.5rem; font-size: 0.9rem;">
      Explore all the courses currently available to you.
    </p>
    <ul class="course-list">
      {% for course in courses %}
        <li class="course-item">
          <a href="{{ path('app_course_show', { id: course.id }) }}" style="text-decoration:none; color:inherit; display:flex; justify-content:space-between; align-items:center;">
            <span class="course-name">{{ course.title }}</span>
            <svg class="course-arrow" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
            </svg>
          </a>
        </li>
      {% else %}
        <li class="course-item">No courses available</li>
      {% endfor %}
    </ul>
  </div>

  <!-- Progress Tracking -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Progress Tracking</h2>
    </div>
    <div style="margin-bottom: 2rem;">
      {% for course in courses %}
        {% set percent = progressData[course.id] ?? 0 %}
        <div class="progress-item">
          <div class="progress-header">
            <span class="progress-label">{{ course.title }} :</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: {{ percent }}%;"></div>
          </div>
        </div>
      {% else %}
        <p>No progress yet.</p>
      {% endfor %}
    </div>
    <a href="/my-courses" class="view-courses-btn">View My Courses</a>
  </div>

  <!-- Transactions (static) -->
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Transactions</h2>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </div>
    <div>
      <div class="transaction-item">
        <div class="transaction-info">
          <h4>Project management Course</h4>
          <p>11 April, 07:11 AM</p>
        </div>
        <div class="transaction-amount">$123.64</div>
      </div>
    </div>
    <button class="view-all-btn">View All</button>
  </div>

</div>

<style>

@media (max-width: 1024px) {
  .certif-card{
     width:100%;
  } .video-card {
    width:100%;
  }
}
</style>
<div style="display:flex; gap:50px; flex-wrap: wrap;"> 

  <!-- Certificates (static) -->
  <div class="card certif-card">
    <div class="card-header">
      <h2 class="card-title">My Certificates</h2>
      <a href="/certificates" class="view-all-link">View All</a>
    </div>
    <div>
      <div class="certificate-item">
        <div class="certificate-icon">🎓</div>

        
        <span class="certificate-name">Project Management</span>
      </div>
    </div>
    <button class="download-all-btn">Download All</button>
  </div>

  <!-- Recent Videos -->
  <div class="card video-card">
    <div class="card-header">
      <h2 class="card-title">Recent Videos</h2>
      <a href="{{path('app_courses')}}" class="view-all-link">View All</a>
    </div>
    <div class="video-grid">
      {% for progress in recentVideos %}
        {% set video = progress.video %}
        <div class="video-card">
          <div class="video-thumbnail" style="background: linear-gradient(135deg, var(--green) 0%, var(--teal) 100%);">
            {% if progress.completed %}
              <div class="status-badge status-complete">Complete</div>
            {% else %}
              <div class="status-badge status-progress">In progress</div>
            {% endif %}
            <div class="video-overlay">
              <a href="{{ path('app_course_show', { id: video.course.id, videoId: video.id }) }}" class="play-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--teal)">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="video-info">
            <h3 class="video-title">{{ video.course.title }}</h3>
            <p class="video-subtitle">{{ video.title }}</p>
            <div class="video-duration">
              <span>00:00</span>
              <span>{{ (video.duration / 60)|round(0, 'floor') }}:{{ (video.duration % 60)|default('00') }}</span>
            </div>
          </div>
        </div>
      {% else %}
        <p>No recent videos.</p>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}