{% extends 'base_auth.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block stylesheets %}
<style>
:root {
  --green:#1A6D55;
  --teal:#0D8383;
  --black:#071717;
  --mint:#E7F3F3;
  --grey:#606060;
  --white:#FFFFFF;
  --bg:#f4f9f8;
  --radius:12px;
  --shadow:0 4px 12px rgba(7,23,23,.08);
}

body {
  background: var(--bg);
  font-family: system-ui, sans-serif;
  color: var(--black);
}

.reset-info {
  max-width: 480px;
  margin: 5rem auto;
  padding: 2rem;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  text-align: center;
}

.reset-info h1 {
  font-size: 1.6rem;
  margin-bottom: 1rem;
  color: var(--green);
}

.reset-info p {
  color: var(--grey);
  line-height: 1.5;
  margin-bottom: 1rem;
}

.reset-info a {
  color: var(--teal);
  font-weight: 600;
  text-decoration: none;
}

.reset-info a:hover {
  text-decoration: underline;
}
</style>
{% endblock %}

{% block body %}
{% import 'reset_password/_macros.html.twig' as ui %}
<div class="reset-info">
  {{ ui.backHeader('show_login', 'Back to login') }}
    <h1>Password Reset Email Sent</h1>

    <p>
        If an account matching your email exists, an email was just sent with a link 
        to reset your password.  
        This link will expire in 
        <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
    </p>

    <p>
        If you don’t receive the email, please check your spam folder or  
        <a href="{{ path('app_forgot_password_request') }}">try again</a>.
    </p>
</div>
{% endblock %}
