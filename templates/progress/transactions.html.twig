{% extends 'base.html.twig' %}

{% block title %}User Transactions{% endblock %}

{% block body %}
<div class="courses-wrapper">
  <h2>All Transactions</h2>

  <table class="progress-table" style="margin-bottom:50px;">
    <thead>
      <tr>
        <th>Type</th>
        <th>Item</th>
        <th>Purchased On</th>
        <th>Price</th>
        <th>Currency</th>
        <th>Invoice</th>
      </tr>
    </thead>
    <tbody>
      {% if hasSubscription %}
        <tr>
          <td>Subscription</td>
          <td>Active Plan</td>
          <td>—</td>
          <td>29.90 / Monthly</td>
          <td>EUR</td>
          <td>
            <a class="btn btn-sm btn-outline-primary"
               href="{{ path('app_invoice_subscription_download') }}"
               title="Download subscription invoice">
              <i class="fa-solid fa-file-pdf"></i>
            </a>
          </td>
        </tr>
      {% endif %}

      {% for e in enrollments %}
        {% set eurPrice = null %}
        {% for price in e.course.coursePrices %}
          {% if price.currency == 'EUR' %}
            {% set eurPrice = price.price / 100 %}
          {% endif %}
        {% endfor %}

        <tr>
          <td>Course</td>
          <td>
            <a href="{{ path('app_course_show', {id: e.course.id}) }}">
              {{ e.course.title ?? 'Untitled Course' }}
            </a>
          </td>
          <td>{{ e.createdAt|date('d/m/Y H:i') }}</td>
          <td>{{ eurPrice is not null ? eurPrice : '—' }}</td>
          <td>{{ eurPrice is not null ? 'EUR' : '—' }}</td>
          <td>
            <a class="btn btn-sm btn-outline-primary"
               href="{{ path('app_invoice_enrollment_download', {id: e.id}) }}"
               title="Download invoice">
              <i class="fa-solid fa-file-pdf"></i>
            </a>

            {# Optionnel: afficher le numéro si déjà en BDD #}
            {% if e.invoiceNumber %}
              <small style="display:block; opacity:.7; margin-top:4px;">
                {{ e.invoiceNumber }}
              </small>
            {% endif %}
          </td>
        </tr>
      {% else %}
        {% if not hasSubscription %}
          <tr>
            <td colspan="6" style="text-align:center;">No transactions yet</td>
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
