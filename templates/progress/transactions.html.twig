{% extends 'base.html.twig' %}

{% block title %}User Transactions{% endblock %}

{% block body %}
<div class="courses-wrapper">
  <h2>All Transactions</h2>

  <table class="progress-table" style="margin-bottom:50px;">
    <thead>
      <tr>
        <th>Type</th>
        <th>Item</th>
        <th>Purchased On</th>
        <th>Price</th>
        <th>Currency</th>
      </tr>
    </thead>
    <tbody>
      {% if hasSubscription %}
        <tr>
          <td>Subscription</td>
          <td>Active Plan</td>
          <td>—</td>
          <td>29.90 / Monthly</td>
          <td>EUR</td>
        </tr>
      {% endif %}

      {% for e in enrollments %}
        <tr>
          <td>Course</td>
          <td>
            <a href="{{ path('app_course_show', {id: e.course.id}) }}">
              {{ e.course.title ?? 'Untitled Course' }}
            </a>
          </td>
          <td>{{ e.createdAt|date('d/m/Y H:i') }}</td>
          <td>
            {% for price in e.course.coursePrices %}
              {% if price.currency == 'EUR' %}
                {{ price.price / 100 }}
              {% endif %}
            {% endfor %}
          </td>
          <td>
            {% for price in e.course.coursePrices %}
              {% if price.currency == 'EUR' %}
                EUR
              {% endif %}
            {% endfor %}
          </td>
        </tr>
      {% else %}
        {% if not hasSubscription %}
          <tr>
            <td colspan="5" style="text-align:center;">No transactions yet</td>
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
