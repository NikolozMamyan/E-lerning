{% extends 'base.html.twig' %}

{% block title %}User Progress{% endblock %}

{% block body %}

<div class="courses-wrapper">
  <h2>User Progress</h2>
  <table class="progress-table" style="margin-bottom:50px;">
    <thead>
      <tr>
        <th>Course Name</th>
        <th>Start On</th>
        <th>Quiz Score</th>
        <th>Progress on Course</th>
        <th>Certification Status</th>
      </tr>
    </thead>
    <tbody>
      {% for item in coursesData %}
        <tr>
          <td>{{ item.course.title ?? 'Untitled Course' }}</td>
          
          <td>
            {% if item.enrollment %}
              {{ item.enrollment.createdAt|date('d/m/Y') }}
            {% else %}
              <em>Via abonnement</em>
            {% endif %}
          </td>

          <td>{{ item.quizScore ?? '-' }}</td>

          <td>
            <div class="progress-bar">
              <span style="width: {{ item.progressPercent }}%"></span>
            </div>
          </td>

          <td>
            {% if item.certified %}
              <span class="certified">Certified</span>
            {% else %}
              <span class="in-learning">In Learning</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endblock %}
