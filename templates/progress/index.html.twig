{% extends 'base.html.twig' %}

{% block title %}User Progress{% endblock %}

{% block body %}

<div class="courses-wrapper">

    <h2>All Courses</h2>
    <div class="courses-grid">
    {% for item in coursesData %}
        <div class="course-card {{ item.certified ? 'complete' : 'in-progress' }}">
            
            {# Boucle sur les vidéos du cours #}
{% set firstVideo = item.course.videos|first %}
{% if firstVideo %}
    <div class="thumb main-video">
        <iframe src="{{ firstVideo.url }}" width="100%" height="200" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    </div>
{% endif %}

<div class="video-list">
    {% for video in item.course.videos|slice(1) %}
        <p><a href="{{ video.url }}" target="_blank">{{ video.title ?? 'Other video' }}</a></p>
    {% endfor %}
</div>


            <h3>{{ item.course.title ?? 'Untitled Course' }}</h3>
            <p>{{ item.course.description ?? '' }}</p>
            <button class="assign-btn">Assign+</button>
        </div>
    {% endfor %}
</div>


    <h2>User Progress</h2>
    <table class="progress-table">
        <thead>
            <tr>
                <th>Courses Name</th>
                <th>Start On</th>
                <th>Quiz Score</th>
                <th>Progress on Course</th>
                <th>Certification Status</th>
            </tr>
        </thead>
        <tbody>
            {% for item in coursesData %}
                <tr>
                    <td>{{ item.course.title ?? 'Untitled Course' }}</td>
                    <td>{{ item.enrollment.createdAt|date('d/m/Y') }}</td>
                    <td>{{ item.quizScore ?? '-' }}</td>
                    <td>
                        <div class="progress-bar">
                            <span style="width: {{ item.progressPercent }}%"></span>
                        </div>
                    </td>
                    <td>
                        {% if item.certified %}
                            <span class="certified">certified</span>
                        {% else %}
                            <span class="in-learning">In Learning</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
