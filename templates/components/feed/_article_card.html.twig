{# templates/feed/_article_card.html.twig #}
<style>
.preview-card {
    display: flex;
    gap: 10px;
    border: 1px solid #e4e6eb;
    border-radius: 8px;
    padding: 8px;
    margin-top: 8px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    max-width: 100%;
}

.preview-card:hover {
    background: #f5f6f7;
}

.preview-card img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
}

.preview-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
}

.preview-content strong {
    font-size: 14px;
    line-height: 1.2;
    margin-bottom: 4px;

    /* 1 ligne max */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.preview-content p {
    font-size: 13px;
    color: #555;
    margin: 0 0 4px 0;

    /* 2 lignes max */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.preview-content small {
    font-size: 12px;
    color: #888;
    text-transform: lowercase;
}

</style>
<article class="article-card" id="article-{{ article.id }}">
    {# HEADER #}
    <div class="article-header">
        <div class="user-info">
            <div class="user-avatar">
 <img class="user-avatar"
     src="{{ asset(article.author.avatar ? 'uploads/avatars/' ~ article.author.avatar : 'images/User.svg') }}">


            </div>
            <div class="user-details">
                <span class="username">
    {# User-{{ article.createdAt|date('Ymd') }}-{{ article.author.id }} USER NAME #}
</span>

                <span class="date">
                    <i class="fa-regular fa-clock"></i>
                    {{ article.createdAt|date('m/d/Y \\a\\t H:i') }}
                </span>
            </div>
        </div>

        {% if app.user and app.user == article.author %}
            <div class="article-menu">
                <a href="{{ path('article_edit', {id: article.id}) }}"
                   class="btn-icon"
                   title="Edit">
                    <i class="fa-solid fa-pen"></i>
                </a>
                <a href="{{ path('article_delete', {id: article.id}) }}"
                   class="btn-icon danger"
                   title="Delete"
                   onclick="return confirm('Are you sure you want to delete this article?');">
                    <i class="fa-solid fa-trash"></i>
                </a>
            </div>
        {% endif %}
    </div>

    {# CONTENT #}
    <div class="article-content">
        <h3>{{ article.titre }}</h3>
<div class="article-body" id="article-body-{{ article.id }}">
    {{ article.description|raw }}
</div>
<div class="link-preview" id="link-preview-{{ article.id }}"></div>

<button class="see-more-btn" data-id="{{ article.id }}" type="button">
    See more
</button>

    </div>

    {% if article.image %}
        <img src="/uploads/articles/{{ article.image }}"
             class="article-image"
             alt="{{ article.titre }}"
             loading="lazy">
    {% endif %}
    {% if article.video %}
    <video controls style="max-width:100%; border-radius:10px;">
        <source src="{{ asset('uploads/videos/' ~ article.video) }}" type="video/mp4">
        Your browser does not support video.
    </video>
{% endif %}


    {# ACTIONS #}
    <div class="article-actions">
        <button class="btn-action like-btn {{ app.user and article.isLikedByUser(app.user) ? 'active' : '' }}"
                data-article-id="{{ article.id }}"
                type="button">
            <i class="{{ app.user and article.isLikedByUser(app.user) ? 'fa-solid' : 'fa-regular' }} fa-heart"></i>
            <span class="count"
                  id="like-count-{{ article.id }}">{{ article.likesCount }}</span>
        </button>

        <button class="btn-action comment-btn"
                data-article-id="{{ article.id }}"
                type="button">
            <i class="fa-regular fa-comment"></i>
            <span class="count">{{ article.comments|length }}</span>
        </button>

        {# <button class="btn-action"
                type="button">
            <i class="fa-solid fa-share"></i>
            <span>Share</span>
        </button> #}
    </div>

    {# COMMENTS #}
    <div class="comments-section"
         id="comments-{{ article.id }}">
        {% for comment in article.comments %}
            <div class="comment">
                <div class="user-avatar user-avatar--small">
                           <img  src="{{ asset(comment.author.avatar ? 'uploads/avatars/' ~ comment.author.avatar : 'images/User.svg') }}"
           class="user-avatar user-avatar--small"
             alt="Avatar"/>
                </div>
                <div class="comment-content">
                    <div class="comment-header">
                        {# User-{{ comment.createdAt|date('Ymd') }}-{{ comment.author.id }} USER NAME #}

                        <span class="date">
                            <i class="fa-regular fa-clock"></i>
                            {{ comment.createdAt|date('m/d/Y') }}
                        </span>
                    </div>
                    <p>{{ comment.content }}</p>
                </div>
            </div>
        {% endfor %}

        {% if is_granted('ROLE_USER') %}
            <form class="comment-form"
                  data-article-id="{{ article.id }}"
                  action="{{ path('article_comment', {id: article.id}) }}"
                  method="POST">
                <div class="user-avatar user-avatar--small">
                     <img  src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}"
           class="user-avatar user-avatar--small"
             alt="Avatar"/>
                </div>
                <input type="text"
                       name="comment"
                       placeholder="Write a comment..."
                       class="input-field"
                       required>
                <button class="btn-send" type="submit">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        {% endif %}
    </div>

</article>
<script>
document.querySelectorAll('.article-body').forEach(body => {

    let url = null;

    // 1️⃣ Lien Quill (<a href="...">)
    const quillLink = body.querySelector('a[href^="http://"], a[href^="https://"]');
    if (quillLink) {
        url = quillLink.getAttribute('href');
    }

    // 2️⃣ Fallback : URL écrite dans le texte
    if (!url) {
        const match = body.textContent.match(/https?:\/\/[^\s<]+/);
        if (match) {
            url = match[0];
        }
    }

    if (!url) return;

    const articleId = body.id.replace('article-body-', '');

    fetch('/app/articles/link-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) return;

        document.getElementById('link-preview-' + articleId).innerHTML = `
            <a href="${url}" target="_blank" class="preview-card">
                ${data.image ? `<img src="${data.image}" alt="preview">` : ''}
                <div class="preview-content">
                    <strong>${data.title || data.site || ''}</strong>
                    <p>${data.description || ''}</p>
                    <small title="${url}">${data.site || ''}</small>
                </div>
            </a>
        `;
    });
});
</script>

