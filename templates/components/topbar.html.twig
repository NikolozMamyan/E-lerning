{% set currentRoute = app.request.attributes.get('_route') %}
{% set routeTitles = {
  'app_dashboard': 'Dashboard',
  'app_courses': 'Available courses',
  'app_certificates': 'Certificates',
  'app_subscription': 'Subscription',
  'app_transactions': 'Payment history',
  'app_progress': 'Progress tracking',
  'article_feed': 'Feed',
  'app_profile': 'My profile',
  'app_public_profile': 'Member profile',
  'app_settings': 'Settings',
  'app_contact': 'Help & support',
  'app_notifications': 'Notifications',
  'company_dashboard': 'Company dashboard',
  'company_certificates_index': 'Employee certificates'
} %}

<header class="header" aria-label="Page header">
  <div class="topbar-leading">
    <button class="burger" id="burger-btn" type="button" aria-label="Open navigation" aria-expanded="false">
      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>

    <div class="topbar-context">
      <span class="topbar-eyebrow">Learning workspace</span>
      <p class="topbar-title">{{ routeTitles[currentRoute] ?? 'Workspace' }}</p>
    </div>
  </div>

  <div class="header-actions">
    <div class="notification-wrapper">
      {% set unreadCount = app.user.unreadNotificationsCount %}
      <button
        class="notification-btn"
        id="notification-btn"
        type="button"
        aria-label="Notifications{{ unreadCount > 0 ? ', ' ~ unreadCount ~ ' unread' : '' }}"
        aria-expanded="false"
        aria-controls="notification-dropdown"
      >
        <i class="fa-regular fa-bell" aria-hidden="true"></i>
        <span class="notification-badge {{ unreadCount == 0 ? 'hidden' : '' }}" id="notification-badge">
          {{ unreadCount > 9 ? '9+' : unreadCount }}
        </span>
      </button>

      <div class="notification-dropdown" id="notification-dropdown" aria-label="Recent notifications">
        {% set recentNotifications = app.user.notifications|reverse|slice(0, 5) %}

        <div class="notification-dropdown__header">
          <div>
            <strong>Notifications</strong>
            <span>{{ unreadCount }} unread</span>
          </div>
          {% if recentNotifications|length > 0 and unreadCount > 0 %}
            <button type="button" class="mark-all-read-btn" id="mark-all-read-btn">
              <i class="fa-solid fa-check-double" aria-hidden="true"></i>
              Mark all read
            </button>
          {% endif %}
        </div>

        <div class="notification-dropdown__list">
          {% for notification in recentNotifications %}
            <a
              href="{{ notification.actionUrl ?: path('app_notifications') }}"
              class="notification-item-link"
              data-id="{{ notification.id }}"
            >
              <div class="notification-item {{ not notification.isRead ? 'unread' : '' }}" data-type="{{ notification.type }}">
                <span class="notification-item-icon">
                  <i class="{{ notification.icon ?: 'fa-solid fa-info-circle' }}" aria-hidden="true"></i>
                </span>
                <span class="notification-content">
                  <strong>{{ notification.title }}</strong>
                  {% if notification.message %}
                    <span class="notification-message">{{ notification.message }}</span>
                  {% endif %}
                  <small class="notification-time">{{ notification.timeAgo }}</small>
                </span>
                {% if not notification.isRead %}
                  <span class="notification-unread-dot" aria-label="Unread"></span>
                {% endif %}
              </div>
            </a>
          {% else %}
            <div class="notification-empty">
              <span><i class="fa-regular fa-bell-slash" aria-hidden="true"></i></span>
              <strong>You are all caught up</strong>
              <p>No notifications for the moment.</p>
            </div>
          {% endfor %}
        </div>

        <a href="{{ path('app_notifications') }}" class="view-all-notifications">
          View all notifications
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <a href="{{ path('app_profile') }}" class="user-profile" aria-label="Open your profile">
      <img
        class="user-avatar"
        src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}"
        alt="{{ app.user.userName }}"
      >
      <span class="user-info">
        <strong>{{ app.user.userName }}</strong>
        <small>View profile</small>
      </span>
      <i class="fa-solid fa-chevron-right user-profile__arrow" aria-hidden="true"></i>
    </a>
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const burger = document.getElementById('burger-btn');
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.getElementById('overlay');
  const closeBtn = document.getElementById('close-btn');
  const notificationBtn = document.getElementById('notification-btn');
  const notificationDropdown = document.getElementById('notification-dropdown');
  const markAllReadBtn = document.getElementById('mark-all-read-btn');

  const setNavigationOpen = (isOpen) => {
    sidebar?.classList.toggle('active', isOpen);
    overlay?.classList.toggle('active', isOpen);
    burger?.setAttribute('aria-expanded', String(isOpen));
  };

  const setNotificationsOpen = (isOpen) => {
    notificationDropdown?.classList.toggle('active', isOpen);
    notificationBtn?.setAttribute('aria-expanded', String(isOpen));
  };

  burger?.addEventListener('click', () => setNavigationOpen(true));
  closeBtn?.addEventListener('click', () => setNavigationOpen(false));
  overlay?.addEventListener('click', () => setNavigationOpen(false));

  notificationBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    setNotificationsOpen(!notificationDropdown?.classList.contains('active'));
  });

  document.addEventListener('click', (event) => {
    if (notificationDropdown && !notificationDropdown.contains(event.target)) {
      setNotificationsOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setNotificationsOpen(false);
      setNavigationOpen(false);
    }
  });

  document.querySelectorAll('.notification-item-link').forEach((link) => {
    link.addEventListener('click', function (event) {
      event.preventDefault();
      const notificationId = this.dataset.id;
      const destination = this.getAttribute('href');

      fetch(`/notifications/${notificationId}/mark-read`, { method: 'POST' })
        .finally(() => window.location.assign(destination));
    });
  });

  markAllReadBtn?.addEventListener('click', async () => {
    markAllReadBtn.disabled = true;

    try {
      await fetch('/notifications/mark-all-read', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
    } finally {
      window.location.reload();
    }
  });
});
</script>
