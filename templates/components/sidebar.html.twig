{% set currentRoute = app.request.attributes.get('_route') %}
{% set dashboardActive = currentRoute == 'app_dashboard' %}
{% set coursesActive = currentRoute starts with 'app_course' %}
{% set progressActive = currentRoute starts with 'app_progress' %}
{% set certificatesActive = currentRoute starts with 'app_certificate' %}
{% set feedActive = currentRoute starts with 'article_' %}
{% set subscriptionActive = currentRoute starts with 'app_subscription' %}
{% set transactionsActive = currentRoute == 'app_transactions' %}
{% set hasActiveSubscription = app.user.hasActiveSubscription() %}

<aside class="sidebar sidebar--learner" aria-label="Learner navigation">
  <div class="sidebar-header">
    <a href="{{ path('app_dashboard') }}" class="sidebar-brand" aria-label="Go to dashboard">
      <img src="{{ asset('images/logo.png') }}" class="sidebar-brand__logo" alt="Les Consultants">
    </a>
    <span class="sidebar-workspace-badge">
      <i class="fa-solid fa-user-graduate" aria-hidden="true"></i>
      Learner workspace
    </span>
    <button class="close-btn" id="close-btn" type="button" aria-label="Close navigation">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="sidebar-nav">
    <section class="nav-section" aria-labelledby="learner-overview-label">
      <p class="nav-section__label" id="learner-overview-label">Overview</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('app_dashboard') }}" class="nav-link {{ dashboardActive ? 'active' : '' }}" aria-current="{{ dashboardActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-table-columns" aria-hidden="true"></i></span>
            <span class="nav-link__label">Dashboard</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="learner-learning-label">
      <p class="nav-section__label" id="learner-learning-label">My learning</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('app_courses') }}" class="nav-link {{ coursesActive ? 'active' : '' }}" aria-current="{{ coursesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
            <span class="nav-link__label">Available courses</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('app_progress') }}" class="nav-link {{ progressActive ? 'active' : '' }}" aria-current="{{ progressActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
            <span class="nav-link__label">Progress tracking</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('app_certificates') }}" class="nav-link {{ certificatesActive ? 'active' : '' }}" aria-current="{{ certificatesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-award" aria-hidden="true"></i></span>
            <span class="nav-link__label">Certificates</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="learner-discover-label">
      <p class="nav-section__label" id="learner-discover-label">Discover</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('article_feed') }}" class="nav-link {{ feedActive ? 'active' : '' }}" aria-current="{{ feedActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-regular fa-newspaper" aria-hidden="true"></i></span>
            <span class="nav-link__label">Feed</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="mailto:?subject=You're%20invited%20to%20join%20our%20Compliance%20E-learning%20Platform&amp;body=Hello,%0A%0AI%27d%20like%20to%20invite%20you%20to%20join%20the%20E-learning%20platform%20from%20Les%20Consultants.%0A%0AYou%20can%20sign%20up%20here:%20https://elearning-lesconsultants.com%0A%0ABest%20regards," class="nav-link nav-link--soft">
            <span class="nav-icon"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span>
            <span class="nav-link__label">Send an invitation</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="learner-billing-label">
      <p class="nav-section__label" id="learner-billing-label">Billing</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('app_subscription') }}" class="nav-link {{ subscriptionActive ? 'active' : '' }} {{ not hasActiveSubscription ? 'nav-link--premium-cta' : '' }}" aria-current="{{ subscriptionActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid {{ hasActiveSubscription ? 'fa-credit-card' : 'fa-crown' }}" aria-hidden="true"></i></span>
            <span class="nav-link__label">{{ hasActiveSubscription ? 'Subscription' : 'Unlock Premium' }}</span>
            {% if not hasActiveSubscription %}
              <span class="nav-link__premium-badge"><i class="fa-solid fa-star" aria-hidden="true"></i>Pro</span>
            {% endif %}
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('app_transactions') }}" class="nav-link {{ transactionsActive ? 'active' : '' }}" aria-current="{{ transactionsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span>
            <span class="nav-link__label">Payment history</span>
          </a>
        </li>
      </ul>
    </section>

  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <img src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}" class="sidebar-user__avatar" alt="">
      <div class="sidebar-user__info">
        <small>Signed in as</small>
        <strong>{{ app.user.userName }}</strong>
      </div>
      <a href="" class="sidebar-user__logout" title="Log out" aria-label="Log out" data-controller="auth" data-action="click->auth#logout">
        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</aside>
