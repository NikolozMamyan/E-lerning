{% if analytics.enabled and (analytics.measurement_id or analytics.ads_id) and not is_granted('ROLE_ADMIN') %}
  {% set french = app.request.locale starts with 'fr' %}
  <link rel="stylesheet" href="{{ asset('styles/analytics.css') }}">
  <div data-controller="analytics"
       data-analytics-config-value="{{ analytics|json_encode|e('html_attr') }}"
       data-analytics-page-value="{{ app.request.attributes.get('_route') }}"
       data-analytics-purchase-value="{{ analyticsPurchase|default(null)|json_encode|e('html_attr') }}"
       data-action="click@document->analytics#trackClick submit@document->analytics#trackCheckout turbo:before-cache@document->analytics#beforeCache">
    <section class="cookie-consent" data-analytics-target="panel" aria-labelledby="cookie-consent-title" role="region" hidden>
      <div class="cookie-consent__heading"><span aria-hidden="true"><i class="fa-solid fa-cookie-bite"></i></span><h2 id="cookie-consent-title">{{ french ? 'Vos choix de cookies' : 'Your cookie choices' }}</h2></div>
      <p>{{ french ? 'Google mesure les visites et les conversions publicitaires, uniquement avec votre accord. Le refus ne limite pas l’accès.' : 'Google measures visits and ad conversions with your permission. Refusing does not limit access.' }}</p>
      <div class="cookie-consent__actions">
        <button type="button" data-action="analytics#reject">{{ french ? 'Tout refuser' : 'Reject all' }}</button>
        <button type="button" data-action="analytics#accept">{{ french ? 'Tout accepter' : 'Accept all' }}</button>
      </div>
      <details class="cookie-consent__customize">
        <summary>{{ french ? 'Personnaliser mes choix' : 'Customize my choices' }}</summary>
        <div class="cookie-consent__choices">
          <label><input type="checkbox" data-analytics-target="statistics"> {{ french ? 'Statistiques (Google Analytics)' : 'Statistics (Google Analytics)' }}</label>
          <label><input type="checkbox" data-analytics-target="advertising"> {{ french ? 'Mesure publicitaire (Google Ads)' : 'Advertising measurement (Google Ads)' }}</label>
        </div>
        <button class="cookie-consent__save" type="button" data-action="analytics#save">{{ french ? 'Enregistrer mes choix' : 'Save my choices' }}</button>
      </details>
      <a class="cookie-consent__policy" href="/legales/cookie.html">{{ french ? 'En savoir plus' : 'Learn more' }}</a>
    </section>
    <button class="cookie-preferences" type="button" data-analytics-target="preferences" data-action="analytics#open" hidden><i class="fa-solid fa-cookie-bite" aria-hidden="true"></i> Cookies</button>
  </div>
{% endif %}
