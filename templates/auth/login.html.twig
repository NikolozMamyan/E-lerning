{% extends 'base_admin.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

<style>
  :root{
    --green:#1A6D55;
    --teal:#0D8383;
    --black:#071717;
    --mint:#E7F3F3;
    --grey:#606060;
    --white:#FFFFFF;
    --radius:12px;
    --shadow:0 4px 12px rgba(7,23,23,.08);
  }
  *{box-sizing:border-box}

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--white);
    color: var(--black);
  }

  /* ------- Layout ------- */
  .auth-layout{
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    align-items: center;
    gap: 0;
    padding: 0;
  }
  
  .auth-hero{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, var(--mint) 0%, #f8fefe 100%);
    min-height: 100vh;
  }
  
  .auth-hero img{
    width: 100%;
    max-width: 500px;
    height: auto;
    margin-bottom: 2rem;
  }
  
  .hero-copy{
    max-width: 450px;
  }
  
  .hero-copy h2{
    font-size: 2.25rem;
    line-height: 1.2;
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--black);
  }
  
  .hero-copy h2 span{ 
    white-space: nowrap; 
  }
  
  .hero-copy p{
    color: var(--grey);
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0;
  }

  .auth-panel{
    max-width: 500px;
    width: 500px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
  
  .auth-panel h1{
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--black);
    text-align: left;
  }
  
  .auth-panel .subtitle{
    color: var(--grey);
    margin: 0 0 2rem;
    font-size: 1rem;
  }

  /* ------- Social buttons ------- */
  .social-row{
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .social-btn{
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid #e5e7eb;
    background: var(--white);
    padding: 0.875rem 1rem;
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .social-btn:hover{
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(7,23,23,.12);
  }
  
  .social-btn .icon{ 
    display: inline-flex; 
    width: 20px; 
    height: 20px; 
  }

  /* ------- Form ------- */
  .auth-form label{
    display: block;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
    color: var(--black);
    font-size: 0.95rem;
  }
  
  .input{
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: var(--radius);
    padding: 0.875rem 1rem;
    background: var(--white);
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .input:focus-within{
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(26, 109, 85, 0.1);
  }
  
  .input input{
    border: 0;
    outline: 0;
    width: 100%;
    font: inherit;
    background: transparent;
    color: var(--black);
    font-size: 0.95rem;
  }
  
  .input input::placeholder{
    color: #9ca3af;
  }
  
  .input-icon{
    width: 18px; 
    height: 18px; 
    display: inline-flex;
    color: var(--grey);
  }
  
  .input-action{ 
    width: 18px; 
    height: 18px; 
    display: inline-flex; 
    opacity: 0.6;
    cursor: pointer;
    color: var(--grey);
  }

  .row-between{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 1rem 0 1.5rem;
    gap: 1rem;
  }
  
  .check{ 
    display: flex; 
    align-items: center; 
    gap: 0.5rem; 
    color: var(--black);
    font-size: 0.9rem;
  }
  
  .check input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--green);
  }
  
  .link{ 
    color: var(--teal); 
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  
  .link:hover{ 
    text-decoration: underline; 
  }

  .btn-primary{
    width: 100%;
    border: 0;
    border-radius: var(--radius);
    padding: 1rem;
    background: var(--green);
    color: var(--white);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .btn-primary:hover{ 
    background: #155a49;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 109, 85, 0.3);
  }

  .muted{
    text-align: center;
    color: var(--grey);
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
  }
  
  .muted a{ 
    color: var(--green); 
    text-decoration: none; 
    font-weight: 600; 
  }
  
  .muted a:hover{ 
    text-decoration: underline; 
  }

  .result{ 
    margin-top: 1rem; 
    min-height: 1rem; 
  }

  /* ------- Footer ------- */
  .auth-footer{
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    padding: 2rem;
    text-align: center;
    color: var(--grey);
    font-size: 0.85rem;
    z-index: 10;
    width: 100%;
  }
  
  .auth-footer nav{
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  
  .auth-footer a{ 
    color: var(--grey); 
    text-decoration: none;
    font-weight: 500;
  }
  
  .auth-footer a:hover{ 
    text-decoration: underline;
    color: var(--black);
  }

  /* ------- Responsive ------- */
  @media (max-width: 1024px){
    .auth-layout{ 
      grid-template-columns: 1fr; 
      gap: 0;
    }
    
    .auth-hero{ 
      order: 2;
      min-height: auto;
      padding: 2rem;
    }
    
    .auth-panel{ 
      order: 1;
      padding: 2rem;
    }
    
    .auth-footer {
      position: static;
      text-align: center;
      padding: 1rem;
    }
    
    .auth-footer nav {
      justify-content: center;
    }
    
    .hero-copy h2 {
      font-size: 1.75rem;
    }
    
    .auth-panel h1 {
      font-size: 2rem;
    }
  }
  
  @media (max-width: 640px) {
    .social-row {
      flex-direction: column;
    }
    
    .row-between {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    
    .hero-copy h2 {
      font-size: 1.5rem;
    }
    
    .auth-panel {
      padding: 1.5rem;
    }
  }
</style>

<div class="auth-layout" data-controller="auth">

  <!-- Colonne gauche (illustration + texte) -->
  <section class="auth-hero">
    <img src="{{ asset('images/login.svg') }}" alt="Illustration d'apprentissage en ligne">
    <div class="hero-copy">
      <h2>Master multiple courses with <span>certification…</span></h2>
      <p>Stay up-to-date with compliance, finance, project management, and personal development modules.</p>
    </div>
  </section>

  <!-- Colonne droite (formulaire) -->
  <section class="auth-panel">
    <h1>Sign In</h1>
    <p class="subtitle">Welcome back, You've been missed!</p>

    <div class="social-row">
      <button type="button" class="social-btn" aria-label="Sign in with Google">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.7 3.8-5.5 3.8a6.4 6.4 0 1 1 0-12.8 5.8 5.8 0 0 1 4.1 1.6l2.8-2.8A10 10 0 1 0 12 22c5.8 0 9.8-4 9.8-9.7 0-.7-.1-1.4-.2-2.1z"/>
          </svg>
        </span>
        Google
      </button>

      <button type="button" class="social-btn" aria-label="Sign in with Apple">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M16.4 12.5c0-2.1 1.8-3 1.9-3.1-1-1.4-2.6-1.6-3.2-1.6-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.9-.8-1.5.1-2.9.9-3.6 2.2-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.5 2.1 2.6 2 .1 0 .4-.1.7-.2.5-.1 1.1-.2 1.7-.2s1.2.1 1.7.2c.2.1.5.2.7.2 1.1.1 1.9-1 2.6-2 .7-1 1-2 1-2-.1 0-2-.8-2-3.2zM14.5 5.8c.6-.7 1-1.7.9-2.7-.9.1-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z"/>
          </svg>
        </span>
        Apple
      </button>
    </div>

    <form class="auth-form" data-action="submit->auth#login">
      <label for="email">Email</label>
      <div class="input">
        <span class="input-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"/>
          </svg>
        </span>
        <input id="email" name="email" type="email" placeholder="email" data-auth-target="email" required>
      </div>

      <label for="password">Password</label>
      <div class="input">
        <span class="input-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1a5 5 0 0 0-5 5v3H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-2V6a5 5 0 0 0-5-5Zm3 8H9V6a3 3 0 0 1 6 0v3Z"/>
          </svg>
        </span>
        <input id="password" name="password" type="password" placeholder="Enter password" data-auth-target="password" required>
        <span class="input-action" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 5c-5 0-9 5-9 7s4 7 9 7 9-5 9-7-4-7-9-7Zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z"/>
          </svg>
        </span>
      </div>

      <div class="row-between">
        <label class="check">
          <input type="checkbox"> <span>Remember me</span>
        </label>
        <a class="link" href="/forgot-password">Forgot password?</a>
      </div>

      <button type="submit" class="btn-primary">Sign In</button>

      <p class="muted">Don't have an account Yet? <a href="/register">Sign Up</a></p>
    </form>

    <div data-auth-target="result" class="result"></div>
  </section>
</div>
<footer class="auth-footer">
  <nav>
    <a href="/terms">Terms & Condition</a>
    <a href="/privacy">Privacy Policy</a>
    <a href="/help">Help</a>
    <a href="#" lang="en">English</a>
  </nav>
  <small>© 2025, All Rights reserved.</small>
</footer>
{% endblock %}