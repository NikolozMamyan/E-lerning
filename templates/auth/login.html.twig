{% extends 'base_auth.html.twig' %}

{% block title %}Sign in to your E-learning Platform | Les Consultants Luxembourg{% endblock %}
{% block meta_description %}Sign in to Les Consultants E-learning to continue professional courses in compliance, AML/CFT, risk, GDPR and cybersecurity.{% endblock %}
{% block meta_robots %}index, follow{% endblock %}
{% block canonical_url %}{{ url('show_login') }}{% endblock %}
{% block body_class %}auth-document auth-document--login{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-shell auth-shell--login" data-controller="auth" data-auth-mode="login">
  <section class="auth-visual" style="--auth-illustration: url('{{ asset('images/login.svg') }}')" aria-label="Learning platform preview">
    <a href="{{ path('app_landing_page') }}" class="auth-brand" aria-label="Les Consultants home">
      <img src="{{ asset('images/logo.png') }}" alt="Les Consultants">
      <span>Digital learning platform</span>
    </a>

    <div class="auth-visual__copy">
      <span class="auth-visual__eyebrow"><i class="fa-solid fa-chart-line" aria-hidden="true"></i>Continue your journey</span>
      <h1>Learn with clarity.<br>Progress with confidence.</h1>
      <p>Return to your courses, follow every milestone and keep your professional achievements in one place.</p>
    </div>

    <div class="auth-learning-preview" aria-hidden="true">
      <div class="auth-learning-preview__window">
        <div class="auth-learning-preview__topbar">
          <span><i></i><i></i><i></i></span>
          <small>My learning space</small>
          <i class="fa-regular fa-bell"></i>
        </div>
        <div class="auth-learning-preview__content">
          <div class="auth-learning-preview__course">
            <div class="auth-learning-preview__media" style="--auth-course-cover: url('{{ asset('uploads/courses/mockup-market-overview.jpg') }}')">
              <span class="auth-learning-preview__play"><i class="fa-solid fa-play"></i></span>
              <span class="auth-learning-preview__lesson">Lesson 06</span>
            </div>
            <div class="auth-learning-preview__course-copy">
              <small>Market analysis</small>
              <strong>Understand market trends and investment risk</strong>
              <div><span>Course progress</span><b>68%</b></div>
              <div class="auth-learning-preview__progress"><span></span></div>
            </div>
          </div>
          <div class="auth-learning-preview__side">
            <div><span><i class="fa-solid fa-fire"></i></span><strong>6 day</strong><small>learning streak</small></div>
            <div><span><i class="fa-solid fa-award"></i></span><strong>3</strong><small>certificates</small></div>
          </div>
        </div>
      </div>
      <div class="auth-learning-preview__floating auth-learning-preview__floating--progress"><i class="fa-solid fa-circle-check"></i><span><strong>Progress saved</strong><small>Continue on any device</small></span></div>
      <div class="auth-learning-preview__floating auth-learning-preview__floating--live"><i></i><span>Learning active</span></div>
    </div>

    <div class="auth-visual__trust">
      <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Secure access</span>
      <span><i class="fa-solid fa-language" aria-hidden="true"></i>Multilingual courses</span>
      <span><i class="fa-solid fa-certificate" aria-hidden="true"></i>Verified certificates</span>
    </div>
  </section>

  <main class="auth-main">
    <div class="auth-main__inner">
      <nav class="auth-switch" aria-label="Authentication pages">
        <span class="auth-switch__active"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>Sign in</span>
        <a href="{{ path('show_register') }}" data-action="click->auth#switchPage" data-auth-direction="forward">Create account</a>
      </nav>

      <section class="auth-card">
        <div class="auth-card__heading">
          <span>Welcome back</span>
          <h2>Sign in to your workspace</h2>
          <p>Access your courses, progress and certificates.</p>
        </div>

        <a href="{{ path('api_google_start') }}" class="auth-google">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.3l6.7-6.7C35.9 2.7 30.4 0 24 0 14.6 0 6.5 5.6 2.6 13.8l7.9 6.1C12.1 13.6 17.6 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.5c-.5 2.5-1.9 4.6-3.9 6.1l6.1 4.7c3.6-3.3 5.4-8.2 5.4-13.3z"/>
            <path fill="#FBBC05" d="M10.5 28.3c-1-2.5-1.5-5.2-1.5-8.3s.6-5.8 1.5-8.3L2.6 5.6C.9 9.1 0 13.4 0 17.9s.9 8.8 2.6 12.3l7.9-6.1z"/>
            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.6l-6.1-4.7c-2.2 1.5-5.1 2.4-9.8 2.4-6.4 0-11.9-4.1-13.9-9.7l-7.9 6.1C6.5 42.4 14.6 48 24 48z"/>
          </svg>
          Continue with Google
        </a>

        <div class="auth-divider"><span>or use your email</span></div>

        <form class="auth-form" data-action="submit->auth#login">
          <div class="auth-field">
            <label for="login-email">Email address</label>
            <div class="auth-input">
              <i class="fa-regular fa-envelope" aria-hidden="true"></i>
              <input id="login-email" name="email" type="email" placeholder="name@company.com" autocomplete="email" data-auth-target="email" required>
            </div>
          </div>

          <div class="auth-field">
            <div class="auth-field__label-row">
              <label for="login-password">Password</label>
              <a href="{{ path('app_forgot_password_request') }}">Forgot password?</a>
            </div>
            <div class="auth-input">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>
              <input id="login-password" name="password" type="password" placeholder="Enter your password" autocomplete="current-password" data-auth-target="password" required>
              <button type="button" class="auth-input__action" data-action="click->auth#togglePassword" aria-label="Show password" aria-pressed="false">
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="auth-submit" data-auth-target="button">
            <span>Sign in securely</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>

          <div class="auth-result" data-auth-target="result" aria-live="polite"></div>
        </form>

        <p class="auth-card__switch-copy">New to the platform? <a href="{{ path('show_register') }}" data-action="click->auth#switchPage" data-auth-direction="forward">Create your account <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></p>
      </section>

      <footer class="auth-footer">
        <span>© {{ 'now'|date('Y') }} Les Consultants</span>
        <nav><a href="/legales/TermsConditions.html">Terms</a><a href="/legales/Privacy.html">Privacy</a></nav>
      </footer>
    </div>
  </main>
</div>
{% endblock %}
