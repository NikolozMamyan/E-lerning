{% extends 'base_auth.html.twig' %}

{% block title %}Create an account | Les Consultants{% endblock %}
{% block body_class %}auth-document auth-document--register{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
{% endblock %}

{% block body %}
<div class="auth-shell auth-shell--register" data-controller="auth" data-auth-mode="register">
  <section class="auth-visual" style="--auth-illustration: url('{{ asset('images/register.svg') }}')" aria-label="Digital learning experience preview">
    <a href="{{ path('app_landing_page') }}" class="auth-brand" aria-label="Les Consultants home">
      <img src="{{ asset('images/logo.png') }}" alt="Les Consultants">
      <span>Digital learning platform</span>
    </a>

    <div class="auth-visual__copy">
      <span class="auth-visual__eyebrow"><i class="fa-solid fa-route" aria-hidden="true"></i>Start building your skills</span>
      <h1>A smarter path from learning to achievement.</h1>
      <p>Create your workspace, explore practical training and turn completed courses into verified professional certificates.</p>
    </div>

    <div class="auth-learning-preview auth-learning-preview--path" aria-hidden="true">
      <div class="auth-learning-preview__window">
        <div class="auth-learning-preview__topbar">
          <span><i></i><i></i><i></i></span>
          <small>Your learning path</small>
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </div>
        <div class="auth-path-preview">
          <div class="auth-path-preview__summary">
            <span><i class="fa-solid fa-graduation-cap"></i></span>
            <div><small>Personal roadmap</small><strong>Build knowledge step by step</strong></div>
            <b>01</b>
          </div>
          <div class="auth-path-preview__steps">
            <div class="is-complete"><span><i class="fa-solid fa-check"></i></span><div><strong>Choose your course</strong><small>Explore practical topics</small></div></div>
            <div class="is-current"><span><i class="fa-solid fa-play"></i></span><div><strong>Learn at your pace</strong><small>Progress saved automatically</small></div></div>
            <div><span><i class="fa-solid fa-award"></i></span><div><strong>Earn your certificate</strong><small>Validate your achievement</small></div></div>
          </div>
        </div>
      </div>
      <div class="auth-learning-preview__floating auth-learning-preview__floating--progress"><i class="fa-solid fa-users"></i><span><strong>Individual or company</strong><small>Choose your workspace</small></span></div>
      <div class="auth-learning-preview__floating auth-learning-preview__floating--live"><i></i><span>Ready to begin</span></div>
    </div>

    <div class="auth-visual__trust">
      <span><i class="fa-solid fa-layer-group" aria-hidden="true"></i>Practical courses</span>
      <span><i class="fa-solid fa-chart-simple" aria-hidden="true"></i>Progress tracking</span>
      <span><i class="fa-solid fa-award" aria-hidden="true"></i>Official achievements</span>
    </div>
  </section>

  <main class="auth-main">
    <div class="auth-main__inner">
      <nav class="auth-switch" aria-label="Authentication pages">
        <a href="{{ path('show_login') }}" data-action="click->auth#switchPage" data-auth-direction="backward">Sign in</a>
        <span class="auth-switch__active"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>Create account</span>
      </nav>

      <section class="auth-card auth-card--register">
        <div class="auth-card__heading">
          <span>Join the platform</span>
          <h2>Create your learning workspace</h2>
          <p>A few details and your learning journey can begin.</p>
        </div>

        <a href="{{ path('api_google_start') }}" class="auth-google">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.3l6.7-6.7C35.9 2.7 30.4 0 24 0 14.6 0 6.5 5.6 2.6 13.8l7.9 6.1C12.1 13.6 17.6 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.5c-.5 2.5-1.9 4.6-3.9 6.1l6.1 4.7c3.6-3.3 5.4-8.2 5.4-13.3z"/>
            <path fill="#FBBC05" d="M10.5 28.3c-1-2.5-1.5-5.2-1.5-8.3s.6-5.8 1.5-8.3L2.6 5.6C.9 9.1 0 13.4 0 17.9s.9 8.8 2.6 12.3l7.9-6.1z"/>
            <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.6l-6.1-4.7c-2.2 1.5-5.1 2.4-9.8 2.4-6.4 0-11.9-4.1-13.9-9.7l-7.9 6.1C6.5 42.4 14.6 48 24 48z"/>
          </svg>
          Create account with Google
        </a>

        <div class="auth-divider"><span>or register with email</span></div>

        <form class="auth-form" data-action="submit->auth#register">
          <fieldset class="auth-account-type">
            <legend>Choose your workspace</legend>
            <div>
              <label class="auth-account-option" for="employee">
                <input type="radio" id="employee" name="account_type" value="employee" data-auth-target="accountType" checked>
                <span class="auth-account-option__icon"><i class="fa-solid fa-user-graduate" aria-hidden="true"></i></span>
                <span><strong>Learner</strong><small>For your own training</small></span>
                <i class="fa-solid fa-check auth-account-option__check" aria-hidden="true"></i>
              </label>

              <label class="auth-account-option" for="company">
                <input type="radio" id="company" name="account_type" value="company" data-auth-target="accountType">
                <span class="auth-account-option__icon"><i class="fa-solid fa-building" aria-hidden="true"></i></span>
                <span><strong>Company</strong><small>Manage team learning</small></span>
                <i class="fa-solid fa-check auth-account-option__check" aria-hidden="true"></i>
              </label>
            </div>
          </fieldset>

          <div class="auth-field">
            <label for="register-name">Full name</label>
            <div class="auth-input">
              <i class="fa-regular fa-user" aria-hidden="true"></i>
              <input id="register-name" name="name" type="text" placeholder="Your full name" autocomplete="name" data-auth-target="userName" required>
            </div>
          </div>

          <div class="auth-field">
            <label for="register-email">Professional email</label>
            <div class="auth-input">
              <i class="fa-regular fa-envelope" aria-hidden="true"></i>
              <input id="register-email" name="email" type="email" placeholder="name@company.com" autocomplete="email" data-auth-target="email" required>
            </div>
          </div>

          <div class="auth-field">
            <label for="register-password">Create a password</label>
            <div class="auth-input">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>
              <input id="register-password" name="password" type="password" placeholder="Choose a secure password" autocomplete="new-password" data-auth-target="password" data-action="input->auth#updatePasswordStrength" required>
              <button type="button" class="auth-input__action" data-action="click->auth#togglePassword" aria-label="Show password" aria-pressed="false">
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
              </button>
            </div>
            <div class="auth-password-strength" data-auth-target="passwordMeter"><span></span></div>
            <small class="auth-password-hint" data-auth-target="passwordHint">Use 8+ characters with letters and numbers.</small>
          </div>

          <label class="auth-consent" for="terms">
            <input type="checkbox" id="terms" name="terms" required>
            <span><i class="fa-solid fa-check" aria-hidden="true"></i></span>
            <small>I agree to the <a href="/legales/TermsConditions.html" target="_blank" rel="noopener">Terms & Conditions</a> and <a href="/legales/Privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</small>
          </label>

          <button type="submit" class="auth-submit" data-auth-target="button">
            <span>Create my workspace</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>

          <div class="auth-result" data-auth-target="result" aria-live="polite"></div>
        </form>

        <p class="auth-card__switch-copy">Already registered? <a href="{{ path('show_login') }}" data-action="click->auth#switchPage" data-auth-direction="backward"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Sign in instead</a></p>
      </section>

      <footer class="auth-footer">
        <span>© {{ 'now'|date('Y') }} Les Consultants</span>
        <nav><a href="/legales/TermsConditions.html">Terms</a><a href="/legales/Privacy.html">Privacy</a></nav>
      </footer>
    </div>
  </main>
</div>
{% endblock %}
