{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<style>
  :root{
    --green:#1A6D55;
    --teal:#0D8383;
    --black:#071717;
    --mint:#E7F3F3;
    --grey:#606060;
    --white:#FFFFFF;
    --radius:12px;
    --shadow:0 4px 12px rgba(7,23,23,.08);
  }
  *{box-sizing:border-box}

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--white);
    color: var(--black);
  }

  /* ------- Layout ------- */
  .auth-layout{
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    align-items: center;
    gap: 0;
    padding: 0;
  }
  
  .auth-hero{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, var(--mint) 0%, #f8fefe 100%);
    min-height: 100vh;
  }
  
  .auth-hero img{
    width: 100%;
    max-width: 500px;
    height: auto;
    margin-bottom: 2rem;
  }
  
  .hero-copy{
    max-width: 450px;
  }
  
  .hero-copy h2{
    font-size: 2.25rem;
    line-height: 1.2;
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--black);
  }
  
  .hero-copy h2 span{ 
    white-space: nowrap; 
  }
  
  .hero-copy p{
    color: var(--grey);
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0;
  }

  .auth-panel{
    max-width: 500px;
    width: 500px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
  
  .auth-panel h1{
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    font-weight: 800;
    color: var(--black);
    text-align: left;
  }
  
  .auth-panel .subtitle{
    color: var(--grey);
    margin: 0 0 2rem;
    font-size: 1rem;
  }

  /* ------- Social buttons ------- */
  .social-row{
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .social-btn{
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border: 1px solid #e5e7eb;
    background: var(--white);
    padding: 0.875rem 1rem;
    border-radius: var(--radius);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .social-btn:hover{
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(7,23,23,.12);
  }
  
  .social-btn .icon{ 
    display: inline-flex; 
    width: 20px; 
    height: 20px; 
  }

  /* ------- Account Type Selection ------- */
  .account-type-section {
    margin-bottom: 1.5rem;
  }

  .account-type-section h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--black);
  }

  .account-type-row {
    display: flex;
    gap: 1rem;
  }

  .account-type-option {
    flex: 1;
    position: relative;
  }

  .account-type-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .account-type-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border: 2px solid #e5e7eb;
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .account-type-option input[type="radio"]:checked + .account-type-label {
    border-color: var(--green);
    background: rgba(26, 109, 85, 0.05);
  }

  .radio-custom {
    width: 20px;
    height: 20px;
    border: 2px solid #d1d5db;
    border-radius: 50%;
    position: relative;
    transition: all 0.2s ease;
  }

  .account-type-option input[type="radio"]:checked + .account-type-label .radio-custom {
    border-color: var(--green);
  }

  .account-type-option input[type="radio"]:checked + .account-type-label .radio-custom::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    background: var(--green);
    border-radius: 50%;
  }

  .account-type-text {
    font-weight: 500;
    color: var(--black);
  }

  /* ------- Form ------- */
  .auth-form label{
    display: block;
    font-weight: 600;
    margin: 1rem 0 0.5rem;
    color: var(--black);
    font-size: 0.95rem;
  }
  
  .input{
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: var(--radius);
    padding: 0.875rem 1rem;
    background: var(--white);
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .input:focus-within{
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(26, 109, 85, 0.1);
  }
  
  .input input{
    border: 0;
    outline: 0;
    width: 100%;
    font: inherit;
    background: transparent;
    color: var(--black);
    font-size: 0.95rem;
  }
  
  .input input::placeholder{
    color: #9ca3af;
  }
  
  .input-icon{
    width: 18px; 
    height: 18px; 
    display: inline-flex;
    color: var(--grey);
  }
  
  .input-action{ 
    width: 18px; 
    height: 18px; 
    display: inline-flex; 
    opacity: 0.6;
    cursor: pointer;
    color: var(--grey);
  }

  .checkbox-row{
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
  }
  
  .checkbox-row input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--green);
  }

  .checkbox-row span {
    color: var(--black);
    font-size: 0.9rem;
  }

  .btn-primary{
    width: 100%;
    border: 0;
    border-radius: var(--radius);
    padding: 1rem;
    background: var(--green);
    color: var(--white);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: var(--shadow);
  }
  
  .btn-primary:hover{ 
    background: #155a49;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 109, 85, 0.3);
  }

  .muted{
    text-align: center;
    color: var(--grey);
    margin: 1.5rem 0 0;
    font-size: 0.95rem;
  }
  
  .muted a{ 
    color: var(--green); 
    text-decoration: none; 
    font-weight: 600; 
  }
  
  .muted a:hover{ 
    text-decoration: underline; 
  }

  .result{ 
    margin-top: 1rem; 
    min-height: 1rem; 
  }

  /* ------- Footer ------- */
  .auth-footer{
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    padding: 2rem;
    text-align: center;
    color: var(--grey);
    font-size: 0.85rem;
    z-index: 10;
    width: 100%;
  }
  
  .auth-footer nav{
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  
  .auth-footer a{ 
    color: var(--grey); 
    text-decoration: none;
    font-weight: 500;
  }
  
  .auth-footer a:hover{ 
    text-decoration: underline;
    color: var(--black);
  }

  /* ------- Responsive ------- */
  @media (max-width: 1024px){
    .auth-layout{ 
      grid-template-columns: 1fr; 
      gap: 0;
    }
    
    .auth-hero{ 
      order: 2;
      min-height: auto;
      padding: 2rem;
    }
    
    .auth-panel{ 
      order: 1;
      padding: 2rem;
    }
    
    .auth-footer {
      position: static;
      text-align: center;
      padding: 1rem;
      transform: none;
    }
    
    .hero-copy h2 {
      font-size: 1.75rem;
    }
    
    .auth-panel h1 {
      font-size: 2rem;
    }

    .account-type-row {
      flex-direction: column;
    }
  }
  
  @media (max-width: 640px) {
    .social-row {
      flex-direction: column;
    }
    
    .hero-copy h2 {
      font-size: 1.5rem;
    }
    
    .auth-panel {
      padding: 1.5rem;
    }
  }
</style>

<div class="auth-layout" data-controller="auth">

  <!-- Colonne gauche (illustration + texte) -->
  <section class="auth-hero">
    <img src="{{ asset('images/register.svg') }}" alt="Illustration d'apprentissage en ligne">
    <div class="hero-copy">
      <h2>Master multiple courses with <span>certification…</span></h2>
      <p>Stay up-to-date with compliance, finance, project management, and personal development modules.</p>
    </div>
  </section>

  <!-- Colonne droite (formulaire) -->
  <section class="auth-panel">
    <h1>Sign Up</h1>
    <p class="subtitle">Welcome, Sign up and start your Journey</p>

    <div class="social-row">
      <button type="button" class="social-btn" aria-label="Sign up with Google">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.7 3.8-5.5 3.8a6.4 6.4 0 1 1 0-12.8 5.8 5.8 0 0 1 4.1 1.6l2.8-2.8A10 10 0 1 0 12 22c5.8 0 9.8-4 9.8-9.7 0-.7-.1-1.4-.2-2.1z"/>
          </svg>
        </span>
        Google
      </button>

      <button type="button" class="social-btn" aria-label="Sign up with Apple">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M16.4 12.5c0-2.1 1.8-3 1.9-3.1-1-1.4-2.6-1.6-3.2-1.6-1.4-.1-2.7.8-3.3.8-.7 0-1.7-.8-2.9-.8-1.5.1-2.9.9-3.6 2.2-1.5 2.6-.4 6.5 1.1 8.7.7 1 1.5 2.1 2.6 2 .1 0 .4-.1.7-.2.5-.1 1.1-.2 1.7-.2s1.2.1 1.7.2c.2.1.5.2.7.2 1.1.1 1.9-1 2.6-2 .7-1 1-2 1-2-.1 0-2-.8-2-3.2zM14.5 5.8c.6-.7 1-1.7.9-2.7-.9.1-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z"/>
          </svg>
        </span>
        Apple
      </button>
    </div>

 <form class="auth-form" data-controller="auth" data-action="submit->auth#register">
  <!-- Account Type Selection -->
  <div class="account-type-section">
    <h3>Select Account Type</h3>
    <div class="account-type-row">
      <div class="account-type-option">
        <input type="radio" id="employee" name="account_type" value="employee" checked
               data-auth-target="accountType">
        <label for="employee" class="account-type-label">
          <div class="radio-custom"></div>
          <span class="account-type-text">Employee</span>
        </label>
      </div>
      <div class="account-type-option">
        <input type="radio" id="company" name="account_type" value="company"
               data-auth-target="accountType">
        <label for="company" class="account-type-label">
          <div class="radio-custom"></div>
          <span class="account-type-text">Company</span>
        </label>
      </div>
    </div>
  </div>

  <label for="name">Name</label>
  <div class="input">
    <span class="input-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
    </span>
    <!-- IMPORTANT: target renommé en userName -->
    <input id="name" name="name" type="text" placeholder="Full Name"
           data-auth-target="userName" required>
  </div>

  <label for="email">Professional email</label>
  <div class="input">
    <span class="input-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z"/></svg>
    </span>
    <input id="email" name="email" type="email" placeholder="Professional email"
           data-auth-target="email" required>
  </div>

  <label for="password">Password</label>
  <div class="input">
    <span class="input-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a5 5 0 0 0-5 5v3H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-2V6a5 5 0 0 0-5-5Zm3 8H9V6a3 3 0 0 1 6 0v3Z"/></svg>
    </span>
    <input id="password" name="password" type="password" placeholder="Enter password"
           data-auth-target="password" required>
    <span class="input-action" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5c-5 0-9 5-9 7s4 7 9 7 9-5 9-7-4-7-9-7Zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10Z"/></svg>
    </span>
  </div>

  <div class="checkbox-row">
    <input type="checkbox" id="remember" name="remember">
    <span>Remember me</span>
  </div>

  <button type="submit" class="btn-primary">Sign Up</button>

  <!-- Zone d’affichage des messages -->
  <div class="muted" data-auth-target="result" aria-live="polite"></div>

  <p class="muted">Already have an account? <a href="/login">Sign In</a></p>
</form>


    <div data-auth-target="result" class="result"></div>
  </section>
</div>

<footer class="auth-footer">
  <nav>
    <a href="/terms">Terms & Condition</a>
    <a href="/privacy">Privacy Policy</a>
    <a href="/help">Help</a>
    <a href="#" lang="en">English</a>
  </nav>
  <small>© 2025, All Rights reserved.</small>
</footer>

{% endblock %}