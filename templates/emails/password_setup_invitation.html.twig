<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject|default('Set up your password') }}</title>
</head>
<body style="margin:0; padding:0; font-family:'Source Sans Pro',Arial,sans-serif; background-color:#f4f9f8; color:#071717;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#f4f9f8; padding:32px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px; background:#ffffff; border-radius:12px; box-shadow:0 4px 12px rgba(7,23,23,.08);">
                <tr>
                    <td align="center" style="padding:32px 32px 20px;">
                        <div style="color:#1A6D55; font-family:Arial,sans-serif; text-align:center;">
                            <div style="font-size:24px; line-height:1.2; font-weight:700; letter-spacing:1px;">LES CONSULTANTS</div>
                            <div style="margin-top:5px; font-size:14px; line-height:1.3; font-weight:600;">Cabinet de Conseil et Formation</div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px; color:#071717; font-size:16px; line-height:1.6;">
                        <p style="margin:0 0 18px;"><strong>Dear {{ user.username ?: 'User' }},</strong></p>
                        <div style="margin:0 0 20px; color:#606060;">{{ message|nl2br }}</div>
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding:8px 32px 28px;">
                        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="display:inline-block; padding:13px 24px; background:#1A6D55; color:#ffffff; font-weight:600; text-decoration:none; border-radius:8px; font-size:16px;">Set my password</a>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px; color:#606060; font-size:14px; line-height:1.5;">
                        <p style="margin:0 0 8px;">This personal link expires in 74 hours and can only be used once.</p>
                        <p style="margin:0 0 8px;">If the button does not work, copy and paste this link into your browser:</p>
                        <p style="margin:0; word-break:break-all;"><a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="color:#0D8383; text-decoration:none;">{{ url('app_reset_password', {token: resetToken.token}) }}</a></p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 32px 32px; color:#606060; font-size:15px; line-height:1.5;">
                        <p style="margin:0;">Kind regards,<br>Pascal</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
