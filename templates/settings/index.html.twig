{% extends 'base.html.twig' %}

{% block title %}Settings - My Profile{% endblock %}

{% block body %}

  <!-- Main Content -->
  <main class="settings-main">
    <h2>My Profile</h2>

    <!-- User Profile -->
<div class="settings-card profile-card">
  <div class="profile-header">
    <img src="{{ asset(user.avatar ? 'uploads/avatars/' ~ user.avatar : 'images/User.svg') }}" 
         alt="User avatar" 
         class="profile-avatar" id="profileAvatar">
    <div>
      <h3>{{ user.username }}</h3>
      <p>{{ user.bio ?? 'No bio yet' }}</p>
    </div>
  </div>
  <button class="btn-edit" data-section="avatar">✏️ Edit</button>
</div>


    <!-- Personal Information -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Personal Information</h3>
        <button class="btn-edit" data-section="personal">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>User name</strong><p>{{ user.username }}</p></div>
        <div><strong>Email Address</strong><p>{{ user.email }}</p></div>
        <div><strong>Phone Number</strong><p>{{ user.phone ?? 'Not set' }}</p></div>
        <div><strong>Bio</strong><p>{{ user.bio ?? 'Not set' }}</p></div>
      </div>
    </div>

    <!-- Address -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Address</h3>
        <button class="btn-edit" data-section="address">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>Country</strong><p>{{ user.country ?? 'Not set' }}</p></div>
        <div><strong>City/State</strong><p>{{ user.city ?? 'Not set' }}</p></div>
        <div><strong>Postal Code</strong><p>{{ user.postalCode ?? 'Not set' }}</p></div>
        <div><strong>TAX ID</strong><p>{{ user.taxId ?? 'Not set' }}</p></div>
      </div>
    </div>

    <!-- Education -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Educational Background</h3>
        <button class="btn-edit" data-section="education">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>Master’s Degree</strong><p>{{ user.masterDegree ?? 'Not set' }}</p></div>
        <div><strong>Bachelor’s Degree</strong><p>{{ user.bachelorDegree ?? 'Not set' }}</p></div>
      </div>
    </div>
  </main>


<style>
.settings-container {
  display: flex;
  gap: 2rem;
  margin: 2rem;
}

.settings-sidebar {
  width: 220px;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem;
}

.settings-sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.settings-sidebar li {
  margin-bottom: 1rem;
}

.settings-sidebar a {
  text-decoration: none;
  color: var(--black);
  font-weight: 500;
}

.settings-sidebar .active a {
  color: var(--green);
}

.settings-sidebar .danger a {
  color: red;
}

.settings-main {
  flex: 1;
}

.settings-card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem 1.5rem;
  margin-bottom: 1.5rem;
  position: relative;
}

.profile-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.profile-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-body {
  margin-top: 1rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.btn-edit {
  background: var(--green);
  color: var(--white);
  border: none;
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.85rem;
}

.btn-edit:hover {
  background: var(--teal);
}

.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal form {
  background: white;
  padding: 2rem;
  border-radius: 8px;
  min-width: 400px;
  max-width: 600px;
}

.btn-save {
  background: var(--green);
  color: white;
  border: none;
  padding: .5rem 1rem;
  border-radius: var(--radius);
  cursor: pointer;
}

.btn-save:hover {
  background: var(--teal);
}

.btn-close {
  background: #ccc;
  color: black;
  border: none;
  padding: .5rem 1rem;
  border-radius: var(--radius);
  cursor: pointer;
}
</style>

<script>
document.querySelectorAll('.btn-edit').forEach(btn => {
  btn.addEventListener('click', function() {
    let section = this.dataset.section;

    fetch(`/app/settings/edit/${section}`)
      .then(res => res.text())
      .then(html => {
        let modal = document.createElement('div');
        modal.classList.add('modal');
        modal.innerHTML = html;
        document.body.appendChild(modal);

        // Fermer modal en cliquant dehors
        modal.addEventListener('click', e => {
          if (e.target === modal) modal.remove();
        });

        // Soumission AJAX
        modal.querySelector('#ajaxForm').addEventListener('submit', function(e) {
          e.preventDefault();
          let formData = new FormData(this);

          fetch(`/app/settings/edit/${section}`, {
            method: 'POST',
            body: formData
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              let card = btn.closest('.settings-card');
              card.querySelector('.card-body').outerHTML = data.html;
              modal.remove();
            }
          });
        });

        // Bouton fermer
        let closeBtn = modal.querySelector('.btn-close');
        if (closeBtn) {
          closeBtn.addEventListener('click', () => modal.remove());
        }
      });
  });
});
</script>

{% endblock %}
