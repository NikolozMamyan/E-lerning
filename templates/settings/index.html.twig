{% extends 'base.html.twig' %}

{% block title %}Settings - My Profile{% endblock %}

{% block body %}

  <!-- Main Content -->
  <main class="settings-main">
    <h2>My Profile</h2>

    <!-- User Profile -->
<div class="settings-card profile-card">
  <div class="profile-header">
    <img src="{{ asset(user.avatar ? 'uploads/avatars/' ~ user.avatar : 'images/User.svg') }}" 
         alt="User avatar" 
         class="profile-avatar" id="profileAvatar">
    <div>
      <h3>{{ user.username }}</h3>
      <p>{{ user.bio ?? 'No bio yet' }}</p>
    </div>
  </div>
  <button class="btn-edit" data-section="avatar">✏️ Edit</button>
</div>


    <!-- Personal Information -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Personal Information</h3>
        <button class="btn-edit" data-section="personal">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>User name</strong><p>{{ user.username }}</p></div>
        <div><strong>Email Address</strong><p>{{ user.email }}</p></div>
        <div><strong>Phone Number</strong><p>{{ user.phone ?? 'Not set' }}</p></div>
        <div><strong>Bio</strong><p>{{ user.bio ?? 'Not set' }}</p></div>
      </div>
    </div>

    <!-- Address -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Address</h3>
        <button class="btn-edit" data-section="address">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>Country</strong><p>{{ user.country ?? 'Not set' }}</p></div>
        <div><strong>City/State</strong><p>{{ user.city ?? 'Not set' }}</p></div>
        <div><strong>Postal Code</strong><p>{{ user.postalCode ?? 'Not set' }}</p></div>
        <div><strong>TAX ID</strong><p>{{ user.taxId ?? 'Not set' }}</p></div>
      </div>
    </div>

    <!-- Education -->
    <div class="settings-card">
      <div class="card-header">
        <h3>Educational Background</h3>
        <button class="btn-edit" data-section="education">✏️ Edit</button>
      </div>
      <div class="card-body grid-2">
        <div><strong>Master’s Degree</strong><p>{{ user.masterDegree ?? 'Not set' }}</p></div>
        <div><strong>Bachelor’s Degree</strong><p>{{ user.bachelorDegree ?? 'Not set' }}</p></div>
      </div>
    </div>
  </main>


<style>
.toast {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: var(--green);
  color: white;
  padding: 0.75rem 1.25rem;
  border-radius: 6px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.3s ease;
  z-index: 2000;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

.settings-container {
  display: flex;
  gap: 2rem;
  margin: 2rem;
}

.settings-sidebar {
  width: 220px;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem;
}

.settings-sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.settings-sidebar li {
  margin-bottom: 1rem;
}

.settings-sidebar a {
  text-decoration: none;
  color: var(--black);
  font-weight: 500;
}

.settings-sidebar .active a {
  color: var(--green);
}

.settings-sidebar .danger a {
  color: red;
}

.settings-main {
  flex: 1;
}

.settings-card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem 1.5rem;
  margin-bottom: 1.5rem;
  position: relative;
}

.profile-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.profile-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-body {
  margin-top: 1rem;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.btn-edit {
  background: var(--green);
  color: var(--white);
  border: none;
  padding: 0.4rem 0.8rem;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 0.85rem;
}

.btn-edit:hover {
  background: var(--teal);
}

.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal form {
  background: white;
  padding: 2rem;
  border-radius: 8px;
  min-width: 400px;
  max-width: 600px;
}

.btn-save {
  background: var(--green);
  color: white;
  border: none;
  padding: .5rem 1rem;
  border-radius: var(--radius);
  cursor: pointer;
}

.btn-save:hover {
  background: var(--teal);
}

.btn-close {
  background: #ccc;
  color: black;
  border: none;
  padding: .5rem 1rem;
  border-radius: var(--radius);
  cursor: pointer;
}

/*form modales*/

/* Overlay */
.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.modal.show {
  opacity: 1;
  pointer-events: all;
}

/* Contenu modal */
.modal form {
  background: #fff;
  padding: 2rem;
  border-radius: 12px;
  min-width: 380px;
  max-width: 600px;
  width: 100%;
  box-shadow: 0 8px 30px rgba(0,0,0,0.2);
  transform: translateY(-30px);
  transition: transform 0.3s ease;
}

.modal.show form {
  transform: translateY(0);
}

/* Titre modal */
.modal h3 {
  margin-top: 0;
  margin-bottom: 1rem;
  font-size: 1.3rem;
  font-weight: 600;
  color: #333;
  border-bottom: 1px solid #eee;
  padding-bottom: .5rem;
}

/* Champs du formulaire */
.modal form input,
.modal form textarea,
.modal form select {
  width: 100%;
  padding: 0.6rem 0.8rem;
  margin-bottom: 1rem;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 0.95rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.modal form input:focus,
.modal form textarea:focus,
.modal form select:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(0,150,100,0.15);
  outline: none;
}

/* Boutons */
.modal .btn-save {
  background: var(--green);
  color: white;
  border: none;
  padding: 0.6rem 1.2rem;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.95rem;
  transition: background 0.2s;
}

.modal .btn-save:hover {
  background: var(--teal);
}

.modal .btn-close {
  background: #eee;
  color: #333;
  border: none;
  padding: 0.6rem 1.2rem;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.95rem;
  transition: background 0.2s;
}

.modal .btn-close:hover {
  background: #ddd;
}

/* Footer boutons */
.modal .form-footer {
  margin-top: 1rem;
  display: flex;
  justify-content: flex-end;
  gap: 0.8rem;
}

</style>

<script>
document.querySelectorAll('.btn-edit').forEach(btn => {
  btn.addEventListener('click', function () {
    let section = this.dataset.section;

    fetch(`/settings/edit/${section}`)
      .then(res => res.text())
      .then(html => {
let modal = document.createElement('div');
modal.classList.add('modal');
modal.innerHTML = html;
document.body.appendChild(modal);

setTimeout(() => modal.classList.add("show"), 20);

        const form = modal.querySelector('#ajaxForm');
        const saveBtn = form.querySelector('.btn-save');
        const closeBtn = modal.querySelector('.btn-close');

        // Fermer modal (clic dehors ou ESC)
        modal.addEventListener('click', e => {
          if (e.target === modal) modal.remove();
        });
        document.addEventListener('keydown', e => {
          if (e.key === "Escape") modal.remove();
        });

        // Focus sur premier champ
        const firstInput = form.querySelector('input, textarea, select');
        if (firstInput) firstInput.focus();

        // Soumission AJAX
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          let formData = new FormData(this);

          // Loader
          saveBtn.disabled = true;
          saveBtn.textContent = "⏳ Saving...";

          fetch(`/settings/edit/${section}`, {
            method: 'POST',
            body: formData
          })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                if (section === "avatar") {
                  // remplacer avatar + forcer reload
                  const avatarImg = document.querySelector('#profileAvatar');
                  if (avatarImg) {
                    let newSrc = avatarImg.src.split('?')[0] + "?v=" + Date.now();
                    avatarImg.src = newSrc;
                  }
                  document.querySelector('.profile-card').innerHTML = data.html;
                } else {
                  btn.closest('.settings-card')
                     .querySelector('.card-body').outerHTML = data.html;
                }

                // Toast de confirmation
                showToast("✔️ Changes saved successfully");
                modal.remove();
              }
            })
            .finally(() => {
              saveBtn.disabled = false;
              saveBtn.textContent = "💾 Save";
            });
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', () => modal.remove());
        }
      });
  });
});

// Toast function
function showToast(message) {
  const toast = document.createElement("div");
  toast.className = "toast";
  toast.textContent = message;
  document.body.appendChild(toast);

  setTimeout(() => toast.classList.add("show"), 50);
  setTimeout(() => toast.classList.remove("show"), 2500);
  setTimeout(() => toast.remove(), 3000);
}


</script>

{% endblock %}
