            transition: all 0.3s;
            border: none;
            font-size: 1rem;
            font-weight: 600;
        }

        .floating-cta-button:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(13, 131, 131, 0.5);
        }

