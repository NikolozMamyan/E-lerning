        /* Scroll Progress Bar */
        .progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--teal), var(--green));
            z-index: 9999;
            transition: width 0.1s;
        }

        /* Mobile Menu Toggle */
        .mobile-menu-toggle {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 0.5rem;
        }

        .mobile-menu-toggle span {
            width: 25px;
            height: 3px;
            background: var(--teal);
            border-radius: 2px;
            transition: all 0.3s;
        }

        .mobile-menu-toggle.active span:nth-child(1) {
            transform: rotate(45deg) translate(8px, 8px);
        }

        .mobile-menu-toggle.active span:nth-child(2) {
            opacity: 0;
        }

        .mobile-menu-toggle.active span:nth-child(3) {
            transform: rotate(-45deg) translate(8px, -8px);
        }

        /* Process Section - NOUVEAU */
        .process {
            max-width: 1400px;
            margin: 7rem auto;
            padding: 0 2rem;
        }

        .process-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .process-header h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .process-header p {
            font-size: 1.2rem;
            color: var(--grey);
        }

        .process-steps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            position: relative;
        }

        .process-steps::before {
            content: '';
            position: absolute;
            top: 50px;
            left: 10%;
            right: 10%;
            height: 2px;
            background: linear-gradient(90deg, var(--mint), var(--teal), var(--green), var(--mint));
            z-index: 0;
        }

        .process-step {
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .process-step-number {
            width: 100px;
            height: 100px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, var(--teal), var(--green));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 2.5rem;
            font-weight: 800;
            box-shadow: 0 8px 25px rgba(13, 131, 131, 0.3);
            position: relative;
        }

        .process-step-number::before {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--mint);
            z-index: -1;
            opacity: 0.3;
        }

        .process-step h3 {
            font-size: 1.4rem;
            margin-bottom: 1rem;
            color: var(--black);
            font-weight: 700;
        }

        .process-step p {
            color: var(--grey);
            font-size: 1rem;
            line-height: 1.7;
        }

        /* Certifications Section - NOUVEAU */
        .certifications {
            background: linear-gradient(135deg, var(--mint), var(--white));
            padding: 5rem 2rem;
            margin: 7rem 0;
        }

        .certifications-content {
            max-width: 1400px;
            margin: 0 auto;
            text-align: center;
        }

        .certifications h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .certifications p {
            font-size: 1.2rem;
            color: var(--grey);
            margin-bottom: 3rem;
        }

        .certifications-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .certification-badge {
            background: var(--white);
            padding: 2.5rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: all 0.3s;
        }

        .certification-badge:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
        }

        .certification-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, var(--teal), var(--green));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .certification-icon svg {
            width: 40px;
            height: 40px;
            fill: var(--white);
        }

        .certification-badge h4 {
            font-size: 1.1rem;
            color: var(--black);
            font-weight: 700;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .hero {
                grid-template-columns: 1fr;
                gap: 3rem;
            }

            .hero-content h1 {
                font-size: 3rem;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .testimonials-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 968px) {
            nav {
                display: none;
            }

            .mobile-menu-toggle {
                display: flex;
            }

            .hero-content h1 {
                font-size: 2.5rem;
            }

            .modules-preview {
                grid-template-columns: 1fr;
            }

            .stats-container {
                grid-template-columns: repeat(2, 1fr);
                padding: 2.5rem 2rem;
            }

            .benefits-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .process-steps {
                grid-template-columns: 1fr;
            }

            .process-steps::before {
                display: none;
            }

            .certifications-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .section-title {
                font-size: 2.2rem;
            }

            .cta-section h2 {
                font-size: 2rem;
            }
        }

        @media (max-width: 640px) {
            .hero-content h1 {
                font-size: 2rem;
            }

            .benefits-grid {
                grid-template-columns: 1fr;
            }

            .stats-container {
                grid-template-columns: 1fr;
            }

            .cta-section h2 {
                font-size: 1.8rem;
            }

            .certifications-grid {
                grid-template-columns: 1fr;
            }

            .cta-buttons {
                flex-direction: column;
            }

            .cta-button {
                width: 100%;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeInUp 0.6s ease-out;
        }

        /* Floating CTA Button */
        .floating-cta {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 999;
            opacity: 0;
            transform: translateY(100px);
            transition: all 0.4s;
        }

        .floating-cta.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .floating-cta-button {
            background: linear-gradient(135deg, var(--green), var(--teal));
            color: var(--white);
            padding: 1rem 2rem;
            border-radius: 50px;
            box-shadow: 0 8px 30px rgba(13, 131, 131, 0.4);
            display: flex;
            align-items: center;
