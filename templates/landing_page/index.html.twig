{% extends 'base_auth.html.twig' %}

{% block title %}Compliance E-learning Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Professional e-learning in Luxembourg for AML/CFT, compliance, risk, GDPR and cybersecurity. Train teams online, track progress and issue certificates.{% endblock %}
{% block meta_robots %}index, follow, max-image-preview:large, max-snippet:-1{% endblock %}
{% block canonical_url %}{{ url('app_landing_page') }}{% endblock %}
{% block meta_image %}{{ absolute_url(asset('images/logo.png')) }}{% endblock %}
{% block body_class %}landing-document{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/landing.css') }}">
{% endblock %}

{% block structured_data %}
  {% set seoGraph = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'EducationalOrganization',
        '@id': url('app_landing_page') ~ '#organization',
        'name': 'Les Consultants E-learning',
        'url': url('app_landing_page'),
        'logo': absolute_url(asset('images/logo.png')),
        'description': 'Luxembourg professional e-learning platform for compliance, AML/CFT, risk, GDPR and cybersecurity training.',
        'email': 'pruffin@les-consultants.lu',
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Luxembourg',
          'addressCountry': 'LU'
        },
        'areaServed': ['Luxembourg', 'European Union', 'Worldwide']
      },
      {
        '@type': 'WebSite',
        '@id': url('app_landing_page') ~ '#website',
        'name': 'Les Consultants E-learning',
        'url': url('app_landing_page'),
        'publisher': {'@id': url('app_landing_page') ~ '#organization'},
        'inLanguage': ['en', 'fr']
      }
    ]
  } %}
  <script type="application/ld+json">{{ seoGraph|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block body %}
{% set featuredCourse = courses|first %}
<div class="landing-page">
  <header class="landing-header">
    <div class="landing-header__inner">
      <a href="{{ path('app_landing_page') }}" class="landing-brand" aria-label="Les Consultants E-learning home">
        <img src="{{ asset('images/logo.png') }}" alt="Les Consultants E-learning">
        <span><strong>Les Consultants</strong><small>E-learning Luxembourg</small></span>
      </a>

      <nav class="landing-nav" aria-label="Primary navigation">
        <a href="{{ path('app_public_catalog') }}">Courses</a>
        <a href="#solutions">Solutions</a>
        <a href="#community">Community</a>
        <a href="#process">How it works</a>
        <a href="#faq">FAQ</a>
      </nav>

      <div class="landing-header__actions">
        <a href="https://form.jotform.com/253131874206453" target="_blank" rel="noopener noreferrer" class="landing-header__quiz">
          Knowledge quiz <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
        <a href="{{ path('show_login') }}" class="landing-button landing-button--ghost">Sign in</a>
        <a href="{{ path('show_register') }}" class="landing-button landing-button--primary">Start learning</a>
      </div>

      <details class="landing-mobile-menu">
        <summary aria-label="Open navigation"><i class="fa-solid fa-bars" aria-hidden="true"></i></summary>
        <nav aria-label="Mobile navigation">
          <a href="{{ path('app_public_catalog') }}">Courses</a>
          <a href="#solutions">Solutions</a>
          <a href="#community">Community</a>
          <a href="#process">How it works</a>
          <a href="#faq">FAQ</a>
          <a href="{{ path('show_login') }}">Sign in</a>
          <a href="{{ path('show_register') }}">Create an account</a>
        </nav>
      </details>
    </div>
  </header>

  <main>
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="landing-hero__copy">
        <span class="landing-eyebrow"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>Built for Luxembourg. Ready for global teams.</span>
        <h1 id="landing-title">Professional compliance training that teams actually complete.</h1>
        <p>One digital learning space for AML/CFT, Compliance, Risk, GDPR and Cybersecurity — with multilingual courses, clear progress tracking and verifiable completion certificates.</p>

        <div class="landing-hero__actions">
          <a href="mailto:pruffin@les-consultants.lu?subject=Request%20a%20Demo%20-%20Les%20Consultants%20E-learning" class="landing-button landing-button--primary landing-button--large">
            Request a free demo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
          <a href="{{ path('app_public_catalog') }}" class="landing-button landing-button--secondary landing-button--large">Explore courses</a>
        </div>

        <div class="landing-hero__proof" aria-label="Platform highlights">
          <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><strong>Luxembourg-focused</strong><small>Local regulatory context</small></span>
          <span><i class="fa-solid fa-language" aria-hidden="true"></i><strong>Multilingual</strong><small>English, French and more</small></span>
          <span><i class="fa-solid fa-clock" aria-hidden="true"></i><strong>Available 24/7</strong><small>Learn at your own pace</small></span>
        </div>
      </div>

      <div class="landing-hero__visual" aria-label="Learning platform preview">
        <div class="landing-preview">
          <div class="landing-preview__topbar">
            <span><i></i><i></i><i></i></span>
            <strong>Team learning space</strong>
            <i class="fa-regular fa-bell" aria-hidden="true"></i>
          </div>
          <div class="landing-preview__content">
            <div class="landing-preview__course">
              <div class="landing-preview__cover"{% if featuredCourse %} style="--landing-cover: url('{{ asset(featuredCourse.thumb ? 'uploads/courses/' ~ featuredCourse.thumb : 'card.png') }}')"{% endif %}>
                <span class="landing-preview__play"><i class="fa-solid fa-play" aria-hidden="true"></i></span>
                <small>Featured learning</small>
              </div>
              <div class="landing-preview__course-copy">
                <span>Compliance essentials</span>
                <h2>{{ featuredCourse ? featuredCourse.title : 'Build practical knowledge at your own pace' }}</h2>
                <div><small>Course progress</small><strong>68%</strong></div>
                <span class="landing-preview__progress"><i></i></span>
              </div>
            </div>
            <aside class="landing-preview__rail">
              <div><i class="fa-solid fa-fire" aria-hidden="true"></i><strong>6 days</strong><small>learning streak</small></div>
              <div><i class="fa-solid fa-award" aria-hidden="true"></i><strong>3</strong><small>certificates</small></div>
            </aside>
          </div>
        </div>
        <span class="landing-preview-note landing-preview-note--top"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Learning active</span>
        <span class="landing-preview-note landing-preview-note--bottom"><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><strong>Progress saved</strong><small>Continue on any device</small></span>
      </div>
    </section>

    <section class="landing-sectors" aria-label="Industries served">
      <span>Trusted learning for</span>
      <div>
        <strong>Banking</strong><strong>Insurance</strong><strong>ManCo &amp; AIFM</strong><strong>Fintech</strong><strong>Audit &amp; Accounting</strong>
      </div>
    </section>

    <section class="landing-section landing-courses" id="courses">
      <header class="landing-section__heading">
        <div>
          <span class="landing-eyebrow"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Professional learning catalogue</span>
          <h2>Courses designed around real regulatory challenges</h2>
          <p>Practical learning developed for professionals working in Luxembourg and international regulated environments.</p>
        </div>
        <a href="{{ path('app_public_catalog') }}" class="landing-text-link">View the full catalogue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </header>

      <div class="landing-course-grid">
        {% for course in courses %}
          <article class="landing-course-card">
            <a href="{{ path('app_public_course_show', {id: course.id, slug: course.slug}) }}" class="landing-course-card__media" aria-label="View {{ course.title }}">
              <img src="{{ asset(course.thumb ? 'uploads/courses/' ~ course.thumb : 'card.png') }}" alt="{{ course.title }} online training course" loading="lazy">
              <span><i class="fa-solid fa-play" aria-hidden="true"></i>{{ course.videos|length }} lesson{{ course.videos|length == 1 ? '' : 's' }}</span>
            </a>
            <div class="landing-course-card__body">
              <span class="landing-course-card__category">{{ course.category ? course.category.name : 'Professional training' }}</span>
              <h3><a href="{{ path('app_public_course_show', {id: course.id, slug: course.slug}) }}">{{ course.title }}</a></h3>
              <p>{{ course.description|striptags|slice(0, 125) }}{% if course.description|striptags|length > 125 %}&hellip;{% endif %}</p>
              <footer>
                <span><i class="fa-solid fa-award" aria-hidden="true"></i>Certificate included</span>
                <a href="{{ path('app_public_course_show', {id: course.id, slug: course.slug}) }}" aria-label="Open {{ course.title }}"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
              </footer>
            </div>
          </article>
        {% else %}
          <div class="landing-empty"><i class="fa-solid fa-book-open" aria-hidden="true"></i><p>New professional courses are being prepared.</p></div>
        {% endfor %}
      </div>
    </section>

    <section class="landing-section landing-community" id="community">
      <header class="landing-section__heading">
        <div>
          <span class="landing-eyebrow"><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>Trending in the community</span>
          <h2>Learning continues beyond the course</h2>
          <p>Explore practical insights, regulatory updates and conversations shared by our learning community.</p>
        </div>
        <a href="{{ path('article_feed', {filter: 'popular'}) }}" class="landing-text-link">Open community feed <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </header>

      <div class="landing-trending-grid">
        {% for article in trendingArticles %}
          <article class="landing-trend-card">
            {% if article.image %}
              <a href="{{ path('app_public_article', {id: article.id, slug: article.slug}) }}" class="landing-trend-card__media">
                <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="{{ article.titre }}" loading="lazy">
                <span><i class="fa-solid fa-fire" aria-hidden="true"></i>Trending</span>
              </a>
            {% else %}
              <a href="{{ path('app_public_article', {id: article.id, slug: article.slug}) }}" class="landing-trend-card__media landing-trend-card__media--placeholder" aria-label="Read {{ article.titre }}">
                <i class="fa-solid fa-comments" aria-hidden="true"></i><span>Community insight</span>
              </a>
            {% endif %}
            <div class="landing-trend-card__body">
              <div class="landing-trend-card__author">
                {% if 'ROLE_ADMIN' not in article.author.roles %}
                  <a href="{{ path('app_public_profile', {id: article.author.id}) }}">
                    <img src="{{ asset(article.author.avatar ? 'uploads/avatars/' ~ article.author.avatar : 'images/User.svg') }}" alt="">
                    <span><strong>{{ article.author.userName }}</strong><small>{{ article.createdAt|date('d M Y') }}</small></span>
                  </a>
                {% else %}
                  <div class="landing-trend-card__identity">
                    <img src="{{ asset(article.author.avatar ? 'uploads/avatars/' ~ article.author.avatar : 'images/User.svg') }}" alt="">
                    <span><strong>{{ article.author.userName }}</strong><small>{{ article.createdAt|date('d M Y') }}</small></span>
                  </div>
                {% endif %}
                <span><i class="fa-solid fa-earth-europe" aria-hidden="true"></i>Public</span>
              </div>
              <h3><a href="{{ path('app_public_article', {id: article.id, slug: article.slug}) }}">{{ article.titre }}</a></h3>
              <p>{{ article.description|striptags|slice(0, 145) }}{% if article.description|striptags|length > 145 %}&hellip;{% endif %}</p>
              <footer>
                <span><i class="fa-regular fa-heart" aria-hidden="true"></i>{{ article.likesCount }}</span>
                <span><i class="fa-regular fa-comment" aria-hidden="true"></i>{{ article.comments|length }}</span>
                <a href="{{ path('app_public_article', {id: article.id, slug: article.slug}) }}">Read conversation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
              </footer>
            </div>
          </article>
        {% else %}
          <div class="landing-empty"><i class="fa-regular fa-comments" aria-hidden="true"></i><p>The first community conversations will appear here.</p></div>
        {% endfor %}
      </div>
    </section>

    <section class="landing-section landing-solutions" id="solutions">
      <header class="landing-section__heading landing-section__heading--center">
        <div>
          <span class="landing-eyebrow"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>A complete learning solution</span>
          <h2>Built for learners, managers and compliance teams</h2>
          <p>Flexible delivery, transparent tracking and content grounded in the Luxembourg regulatory environment.</p>
        </div>
      </header>

      <div class="landing-feature-grid">
        <article><span>01</span><i class="fa-solid fa-sliders" aria-hidden="true"></i><h3>Flexible à la carte access</h3><p>Select only the modules you need and expand your training plan as priorities evolve.</p></article>
        <article><span>02</span><i class="fa-solid fa-infinity" aria-hidden="true"></i><h3>12-month subscription</h3><p>Give teams unlimited access to the learning catalogue with clear and predictable pricing.</p></article>
        <article><span>03</span><i class="fa-solid fa-user-tie" aria-hidden="true"></i><h3>15+ years of expertise</h3><p>Training shaped by experienced professionals in Compliance, Risk, GDPR and Cybersecurity.</p></article>
        <article><span>04</span><i class="fa-solid fa-location-dot" aria-hidden="true"></i><h3>Made for Luxembourg</h3><p>Content adapted to local requirements and the CSSF, CAA, CNPD, IRE and OEC environment.</p></article>
        <article><span>05</span><i class="fa-solid fa-chart-line" aria-hidden="true"></i><h3>Team progress tracking</h3><p>Manager dashboards, real-time progress, certificates and training completion reporting.</p></article>
        <article><span>06</span><i class="fa-solid fa-language" aria-hidden="true"></i><h3>Multilingual delivery</h3><p>English and French learning experiences, with additional languages available for teams.</p></article>
      </div>

      <div class="landing-stats" aria-label="Les Consultants E-learning figures">
        <div><strong>30+</strong><span>client companies</span></div>
        <div><strong>15+</strong><span>years of expertise</span></div>
        <div><strong>30+</strong><span>learning modules</span></div>
        <div><strong>98%</strong><span>satisfaction</span></div>
      </div>
    </section>

    <section class="landing-section landing-video">
      <div class="landing-video__copy">
        <span class="landing-eyebrow"><i class="fa-solid fa-circle-play" aria-hidden="true"></i>Inside our learning experience</span>
        <h2>A clearer way to build professional knowledge</h2>
        <p>Discover our vision, our learning approach and the digital environment created for professionals and their teams.</p>
        <ul>
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Accessible on every device</li>
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Progress saved automatically</li>
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Certificates and learning records</li>
        </ul>
      </div>
      <div class="landing-video__player">
        <iframe src="https://player.vimeo.com/video/1135225496?h=f203faa575&amp;badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" title="Les Consultants E-learning platform presentation" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
      </div>
    </section>

    <section class="landing-section landing-process" id="process">
      <header class="landing-section__heading landing-section__heading--center">
        <div>
          <span class="landing-eyebrow"><i class="fa-solid fa-route" aria-hidden="true"></i>Simple onboarding</span>
          <h2>From training needs to verified completion</h2>
          <p>A straightforward four-step process for deploying professional learning across your organisation.</p>
        </div>
      </header>
      <ol>
        <li><span>01</span><div><h3>Free consultation</h3><p>We assess your needs and recommend the most relevant modules.</p></div></li>
        <li><span>02</span><div><h3>Custom configuration</h3><p>We configure the platform and prepare access for your employees.</p></div></li>
        <li><span>03</span><div><h3>Training and support</h3><p>Your teams learn 24/7 with a clear and guided experience.</p></div></li>
        <li><span>04</span><div><h3>Tracking and certification</h3><p>Monitor completion and generate certificates and reports.</p></div></li>
      </ol>
    </section>

    <section class="landing-section landing-faq" id="faq">
      <header class="landing-section__heading landing-section__heading--center">
        <div>
          <span class="landing-eyebrow"><i class="fa-regular fa-circle-question" aria-hidden="true"></i>Frequently asked questions</span>
          <h2>Everything you need to start</h2>
          <p>Answers about our Luxembourg e-learning platform and professional training services.</p>
        </div>
      </header>
      <div class="landing-faq__list">
        <details><summary>What types of training do you offer?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>We offer professional e-learning courses in AML/CFT, Compliance, Risk, GDPR and Cybersecurity.</p></details>
        <details><summary>How does the à la carte option work?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>Select and pay only for the modules you need, with the freedom to add more training later.</p></details>
        <details><summary>How does the subscription work?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>A 12-month subscription gives your teams access to the learning catalogue at a fixed price.</p></details>
        <details><summary>Do courses include certificates?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>Yes. Successful course completion can generate a certificate and a verifiable learning record.</p></details>
        <details><summary>Can managers track team progress?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>Yes. Manager dashboards provide progress tracking and centralised completion information.</p></details>
        <details><summary>How long do courses take?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>Course duration generally ranges from 20 minutes to 2 hours, depending on the module.</p></details>
        <details><summary>Can we test the platform first?<i class="fa-solid fa-plus" aria-hidden="true"></i></summary><p>Yes. Request a free demo to explore the learning experience before making a decision.</p></details>
      </div>
    </section>

    <section class="landing-cta">
      <div>
        <span class="landing-eyebrow"><i class="fa-solid fa-rocket" aria-hidden="true"></i>Ready when your team is</span>
        <h2>Make compliance learning easier to access, follow and complete.</h2>
        <p>Tell us about your team and receive a training recommendation tailored to your organisation.</p>
      </div>
      <div>
        <a href="mailto:pruffin@les-consultants.lu?subject=Request%20a%20Demo%20-%20Les%20Consultants%20E-learning" class="landing-button landing-button--primary landing-button--large">Request a free demo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <a href="{{ path('show_register') }}" class="landing-button landing-button--light landing-button--large">Create an account</a>
      </div>
    </section>
  </main>

  <footer class="landing-footer">
    <div class="landing-footer__main">
      <a href="{{ path('app_landing_page') }}" class="landing-brand">
        <img src="{{ asset('images/logo.png') }}" alt="Les Consultants E-learning">
        <span><strong>Les Consultants</strong><small>E-learning Luxembourg</small></span>
      </a>
      <p>Professional digital learning for regulated teams in Luxembourg and beyond.</p>
      <nav aria-label="Footer navigation">
        <a href="#courses">Courses</a><a href="{{ path('article_feed') }}">Community feed</a><a href="#faq">FAQ</a><a href="{{ path('show_login') }}">Sign in</a>
      </nav>
    </div>
    <div class="landing-footer__bottom">
      <span>&copy; {{ 'now'|date('Y') }} Les Consultants. All rights reserved.</span>
      <span>Made in Luxembourg <i class="fa-solid fa-heart" aria-hidden="true"></i></span>
    </div>
  </footer>
</div>
{% endblock %}
