{% extends 'base.html.twig' %}

{% block title %}Password setup invitations{% endblock %}

{% block stylesheets %}
<style>
.password-mail-container { min-height: 100vh; padding: 2rem 0; }
.mail-header, .mail-card, .mail-users-panel {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}
.mail-header { padding: 2rem; margin-bottom: 1.5rem; }
.mail-header h1 { margin: 0 0 .5rem; font-size: 1.75rem; }
.mail-header p { margin: 0; color: var(--grey); }
.back-link { display: inline-block; margin-bottom: 1rem; color: var(--teal); font-weight: 600; text-decoration: none; }
.mail-layout { display: grid; grid-template-columns: minmax(320px, 380px) minmax(0, 1fr); gap: 1.5rem; }
.mail-users-panel { overflow: hidden; position: sticky; top: 2rem; align-self: start; }
.panel-header {
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, var(--green), var(--teal));
    color: white;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.panel-body { padding: 1rem; }
.search-input, .mail-input, .mail-textarea {
    box-sizing: border-box;
    width: 100%;
    border: 2px solid var(--mint);
    border-radius: var(--radius);
    padding: .85rem 1rem;
    background: #fff;
}
.mail-input, .mail-textarea { margin-top: .4rem; }
.mail-textarea { min-height: 220px; resize: vertical; }
.users-list { max-height: 65vh; overflow-y: auto; margin-top: 1rem; }
.user-item {
    border: 1px solid #e7efe9;
    border-radius: 14px;
    padding: .85rem 1rem;
    cursor: pointer;
    transition: .2s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}
.user-item + .user-item { margin-top: .75rem; }
.user-item:hover { border-color: var(--teal); background: #f5fffb; }
.user-item.selected { border-color: var(--teal); background: linear-gradient(90deg, rgba(94, 210, 176, .22), rgba(94, 210, 176, 0)); }
.user-meta { min-width: 0; }
.user-email { font-weight: 600; word-break: break-word; }
.user-name { color: var(--grey); font-size: .92rem; }
.mail-card { padding: 1.5rem; }
.mail-grid { display: grid; gap: 1.25rem; }
.field-label { display: block; font-weight: 600; color: var(--black); }
.helper-text { margin: .35rem 0 0; color: var(--grey); font-size: .92rem; }
.security-note {
    display: flex;
    gap: .8rem;
    padding: 1rem;
    border-radius: 14px;
    background: #f1faf7;
    color: var(--green);
    line-height: 1.45;
}
.selection-box { border: 1px solid #e7efe9; border-radius: 16px; padding: 1rem; background: #fbfdfc; }
.selection-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .75rem; }
.selection-count { font-weight: 700; color: var(--green); }
.chip-list { display: flex; flex-wrap: wrap; gap: .5rem; }
.chip { display: inline-flex; padding: .45rem .75rem; border-radius: 999px; background: var(--mint); color: var(--green); font-size: .92rem; }
.empty-state { color: var(--grey); font-size: .95rem; }
.preview-card { border: 1px solid #e7efe9; border-radius: 16px; padding: 1.25rem; background: #f4f9f8; }
.preview-card h3 { margin: 0 0 1rem; color: var(--green); }
.preview-message { color: var(--grey); white-space: pre-wrap; line-height: 1.5; }
.preview-button { display: inline-block; margin-top: 1rem; padding: .7rem 1.2rem; border-radius: 8px; background: var(--green); color: white; font-weight: 600; }
.mail-actions { display: flex; justify-content: flex-end; gap: .75rem; }
.btn-primary-mail, .btn-secondary-mail { border: 0; border-radius: var(--radius); padding: .9rem 1.25rem; cursor: pointer; font-weight: 600; }
.btn-primary-mail { background: var(--teal); color: white; }
.btn-primary-mail:disabled { opacity: .55; cursor: not-allowed; }
.btn-secondary-mail { background: var(--mint); color: var(--green); }
.confirmation-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    place-items: center;
    padding: 1rem;
    background: rgba(7, 23, 23, .62);
}
.confirmation-backdrop.open { display: grid; }
.confirmation-dialog { width: min(100%, 480px); padding: 2rem; border-radius: var(--radius); background: white; box-shadow: var(--shadow); }
.confirmation-dialog h2 { margin: 0 0 .75rem; }
.confirmation-dialog p { color: var(--grey); line-height: 1.5; }
.confirmation-actions { display: flex; justify-content: flex-end; gap: .75rem; margin-top: 1.5rem; }
@media (max-width: 991px) {
    .mail-layout { grid-template-columns: 1fr; }
    .mail-users-panel { position: static; }
}
</style>
{% endblock %}

{% block body %}
<div class="password-mail-container">
    <a class="back-link" href="{{ path('admin_email_choice') }}">&larr; Back to email centre</a>

    <header class="mail-header">
        <h1>Password setup invitations</h1>
        <p>Select users and write the message that will accompany their individual password setup link.</p>
    </header>

    <form method="post" id="password-mail-form">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_password_setup_email') }}">

        <div class="mail-layout">
            <aside class="mail-users-panel">
                <div class="panel-header">
                    <span>Users</span>
                    <span>{{ users|length }}</span>
                </div>
                <div class="panel-body">
                    <input type="search" id="user-search" class="search-input" placeholder="Search by email or name...">

                    <div class="users-list" id="users-list">
                        {% for user in users %}
                            <div
                                class="user-item"
                                data-user-id="{{ user.id }}"
                                data-user-email="{{ user.email|lower }}"
                                data-user-email-label="{{ user.email }}"
                                data-user-name="{{ (user.username ?? '')|lower }}"
                            >
                                <div class="user-meta">
                                    <div class="user-email">{{ user.email }}</div>
                                    <div class="user-name">{{ user.username ?: 'No name' }}</div>
                                </div>
                                <input type="checkbox" class="user-checkbox" value="{{ user.id }}" aria-label="Select {{ user.email }}">
                            </div>
                        {% else %}
                            <p class="empty-state">No users available.</p>
                        {% endfor %}
                    </div>
                </div>
            </aside>

            <section class="mail-card">
                <div class="mail-grid">
                    <div class="selection-box">
                        <div class="selection-header">
                            <span class="selection-count"><span id="selected-users-count">0</span> recipient(s) selected</span>
                            <button type="button" class="btn-secondary-mail" id="clear-users-btn">Clear selection</button>
                        </div>
                        <div class="chip-list" id="selected-users-feedback">
                            <span class="empty-state">No users selected.</span>
                        </div>
                    </div>

                    <div class="security-note">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        <span>Each recipient receives a different personal link. The link expires after 74 hours and can only be used once.</span>
                    </div>

                    <div>
                        <label for="subject" class="field-label">Subject</label>
                        <input type="text" id="subject" name="subject" class="mail-input" maxlength="255" value="{{ subject }}" required>
                    </div>

                    <div>
                        <label for="message" class="field-label">Message</label>
                        <textarea id="message" name="message" class="mail-textarea" maxlength="10000" placeholder="Write your invitation message here..." required>{{ message }}</textarea>
                        <p class="helper-text">The greeting, password button, expiry information and signature are added automatically.</p>
                    </div>

                    <div class="preview-card" aria-live="polite">
                        <h3>Email preview</h3>
                        <strong>Dear [First name],</strong>
                        <div class="preview-message" id="preview-message">Your message will appear here.</div>
                        <span class="preview-button">Set my password</span>
                    </div>

                    <div id="selected-user-inputs"></div>

                    <div class="mail-actions">
                        <button type="button" class="btn-secondary-mail" id="reset-form-btn">Reset</button>
                        <button type="submit" class="btn-primary-mail" id="submit-mail-btn" disabled>Review and send</button>
                    </div>
                </div>
            </section>
        </div>
    </form>
</div>

<div class="confirmation-backdrop" id="confirmation-backdrop" role="presentation">
    <div class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmation-title">
        <h2 id="confirmation-title">Confirm invitation delivery</h2>
        <p>You are about to send <strong id="confirmation-count">0</strong> individual password setup invitation(s). Each recipient will receive a unique personal link.</p>
        <div class="confirmation-actions">
            <button type="button" class="btn-secondary-mail" id="cancel-send-btn">Cancel</button>
            <button type="button" class="btn-primary-mail" id="confirm-send-btn">Send invitations</button>
        </div>
    </div>
</div>

<script>
const preselectedUserIds = {{ preselectedUserIds|json_encode|raw }};
const selectedUsers = new Map();
const form = document.getElementById('password-mail-form');
const selectedUserInputs = document.getElementById('selected-user-inputs');
const selectedUsersFeedback = document.getElementById('selected-users-feedback');
const selectedUsersCount = document.getElementById('selected-users-count');
const submitButton = document.getElementById('submit-mail-btn');
const messageInput = document.getElementById('message');
const previewMessage = document.getElementById('preview-message');
const searchInput = document.getElementById('user-search');
const confirmationBackdrop = document.getElementById('confirmation-backdrop');
let deliveryConfirmed = false;

function renderSelection() {
    selectedUserInputs.innerHTML = '';
    selectedUsersFeedback.innerHTML = '';
    selectedUsersCount.textContent = String(selectedUsers.size);
    submitButton.disabled = selectedUsers.size === 0;

    if (selectedUsers.size === 0) {
        selectedUsersFeedback.innerHTML = '<span class="empty-state">No users selected.</span>';
        return;
    }

    selectedUsers.forEach((user) => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'user_ids[]';
        input.value = user.id;
        selectedUserInputs.appendChild(input);

        const chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = user.email;
        selectedUsersFeedback.appendChild(chip);
    });
}

function setUserSelected(item, selected) {
    const checkbox = item.querySelector('.user-checkbox');
    const id = Number(item.dataset.userId);
    checkbox.checked = selected;
    item.classList.toggle('selected', selected);

    if (selected) {
        selectedUsers.set(id, { id, email: item.dataset.userEmailLabel });
    } else {
        selectedUsers.delete(id);
    }

    renderSelection();
}

document.querySelectorAll('.user-item').forEach((item) => {
    const checkbox = item.querySelector('.user-checkbox');

    item.addEventListener('click', (event) => {
        if (event.target !== checkbox) {
            setUserSelected(item, !checkbox.checked);
        }
    });

    checkbox.addEventListener('click', (event) => event.stopPropagation());
    checkbox.addEventListener('change', () => setUserSelected(item, checkbox.checked));

    if (preselectedUserIds.includes(Number(item.dataset.userId))) {
        setUserSelected(item, true);
    }
});

document.getElementById('clear-users-btn').addEventListener('click', () => {
    document.querySelectorAll('.user-item').forEach((item) => setUserSelected(item, false));
});

document.getElementById('reset-form-btn').addEventListener('click', () => {
    document.getElementById('subject').value = 'Set up your password';
    messageInput.value = '';
    searchInput.value = '';
    document.querySelectorAll('.user-item').forEach((item) => {
        setUserSelected(item, false);
        item.style.display = 'flex';
    });
    renderPreview();
});

function renderPreview() {
    previewMessage.textContent = messageInput.value.trim() || 'Your message will appear here.';
}

messageInput.addEventListener('input', renderPreview);

searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    document.querySelectorAll('.user-item').forEach((item) => {
        const matches = item.dataset.userEmail.includes(query) || item.dataset.userName.includes(query);
        item.style.display = matches ? 'flex' : 'none';
    });
});

form.addEventListener('submit', (event) => {
    if (deliveryConfirmed) {
        return;
    }

    event.preventDefault();
    if (!form.reportValidity() || selectedUsers.size === 0) {
        return;
    }

    document.getElementById('confirmation-count').textContent = String(selectedUsers.size);
    confirmationBackdrop.classList.add('open');
    document.getElementById('cancel-send-btn').focus();
});

function closeConfirmation() {
    confirmationBackdrop.classList.remove('open');
}

document.getElementById('cancel-send-btn').addEventListener('click', closeConfirmation);
document.getElementById('confirm-send-btn').addEventListener('click', () => {
    deliveryConfirmed = true;
    closeConfirmation();
    form.requestSubmit();
});

confirmationBackdrop.addEventListener('click', (event) => {
    if (event.target === confirmationBackdrop) {
        closeConfirmation();
    }
});

document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
        closeConfirmation();
    }
});

renderSelection();
renderPreview();
</script>
{% endblock %}
