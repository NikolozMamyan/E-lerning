<!-- Header -->
<style>

/* Bouton burger */
.burger {
  font-size: 24px;
  background: none;
  border: none;
  cursor: pointer;
  display: none; 
}

/* Overlay (caché par défaut) */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5); /* noir semi-transparent */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
  z-index: 900; /* juste en dessous de la sidebar (qui est z-index:1000) */
}

.overlay.active {
  opacity: 1;
  visibility: visible;
}


/* Mobile */
@media (min-width: 1025px) {
  .close-btn {
    display: none; /* pas besoin en desktop */
  }
}
@media (max-width: 1024px) {
  .burger {
    display: block;
  }
  
  .welcome-title{
    display:none;
  }
      .header {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }

  .sidebar {
    position: fixed;
    top: 0;
    left: -260px; /* cachée */
    width: 250px;
    height: 100%;
    background: var(--mint);
    transition: left 0.3s ease;
    z-index: 1000;
  }

  .sidebar.active {
    left: 0; /* affichée */
  }

  .main-content {
    margin-left: 0; /* pas de sidebar collée */
  }
}

</style>
<header class="header">
  <button class="burger" id="burger-btn">
    &#9776;
  </button>

  <h1 class="welcome-title">Welcome in, {{app.user.userName}}</h1>

  <div class="user-profile">
    <img src="https://i.pravatar.cc/150?img=5" alt="Guy Hawkins" class="user-avatar">
    <div class="user-info">
      <h3>{{app.user.userName}}</h3>
    </div>
  </div>
</header>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const burger = document.getElementById('burger-btn');
  const sidebar = document.querySelector('.sidebar');
  const overlay = document.getElementById('overlay');
  const closeBtn = document.getElementById('close-btn');

  function openMenu() {
    sidebar.classList.add('active');
    overlay.classList.add('active');
  }

  function closeMenu() {
    sidebar.classList.remove('active');
    overlay.classList.remove('active');
  }

  if (burger) {
    burger.addEventListener('click', openMenu);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeMenu);
  }

  if (overlay) {
    overlay.addEventListener('click', closeMenu);
  }
});
</script>

