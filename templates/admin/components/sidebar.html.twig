{% set currentRoute = app.request.attributes.get('_route') %}
{% set coursesActive = currentRoute starts with 'admin_course_' or currentRoute starts with 'admin_scorm_' %}
{% set quizActive = currentRoute starts with 'admin_quiz_attempt_' %}
{% set certificatesActive = currentRoute starts with 'admin_certificate_' %}
{% set subscriptionsActive = currentRoute starts with 'admin_subscription_' %}
{% set importsActive = currentRoute starts with 'admin_user_import' %}
{% set enrollmentsActive = currentRoute starts with 'admin_enrollment' %}
{% set emailsActive = currentRoute starts with 'admin_email_' or currentRoute == 'admin_bulk_email' %}
{% set articlesActive = currentRoute starts with 'admin_article' or currentRoute starts with 'admin_comment' or currentRoute starts with 'admin_category' %}
{% set communityActive = currentRoute starts with 'admin_community_' %}

<aside class="sidebar sidebar--admin" aria-label="Administration navigation">
  <div class="sidebar-header">
    <a href="{{ path('admin_course_index') }}" class="sidebar-brand" aria-label="Go to course administration">
      <img src="{{ asset('images/logo.png') }}" class="sidebar-brand__logo" alt="Les Consultants">
    </a>
    <span class="sidebar-workspace-badge">
      <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
      Admin console
    </span>
    <button class="close-btn" id="close-btn" type="button" aria-label="Close navigation">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="sidebar-nav">
    <section class="nav-section" aria-labelledby="admin-content-label">
      <p class="nav-section__label" id="admin-content-label">Learning content</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('admin_course_index') }}" class="nav-link {{ coursesActive ? 'active' : '' }}" aria-current="{{ coursesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
            <span class="nav-link__label">Courses</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_quiz_attempt_index') }}" class="nav-link {{ quizActive ? 'active' : '' }}" aria-current="{{ quizActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span>
            <span class="nav-link__label">Quiz attempts</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_certificate_list') }}" class="nav-link {{ certificatesActive ? 'active' : '' }}" aria-current="{{ certificatesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-award" aria-hidden="true"></i></span>
            <span class="nav-link__label">Certificates</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_articles') }}" class="nav-link {{ articlesActive ? 'active' : '' }}" aria-current="{{ articlesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-regular fa-newspaper" aria-hidden="true"></i></span>
            <span class="nav-link__label">Articles</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="admin-access-label">
      <p class="nav-section__label" id="admin-access-label">People &amp; access</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('admin_subscription_add') }}" class="nav-link {{ subscriptionsActive ? 'active' : '' }}" aria-current="{{ subscriptionsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-regular fa-credit-card" aria-hidden="true"></i></span>
            <span class="nav-link__label">Subscriptions</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_user_import') }}" class="nav-link {{ importsActive ? 'active' : '' }}" aria-current="{{ importsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i></span>
            <span class="nav-link__label">Import users</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_enrollments') }}" class="nav-link {{ enrollmentsActive ? 'active' : '' }}" aria-current="{{ enrollmentsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
            <span class="nav-link__label">Assign courses</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="admin-communication-label">
      <p class="nav-section__label" id="admin-communication-label">Communication</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('admin_email_choice') }}" class="nav-link {{ emailsActive ? 'active' : '' }}" aria-current="{{ emailsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i></span>
            <span class="nav-link__label">Group email</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('admin_community_index') }}" class="nav-link {{ communityActive ? 'active' : '' }}" aria-current="{{ communityActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i></span>
            <span class="nav-link__label">Jobs &amp; agenda</span>
          </a>
        </li>
      </ul>
    </section>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <img src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}" class="sidebar-user__avatar" alt="">
      <div class="sidebar-user__info">
        <small>Administrator</small>
        <strong>{{ app.user.userName }}</strong>
      </div>
      <a href="" class="sidebar-user__logout" title="Log out" aria-label="Log out" data-controller="auth" data-action="click->auth#logout">
        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</aside>
