{% extends 'base.html.twig' %}

{% block title %}Attribuer un abonnement{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/adminSubscriptionCreate.css') }}">
{% endblock %}

{% block body %}
<section class="subscription-assignment" data-subscription-assignment>
  <header class="subscription-assignment__hero">
    <a href="{{ path('admin_subscription_add') }}" class="subscription-assignment__back">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      Retour aux abonnements
    </a>
    <span class="subscription-assignment__eyebrow"><i class="fa-solid fa-crown" aria-hidden="true"></i>Administration</span>
    <h1>Attribuer un abonnement</h1>
    <p>Recherchez un utilisateur par son nom ou son adresse e-mail, puis confirmez la période d’accès.</p>
  </header>

  <form method="post" class="subscription-assignment__form">
    <input type="hidden" name="_token" value="{{ csrf_token('create_subscription') }}">

    <div class="subscription-assignment__main">
      <section class="subscription-step">
        <header class="subscription-step__header">
          <span>1</span>
          <div><small>Utilisateur</small><h2>À qui attribuer l’abonnement ?</h2></div>
        </header>

        <label for="subscription-user" class="subscription-step__label">Utilisateur</label>
        <select id="subscription-user" name="user_id" required data-user-select>
          <option value="">Sélectionnez un utilisateur</option>
          {% for user in users %}
            {% set roleLabel = 'Utilisateur' %}
            {% if 'ROLE_ADMIN' in user.roles %}
              {% set roleLabel = 'Administrateur' %}
            {% elseif 'ROLE_COMPANY' in user.roles %}
              {% set roleLabel = 'Entreprise' %}
            {% elseif 'ROLE_EMPLOYEE' in user.roles %}
              {% set roleLabel = 'Apprenant' %}
            {% endif %}
            <option
              value="{{ user.id }}"
              data-user-name="{{ user.username|e('html_attr') }}"
              data-user-email="{{ user.email|e('html_attr') }}"
              data-user-role="{{ roleLabel|e('html_attr') }}"
              data-user-initial="{{ (user.username ?: user.email)|first|upper|e('html_attr') }}"
            >{{ user.username }} — {{ user.email }}</option>
          {% endfor %}
        </select>

        <div class="user-picker" data-user-picker hidden>
          <div class="user-picker__search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" autocomplete="off" placeholder="Rechercher par nom ou e-mail…" aria-label="Rechercher un utilisateur" data-user-search>
            <button type="button" aria-label="Effacer la recherche" data-user-search-clear hidden><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
          </div>
          <p class="user-picker__hint">Commencez à écrire ou choisissez parmi les premiers résultats.</p>
          <div class="user-picker__results" role="listbox" aria-label="Résultats utilisateurs" data-user-results></div>
          <p class="user-picker__empty" data-user-empty hidden><i class="fa-regular fa-face-frown" aria-hidden="true"></i>Aucun utilisateur trouvé.</p>
        </div>

        <div class="selected-user" data-selected-user hidden>
          <span class="selected-user__avatar" data-selected-initial></span>
          <div><small>Utilisateur sélectionné</small><strong data-selected-name></strong><span data-selected-email></span></div>
          <span class="selected-user__role" data-selected-role></span>
          <button type="button" data-change-user><i class="fa-solid fa-pen" aria-hidden="true"></i>Changer</button>
        </div>
      </section>

      <section class="subscription-step subscription-step--dates">
        <header class="subscription-step__header">
          <span>2</span>
          <div><small>Période d’accès</small><h2>Définir les dates</h2></div>
        </header>

        <input type="hidden" name="type" value="monthly">
        <div class="subscription-plan">
          <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
          <div><strong>Abonnement mensuel</strong><span>Accès activé immédiatement à la création</span></div>
          <span>Mensuel</span>
        </div>

        <div class="subscription-dates">
          <label>
            <span>Date de début</span>
            <input type="date" name="startDate" value="{{ 'now'|date('Y-m-d') }}" required data-start-date>
          </label>
          <span class="subscription-dates__arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
          <label>
            <span>Date de fin</span>
            <input type="date" name="endDate" value="{{ '+1 month'|date('Y-m-d') }}" required data-end-date>
          </label>
        </div>
      </section>
    </div>

    <aside class="subscription-summary">
      <span class="subscription-summary__icon"><i class="fa-solid fa-key" aria-hidden="true"></i></span>
      <small>Récapitulatif</small>
      <h2>Prêt à attribuer l’accès</h2>
      <p data-summary-user>Sélectionnez d’abord un utilisateur.</p>
      <dl>
        <div><dt>Formule</dt><dd>Mensuelle</dd></div>
        <div><dt>Début</dt><dd data-summary-start>—</dd></div>
        <div><dt>Fin</dt><dd data-summary-end>—</dd></div>
        <div><dt>Statut</dt><dd><span class="subscription-summary__active">Actif</span></dd></div>
      </dl>
      <button type="submit" data-submit-subscription>
        <i class="fa-solid fa-check" aria-hidden="true"></i>
        Attribuer l’abonnement
      </button>
      <p class="subscription-summary__notice"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>Un abonnement existant pour cet utilisateur sera remplacé.</p>
    </aside>
  </form>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const root = document.querySelector('[data-subscription-assignment]');
  if (!root) return;

  const select = root.querySelector('[data-user-select]');
  const picker = root.querySelector('[data-user-picker]');
  const search = root.querySelector('[data-user-search]');
  const clearSearch = root.querySelector('[data-user-search-clear]');
  const results = root.querySelector('[data-user-results]');
  const empty = root.querySelector('[data-user-empty]');
  const selected = root.querySelector('[data-selected-user]');
  const changeUser = root.querySelector('[data-change-user]');
  const submit = root.querySelector('[data-submit-subscription]');
  const startDate = root.querySelector('[data-start-date]');
  const endDate = root.querySelector('[data-end-date]');
  const options = Array.from(select?.options || []).filter((option) => option.value);

  if (!select || !picker || !search || !results || !selected || !submit) return;

  select.hidden = true;
  picker.hidden = false;

  const normalize = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const formatDate = (value) => value ? new Intl.DateTimeFormat('fr-FR').format(new Date(`${value}T12:00:00`)) : '—';

  const updateSummary = () => {
    const option = options.find((item) => item.value === select.value);
    root.querySelector('[data-summary-user]').textContent = option ? `${option.dataset.userName} · ${option.dataset.userEmail}` : 'Sélectionnez d’abord un utilisateur.';
    root.querySelector('[data-summary-start]').textContent = formatDate(startDate?.value);
    root.querySelector('[data-summary-end]').textContent = formatDate(endDate?.value);
    submit.disabled = !option || !startDate?.value || !endDate?.value || endDate.value <= startDate.value;
  };

  const chooseUser = (option) => {
    select.value = option.value;
    selected.querySelector('[data-selected-initial]').textContent = option.dataset.userInitial;
    selected.querySelector('[data-selected-name]').textContent = option.dataset.userName;
    selected.querySelector('[data-selected-email]').textContent = option.dataset.userEmail;
    selected.querySelector('[data-selected-role]').textContent = option.dataset.userRole;
    selected.hidden = false;
    picker.hidden = true;
    updateSummary();
  };

  const renderResults = () => {
    const query = normalize(search.value);
    const matches = options.filter((option) => normalize(`${option.dataset.userName} ${option.dataset.userEmail}`).includes(query)).slice(0, 8);
    results.replaceChildren();
    empty.hidden = matches.length > 0;
    clearSearch.hidden = search.value.length === 0;

    matches.forEach((option) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'user-picker__option';
      button.setAttribute('role', 'option');
      button.innerHTML = '<span class="user-picker__avatar"></span><span class="user-picker__identity"><strong></strong><small></small></span><span class="user-picker__role"></span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i>';
      button.querySelector('.user-picker__avatar').textContent = option.dataset.userInitial;
      button.querySelector('strong').textContent = option.dataset.userName;
      button.querySelector('small').textContent = option.dataset.userEmail;
      button.querySelector('.user-picker__role').textContent = option.dataset.userRole;
      button.addEventListener('click', () => chooseUser(option));
      results.appendChild(button);
    });
  };

  search.addEventListener('input', renderResults);
  search.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      results.querySelector('button')?.focus();
    }
  });
  clearSearch?.addEventListener('click', () => {
    search.value = '';
    search.focus();
    renderResults();
  });
  changeUser?.addEventListener('click', () => {
    select.value = '';
    selected.hidden = true;
    picker.hidden = false;
    search.value = '';
    renderResults();
    search.focus();
    updateSummary();
  });

  startDate?.addEventListener('change', () => {
    if (startDate.value) {
      const nextMonth = new Date(`${startDate.value}T12:00:00`);
      nextMonth.setMonth(nextMonth.getMonth() + 1);
      endDate.value = nextMonth.toISOString().slice(0, 10);
    }
    updateSummary();
  });
  endDate?.addEventListener('change', updateSummary);

  renderResults();
  updateSummary();
});
</script>
{% endblock %}
