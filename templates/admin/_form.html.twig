{{ form_start(form, {'attr': {'class': 'course-form'}}) }}

<div class="form-section">
    <div class="section-header">
        <h2>New course</h2>
        <p>Basic details about your course</p>
    </div>
    <div class="form-grid">
        {{ form_row(form.title) }}
        {{ form_row(form.description) }}
    </div>
</div>
<div class="divider"></div>

<div class="form-section">
    <div class="section-header">
        <h2>Course Prices</h2>
        <p>Define the pricing options for this course</p>
    </div>
    <div id="course_prices"
         data-prototype="{{ form_widget(form.coursePrices.vars.prototype)|e('html_attr') }}"
         data-index="{{ form.coursePrices|length }}"
         class="collection-container">
        {% for priceForm in form.coursePrices %}
            <div class="price-item card collection-item">
                <div class="item-header">
                    <span class="item-number">Price {{ loop.index }}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this price">
                        <span class="btn-icon">×</span> Remove
                    </button>
                </div>
                <div class="form-grid">
                    {{ form_row(priceForm.price) }}
                    {{ form_row(priceForm.currency) }}
                </div>
            </div>
        {% endfor %}
        {% if form.coursePrices|length == 0 %}
            <div class="empty-state">
                <p>No price defined yet. Click the button below to add one.</p>
            </div>
        {% endif %}
    </div>
    <button type="button" class="btn btn-primary add-item" data-target="#course_prices">
        <span class="btn-icon">+</span> Add Price
    </button>
</div>

<div class="divider"></div>

<div class="form-section">
    <div class="section-header">
        <h2>Course Videos</h2>
        <p>Add educational videos to your course</p>
    </div>
    <div id="course_videos"
         data-prototype="{{ form_widget(form.videos.vars.prototype)|e('html_attr') }}"
         data-index="{{ form.videos|length }}"
         class="collection-container">
        {% for videoForm in form.videos %}
            <div class="video-item card collection-item">
                <div class="item-header">
                    <span class="item-number">Video {{ loop.index }}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this video">
                        <span class="btn-icon">×</span> Remove
                    </button>
                </div>
                <div class="form-grid">
                    {{ form_row(videoForm.title) }}
                    <div class="duration-field">
                        <label class="form-label">Durée</label>
                        <div class="duration-input-group">
                            <input type="number" 
                                   class="form-control duration-minutes" 
                                   step="0.5" 
                                   min="0.5"
                                   placeholder="Ex: 15.5"
                                   data-target="{{ videoForm.duration.vars.full_name }}"
                                   data-current-seconds="{{ videoForm.duration.vars.value }}">
                            <span class="input-group-text">minutes</span>
                        </div>
                        <small class="form-text text-muted duration-conversion"></small>
                        {{ form_widget(videoForm.duration, {'attr': {'style': 'display: none;'}}) }}
                    </div>
                </div>
                {{ form_row(videoForm.description) }}
                {{ form_row(videoForm.url) }}
            </div>
        {% endfor %}
        {% if form.videos|length == 0 %}
            <div class="empty-state">
                <p>No videos added yet. Click the button below to add your first video.</p>
            </div>
        {% endif %}
    </div>
    <button type="button" class="btn btn-primary add-item" data-target="#course_videos">
        <span class="btn-icon">+</span> Add Video
    </button>
</div>

<div class="divider"></div>

<div class="form-section">
    <div class="section-header">
        <h2>Quiz Questions</h2>
        <p>Create interactive questions to test knowledge</p>
    </div>
    <div id="course_questions"
         data-prototype="{{ form_widget(form.quizQuestions.vars.prototype)|e('html_attr') }}"
         data-index="{{ form.quizQuestions|length }}"
         class="collection-container">
        {% for qForm in form.quizQuestions %}
            <div class="question-item card collection-item">
                <div class="item-header">
                    <span class="item-number">Question {{ loop.index }}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this question">
                        <span class="btn-icon">×</span> Remove Question
                    </button>
                </div>
                
                {{ form_row(qForm.question) }}

                <div class="answers-section">
                    <h4>Answer Options</h4>
                    <div class="answers"
                         data-prototype="{{ form_widget(qForm.answers.vars.prototype)|e('html_attr') }}"
                         data-index="{{ qForm.answers|length }}">
                        {% for aForm in qForm.answers %}
                            <div class="answer-item">
                                <div class="answer-content">
                                    {{ form_row(aForm.text) }}
                                    <div class="answer-controls">
                                        {{ form_row(aForm.isCorrect) }}
                                        <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this answer">
                                            <span class="btn-icon">×</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn btn-secondary btn-small add-answer">
                        <span class="btn-icon">+</span> Add Answer Option
                    </button>
                </div>
            </div>
        {% endfor %}
        {% if form.quizQuestions|length == 0 %}
            <div class="empty-state">
                <p>No quiz questions added yet. Click the button below to add your first question.</p>
            </div>
        {% endif %}
    </div>
    <button type="button" class="btn btn-primary add-item" data-target="#course_questions">
        <span class="btn-icon">+</span> Add Question
    </button>
</div>

<div class="divider"></div>

<div class="form-actions">
    <button class="btn btn-success btn-large">
        <span class="btn-icon">✓</span> {{ button_label|default('Save Course') }}
    </button>
    <a href="{{ path('admin_course_index') }}" class="btn btn-secondary btn-large">
        <span class="btn-icon">←</span> Back to Courses
    </a>
</div>

{{ form_end(form) }}

