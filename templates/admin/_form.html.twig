    min-height: 42px;
    padding: .72rem .8rem;
}

.course-editor .input-group-text {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    padding: 0 .8rem;
    background: #edf4f2;
}

.course-editor .form-actions {
    position: sticky;
    z-index: 20;
    bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: .9rem 1rem;
    background: rgba(255, 255, 255, .94);
    border: 1px solid var(--editor-border);
    border-radius: 16px;
    box-shadow: 0 14px 35px rgba(7, 23, 23, .14);
    backdrop-filter: blur(12px);
}

.save-status {
    display: flex;
    align-items: center;
    gap: .55rem;
    color: var(--editor-muted);
    font-size: .8rem;
    font-weight: 650;
}

.save-status i {
    color: var(--teal);
}

.save-status.is-dirty i {
    color: #d59618;
    font-size: .55rem;
}

.form-action-buttons {
    display: flex;
    gap: .65rem;
}

.course-editor .divider {
    display: none;
}

@keyframes slideOut {
    to {
        opacity: 0;
        transform: translateY(-8px) scale(.985);
    }
}

@media (max-width: 1100px) {
    .editor-shell {
        grid-template-columns: 1fr;
    }

    .editor-sidebar {
        position: sticky;
        z-index: 15;
        top: 0;
        overflow-x: auto;
        padding: .65rem;
    }

    .editor-sidebar-title,
    .editor-tip {
        display: none;
    }

    .editor-nav {
        flex-direction: row;
        min-width: max-content;
    }

    .editor-nav-link {
        display: inline-flex;
        padding: .6rem .75rem;
    }
}

@media (max-width: 820px) {
    .course-editor {
        padding: .75rem .65rem 3rem;
    }

    .editor-hero {
        flex-direction: column;
        padding: 1.5rem;
        border-radius: 18px;
    }

    .editor-hero-stats {
        align-self: stretch;
        min-width: 0;
    }

    .course-editor .form-section {
        padding: 1.1rem;
        border-radius: 15px;
    }

    .course-editor .section-header {
        flex-direction: column;
    }

    .course-editor .form-grid,
    .resource-grid,
    .course-editor .localized-fields,
    .course-editor .answer-translations {
        grid-template-columns: 1fr;
    }

    .course-editor .answer-content {
        align-items: stretch;
    }

    .course-editor .item-header {
        flex-direction: row;
        align-items: center;
    }

    .course-editor .form-actions {
        position: static;
        align-items: stretch;
        flex-direction: column;
    }

    .form-action-buttons {
        flex-direction: column-reverse;
    }

    .course-editor .btn-success {
        width: 100%;
    }
}
</style>

{% set isEditing = course is defined and course.id %}
<div class="course-editor">
  <header class="editor-hero">
    <div class="editor-hero-copy">
      <a href="{{ path('admin_course_index') }}" class="editor-back-link">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Back to courses
      </a>
      <span class="editor-kicker">Course builder</span>
      <h1>{{ isEditing ? 'Edit your course' : 'Create a new course' }}</h1>
      <p>{{ isEditing ? 'Update the content, lessons and knowledge check from one guided workspace.' : 'Build the course step by step. You can add translations and learning content as you go.' }}</p>
    </div>
    <div class="editor-hero-stats" aria-label="Course content summary">
      <div class="editor-stat">
        <strong data-summary-count="prices">{{ form.coursePrices|length }}</strong>
        <span>Prices</span>
      </div>
      <div class="editor-stat">
        <strong data-summary-count="videos">{{ form.videos|length }}</strong>
        <span>Lessons</span>
      </div>
      <div class="editor-stat">
        <strong data-summary-count="questions">{{ form.quizQuestions|length }}</strong>
        <span>Questions</span>
      </div>
    </div>
  </header>

{{ form_start(form, {'attr': {'class': 'course-form'}}) }}
<div class="editor-shell">
  <aside class="editor-sidebar" aria-label="Course form navigation">
