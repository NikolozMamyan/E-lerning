<script>
document.addEventListener('DOMContentLoaded', function() {
    // Fonction pour convertir minutes en secondes et vice versa
    function setupDurationFields() {
        document.querySelectorAll('.duration-minutes').forEach(function(minutesInput) {
            const targetName = minutesInput.dataset.target;
            const currentSeconds = minutesInput.dataset.currentSeconds;
            const secondsInput = document.querySelector(`[name="${targetName}"]`);
            
            if (secondsInput) {
                // Convertir de secondes vers minutes lors du chargement initial
                if (currentSeconds && parseFloat(currentSeconds) > 0) {
                    const minutes = (parseFloat(currentSeconds) / 60);
                    minutesInput.value = minutes % 1 === 0 ? Math.floor(minutes) : minutes.toFixed(1);
                    updateDurationDisplay(minutesInput, currentSeconds);
                }
                
                // Écouter les changements sur le champ minutes
                minutesInput.addEventListener('input', function() {
                    const minutes = parseFloat(this.value) || 0;
                    const seconds = Math.round(minutes * 60);
                    secondsInput.value = seconds;
                    
                    // Afficher la conversion
                    updateDurationDisplay(this, seconds);
                });
                
                // Écouter le focus pour sélectionner le texte
                minutesInput.addEventListener('focus', function() {
                    this.select();
                });
            }
        });
    }

    function updateDurationDisplay(minutesInput, seconds) {
        const conversionElement = minutesInput.closest('.duration-field').querySelector('.duration-conversion');
        
        if (conversionElement && seconds > 0) {
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            
            let displayText = '= ';
            if (minutes > 0) {
                displayText += `${minutes} min`;
                if (remainingSeconds > 0) {
                    displayText += ` ${remainingSeconds} sec`;
                }
            } else {
                displayText += `${remainingSeconds} sec`;
            }
            
            conversionElement.textContent = displayText;
            conversionElement.style.display = 'block';
        } else if (conversionElement) {
            conversionElement.style.display = 'none';
        }
    }

    // Update item numbers when items are added/removed
    function updateItemNumbers() {
        // Update price numbers
        document.querySelectorAll('#course_prices .price-item').forEach((item, index) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) {
                numberSpan.textContent = `Price ${index + 1}`;
            }
        });
        
        // Update video numbers
        document.querySelectorAll('#course_videos .video-item').forEach((item, index) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) {
                numberSpan.textContent = `Video ${index + 1}`;
            }
        });
        
        // Update question numbers
        document.querySelectorAll('#course_questions .question-item').forEach((item, index) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) {
                numberSpan.textContent = `Question ${index + 1}`;
            }
        });
    }
    
    // Hide/show empty states
    function toggleEmptyStates() {
        const containers = ['#course_prices', '#course_videos', '#course_questions'];
        const itemClasses = ['.price-item', '.video-item', '.question-item'];
        const emptyMessages = [
            'No price defined yet. Click the button below to add one.',
            'No videos added yet. Click the button below to add your first video.',
            'No quiz questions added yet. Click the button below to add your first question.'
        ];
        
        containers.forEach((containerSelector, index) => {
            const container = document.querySelector(containerSelector);
            if (container) {
                const items = container.querySelectorAll(itemClasses[index]);
                const emptyState = container.querySelector('.empty-state');
                
                if (items.length === 0) {
                    if (!emptyState) {
                        const emptyDiv = document.createElement('div');
                        emptyDiv.className = 'empty-state';
                        emptyDiv.innerHTML = `<p>${emptyMessages[index]}</p>`;
                        container.appendChild(emptyDiv);
                    }
                } else if (emptyState) {
                    emptyState.remove();
                }
            }
        });
    }
    
    // Initialiser les champs de durée
    setupDurationFields();
    toggleEmptyStates();
});

document.addEventListener('click', function (e) {
    // Add item (price, video or question)
    if (e.target.classList.contains('add-item')) {
        const target = document.querySelector(e.target.dataset.target);
        const index = parseInt(target.dataset.index);
        let proto = target.dataset.prototype.replace(/__name__/g, index);
        const div = document.createElement('div');
        
        // Create wrapper based on target
        if (target.id === 'course_prices') {
            div.className = 'price-item card collection-item';
            div.innerHTML = `
                <div class="item-header">
                    <span class="item-number">Price ${index + 1}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this price">
                        <span class="btn-icon">×</span> Remove
                    </button>
                </div>
                <div class="form-grid">
                    ${proto}
                </div>
            `;
        } else if (target.id === 'course_videos') {
            div.className = 'video-item card collection-item';
            
            // Extraire les différents champs du prototype
            const titleMatch = proto.match(/<[^>]*name="[^"]*\[title\][^"]*"[^>]*>.*?(?=<[^>]*name="[^"]*\[(?:description|duration|url)\]|$)/s);
            const durationMatch = proto.match(/<[^>]*name="[^"]*\[duration\][^"]*"[^>]*>.*?(?=<[^>]*name="[^"]*\[(?:description|url)\]|$)/s);
            const descriptionMatch = proto.match(/<[^>]*name="[^"]*\[description\][^"]*"[^>]*>.*?(?=<[^>]*name="[^"]*\[url\]|$)/s);
            const urlMatch = proto.match(/<[^>]*name="[^"]*\[url\][^"]*"[^>]*>.*$/s);
            
            // Extraire le nom du champ duration pour le data-target
            const durationNameMatch = proto.match(/name="([^"]*\[duration\][^"]*)"/);
            const durationFieldName = durationNameMatch ? durationNameMatch[1] : '';
            
            div.innerHTML = `
                <div class="item-header">
                    <span class="item-number">Video ${index + 1}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this video">
                        <span class="btn-icon">×</span> Remove
                    </button>
                </div>
                <div class="form-grid">
                    ${titleMatch ? titleMatch[0] : ''}
                    <div class="duration-field">
                        <label class="form-label">Durée</label>
                        <div class="duration-input-group">
                            <input type="number" 
                                   class="form-control duration-minutes" 
                                   step="0.5" 
                                   min="0.5"
                                   placeholder="Ex: 15.5"
                                   data-target="${durationFieldName}"
                                   data-current-seconds="0">
                            <span class="input-group-text">minutes</span>
                        </div>
                        <small class="form-text text-muted duration-conversion" style="display: none;"></small>
                        ${durationMatch ? durationMatch[0].replace(/class="[^"]*"/, 'class="form-control" style="display: none;"') : ''}
                    </div>
                </div>
                ${descriptionMatch ? descriptionMatch[0] : ''}
                ${urlMatch ? urlMatch[0] : ''}
            `;
        } else if (target.id === 'course_questions') {
            div.className = 'question-item card collection-item';
            
            // Extraire la partie question du prototype
            const questionMatch = proto.match(/<[^>]*name="[^"]*\[question\][^"]*"[^>]*>[\s\S]*?<\/[^>]*>/);
            const answersProtoMatch = proto.match(/data-prototype="([^"]*)"/);
            const answersProto = answersProtoMatch ? answersProtoMatch[1].replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>') : '';
            
            div.innerHTML = `
                <div class="item-header">
                    <span class="item-number">Question ${index + 1}</span>
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this question">
                        <span class="btn-icon">×</span> Remove Question
                    </button>
                </div>
                ${questionMatch ? questionMatch[0] : ''}
                <div class="answers-section">
                    <h4>Answer Options</h4>
                    <div class="answers" 
                         data-prototype="${answersProto.replace(/"/g, '&quot;')}" 
                         data-index="0">
                    </div>
                    <button type="button" class="btn btn-secondary btn-small add-answer">
                        <span class="btn-icon">+</span> Add Answer Option
                    </button>
                </div>
            `;
        }
        
        target.appendChild(div);
        target.dataset.index = index + 1;
        
        // Remove empty state if it exists
        const emptyState = target.querySelector('.empty-state');
        if (emptyState) {
            emptyState.remove();
        }
        
        // Réinitialiser les champs de durée pour les nouvelles vidéos
        if (target.id === 'course_videos') {
            setTimeout(() => {
                const newMinutesInput = div.querySelector('.duration-minutes');
                const newSecondsInput = div.querySelector('[name*="[duration]"]');
                
                if (newMinutesInput && newSecondsInput) {
                    newMinutesInput.addEventListener('input', function() {
                        const minutes = parseFloat(this.value) || 0;
                        const seconds = Math.round(minutes * 60);
                        newSecondsInput.value = seconds;
                        updateDurationDisplay(this, seconds);
                    });
                    
                    newMinutesInput.addEventListener('focus', function() {
                        this.select();
                    });
                }
            }, 100);
        }
    }

    // Add answer
    if (e.target.classList.contains('add-answer')) {
        const answers = e.target.closest('.question-item').querySelector('.answers');
        const index = parseInt(answers.dataset.index);
        let proto = answers.dataset.prototype.replace(/__name__/g, index);
        
        const div = document.createElement('div');
        div.className = 'answer-item';
        div.innerHTML = `
            <div class="answer-content">
                ${proto}
                <div class="answer-controls">
                    <button type="button" class="btn btn-danger btn-small remove-item" title="Remove this answer">
                        <span class="btn-icon">×</span>
                    </button>
                </div>
            </div>
        `;
        answers.appendChild(div);
        answers.dataset.index = index + 1;
    }

    // Remove item
    if (e.target.classList.contains('remove-item')) {
        e.preventDefault();
        const item = e.target.closest('.video-item, .question-item, .answer-item, .price-item');
        if (item) {
            item.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => {
                item.remove();
                updateItemNumbers();
                toggleEmptyStates();
            }, 300);
        }
    }
});

// Fonction utilitaire pour la conversion (utilisée dans les event listeners dynamiques)
function updateDurationDisplay(minutesInput, seconds) {
    const conversionElement = minutesInput.closest('.duration-field').querySelector('.duration-conversion');
    
    if (conversionElement && seconds > 0) {
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = seconds % 60;
        
        let displayText = '= ';
        if (minutes > 0) {
            displayText += `${minutes} min`;
            if (remainingSeconds > 0) {
                displayText += ` ${remainingSeconds} sec`;
            }
        } else {
            displayText += `${remainingSeconds} sec`;
        }
        
        conversionElement.textContent = displayText;
        conversionElement.style.display = 'block';
    } else if (conversionElement) {
        conversionElement.style.display = 'none';
    }
}

// Animation for removing items
const style = document.createElement('style');
style.textContent = `
@keyframes slideOut {
    to {
        opacity: 0;
        transform: translateX(-100%);
    }
}
`;

document.head.appendChild(style);

// Fonction pour mettre à jour les numéros d'items
function updateItemNumbers() {
    // Update price numbers
    document.querySelectorAll('#course_prices .price-item').forEach((item, index) => {
        const numberSpan = item.querySelector('.item-number');
        if (numberSpan) {
            numberSpan.textContent = `Price ${index + 1}`;
        }
    });
    
    // Update video numbers
    document.querySelectorAll('#course_videos .video-item').forEach((item, index) => {
        const numberSpan = item.querySelector('.item-number');
        if (numberSpan) {
            numberSpan.textContent = `Video ${index + 1}`;
        }
    });
    
    // Update question numbers
    document.querySelectorAll('#course_questions .question-item').forEach((item, index) => {
        const numberSpan = item.querySelector('.item-number');
        if (numberSpan) {
            numberSpan.textContent = `Question ${index + 1}`;
        }
    });
}

// Fonction pour gérer les états vides
function toggleEmptyStates() {
    const containers = [
        { selector: '#course_prices', itemClass: '.price-item', message: 'No price defined yet. Click the button below to add one.' },
        { selector: '#course_videos', itemClass: '.video-item', message: 'No videos added yet. Click the button below to add your first video.' },
        { selector: '#course_questions', itemClass: '.question-item', message: 'No quiz questions added yet. Click the button below to add your first question.' }
    ];
    
    containers.forEach(config => {
        const container = document.querySelector(config.selector);
        if (container) {
            const items = container.querySelectorAll(config.itemClass);
            const emptyState = container.querySelector('.empty-state');
            
            if (items.length === 0) {
                if (!emptyState) {
                    const emptyDiv = document.createElement('div');
                    emptyDiv.className = 'empty-state';
                    emptyDiv.innerHTML = `<p>${config.message}</p>`;
                    container.appendChild(emptyDiv);
                }
            } else if (emptyState) {
                emptyState.remove();
            }
        }
    });
}

// Validation supplémentaire avant soumission du formulaire
document.addEventListener('submit', function(e) {
    const form = e.target;
    if (form.classList.contains('course-form')) {
        // Vérifier que toutes les durées sont correctement converties
        document.querySelectorAll('.duration-minutes').forEach(function(minutesInput) {
            const targetName = minutesInput.dataset.target;
            const secondsInput = document.querySelector(`[name="${targetName}"]`);
            
            if (secondsInput && minutesInput.value) {
                const minutes = parseFloat(minutesInput.value) || 0;
                const seconds = Math.round(minutes * 60);
                secondsInput.value = seconds;
            }
        });
        
        // Validation basique
        const videos = document.querySelectorAll('.video-item');
        let hasInvalidDuration = false;
        
        videos.forEach(video => {
            const minutesInput = video.querySelector('.duration-minutes');
            if (minutesInput && minutesInput.value && parseFloat(minutesInput.value) <= 0) {
                hasInvalidDuration = true;
                minutesInput.style.borderColor = '#e74c3c';
            } else if (minutesInput) {
                minutesInput.style.borderColor = '#ddd';
            }
        });
        
        if (hasInvalidDuration) {
            e.preventDefault();
            alert('Veuillez saisir des durées valides pour toutes les vidéos (supérieures à 0).');
            return false;
        }
    }
});

// Gestion du paste pour les URLs YouTube (bonus)
document.addEventListener('paste', function(e) {
    if (e.target.name && e.target.name.includes('[url]')) {
        setTimeout(() => {
            const url = e.target.value;
            // Détecter si c'est une URL YouTube et extraire l'ID
            const youtubeMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\n?#]+)/);
            if (youtubeMatch) {
                const videoId = youtubeMatch[1];
                // Vous pouvez ici ajouter une logique pour récupérer automatiquement
                // le titre et la durée de la vidéo via l'API YouTube
                console.log('YouTube video detected:', videoId);
            }
        }, 100);
    }
});
