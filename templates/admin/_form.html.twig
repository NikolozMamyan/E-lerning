    <nav class="editor-nav">
      <a href="#course-details" class="editor-nav-link is-active" data-section-link="course-details">
        <i class="fa-regular fa-pen-to-square" aria-hidden="true"></i><span>Details</span>
      </a>
      <a href="#course-resources" class="editor-nav-link" data-section-link="course-resources">
        <i class="fa-regular fa-image" aria-hidden="true"></i><span>Resources</span>
      </a>
      <a href="#course-pricing" class="editor-nav-link" data-section-link="course-pricing">
        <i class="fa-solid fa-tag" aria-hidden="true"></i><span>Pricing</span>
        <span class="editor-nav-count" data-nav-count="prices">{{ form.coursePrices|length }}</span>
