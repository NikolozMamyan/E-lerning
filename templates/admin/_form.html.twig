<script>
document.addEventListener('DOMContentLoaded', function () {
    const editor = document.querySelector('.course-editor');
    const form = editor?.querySelector('.course-form');
    const saveStatus = document.getElementById('courseSaveStatus');
    const submitButton = document.getElementById('courseSubmitButton');

    if (!editor || !form) return;

    function setupDurationInputs(container) {
        container.querySelectorAll('.duration-minutes').forEach(input => {
            if (input.dataset.durationReady === 'true') return;

            const hiddenName = input.dataset.target;
            const hiddenField = container.querySelector(`[name="${hiddenName}"]`);
            const conversion = input.closest('.duration-field').querySelector('.duration-conversion');

            if (!hiddenField) return;

            input.dataset.durationReady = 'true';

            if (input.dataset.currentSeconds && parseInt(input.dataset.currentSeconds) > 0) {
                const minutes = parseInt(input.dataset.currentSeconds) / 60;
                input.value = minutes % 1 === 0 ? Math.floor(minutes) : minutes.toFixed(1);
                updateDisplay(conversion, parseInt(input.dataset.currentSeconds));
            }

            input.addEventListener('input', function () {
                const minutes = parseFloat(this.value) || 0;
                const seconds = Math.round(minutes * 60);
                hiddenField.value = seconds;
                updateDisplay(conversion, seconds);
            });

            input.addEventListener('focus', function () {
                this.select();
            });
        });
    }

    function updateDisplay(el, seconds) {
        if (!el) return;
        if (seconds > 0) {
            const min = Math.floor(seconds / 60);
            const sec = seconds % 60;
            el.textContent = `= ${min} min${sec > 0 ? ' ' + sec + ' sec' : ''}`;
            el.style.display = 'block';
        } else {
            el.style.display = 'none';
        }
    }

    function updateItemNumbers() {
        document.querySelectorAll('#course_prices .price-item').forEach((item, i) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) numberSpan.textContent = `Price ${i + 1}`;
        });
        document.querySelectorAll('#course_videos .video-item').forEach((item, i) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) numberSpan.textContent = `Lesson ${i + 1}`;
        });
        document.querySelectorAll('#course_questions .question-item').forEach((item, i) => {
            const numberSpan = item.querySelector('.item-number');
            if (numberSpan) numberSpan.textContent = `Question ${i + 1}`;
        });

        updateCounts();
    }

    function updateCounts() {
        const counts = {
            prices: editor.querySelectorAll('#course_prices .price-item').length,
            videos: editor.querySelectorAll('#course_videos .video-item').length,
            questions: editor.querySelectorAll('#course_questions .question-item').length,
        };

        Object.entries(counts).forEach(([key, value]) => {
            editor.querySelectorAll(`[data-nav-count="${key}"], [data-summary-count="${key}"], [data-section-count="${key}"]`).forEach(element => {
                element.textContent = value;
            });
        });
    }

    function toggleEmptyStates() {
        const containers = [
            { selector: '#course_prices', itemClass: '.price-item', icon: 'fa-solid fa-tag', message: 'No price yet. Add one when the course is sold individually.' },
            { selector: '#course_videos', itemClass: '.video-item', icon: 'fa-regular fa-circle-play', message: 'No lessons yet. Add the first video to start building the course.' },
            { selector: '#course_questions', itemClass: '.question-item', icon: 'fa-regular fa-circle-question', message: 'No questions yet. Add a question to create the knowledge check.' }
        ];

        containers.forEach(config => {
            const container = editor.querySelector(config.selector);
            if (container) {
                const items = container.querySelectorAll(config.itemClass);
                const emptyState = container.querySelector('.empty-state');

                if (items.length === 0) {
                    if (!emptyState) {
                        const emptyDiv = document.createElement('div');
                        emptyDiv.className = 'empty-state';
                        emptyDiv.innerHTML = `<i class="${config.icon}" aria-hidden="true"></i><p>${config.message}</p>`;
                        container.appendChild(emptyDiv);
                    }
                } else if (emptyState) {
                    emptyState.remove();
                }
            }
        });

        updateCounts();
    }

    function addItem(button) {
        const target = editor.querySelector(button.dataset.target);
        if (!target) return;

        const index = parseInt(target.dataset.index || '0', 10);
        const proto = target.dataset.prototype.replace(/__name__/g, index);
        const wrapper = document.createElement('div');
        wrapper.innerHTML = proto;
        const div = wrapper.firstElementChild;

        if (!div) return;

        target.appendChild(div);
        target.dataset.index = index + 1;

        if (target.id === 'course_videos') {
            setupDurationInputs(div);
        }

        const emptyState = target.querySelector('.empty-state');
        if (emptyState) emptyState.remove();

        updateItemNumbers();
        markDirty();

        requestAnimationFrame(() => {
            div.scrollIntoView({ behavior: 'smooth', block: 'center' });
            div.querySelector('input:not([type="hidden"]), textarea, select')?.focus({ preventScroll: true });
        });
    }

    function removeItem(button) {
        const item = button.closest('.video-item, .question-item, .answer-item, .price-item');
        if (item) {
            item.style.animation = 'slideOut 0.22s ease forwards';
            setTimeout(() => {
                item.remove();
                updateItemNumbers();
                toggleEmptyStates();
                markDirty();
            }, 220);
        }
    }

    function addAnswer(button) {
        const answers = button.closest('.question-item').querySelector('.answers');
        const index = parseInt(answers.dataset.index || '0', 10);
        const proto = answers.dataset.prototype.replace(/__answer_name__/g, index);
        const prototypeWrapper = document.createElement('div');
        prototypeWrapper.innerHTML = proto;
        const prototypeRoot = prototypeWrapper.firstElementChild;

        if (!prototypeRoot) return;

        const div = document.createElement('div');
        div.className = 'answer-item';
        const content = document.createElement('div');
        content.className = 'answer-content';
        const translations = document.createElement('div');
        translations.className = 'answer-translations';
        const controls = document.createElement('div');
        controls.className = 'answer-controls';
        const fieldRows = Array.from(prototypeRoot.children);

        fieldRows.slice(0, 3).forEach(field => translations.appendChild(field));
        fieldRows.slice(3).forEach(field => controls.appendChild(field));
        controls.insertAdjacentHTML('beforeend', '<button type="button" class="btn btn-danger btn-small remove-item" title="Remove this answer" aria-label="Remove this answer"><i class="fa-regular fa-trash-can" aria-hidden="true"></i></button>');
        content.append(translations, controls);
        div.appendChild(content);
        answers.appendChild(div);
        answers.dataset.index = index + 1;

        markDirty();
        div.querySelector('input[type="text"]')?.focus();
    }

    function markDirty() {
        if (!saveStatus || form.dataset.submitting === 'true') return;

        saveStatus.innerHTML = '<i class="fa-solid fa-circle" aria-hidden="true"></i><span>Unsaved changes</span>';
        saveStatus.classList.add('is-dirty');
    }

    function setActiveSection(sectionId) {
        editor.querySelectorAll('[data-section-link]').forEach(link => {
            link.classList.toggle('is-active', link.dataset.sectionLink === sectionId);
        });
    }

    setupDurationInputs(document);
    toggleEmptyStates();
    updateItemNumbers();

    editor.querySelectorAll('[data-section-link]').forEach(link => {
        link.addEventListener('click', event => {
            const section = document.getElementById(link.dataset.sectionLink);
            if (!section) return;

            event.preventDefault();
            setActiveSection(section.id);
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
            const visibleSection = entries
                .filter(entry => entry.isIntersecting)
                .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

            if (visibleSection) setActiveSection(visibleSection.target.id);
        }, { rootMargin: '-15% 0px -65% 0px', threshold: [0, .15, .4] });

        editor.querySelectorAll('[data-editor-section]').forEach(section => observer.observe(section));
    }

    editor.addEventListener('click', function (e) {
        const addItemButton = e.target.closest('.add-item');
        const removeItemButton = e.target.closest('.remove-item');
        const addAnswerButton = e.target.closest('.add-answer');

        if (addItemButton) {
            e.preventDefault();
            addItem(addItemButton);
        } else if (removeItemButton) {
            e.preventDefault();
            removeItem(removeItemButton);
        } else if (addAnswerButton) {
            e.preventDefault();
            addAnswer(addAnswerButton);
        }
    });

    form.addEventListener('input', markDirty);
    form.addEventListener('change', markDirty);

    form.addEventListener('submit', function() {
        form.querySelectorAll('.duration-minutes').forEach(input => {
            const targetName = input.dataset.target;
            const secondsInput = form.querySelector(`[name="${targetName}"]`);
            if (secondsInput && input.value) {
                const minutes = parseFloat(input.value) || 0;
                secondsInput.value = Math.round(minutes * 60);
            }
        });

        form.dataset.submitting = 'true';

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i><span>Saving…</span>';
        }

        if (saveStatus) {
            saveStatus.innerHTML = '<i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><span>Saving your course…</span>';
            saveStatus.classList.remove('is-dirty');
        }
    });
});
</script>


