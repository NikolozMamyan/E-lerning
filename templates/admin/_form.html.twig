{{ form_start(form, {'attr': {'class': 'course-form'}}) }}

<div class="form-section">
    <h2>Informations du cours</h2>
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
</div>

<hr>
<div class="form-section">
    <h2>Vidéos</h2>
    <div id="course_videos"
         data-prototype="{{ form_widget(form.videos.vars.prototype)|e('html_attr') }}"
         data-index="{{ form.videos|length }}">
        {% for videoForm in form.videos %}
            <div class="video-item card">
                {{ form_row(videoForm.title) }}
                {{ form_row(videoForm.description) }}
                {{ form_row(videoForm.duration) }}
                {{ form_row(videoForm.url) }}
                <button type="button" class="btn btn-danger btn-small remove-item">Supprimer</button>
            </div>
        {% endfor %}
    </div>
    <button type="button" class="btn btn-primary btn-small add-item" data-target="#course_videos">+ Ajouter une vidéo</button>
</div>

<hr>
<div class="form-section">
    <h2>Quiz</h2>
    <div id="course_questions"
         data-prototype="{{ form_widget(form.quizQuestions.vars.prototype)|e('html_attr') }}"
         data-index="{{ form.quizQuestions|length }}">
        {% for qForm in form.quizQuestions %}
            <div class="question-item card">
                {{ form_row(qForm.question) }}

                <div class="answers"
                     data-prototype="{{ form_widget(qForm.answers.vars.prototype)|e('html_attr') }}"
                     data-index="{{ qForm.answers|length }}">
                    {% for aForm in qForm.answers %}
                        <div class="answer-item">
                            {{ form_row(aForm.text) }}
                            {{ form_row(aForm.isCorrect) }}
                            <button type="button" class="btn btn-danger btn-small remove-item">Supprimer</button>
                        </div>
                    {% endfor %}
                </div>

                {# <button type="button" class="btn btn-sm btn-secondary add-answer">+ Ajouter une réponse</button> #}
                <button type="button" class="btn btn-sm btn-danger remove-item">Supprimer la question</button>
            </div>
        {% endfor %}
    </div>
    <button type="button" class="btn btn-primary btn-small add-item" data-target="#course_questions">+ Ajouter une question</button>
</div>

<hr>
<div class="form-actions">
    <button class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
    <a href="{{ path('admin_course_index') }}" class="btn btn-secondary">Retour</a>
</div>

{{ form_end(form) }}

<style>
.course-form {
    padding: 2rem;
    background: var(--bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.form-section {
    margin-bottom: 2rem;
}

.form-section h2 {
    font-size: 1.3rem;
    color: var(--green);
    margin-bottom: 1rem;
}

.card {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1rem;
    margin-bottom: 1rem;
}

.answer-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
}

.answer-item .form-check {
    margin-top: 0.5rem;
}

.form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
}

.btn {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    border-radius: var(--radius);
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    text-decoration: none;
}

.btn-small {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
}

.btn-primary {
    background: var(--teal);
    color: var(--white);
}

.btn-primary:hover {
    opacity: 0.9;
}

.btn-secondary {
    background: var(--mint);
    color: var(--black);
}

.btn-secondary:hover {
    background: var(--grey);
    color: var(--white);
}

.btn-danger {
    background: #e74c3c;
    color: var(--white);
}

.btn-success {
    background: var(--green);
    color: var(--white);
}
</style>

<script>
document.addEventListener('click', function (e) {
    // Ajouter un élément (vidéo ou question)
    if (e.target.classList.contains('add-item')) {
        const target = document.querySelector(e.target.dataset.target);
        const index = target.dataset.index;
        const proto = target.dataset.prototype.replace(/__name__/g, index);
        const div = document.createElement('div');
        div.innerHTML = proto;
        target.appendChild(div);
        target.dataset.index = parseInt(index) + 1;
    }

    // Ajouter une réponse
    if (e.target.classList.contains('add-answer')) {
        const answers = e.target.closest('.question-item').querySelector('.answers');
        const index = answers.dataset.index;
        const proto = answers.dataset.prototype.replace(/__name__/g, index);
        const div = document.createElement('div');
        div.innerHTML = proto;
        answers.appendChild(div);
        answers.dataset.index = parseInt(index) + 1;
    }

    // Supprimer un élément
    if (e.target.classList.contains('remove-item')) {
        e.preventDefault();
        e.target.closest('.video-item, .question-item, .answer-item').remove();
    }
});
</script>