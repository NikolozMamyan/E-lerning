{% extends 'base.html.twig' %}

{% block title %}SCORM Generator{% endblock %}

{% block body %}
<div class="scorm-page">
    <header class="scorm-header">
        <div>
            <span class="scorm-kicker">SCORM 1.2</span>
            <h1>SCORM Generator</h1>
            <p>Upload one localized MP4 per language, then download a ready-to-import SCORM package.</p>
        </div>
        <div class="scorm-limit">
            <span>Package limit</span>
            <strong>{{ (maxPackageSize / 1024 / 1024 / 1024)|number_format(1, '.', '') }} GB</strong>
        </div>
    </header>

    <section class="scorm-panel course-picker">
        <form method="get" action="{{ path('admin_scorm_generator') }}">
            <label for="course-select">Choose a course</label>
            <div class="select-wrap">
                <select id="course-select" name="course" onchange="this.form.submit()">
                    <option value="">Select a course</option>
                    {% for course in courses %}
                        <option value="{{ course.id }}" {{ selectedCourse and selectedCourse.id == course.id ? 'selected' : '' }}>
                            {{ course.title }}
                        </option>
                    {% endfor %}
                </select>
                <span aria-hidden="true">⌄</span>
            </div>
        </form>
    </section>

    {% if selectedCourse %}
        <section class="course-summary">
            <div>
                <span class="summary-label">Selected course</span>
                <h2>{{ selectedCourse.title }}</h2>
            </div>
            <div class="summary-pill">
                <span class="status-dot"></span>
                One video per package
            </div>
        </section>

        {% if courseError %}
            <div class="scorm-alert" role="alert">{{ courseError }}</div>
        {% else %}
            <div class="language-grid">
                {% for status in languageStatuses %}
                    <article id="language-{{ status.language.value }}" class="language-card {{ status.ready ? 'is-ready' : 'is-missing' }}">
                        <div class="language-heading">
                            <div>
                                <span class="language-code">{{ status.language.value|upper }}</span>
                                <h3>{{ status.language.label }}</h3>
                            </div>
                            <span class="readiness-badge">{{ status.ready ? 'Ready' : 'Missing file or title' }}</span>
                        </div>

                        <form method="post" enctype="multipart/form-data" action="{{ path('admin_scorm_video_upload', {id: video.id}) }}" class="language-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('scorm_upload_' ~ video.id) }}">
                            <input type="hidden" name="language" value="{{ status.language.value }}">

                            <label for="title-{{ status.language.value }}">Localized title</label>
                            <input id="title-{{ status.language.value }}" type="text" name="title" maxlength="255" required value="{{ status.title }}" placeholder="Enter the {{ status.language.label|lower }} title">

                            <label for="video-{{ status.language.value }}">MP4 video</label>
                            <label class="file-drop" for="video-{{ status.language.value }}">
                                <span class="file-icon">↑</span>
                                <span>
                                    <strong>{{ status.fileExists ? 'Replace MP4' : 'Choose MP4 file' }}</strong>
                                    <small>{{ status.filename ?: 'No file uploaded' }}</small>
                                </span>
                            </label>
                            <input id="video-{{ status.language.value }}" class="file-input" type="file" name="video" accept="video/mp4,.mp4" {{ status.fileExists ? '' : 'required' }}>

                            <button type="submit" class="save-button">{{ status.fileExists ? 'Save changes' : 'Upload video' }}</button>
                        </form>

                        {% if status.ready %}
                            <a href="{{ path('admin_scorm_export', {id: selectedCourse.id, language: status.language.value}) }}" class="download-button">Download {{ status.language.label }} SCORM ZIP</a>
                        {% else %}
                            <button type="button" class="download-button is-disabled" disabled>Complete this language to download</button>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    {% else %}
        <section class="empty-state">
            <div class="empty-icon">▣</div>
            <h2>Select a course to begin</h2>
            <p>Its English, French and German SCORM versions will appear here.</p>
        </section>
    {% endif %}
</div>

<script>
document.querySelectorAll('.file-input').forEach(function(input){input.addEventListener('change',function(){var label=input.previousElementSibling;var name=label.querySelector('small');var action=label.querySelector('strong');if(input.files&&input.files[0]){name.textContent=input.files[0].name;action.textContent='Selected MP4'}})})
</script>

<style>
.scorm-page{max-width:1200px;margin:0 auto;padding:32px;color:#071717}.scorm-header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:26px}.scorm-kicker,.summary-label{color:#0d8383;font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.scorm-header h1{font-size:2.25rem;margin:4px 0 8px}.scorm-header p{color:#60706d;margin:0;max-width:680px}.scorm-limit{background:#e7f3f3;border:1px solid #c5dddd;border-radius:14px;padding:14px 20px;text-align:right}.scorm-limit span{display:block;color:#60706d;font-size:.8rem}.scorm-limit strong{color:#1a6d55;font-size:1.2rem}.scorm-panel,.course-summary,.language-card,.empty-state{background:#fff;border:1px solid #dce8e5;border-radius:18px;box-shadow:0 10px 30px rgba(7,23,23,.07)}.course-picker{padding:22px;margin-bottom:22px}.course-picker label,.language-form>label:first-of-type,.language-form>label:nth-of-type(2){display:block;font-weight:700;margin-bottom:8px}.select-wrap{position:relative}.select-wrap select{appearance:none;background:#f8fbfa;border:1px solid #cbdad7;border-radius:11px;color:#071717;font-size:1rem;padding:13px 46px 13px 14px;width:100%}.select-wrap span{pointer-events:none;position:absolute;right:16px;top:10px;font-size:1.35rem}.course-summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 24px;margin-bottom:22px}.course-summary h2{margin:3px 0 0}.summary-pill{display:flex;align-items:center;gap:8px;background:#eff8f5;border-radius:999px;color:#1a6d55;font-weight:700;padding:9px 14px}.status-dot{background:#23a36d;border-radius:50%;height:9px;width:9px}.language-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.language-card{overflow:hidden;padding:22px}.language-card.is-ready{border-top:4px solid #1a6d55}.language-card.is-missing{border-top:4px solid #d6a044}.language-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:22px}.language-code{color:#0d8383;font-size:.75rem;font-weight:900;letter-spacing:.12em}.language-heading h3{font-size:1.35rem;margin:2px 0}.readiness-badge{background:#f3f7f6;border-radius:999px;color:#60706d;font-size:.72rem;font-weight:800;padding:6px 9px;text-align:center}.is-ready .readiness-badge{background:#e5f5ed;color:#176c47}.language-form input[type=text]{border:1px solid #cbdad7;border-radius:10px;font-size:.95rem;margin-bottom:18px;padding:11px 12px;width:100%}.file-drop{align-items:center;background:#f8fbfa;border:1px dashed #9cbab3;border-radius:11px;cursor:pointer;display:flex;gap:12px;margin-bottom:14px;padding:13px}.file-icon{align-items:center;background:#e7f3f3;border-radius:9px;color:#1a6d55;display:flex;font-size:1.25rem;height:38px;justify-content:center;width:38px}.file-drop span:last-child{min-width:0}.file-drop strong,.file-drop small{display:block}.file-drop small{color:#71807d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.file-input{position:absolute;left:-9999px}.save-button,.download-button{border-radius:10px;display:block;font-weight:800;padding:11px 14px;text-align:center;text-decoration:none;width:100%}.save-button{background:#e7f3f3;border:0;color:#1a6d55;cursor:pointer;margin-bottom:10px}.download-button{background:#1a6d55;border:0;color:#fff}.download-button.is-disabled{background:#d8e0de;color:#82908d;cursor:not-allowed}.scorm-alert{background:#fff0f0;border:1px solid #efc4c4;border-radius:12px;color:#a92727;font-weight:700;padding:16px}.empty-state{padding:64px 24px;text-align:center}.empty-icon{color:#0d8383;font-size:2.5rem}.empty-state h2{margin:12px 0 6px}.empty-state p{color:#71807d;margin:0}@media(max-width:950px){.language-grid{grid-template-columns:1fr}.scorm-header{align-items:flex-start;flex-direction:column}.scorm-limit{text-align:left}.course-summary{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.scorm-page{padding:18px}.scorm-header h1{font-size:1.8rem}.course-summary{padding:18px}}
</style>
{% endblock %}
