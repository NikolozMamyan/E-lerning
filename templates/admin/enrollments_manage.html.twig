{% extends 'base.html.twig' %}

{% block title %}Gestion des inscriptions{% endblock %}

{% block stylesheets %}
<style>
    .enrollment-container {
        background: var(--bg);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .page-header {
        background: var(--white);
        padding: 2rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 2rem;
    }

    .page-header h1 {
        color: var(--black);
        margin: 0 0 0.5rem 0;
        font-size: 1.75rem;
        font-weight: 600;
    }

    .page-header p {
        color: var(--grey);
        margin: 0;
    }

    .search-panel {
        background: var(--white);
        padding: 1.5rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 1.5rem;
    }

    .search-form {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .search-input {
        flex: 1;
        padding: 0.75rem 1rem;
        border: 2px solid var(--mint);
        border-radius: var(--radius);
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .search-input:focus {
        outline: none;
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(13, 131, 131, 0.1);
    }

    .btn-search {
        padding: 0.75rem 1.5rem;
        background: var(--teal);
        color: var(--white);
        border: none;
        border-radius: var(--radius);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
        white-space: nowrap;
    }

    .btn-search:hover {
        background: var(--green);
        transform: translateY(-1px);
        box-shadow: var(--shadow);
    }

    .btn-reset {
        padding: 0.75rem 1rem;
        background: var(--mint);
        color: var(--green);
        border: none;
        border-radius: var(--radius);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-reset:hover {
        background: var(--green);
        color: var(--white);
    }

    .users-panel {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        height: fit-content;
        position: sticky;
        top: 2rem;
    }

    .panel-header {
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, var(--green), var(--teal));
        color: var(--white);
        font-weight: 600;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .user-count {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .users-list {
        max-height: 60vh;
        overflow-y: auto;
        padding: 0;
        margin: 0;
    }

    .users-list::-webkit-scrollbar {
        width: 8px;
    }

    .users-list::-webkit-scrollbar-track {
        background: var(--mint);
    }

    .users-list::-webkit-scrollbar-thumb {
        background: var(--teal);
        border-radius: 4px;
    }

    .user-item {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--mint);
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
    }

    .user-item:hover {
        background: var(--mint);
        transform: translateX(4px);
    }

    .user-item.selected {
        background: linear-gradient(90deg, var(--mint), transparent);
        border-left: 4px solid var(--teal);
    }

    .user-email {
        color: var(--black);
        font-weight: 600;
        margin-bottom: 0.25rem;
        font-size: 0.95rem;
    }

    .user-name {
        color: var(--grey);
        font-size: 0.85rem;
    }

    .user-checkbox {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        accent-color: var(--teal);
    }

    .courses-panel {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.25rem;
        padding: 1.5rem;
    }

    .course-card {
        background: var(--white);
        border: 2px solid var(--mint);
        border-radius: var(--radius);
        padding: 1.5rem;
        transition: all 0.3s;
        cursor: pointer;
        position: relative;
    }

    .course-card:hover {
        border-color: var(--teal);
        box-shadow: var(--shadow);
        transform: translateY(-2px);
    }

    .course-title {
        color: var(--black);
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
    }

    .course-description {
        color: var(--grey);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 1.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .enroll-btn {
        width: 100%;
        padding: 0.75rem;
        background: var(--teal);
        color: var(--white);
        border: none;
        border-radius: var(--radius);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
        font-size: 0.95rem;
    }

    .enroll-btn:hover:not(:disabled) {
        background: var(--green);
        transform: translateY(-1px);
        box-shadow: var(--shadow);
    }

    .enroll-btn:disabled {
        background: var(--grey);
        cursor: not-allowed;
        opacity: 0.5;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1.5rem;
        color: var(--grey);
    }

    .empty-state svg {
        width: 80px;
        height: 80px;
        margin-bottom: 1rem;
        opacity: 0.3;
    }

    .selection-summary {
        background: var(--mint);
        padding: 1rem 1.5rem;
        border-radius: var(--radius);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .summary-text {
        color: var(--green);
        font-weight: 600;
    }

    .btn-bulk-action {
        padding: 0.5rem 1.25rem;
        background: var(--green);
        color: var(--white);
        border: none;
        border-radius: var(--radius);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-bulk-action:hover {
        background: var(--teal);
        box-shadow: var(--shadow);
    }
</style>
{% endblock %}

{% block body %}
        
        <div class="page-header">
            <h1>🎓 Gestion des inscriptions</h1>
            <p>Sélectionnez des utilisateurs et inscrivez-les aux cours de votre choix</p>
        </div>

        <div class="search-panel">
            <form method="get" class="search-form">
                <input type="text" 
                       name="email" 
                       class="search-input"
                       value="{{ email }}" 
                       placeholder="🔍 Rechercher un utilisateur par email...">
                <button type="submit" class="btn-search">Rechercher</button>
                {% if email %}
                <a href="{{ path('admin_enrollments_manage') }}" class="btn-reset">Réinitialiser</a>
                {% endif %}
            </form>
        </div>

        <div id="selection-summary" class="selection-summary" style="display: none;">
            <span class="summary-text">
                <span id="selected-count">0</span> utilisateur(s) sélectionné(s)
            </span>
            <button type="button" class="btn-bulk-action" onclick="clearSelection()">
                Effacer la sélection
            </button>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="users-panel">
                    <div class="panel-header">
                        <span>👥 Utilisateurs</span>
                        <span class="user-count">{{ users|length }}</span>
                    </div>
                    <div class="users-list">
                        {% for u in users %}
                            <div class="user-item" data-user-id="{{ u.id }}" onclick="toggleUser({{ u.id }}, '{{ u.email }}')">
                                <div class="user-email">{{ u.email }}</div>
                                <div class="user-name">{{ u.username }}</div>
                                <input type="checkbox" class="user-checkbox" id="user-{{ u.id }}">
                            </div>
                        {% else %}
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <p>Aucun utilisateur trouvé</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="courses-panel">
                    <div class="panel-header">
                        <span>📚 Cours disponibles</span>
                        <span class="user-count">{{ courses|length }}</span>
                    </div>
                    <div class="courses-grid">
                        {% for c in courses %}
                            <div class="course-card">
                                <div class="course-title">{{ c.title }}</div>
                                <div class="course-description">{{ c.description }}</div>
                                <button type="button" 
                                        class="enroll-btn" 
                                        data-course-id="{{ c.id }}"
                                        data-course-title="{{ c.title }}"
                                        onclick="enrollSelected({{ c.id }}, '{{ c.title }}')">
                                    ✓ Inscrire les utilisateurs sélectionnés
                                </button>
                            </div>
                        {% else %}
                            <div class="empty-state">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                </svg>
                                <p>Aucun cours disponible</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>


<script>
let selectedUsers = new Set();

function toggleUser(userId, email) {
    const checkbox = document.getElementById('user-' + userId);
    const userItem = document.querySelector(`[data-user-id="${userId}"]`);
    
    if (selectedUsers.has(userId)) {
        selectedUsers.delete(userId);
        checkbox.checked = false;
        userItem.classList.remove('selected');
    } else {
        selectedUsers.add(userId);
        checkbox.checked = true;
        userItem.classList.add('selected');
    }
    
    updateSelectionSummary();
    updateEnrollButtons();
}

function updateSelectionSummary() {
    const summary = document.getElementById('selection-summary');
    const count = document.getElementById('selected-count');
    
    count.textContent = selectedUsers.size;
    summary.style.display = selectedUsers.size > 0 ? 'flex' : 'none';
}

function updateEnrollButtons() {
    const buttons = document.querySelectorAll('.enroll-btn');
    buttons.forEach(btn => {
        btn.disabled = selectedUsers.size === 0;
    });
}

function clearSelection() {
    selectedUsers.clear();
    document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
    document.querySelectorAll('.user-item').forEach(item => item.classList.remove('selected'));
    updateSelectionSummary();
    updateEnrollButtons();
}

function enrollSelected(courseId, courseTitle) {
    if (selectedUsers.size === 0) {
        alert('Veuillez sélectionner au moins un utilisateur');
        return;
    }
    
    const count = selectedUsers.size;
    if (!confirm(`Voulez-vous vraiment inscrire ${count} utilisateur(s) au cours "${courseTitle}" ?`)) {
        return;
    }
    
    // Créer un formulaire pour envoyer toutes les inscriptions
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '{{ path("admin_enrollment_bulk") }}';
    
    const courseInput = document.createElement('input');
    courseInput.type = 'hidden';
    courseInput.name = 'courseId';
    courseInput.value = courseId;
    form.appendChild(courseInput);
    
    selectedUsers.forEach(userId => {
        const userInput = document.createElement('input');
        userInput.type = 'hidden';
        userInput.name = 'userIds[]';
        userInput.value = userId;
        form.appendChild(userInput);
    });
    
    document.body.appendChild(form);
    form.submit();
}

// Initialiser l'état des boutons au chargement
document.addEventListener('DOMContentLoaded', function() {
    updateEnrollButtons();
});
</script>
{% endblock %}