{% extends 'base.html.twig' %}

{% block title %}Gestion des inscriptions{% endblock %}

{% block stylesheets %}
<style>
/* ---- STYLES GLOBAUX IDENTIQUES À TA VERSION ---- */

.enrollment-container {
    background: var(--bg);
    min-height: 100vh;
    padding: 2rem 0;
}

/* ======= HEADER ======= */
.page-header {
    background: var(--white);
    padding: 2rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
}
.page-header h1 { color: var(--black); margin: 0 0 0.5rem; font-size: 1.75rem; font-weight: 600; }
.page-header p { color: var(--grey); }

/* ======= PANEL RECHERCHE ======= */
.search-panel {
    background: var(--white);
    padding: 1.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 1.5rem;
}
.search-form { display: flex; gap: .75rem; }
.search-input {
    flex: 1; padding: .75rem 1rem; border: 2px solid var(--mint); border-radius: var(--radius);
}
.btn-search { padding: .75rem 1.5rem; background: var(--teal); color: white; border-radius: var(--radius); }
.btn-reset { padding: .75rem 1rem; background: var(--mint); color: var(--green); border-radius: var(--radius); }

/* ======= PANNEAU UTILISATEURS ======= */
.users-panel {
    background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow);
    overflow: hidden; position: sticky; top: 2rem;
}
.panel-header {
    padding: 1.25rem 1.5rem; background: linear-gradient(135deg, var(--green), var(--teal));
    color: white; font-weight: 600; font-size: 1.1rem; display: flex; justify-content: space-between;
}
.users-list { max-height: 60vh; overflow-y: auto; }
.user-item {
    padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--mint); cursor: pointer;
    transition: .3s; position: relative;
}
.user-item:hover { background: var(--mint); }
.user-item.selected {
    background: linear-gradient(90deg, var(--mint), transparent); border-left: 4px solid var(--teal);
}
.user-checkbox { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); }

/* ======= PANNEAU COURS ======= */
.courses-panel {
    background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow);
}
.courses-grid {
    display: grid; gap: 1rem; padding: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
}
.course-card {
    padding: 1.5rem; border: 2px solid var(--mint); border-radius: var(--radius);
    cursor: pointer; transition: .3s;
}
.course-card:hover { border-color: var(--teal); }
.course-card.selected { border-color: var(--teal); background: var(--mint); }

/* ======= SECTION RÉSUMÉ ======= */
.selection-summary {
    background: var(--mint); padding: 1rem 1.5rem; border-radius: var(--radius);
    display: none; margin-bottom: 1.5rem; justify-content: space-between; align-items: center;
}
.summary-text { font-weight: 600; color: var(--green); }
.btn-bulk-action {
    padding: .75rem 1.5rem; background: var(--green); color: white;
    border-radius: var(--radius); cursor: pointer;
}

/* ======= BOUTON GLOBAL ======= */
#global-enroll-btn {
    width: 100%; padding: 1rem; margin-top: 1.5rem;
    background: var(--teal); color: white; border-radius: var(--radius);
    font-size: 1.2rem; font-weight: 600; cursor: pointer;
}
#global-enroll-btn:disabled {
    background: var(--grey); cursor: not-allowed; opacity: .5;
}
</style>
{% endblock %}

{% block body %}

<div class="page-header">
    <h1>🎓 Gestion des inscriptions</h1>
    <p>Sélectionnez des utilisateurs et des cours avant d’inscrire</p>
</div>

<div class="search-panel">
    <form method="get" class="search-form">
        <input type="text" name="email" class="search-input" value="{{ email }}" placeholder="🔍 Rechercher un utilisateur par email...">
        <button type="submit" class="btn-search">Rechercher</button>
        {% if email %}
            <a href="{{ path('admin_enrollments_manage') }}" class="btn-reset">Réinitialiser</a>
        {% endif %}
    </form>
</div>

<!-- Résumé des sélections -->
<div id="selection-summary" class="selection-summary">
    <span class="summary-text">
        <span id="selected-users-count">0</span> utilisateur(s) — 
        <span id="selected-courses-count">0</span> cours sélectionnés
    </span>
    <button class="btn-bulk-action" onclick="clearAllSelection()">Effacer tout</button>
</div>

<div class="row">
    <!-- PANEL UTILISATEURS -->
    <div class="col-md-4">
        <div class="users-panel">
            <div class="panel-header">
                👥 Utilisateurs
                <span class="user-count">{{ users|length }}</span>
            </div>

            <div class="users-list">
                {% for u in users %}
                    <div class="user-item" data-user-id="{{ u.id }}" onclick="toggleUser({{ u.id }})">
                        <div class="user-email">{{ u.email }}</div>
                        <div class="user-name">{{ u.username }}</div>
                        <input type="checkbox" class="user-checkbox" id="user-{{ u.id }}">
                    </div>
                {% else %}
                    <p class="p-3 text-muted">Aucun utilisateur trouvé</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- PANEL COURS -->
    <div class="col-md-8">
        <div class="courses-panel">
            <div class="panel-header">
                📚 Cours disponibles
                <span class="user-count">{{ courses|length }}</span>
            </div>

            <div class="courses-grid">
                {% for c in courses %}
                    <div class="course-card" data-course-id="{{ c.id }}" onclick="toggleCourse({{ c.id }})">
                        <div class="course-title">{{ c.title }}</div>
                        <div class="course-description">  {{ c.description|slice(0, 100)}} ...</div>
                    </div>
                {% else %}
                    <p class="p-3 text-muted">Aucun cours disponible</p>
                {% endfor %}
            </div>

            <!-- BOUTON GLOBAL -->
            <button id="global-enroll-btn" onclick="enrollAll()" disabled>
                ✓ Inscrire toutes les sélections
            </button>
        </div>
    </div>
</div>

<script>
/* ===============================
   VARIABLES GLOBALES
================================ */
let selectedUsers = new Set();
let selectedCourses = new Set();

/* ===============================
   SÉLECTION UTILISATEURS
================================ */
function toggleUser(id) {
    const box = document.getElementById("user-" + id);
    const item = document.querySelector(`[data-user-id="${id}"]`);

    if (selectedUsers.has(id)) {
        selectedUsers.delete(id);
        box.checked = false;
        item.classList.remove("selected");
    } else {
        selectedUsers.add(id);
        box.checked = true;
        item.classList.add("selected");
    }

    updateSummary();
    updateGlobalButton();
}

/* ===============================
   SÉLECTION COURS
================================ */
function toggleCourse(id) {
    const card = document.querySelector(`[data-course-id="${id}"]`);

    if (selectedCourses.has(id)) {
        selectedCourses.delete(id);
        card.classList.remove("selected");
    } else {
        selectedCourses.add(id);
        card.classList.add("selected");
    }

    updateSummary();
    updateGlobalButton();
}

/* ===============================
   RÉSUMÉ DES SÉLECTIONS
================================ */
function updateSummary() {
    document.getElementById("selected-users-count").textContent = selectedUsers.size;
    document.getElementById("selected-courses-count").textContent = selectedCourses.size;

    const summary = document.getElementById("selection-summary");
    summary.style.display = (selectedUsers.size + selectedCourses.size > 0) ? "flex" : "none";
}

/* ===============================
   BOUTON GLOBAL
================================ */
function updateGlobalButton() {
    const btn = document.getElementById("global-enroll-btn");

    btn.disabled = !(selectedUsers.size > 0 && selectedCourses.size > 0);
}

/* ===============================
   EFFACER TOUTE LA SÉLECTION
================================ */
function clearAllSelection() {
    selectedUsers.clear();
    selectedCourses.clear();

    document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
    document.querySelectorAll('.user-item').forEach(i => i.classList.remove('selected'));
    document.querySelectorAll('.course-card').forEach(c => c.classList.remove('selected'));

    updateSummary();
    updateGlobalButton();
}

/* ===============================
   INSCRIPTION GLOBALE
================================ */
function enrollAll() {
    if (selectedUsers.size === 0 || selectedCourses.size === 0) {
        alert("Veuillez sélectionner au moins 1 utilisateur et 1 cours.");
        return;
    }

    if (!confirm(`Inscrire ${selectedUsers.size} utilisateur(s) à ${selectedCourses.size} cours ?`)) {
        return;
    }

    const form = document.createElement("form");
    form.method = "POST";
    form.action = "{{ path('admin_enrollment_bulk') }}";

    selectedUsers.forEach(id => {
        let input = document.createElement("input");
        input.type = "hidden";
        input.name = "userIds[]";
        input.value = id;
        form.appendChild(input);
    });

    selectedCourses.forEach(id => {
        let input = document.createElement("input");
        input.type = "hidden";
        input.name = "courseIds[]";
        input.value = id;
        form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();
}
</script>

{% endblock %}
