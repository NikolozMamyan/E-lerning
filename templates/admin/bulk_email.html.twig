{% extends 'base.html.twig' %}

{% block title %}Email groupé{% endblock %}

{% block stylesheets %}
<style>
.bulk-mail-container {
    min-height: 100vh;
    padding: 2rem 0;
}

.mail-header,
.mail-card,
.mail-users-panel {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.mail-header {
    padding: 2rem;
    margin-bottom: 1.5rem;
}

.mail-header h1 {
    margin: 0 0 .5rem;
    font-size: 1.75rem;
}

.mail-layout {
    display: grid;
    grid-template-columns: minmax(320px, 380px) minmax(0, 1fr);
    gap: 1.5rem;
}

.mail-users-panel {
    overflow: hidden;
    position: sticky;
    top: 2rem;
}

.panel-header {
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, var(--green), var(--teal));
    color: white;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.panel-body {
    padding: 1rem;
}

.search-input,
.mail-input,
.mail-textarea {
    width: 100%;
    border: 2px solid var(--mint);
    border-radius: var(--radius);
    padding: .85rem 1rem;
    background: #fff;
}

.mail-input,
.mail-textarea {
    margin-top: .4rem;
}

.mail-textarea {
    min-height: 180px;
    resize: vertical;
}

.users-list {
    max-height: 65vh;
    overflow-y: auto;
    margin-top: 1rem;
}

.user-item {
    border: 1px solid #e7efe9;
    border-radius: 14px;
    padding: .85rem 1rem;
    cursor: pointer;
    transition: .2s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
}

.user-item + .user-item {
    margin-top: .75rem;
}

.user-item:hover {
    border-color: var(--teal);
    background: #f5fffb;
}

.user-item.selected {
    border-color: var(--teal);
    background: linear-gradient(90deg, rgba(94, 210, 176, 0.22), rgba(94, 210, 176, 0));
}

.user-meta {
    min-width: 0;
}

.user-email {
    font-weight: 600;
    word-break: break-word;
}

.user-name {
    color: var(--grey);
    font-size: .92rem;
}

.mail-card {
    padding: 1.5rem;
}

.mail-grid {
    display: grid;
    gap: 1.25rem;
}

.field-label {
    display: block;
    font-weight: 600;
    color: var(--black);
}

.helper-text {
    margin-top: .35rem;
    color: var(--grey);
    font-size: .92rem;
}

.selection-box {
    border: 1px solid #e7efe9;
    border-radius: 16px;
    padding: 1rem;
    background: #fbfdfc;
}

.selection-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: .75rem;
}

.selection-count {
    font-weight: 700;
    color: var(--green);
}

.chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
}

.chip {
    display: inline-flex;
    align-items: center;
    padding: .45rem .75rem;
    border-radius: 999px;
    background: var(--mint);
    color: var(--green);
    font-size: .92rem;
}

.chip.manual {
    background: #eef6ff;
    color: #1d4d7c;
}

.empty-state {
    color: var(--grey);
    font-size: .95rem;
}

.mail-actions {
    display: flex;
    justify-content: flex-end;
    gap: .75rem;
}

.btn-primary-mail,
.btn-secondary-mail {
    border: 0;
    border-radius: var(--radius);
    padding: .9rem 1.25rem;
    cursor: pointer;
    font-weight: 600;
}

.btn-primary-mail {
    background: var(--teal);
    color: white;
}

.btn-primary-mail:disabled {
    opacity: .55;
    cursor: not-allowed;
}

.btn-secondary-mail {
    background: var(--mint);
    color: var(--green);
}

@media (max-width: 991px) {
    .mail-layout {
        grid-template-columns: 1fr;
    }

    .mail-users-panel {
        position: static;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="bulk-mail-container">
    <div class="mail-header">
        <h1>Envoi d'email groupé</h1>
        <p>Sélectionnez des utilisateurs, ajoutez si besoin des emails en copie, puis envoyez votre message.</p>
    </div>

    <form method="post" id="bulk-mail-form">
        <div class="mail-layout">
            <aside class="mail-users-panel">
                <div class="panel-header">
                    <span>Utilisateurs</span>
                    <span>{{ users|length }}</span>
                </div>
                <div class="panel-body">
                    <input
                        type="text"
                        id="user-search"
                        class="search-input"
                        placeholder="Rechercher par email ou nom..."
                    >

                    <div class="users-list" id="users-list">
                        {% for user in users %}
                            <div
                                class="user-item"
                                data-user-id="{{ user.id }}"
                                data-user-email="{{ user.email|lower }}"
                                data-user-email-label="{{ user.email }}"
                                data-user-name="{{ (user.username ?? '')|lower }}"
                            >
                                <div class="user-meta">
                                    <div class="user-email">{{ user.email }}</div>
                                    <div class="user-name">{{ user.username ?: 'Sans nom' }}</div>
                                </div>
                                <input
                                    type="checkbox"
                                    class="user-checkbox"
                                    value="{{ user.id }}"
                                    aria-label="Sélectionner {{ user.email }}"
                                >
                            </div>
                        {% else %}
                            <p class="empty-state">Aucun utilisateur disponible.</p>
                        {% endfor %}
                    </div>
                </div>
            </aside>

            <section class="mail-card">
                <div class="mail-grid">
                    <div class="selection-box">
                        <div class="selection-header">
                            <span class="selection-count"><span id="selected-users-count">0</span> destinataire(s) sélectionné(s)</span>
                            <button type="button" class="btn-secondary-mail" id="clear-users-btn">Effacer la sélection</button>
                        </div>
                        <div class="chip-list" id="selected-users-feedback">
                            <span class="empty-state">Aucun utilisateur sélectionné.</span>
                        </div>
                    </div>

                    <div>
                        <label for="subject" class="field-label">Sujet</label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            class="mail-input"
                            value="{{ subject }}"
                            required
                        >
                    </div>

                    <div>
                        <label for="cc_emails" class="field-label">Emails en copie</label>
                        <textarea
                            id="cc_emails"
                            name="cc_emails"
                            class="mail-textarea"
                            placeholder="Ajoutez un ou plusieurs emails, séparés par une virgule, un espace ou un retour à la ligne."
                        >{{ ccEmailsText }}</textarea>
                        <p class="helper-text">Ces adresses recevront l'email en copie visible.</p>
                    </div>

                    <div class="selection-box">
                        <div class="selection-header">
                            <span class="selection-count">Copie manuelle détectée</span>
                        </div>
                        <div class="chip-list" id="manual-cc-feedback">
                            <span class="empty-state">Aucun email en copie saisi.</span>
                        </div>
                    </div>

                    <div>
                        <label for="message" class="field-label">Message</label>
                        <textarea
                            id="message"
                            name="message"
                            class="mail-textarea"
                            placeholder="Tapez votre message ici..."
                            required
                        >{{ message }}</textarea>
                    </div>

                    <div id="selected-user-inputs"></div>

                    <div class="mail-actions">
                        <button type="button" class="btn-secondary-mail" id="reset-form-btn">Réinitialiser</button>
                        <button type="submit" class="btn-primary-mail" id="submit-mail-btn">Envoyer l'email</button>
                    </div>
                </div>
            </section>
        </div>
    </form>
</div>

<script>
const preselectedUserIds = {{ preselectedUserIds|json_encode|raw }};
const selectedUsers = new Map();
const selectedUserInputContainer = document.getElementById('selected-user-inputs');
const selectedUsersFeedback = document.getElementById('selected-users-feedback');
const manualCcFeedback = document.getElementById('manual-cc-feedback');
const selectedUsersCount = document.getElementById('selected-users-count');
const submitMailBtn = document.getElementById('submit-mail-btn');
const ccTextarea = document.getElementById('cc_emails');
const userSearch = document.getElementById('user-search');

function renderSelectedUserInputs() {
    selectedUserInputContainer.innerHTML = '';

    selectedUsers.forEach((user) => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'user_ids[]';
        input.value = user.id;
        selectedUserInputContainer.appendChild(input);
    });
}

function renderSelectedUsersFeedback() {
    selectedUsersCount.textContent = String(selectedUsers.size);

    if (selectedUsers.size === 0) {
        selectedUsersFeedback.innerHTML = '<span class="empty-state">Aucun utilisateur sélectionné.</span>';
        submitMailBtn.disabled = true;
        return;
    }

    selectedUsersFeedback.innerHTML = '';

    selectedUsers.forEach((user) => {
        const chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = user.email;
        selectedUsersFeedback.appendChild(chip);
    });

    submitMailBtn.disabled = false;
}

function parseManualCcEmails() {
    return ccTextarea.value
        .split(/[\s,;]+/)
        .map((email) => email.trim())
        .filter((email) => email.length > 0);
}

function renderManualCcFeedback() {
    const emails = [...new Set(parseManualCcEmails())];

    if (emails.length === 0) {
        manualCcFeedback.innerHTML = '<span class="empty-state">Aucun email en copie saisi.</span>';
        return;
    }

    manualCcFeedback.innerHTML = '';

    emails.forEach((email) => {
        const chip = document.createElement('span');
        chip.className = 'chip manual';
        chip.textContent = email;
        manualCcFeedback.appendChild(chip);
    });
}

function syncUserState(item, forceChecked = null) {
    const checkbox = item.querySelector('.user-checkbox');
    const userId = Number(item.dataset.userId);
    const email = item.dataset.userEmailLabel;

    const shouldSelect = forceChecked === null ? !checkbox.checked : forceChecked;
    checkbox.checked = shouldSelect;

    if (shouldSelect) {
        selectedUsers.set(userId, { id: userId, email });
        item.classList.add('selected');
    } else {
        selectedUsers.delete(userId);
        item.classList.remove('selected');
    }

    renderSelectedUserInputs();
    renderSelectedUsersFeedback();
}

document.querySelectorAll('.user-item').forEach((item) => {
    const userId = Number(item.dataset.userId);
    const checkbox = item.querySelector('.user-checkbox');

    item.addEventListener('click', (event) => {
        if (event.target === checkbox) {
            syncUserState(item, checkbox.checked);
            return;
        }

        syncUserState(item);
    });

    checkbox.addEventListener('click', (event) => {
        event.stopPropagation();
    });

    checkbox.addEventListener('change', () => {
        syncUserState(item, checkbox.checked);
    });

    if (preselectedUserIds.includes(userId)) {
        syncUserState(item, true);
    }
});

document.getElementById('clear-users-btn').addEventListener('click', () => {
    document.querySelectorAll('.user-item').forEach((item) => syncUserState(item, false));
});

document.getElementById('reset-form-btn').addEventListener('click', () => {
    document.getElementById('subject').value = '';
    document.getElementById('message').value = '';
    ccTextarea.value = '';
    userSearch.value = '';
    document.querySelectorAll('.user-item').forEach((item) => syncUserState(item, false));
    document.querySelectorAll('.user-item').forEach((item) => {
        item.style.display = 'flex';
    });
    renderManualCcFeedback();
});

ccTextarea.addEventListener('input', renderManualCcFeedback);

userSearch.addEventListener('input', () => {
    const query = userSearch.value.trim().toLowerCase();

    document.querySelectorAll('.user-item').forEach((item) => {
        const matches = item.dataset.userEmail.includes(query) || item.dataset.userName.includes(query);
        item.style.display = matches ? 'flex' : 'none';
    });
});

renderSelectedUsersFeedback();
renderManualCcFeedback();
</script>
{% endblock %}
