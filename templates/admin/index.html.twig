{% extends 'base.html.twig' %}

{% block body %}
<div class="page-container">
    <div class="header-bar">
        <h1>Cours</h1>
        <a href="{{ path('admin_course_new') }}" class="btn btn-primary">+ Nouveau cours</a>
    </div>

    {% if courses is empty %}
        <div class="empty">Aucun cours trouvé.</div>
    {% else %}
        <div class="table-wrapper">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Vidéos</th>
                        <th>Quiz</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for c in courses %}
                    <tr>
                        <td>{{ c.id }}</td>
                        <td>{{ c.title }}</td>
                        <td>{{ c.videos|length }}</td>
                        <td>{{ c.quizQuestions|length }}</td>
                        <td class="actions">
                            <a href="{{ path('admin_course_show',{id:c.id}) }}" class="btn btn-small btn-outline">Voir</a>
                            <a href="{{ path('admin_course_edit',{id:c.id}) }}" class="btn btn-small btn-primary">Éditer</a>
                            <form method="post" action="{{ path('admin_course_delete',{id:c.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce cours ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                                <button class="btn btn-small btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<style>
.page-container {
    padding: 2rem;
    background: var(--bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.header-bar h1 {
    color: var(--black);
    font-size: 1.6rem;
    margin: 0;
}

.empty {
    padding: 1.2rem;
    text-align: center;
    background: var(--mint);
    color: var(--grey);
    border-radius: var(--radius);
}

.table-wrapper {
    overflow-x: auto;
}

.styled-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
}

.styled-table th {
    background: var(--green);
    color: var(--white);
    padding: 0.8rem;
    text-align: left;
}

.styled-table td {
    padding: 0.8rem;
    border-bottom: 1px solid #eee;
    color: var(--black);
}

.styled-table tr:nth-child(even) td {
    background: var(--mint);
}

.actions {
    display: flex;
    gap: 0.5rem;
}

.btn {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    border-radius: var(--radius);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    border: none;
}

.btn:hover {
    opacity: 0.9;
}

.btn-primary {
    background: var(--teal);
    color: var(--white);
}

.btn-outline {
    border: 1px solid var(--teal);
    color: var(--teal);
    background: transparent;
}

.btn-outline:hover {
    background: var(--teal);
    color: var(--white);
}

.btn-danger {
    background: #e74c3c;
    color: var(--white);
}

.btn-small {
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
}
</style>
{% endblock %}
