{% extends 'base.html.twig' %}

{% block title %}Créer un certificat{% endblock %}

{% block body %}
<div class="certificate-create-page">
    <div class="page-header">
        <div>
            <h1>Créer un certificat</h1>
            <p>Attribuer un certificat à un ou plusieurs utilisateurs pour un cours existant.</p>
        </div>
        <a href="{{ path('admin_certificate_list') }}" class="btn-secondary">Retour à la liste</a>
    </div>

    <div class="form-card">
        {{ form_start(form) }}
            <div class="form-grid">
                <div class="field field-full">
                    {{ form_label(form.users) }}
                    {{ form_widget(form.users, { attr: { class: 'input-select multi-select' } }) }}
                    {{ form_errors(form.users) }}
                    <small>Maintiens `Ctrl` pour sélectionner plusieurs utilisateurs.</small>
                </div>

                <div class="field field-full">
                    {{ form_label(form.course) }}
                    {{ form_widget(form.course, { attr: { class: 'input-select' } }) }}
                    {{ form_errors(form.course) }}
                </div>

                <div class="field">
                    {{ form_label(form.durationLabel) }}
                    {{ form_widget(form.durationLabel, { attr: { class: 'input-text' } }) }}
                    {{ form_errors(form.durationLabel) }}
                </div>

                <div class="field">
                    {{ form_label(form.trainerName) }}
                    {{ form_widget(form.trainerName, { attr: { class: 'input-text' } }) }}
                    {{ form_errors(form.trainerName) }}
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-primary">Créer certificat</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
.certificate-create-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
}

.page-header h1 {
    margin: 0 0 8px;
    font-size: 2rem;
    color: #0f172a;
}

.page-header p {
    margin: 0;
    color: #64748b;
}

.form-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.field-full {
    grid-column: 1 / -1;
}

.field label {
    font-weight: 700;
    color: #0f172a;
}

.field small {
    color: #64748b;
}

.input-text,
.input-select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    font-size: 0.95rem;
    background: #fff;
}

.multi-select {
    min-height: 260px;
}

.actions {
    margin-top: 24px;
    display: flex;
    justify-content: flex-end;
}

.btn-primary,
.btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
}

.btn-primary {
    border: none;
    background: #0f766e;
    color: #fff;
    cursor: pointer;
}

.btn-secondary {
    background: #fff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
}

@media (max-width: 768px) {
    .page-header {
        flex-direction: column;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}
