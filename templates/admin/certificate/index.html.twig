    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
    white-space: nowrap;
}

.badge-icon {
    width: 14px;
    height: 14px;
}

.sub-badge.active {
    background: #D1FAE5;
    color: #065F46;
}

.sub-badge.inactive {
    background: #FEE2E2;
    color: #991B1B;
}

/* Responsive */
@media (max-width: 1024px) {
    .filter-grid {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .month-header {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 768px) {
    body {
        padding: 12px;
    }

    .filters-header {
        flex-direction: column;
        align-items: stretch;
    }

    .filters-card {
        padding: 20px;
    }

    .filters-title {
        font-size: 1.5rem;
    }

    .quick-filters {
        flex-direction: column;
    }

    .filter-btn {
        width: 100%;
        justify-content: center;
    }

    .month-section {
        padding: 20px;
    }

    .month-title {
        font-size: 1.25rem;
    }

    .stat-value {
        font-size: 1.75rem;
    }

    .certificates-table {
        font-size: 0.875rem;
    }

    .certificates-table th,
    .certificates-table td {
        padding: 14px 12px;
    }
}
