{% extends 'base.html.twig' %}

{% block body %}
<!-- Google Fonts - Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="admin-container">
    
    <!-- Header -->
    <div class="admin-header">
        <div class="header-content">
            <div class="header-left">
                <h1>Articles</h1>
                <p class="subtitle">Gérer tous les articles publiés</p>
            </div>
            <div class="admin-stats">
                <div class="stat-card">
                    <div class="stat-number">{{ articles|length }}</div>
                    <div class="stat-label">Total articles</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres & Recherche -->
    <div class="filters-card">
        <div class="filters-grid">
            <input type="text" class="search-input" placeholder="🔍 Rechercher un article...">
            <select class="filter-select">
                <option>Tous les auteurs</option>
            </select>
            <select class="filter-select">
                <option>Trier par date ↓</option>
                <option>Trier par likes</option>
                <option>Trier par commentaires</option>
            </select>
        </div>
    </div>

    <!-- Table moderne -->
    <div class="table-card">
        <div class="table-wrapper">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th class="th-checkbox">
                            <input type="checkbox" class="checkbox">
                        </th>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th class="th-center"><i class="fas fa-comments"></i> Commentaires</th>
                        <th class="th-center"><i class="fas fa-heart"></i> Likes</th>
                        <th>Date</th>
                        <th class="th-actions">Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for article in articles %}
                    <tr class="article-row">
                        <td>
                            <input type="checkbox" class="checkbox">
                        </td>
                        <td>
                            <div class="article-info">
                                {% if article.image %}
                                <div class="article-thumb">
                                    <img src="/uploads/articles/{{ article.image }}" alt="{{ article.titre }}">
                                </div>
                                {% else %}
                                <div class="article-thumb article-thumb-empty">
                                    <i class="fas fa-file-alt"></i>
                                </div>
                                {% endif %}
                                <div class="article-details">
                                    <div class="article-title">{{ article.titre }}</div>
                                    <small class="article-id">ID: {{ article.id }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="author-info">
                                <div class="author-avatar">
                                    {{ article.author.username|slice(0, 1)|upper }}
                                </div>
                                <span class="author-name">{{ article.author.username }}</span>
                            </div>
                        </td>
                        <td class="td-center">
                            <span class="badge badge-comments">
                                {{ article.comments|length }}
                            </span>
                        </td>
                        <td class="td-center">
                            <span class="badge badge-likes">
                                {{ article.likesCount }}
                            </span>
                        </td>
                        <td class="td-date">
                            {{ article.createdAt|date('d/m/Y') }}<br>
                            <small>{{ article.createdAt|date('H:i') }}</small>
                        </td>
                        <td>
                            <div class="actions-group">
                                <a href="{{ path('admin_article_detail', {id: article.id}) }}"
                                   class="btn btn-view">
                                    <i class="fas fa-eye"></i> Voir
                                </a>

                                <form action="{{ path('admin_article_delete_admin', {id: article.id}) }}"
                                      method="POST"
                                      class="inline-form"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');">
                                    <button class="btn btn-delete">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
    }

    .admin-container {
        padding: 2rem;
        background: var(--bg);
        min-height: 100vh;
    }

    /* Header */
    .admin-header {
        margin-bottom: 2rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .header-left h1 {
        color: var(--black);
        font-weight: 600;
        font-size: 2rem;
        margin-bottom: 0.25rem;
    }

    .subtitle {
        color: var(--grey);
        margin: 0;
    }

    .admin-stats {
        display: flex;
        gap: 1rem;
    }

    .stat-card {
        background: var(--white);
        padding: 1rem 1.5rem;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        text-align: center;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--teal);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--grey);
        margin-top: 0.25rem;
    }

    /* Filtres */
    .filters-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 1rem;
    }

    .search-input,
    .filter-select {
        width: 100%;
        border: 2px solid var(--mint);
        border-radius: var(--radius);
        padding: 0.75rem 1rem;
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .search-input:focus,
    .filter-select:focus {
        border-color: var(--teal);
        outline: none;
        box-shadow: 0 0 0 3px rgba(13, 131, 131, 0.1);
    }

    /* Table */
    .table-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
    }

    .modern-table thead {
        background: var(--mint);
        border-bottom: 2px solid var(--teal);
    }

    .modern-table th {
        color: var(--green);
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        padding: 1rem;
        text-align: left;
    }

    .th-checkbox {
        padding-left: 1.5rem;
    }

    .th-center {
        text-align: center;
    }

    .th-actions {
        text-align: right;
        padding-right: 1.5rem;
    }

    .modern-table tbody tr {
        border-bottom: 1px solid var(--mint);
        transition: all 0.2s;
    }

    .modern-table tbody tr:hover {
        background: var(--bg);
        transform: scale(1.002);
    }

    .modern-table tbody tr:last-child {
        border-bottom: none;
    }

    .modern-table td {
        padding: 1rem;
    }

    .td-center {
        text-align: center;
    }

    .td-date {
        color: var(--grey);
        font-size: 0.9rem;
    }

    .td-date small {
        color: var(--grey);
        opacity: 0.7;
    }

    /* Article Info */
    .article-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .article-thumb {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .article-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .article-thumb-empty {
        background: var(--mint);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--teal);
        font-size: 1.2rem;
    }

    .article-details {
        flex: 1;
    }

    .article-title {
        font-weight: 500;
        color: var(--black);
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .article-id {
        color: var(--grey);
        font-size: 0.8rem;
    }

    /* Author Info */
    .author-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .author-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--teal);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .author-name {
        color: var(--black);
        font-weight: 500;
    }

    /* Badges */
    .badge {
        display: inline-block;
        padding: 0.4rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .badge-comments {
        background: var(--mint);
        color: var(--teal);
    }

    .badge-likes {
        background: #FFE5E5;
        color: #D32F2F;
    }

    /* Buttons */
    .actions-group {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .btn {
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 500;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .btn-view {
        background: var(--teal);
        color: white;
        text-decoration: none;
    }

    .btn-view:hover {
        background: var(--green);
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(13, 131, 131, 0.3);
    }

    .btn-delete {
        background: #FFE5E5;
        color: #D32F2F;
    }

    .btn-delete:hover {
        background: #D32F2F;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(211, 47, 47, 0.3);
    }

    .inline-form {
        display: inline;
    }

    .checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .filters-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .admin-container {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .article-title {
            max-width: 150px;
        }
    }
</style>
{% endblock %}