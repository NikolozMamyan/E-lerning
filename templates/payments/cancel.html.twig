{# templates/payments/cancel.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Payment Canceled{% endblock %}

{% block body %}
<div class="payment-success">
    <div class="success-container">


        <div class="success-content">
            <h1 class="success-title cancel-title">Payment Canceled</h1>

            <p class="success-message">
                Your payment was canceled or didn’t complete. No charges were made.
                {% if courseId %}
                    You can return to the course page and try again anytime.
                {% endif %}
            </p>

            <div class="success-details">
                {% if courseId %}
                <div class="detail-item">
                    <span class="detail-label">Course:</span>
                    <span class="detail-value">#{{ courseId }}</span>
                </div>
                {% else %}
                <div class="detail-item">
                    <span class="detail-label">Course:</span>
                    <span class="detail-value"><em>Not specified</em></span>
                </div>
                {% endif %}
                <div class="detail-item">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value">Canceled</span>
                </div>
            </div>

            <div class="success-actions">
                {% if courseId %}
                    <a href="{{ path('app_course_show', { id: courseId }) }}" class="btn btn-primary">
                        Back to Course
                    </a>
                {% endif %}
                <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
                    Go to Dashboard
                </a>
            </div>

            <p class="success-message" style="margin-top:1rem;">
                <small>If you believe this is an error, please try again from the course page,
                or contact support.</small>
            </p>
        </div>
    </div>
</div>

<style>
/* Reuse success page layout/styles for consistency */
.payment-success {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background-color: var(--bg);
}
.success-container {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 560px;
    width: 100%;
}
.success-icon { margin-bottom: 2rem; }
.success-icon img {
    width: 120px; height: 120px; object-fit: contain;
}

/* Title uses a warning color tone */
.success-title {
    color: var(--green);
    font-size: 2.2rem; font-weight: 700;
    margin-bottom: 1rem; line-height: 1.2;
}
.cancel-title {
    color: var(--orange, #ff9500);
}

.success-message {
    color: var(--grey);
    font-size: 1.05rem;
    margin-bottom: 1.5rem; line-height: 1.5;
}
.success-details {
    background: var(--mint);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2rem;
    text-align: left;
}
.detail-item {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.75rem;
}
.detail-item:last-child { margin-bottom: 0; }
.detail-label { color: var(--grey); font-weight: 500; }
.detail-value { color: var(--black); font-weight: 600; }

.success-actions {
    display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
}
.btn {
    padding: 0.875rem 1.5rem; border-radius: var(--radius); text-decoration: none;
    font-weight: 600; transition: all 0.2s ease; border: 2px solid transparent;
    cursor: pointer; font-size: 1rem;
}
.btn-primary { background-color: var(--green); color: var(--white); }
.btn-primary:hover { background-color: var(--teal); transform: translateY(-1px); }
.btn-secondary { background-color: var(--white); color: var(--green); border-color: var(--green); }
.btn-secondary:hover { background-color: var(--mint); transform: translateY(-1px); }

@media (max-width: 768px) {
    .success-container { padding: 2rem 1.5rem; margin: 1rem; }
    .success-title { font-size: 1.8rem; }
    .success-actions { flex-direction: column; }
    .btn { width: 100%; }
}
</style>
{% endblock %}
