{% extends 'base.html.twig' %}

{% block title %}Payment Successful{% endblock %}

{% block body %}
<div class="payment-success">
    <div class="success-container">
        <div class="success-icon">
            <img src="{{ asset('images/congrats.svg') }}" alt="Payment Successful" />
        </div>

        <div class="success-content">
            <h1 class="success-title">
                {% if course_title %}
                    Congratulations!

                {% else %}
                    Payment Successful!
                {% endif %}
            </h1>

            <p class="success-message">
                Thank you for your purchase. Your payment has been processed successfully.
                {% if course_title %}
                    You can start your course right away.
                {% endif %}
            </p>

            <div class="success-details">
                <div class="detail-item">
                    <span class="detail-label">Transaction ID:</span>
                    <span class="detail-value">
                        {% if transaction_id %}
                            #{{ transaction_id }}
                        {% else %}
                            <em>Not available</em>
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Amount:</span>
                    <span class="detail-value">
                        {% if amount is not null %}
                            {{ amount|number_format(2, '.', ',') }} {{ currency|upper }}
                        {% else %}
                            <em>Not available</em>
                        {% endif %}
                    </span>
                </div>
                {% if course_id %}
                <div class="detail-item">
                    <span class="detail-label">Course:</span>
                    <span class="detail-value">
                        {% if course_title %}
                            {{ course_title }}
                        {% else %}
                            #{{ course_id }}
                        {% endif %}
                    </span>
                </div>
                {% endif %}
            </div>

            <div class="success-actions">
                <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
                    Go to Dashboard
                </a>

                {% if course_id is not null %}
                    <a href="{{ path('app_course_show', { id: course_id }) }}" class="btn btn-secondary">
                        Go to Course
                    </a>
                {% else %}
                    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
                        View My Courses
                    </a>
                {% endif %}
            </div>

            {% if transaction_id is null %}
                <p class="success-message" style="margin-top:1rem;">
                    <small>If you refreshed this page directly, details may not be available. 
                    Please return via the payment confirmation link or check your confirmation email.</small>
                </p>
            {% endif %}
        </div>
    </div>
</div>

<style>
.payment-success {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background-color: var(--bg);
}
.success-container {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 560px;
    width: 100%;
}
.success-icon { margin-bottom: 2rem; }
.success-icon img {
    width: 120px; height: 120px; object-fit: contain;
}
.success-title {
    color: var(--green);
    font-size: 2.2rem; font-weight: 700;
    margin-bottom: 1rem; line-height: 1.2;
}
.success-message {
    color: var(--grey);
    font-size: 1.05rem;
    margin-bottom: 1.5rem; line-height: 1.5;
}
.success-details {
    background: var(--mint);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2rem;
    text-align: left;
}
.detail-item {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.75rem;
}
.detail-item:last-child { margin-bottom: 0; }
.detail-label { color: var(--grey); font-weight: 500; }
.detail-value { color: var(--black); font-weight: 600; }
.success-actions {
    display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
}
.btn {
    padding: 0.875rem 1.5rem; border-radius: var(--radius); text-decoration: none;
    font-weight: 600; transition: all 0.2s ease; border: 2px solid transparent;
    cursor: pointer; font-size: 1rem;
}
.btn-primary { background-color: var(--green); color: var(--white); }
.btn-primary:hover { background-color: var(--teal); transform: translateY(-1px); }
.btn-secondary { background-color: var(--white); color: var(--green); border-color: var(--green); }
.btn-secondary:hover { background-color: var(--mint); transform: translateY(-1px); }

@media (max-width: 768px) {
    .success-container { padding: 2rem 1.5rem; margin: 1rem; }
    .success-title { font-size: 1.8rem; }
    .success-actions { flex-direction: column; }
    .btn { width: 100%; }
}
</style>
{% endblock %}
