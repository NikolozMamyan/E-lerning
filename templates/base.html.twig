<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Tableau de bord{% endblock %}</title>
  <link rel="icon" href="/build/images/favicon.png" type="image/x-icon">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<!-- ✅ AJOUTE CES CDN AVANT TON SCRIPT -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>


  {% block stylesheets %}{% endblock %}
  {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
  {% endblock %}
</head>
<body>
<div class="wrapper-layout">
{% if "ROLE_ADMIN" in app.user.roles %}
    {% include 'admin/components/sidebar.html.twig' %}
    <div class="overlay" id="overlay"></div>
{% elseif "ROLE_EMPLOYEE" in app.user.roles %}
    {% include 'components/sidebar.html.twig' %}
    <div class="overlay" id="overlay"></div>
    {% elseif "ROLE_COMPANY" in app.user.roles %}
    {% include 'company/components/sidebar.html.twig' %}
    <div class="overlay" id="overlay"></div>
{% endif %}

    <main class="main-content">
    {% if app.user %}
  {% include 'components/topbar.html.twig' %}
      {% endif %}
    {% block body %}{% endblock %}
   </main>
</div>

</body>
</html>
