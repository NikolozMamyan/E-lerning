{% extends 'base.html.twig' %}

{% block title %}Subscription Successful{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --green: #1A6D55;
            --teal: #0D8383;
            --black: #071717;
            --mint: #E7F3F3;
            --grey: #606060;
            --white: #FFFFFF;
            --bg: #f4f9f8;
            --radius: 12px;
            --shadow: 0 4px 12px rgba(7, 23, 23, .08);
        }

        body {
            background-color: var(--bg);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        .success-container {
            max-width: 480px;
            margin: 80px auto;
            padding: 32px 24px;
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            text-align: center;
        }

        .success-icon {
            font-size: 3rem;
            color: var(--green);
            background: rgba(26, 109, 85, 0.1);
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .success-title {
            font-size: 1.8rem;
            color: var(--black);
            margin-bottom: 12px;
        }

        .success-message {
            font-size: 1.1rem;
            color: var(--grey);
            margin-bottom: 32px;
            line-height: 1.5;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            display: inline-block;
            width: 100%;
            padding: 14px 20px;
            font-size: 1rem;
            font-weight: 600;
            border-radius: var(--radius);
            border: none;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            text-align: center;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .btn-dashboard {
            background: linear-gradient(135deg, var(--teal), var(--green));
            color: var(--white);
        }

        .btn-courses {
            background: var(--white);
            color: var(--teal);
            border: 2px solid var(--teal);
        }

        @media (max-width: 480px) {
            .success-container {
                margin: 40px auto;
                padding: 24px 16px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="success-container">
        <div class="success-icon">✓</div>
        <h1 class="success-title">Congratulations!</h1>
        <p class="success-message">
            You have successfully subscribed to the <strong>Premium Plan</strong>.<br>
            Enjoy full access to all current and future content.
        </p>

        <div class="btn-group">
            <a href="{{ path('app_dashboard') }}" class="btn btn-dashboard">Go to Dashboard</a>
            <a href="{{ path('app_courses') }}" class="btn btn-courses">Go to Courses</a>
        </div>
    </div>
{% endblock %}
