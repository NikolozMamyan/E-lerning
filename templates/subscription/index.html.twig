{% extends 'base.html.twig' %}

{% block title %}Abonnement Premium{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --green: #1A6D55;
            --teal: #0D8383;
            --black: #071717;
            --mint: #E7F3F3;
            --grey: #606060;
            --white: #FFFFFF;
            --bg: #f4f9f8;
            --radius: 12px;
            --shadow: 0 4px 12px rgba(7, 23, 23, .08);
        }

        body {
            background-color: var(--bg);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        .subscription-container {
            max-width: 480px;
            margin: 60px auto;
            padding: 20px;
        }

        .subscription-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .subscription-header h1 {
            color: var(--black);
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .subscription-header p {
            color: var(--grey);
            font-size: 1.1rem;
        }

        .plan-card {
            background: linear-gradient(135deg, var(--teal), var(--green));
            border-radius: var(--radius);
            padding: 40px 32px;
            box-shadow: var(--shadow);
            color: var(--white);
            position: relative;
            overflow: hidden;
        }

        .plan-card::before,
        .plan-card::after {
            content: '';
            position: absolute;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

        .plan-card::before {
            top: -20px;
            left: -20px;
        }

        .plan-card::after {
            bottom: -20px;
            right: -20px;
        }

        .plan-header {
            text-align: center;
            margin-bottom: 32px;
            position: relative;
        }

        .plan-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .billing-toggle {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }

        .billing-toggle input[type="radio"] {
            margin-right: 4px;
        }

        .plan-price {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .plan-price small {
            font-size: 1.2rem;
            font-weight: 400;
            opacity: 0.9;
        }

        .plan-features {
            list-style: none;
            padding: 0;
            margin: 32px 0;
        }

        .plan-features li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 16px;
            font-size: 1rem;
            line-height: 1.5;
        }

        .plan-features li::before {
            content: '✓';
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            flex-shrink: 0;
            font-weight: bold;
        }

        .subscribe-btn {
            width: 100%;
            background: var(--white);
            color: var(--teal);
            border: none;
            border-radius: var(--radius);
            padding: 16px 32px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
        }

        .subscribe-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .subscribe-btn:active {
            transform: translateY(0);
        }

        .engagement-note {
            text-align: center;
            margin-top: 16px;
            font-size: 0.85rem;
            opacity: 0.8;
            font-style: italic;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 24px;
            color: var(--teal);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: var(--green);
        }

        @media (max-width: 480px) {
            .subscription-container {
                margin: 20px auto;
                padding: 16px;
            }

            .plan-card {
                padding: 32px 24px;
            }

            .plan-price {
                font-size: 2.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="subscription-container">

        <div class="subscription-header">
            <h1>Débloquez l'accès Premium</h1>
            <p>Accédez à tous les contenus et fonctionnalités</p>
        </div>

        <div class="plan-card">
            <div class="plan-header">
                <h2 class="plan-title">Plan Premium</h2>
                
                <div class="billing-toggle">
                    <label>
                        <input type="radio" name="billing" value="monthly" checked>
                        Mensuel
                    </label>
                    <label>
                        <input type="radio" name="billing" value="yearly">
                        Annuel
                    </label>
                </div>

                <div class="plan-price">
                    €20<small>/mois</small>
                </div>
            </div>

            <ul class="plan-features">
                <li>Accès unique à toutes les vidéos existantes</li>
                <li>Accès aux vidéos à venir pendant votre abonnement</li>
                <li>Facturation mensuelle ou annuelle</li>
                <li>Certificat de fin de parcours après quiz</li>
                <li>Nouvelles vidéos publiées régulièrement</li>
            </ul>

            <form action="{{ path('app_subscription_checkout') }}" method="post">
                <button type="submit" class="subscribe-btn">
                    S'abonner maintenant
                </button>
            </form>

            <p class="engagement-note">Engagement de 12 mois</p>
        </div>
    </div>
{% endblock %}