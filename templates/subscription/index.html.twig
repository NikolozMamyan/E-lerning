{% extends 'base.html.twig' %}

{% block title %}Learning Plans{% endblock %}

{% block body %}
<div class="subscription-page {{ subscription ? 'has-active-plan' : '' }}">
  {% if not subscription %}
    <header class="subscription-page__hero">
      <div class="subscription-page__hero-copy">
        <span class="subscription-page__eyebrow">
          <i class="fa-solid fa-gem" aria-hidden="true"></i>
          Flexible learning access
        </span>
        <h1>One plan. Every course. Unlimited progress.</h1>
        <p>Unlock the complete training library, learn at your own pace and earn verified certificates from one simple subscription.</p>
        <div class="subscription-page__hero-meta">
          <span><i class="fa-solid fa-infinity" aria-hidden="true"></i>Unlimited catalogue access</span>
          <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Secure Stripe checkout</span>
          <span><i class="fa-solid fa-award" aria-hidden="true"></i>Certificates included</span>
        </div>
      </div>

      <div class="subscription-page__hero-card">
        <span class="subscription-page__hero-card-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
        <div>
          <small>Everything you need</small>
          <strong>Learn without limits</strong>
          <p>New courses are automatically included throughout your membership.</p>
        </div>
      </div>
    </header>

    <section class="subscription-page__intro" aria-labelledby="plans-heading">
      <div>
        <span>Choose your access</span>
        <h2 id="plans-heading">A plan for every learning goal</h2>
      </div>
      <p>Subscribe for unlimited learning or purchase only the individual courses you need.</p>
    </section>

    <section class="subscription-page__plans" aria-label="Available learning plans">
      <article class="subscription-plan subscription-plan--premium">
        <div class="subscription-plan__topline">
          <span><i class="fa-solid fa-star" aria-hidden="true"></i>Most popular</span>
          <small>Premium access</small>
        </div>

        <div class="subscription-plan__heading">
          <span>12-month subscription</span>
          <h2>Unlimited Learning</h2>
          <p>Ideal when you want continuous access to the full learning experience.</p>
        </div>

        <div class="subscription-plan__price">
          <strong><sup>€</sup>39<small>.90</small></strong>
          <span>per month<br><small>excluding VAT</small></span>
        </div>

        <div class="subscription-plan__divider"></div>

        <ul class="subscription-plan__features">
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Full course catalogue</strong><small>Access every current learning module</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>New releases included</strong><small>Discover new content as it is published</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Progress and certificates</strong><small>Track completion and download achievements</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Multilingual learning</strong><small>Use the available course languages</small></div></li>
        </ul>

        <form action="{{ path('app_subscription_checkout') }}" method="post" data-subscription-form>
          <button type="submit" class="subscription-plan__cta" data-subscription-button>
            <span data-subscription-label>Start my subscription</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>

        <p class="subscription-plan__commitment"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i>12-month commitment · billed monthly</p>
      </article>

      <article class="subscription-plan subscription-plan--single">
        <div class="subscription-plan__topline">
          <span><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>Pay once</span>
          <small>Individual access</small>
        </div>

        <div class="subscription-plan__heading">
          <span>À la carte</span>
          <h2>Choose One Course</h2>
          <p>A focused option when you need a specific training module right now.</p>
        </div>

        <div class="subscription-plan__single-visual">
          <span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span>
          <div><strong>One-time purchase</strong><small>Price displayed on each course</small></div>
        </div>

        <div class="subscription-plan__divider"></div>

        <ul class="subscription-plan__features">
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Access the selected course</strong><small>Only pay for the content you choose</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Final knowledge quiz</strong><small>Validate what you have learned</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Certificate included</strong><small>Available after successfully passing</small></div></li>
          <li><span><i class="fa-solid fa-check" aria-hidden="true"></i></span><div><strong>Clear one-time payment</strong><small>No recurring subscription charge</small></div></li>
        </ul>

        <a href="{{ path('app_courses') }}" class="subscription-plan__cta subscription-plan__cta--secondary">
          Browse individual courses
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <p class="subscription-plan__commitment"><i class="fa-solid fa-lock" aria-hidden="true"></i>Secure checkout for each purchase</p>
      </article>
    </section>

    <section class="subscription-page__assurance" aria-label="Subscription assurances">
      <article><span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span><div><strong>Secure payment</strong><small>Your checkout is handled by Stripe</small></div></article>
      <article><span><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></span><div><strong>Downloadable invoices</strong><small>Find every document in your payment history</small></div></article>
      <article><span><i class="fa-solid fa-headset" aria-hidden="true"></i></span><div><strong>Human support</strong><small>Get help whenever you need it</small></div></article>
    </section>
  {% else %}
    <header class="subscription-page__active-hero">
      <div class="subscription-page__active-copy">
        <span class="subscription-page__active-status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Premium active</span>
        <h1>Your complete learning library is unlocked.</h1>
        <p>Keep learning without interruption, explore every available course and turn your progress into verified certificates.</p>
        <div class="subscription-page__active-actions">
          <a href="{{ path('app_courses') }}" class="subscription-page__button subscription-page__button--light"><i class="fa-solid fa-compass" aria-hidden="true"></i>Explore courses</a>
          <a href="{{ path('app_transactions') }}" class="subscription-page__button subscription-page__button--glass"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i>Payment history</a>
        </div>
      </div>

      <div class="subscription-page__active-seal">
        <span><i class="fa-solid fa-crown" aria-hidden="true"></i></span>
        <small>Your plan</small>
        <strong>Unlimited Learning</strong>
        <p>All courses available now</p>
      </div>
    </header>

    <section class="subscription-page__active-grid">
      <article class="subscription-page__active-panel subscription-page__access-panel">
        <div class="subscription-page__section-head">
          <div><span>Included in your plan</span><h2>Everything is ready for you</h2></div>
          <i class="fa-solid fa-infinity" aria-hidden="true"></i>
        </div>

        <div class="subscription-page__benefit-grid">
          <div><span><i class="fa-solid fa-book-open" aria-hidden="true"></i></span><strong>All courses</strong><small>Browse the complete catalogue</small></div>
          <div><span><i class="fa-solid fa-bolt" aria-hidden="true"></i></span><strong>New releases</strong><small>Available as soon as they launch</small></div>
          <div><span><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span><strong>Progress tracking</strong><small>Follow every course milestone</small></div>
          <div><span><i class="fa-solid fa-award" aria-hidden="true"></i></span><strong>Certificates</strong><small>Download verified achievements</small></div>
        </div>
      </article>

      <aside class="subscription-page__active-panel subscription-page__next-step">
        <div class="subscription-page__section-head">
          <div><span>Next step</span><h2>Continue your journey</h2></div>
          <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
        </div>
        <p>Your subscription is active. Choose a new topic or return to a course already in progress.</p>
        <a href="{{ path('app_progress') }}">View learning progress <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        <a href="{{ path('app_dashboard') }}">Return to dashboard <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </aside>
    </section>
  {% endif %}
</div>

{% if not subscription %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('[data-subscription-form]');
  if (!form) return;

  form.addEventListener('submit', () => {
    const button = form.querySelector('[data-subscription-button]');
    const label = form.querySelector('[data-subscription-label]');
    button.disabled = true;
    button.classList.add('is-loading');
    label.textContent = 'Opening secure checkout…';
  });
});
</script>
{% endif %}
{% endblock %}
