{% extends 'base.html.twig' %}

{% block title %}Company dashboard{% endblock %}

{% block body %}
<section class="company-dashboard-overview" aria-label="Company learning overview">
  <article class="company-overview-card company-overview-card--courses">
    <header class="company-overview-card__header">
      <div class="company-overview-card__heading">
        <span class="company-overview-card__icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span>
        <div>
          <span class="company-overview-card__kicker">Learning catalogue</span>
          <h2>Available courses</h2>
        </div>
      </div>
      <span class="company-overview-card__count">{{ courses|length }}</span>
    </header>

    <div class="company-overview-list">
      {% for course in latestCourses %}
        <a href="{{ path('company_course_show', {id: course.id}) }}" class="company-course-summary">
          <span class="company-course-summary__thumb">
            {% if course.thumb %}
              <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="" loading="lazy">
            {% else %}
              <i class="fa-solid fa-book-open" aria-hidden="true"></i>
            {% endif %}
          </span>
          <span class="company-course-summary__content">
            <strong>{{ course.title }}</strong>
            <small>
              {% if course.category %}{{ course.category.name }} · {% endif %}
              {{ course.videos|length }} lesson{{ course.videos|length == 1 ? '' : 's' }}
            </small>
          </span>
          <span class="company-summary-arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </a>
      {% else %}
        <div class="company-overview-empty">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <strong>No courses available</strong>
          <span>Your future training will appear here.</span>
        </div>
      {% endfor %}
    </div>

    <footer class="company-overview-card__footer">
      <a href="{{ path('company_courses') }}">Explore catalogue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </footer>
  </article>

  <article class="company-overview-card company-overview-card--team">
    <header class="company-overview-card__header">
      <div class="company-overview-card__heading">
        <span class="company-overview-card__icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
        <div>
          <span class="company-overview-card__kicker">Team momentum</span>
          <h2>Learning progress</h2>
        </div>
      </div>
      <div class="company-overview-card__metric">
        <strong>{{ teamAverage|round }}%</strong>
        <small>average</small>
      </div>
    </header>

    <div class="company-overview-list company-team-summary-list">
      {% for collab in collaboratorsProgress|slice(0, 3) %}
        {% set employeeName = collab.employee.username ?: collab.employee.email %}
        <div class="company-team-summary">
          <div class="company-team-summary__top">
            <span class="company-team-summary__avatar">
              {% if collab.employee.avatar %}
                <img src="{{ asset('uploads/avatars/' ~ collab.employee.avatar) }}" alt="" loading="lazy">
              {% else %}
                {{ employeeName|first|upper }}
              {% endif %}
            </span>
            <span class="company-team-summary__identity">
              <strong>{{ employeeName }}</strong>
              <small>
                {% if collab.activeCourses > 0 %}
                  {{ collab.activeCourses }} active course{{ collab.activeCourses == 1 ? '' : 's' }}
                {% else %}
                  Ready to start learning
                {% endif %}
              </small>
            </span>
            <strong class="company-team-summary__value">{{ collab.average|round }}%</strong>
          </div>
          <div class="company-team-summary__progress" aria-label="{{ collab.average|round }}% average progress">
            <span style="--company-progress: {{ collab.average }}%"></span>
          </div>
        </div>
      {% else %}
        <div class="company-overview-empty">
          <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
          <strong>No team members yet</strong>
          <span>Add employees to start tracking progress.</span>
        </div>
      {% endfor %}
    </div>

    <footer class="company-overview-card__footer">
      <a href="{{ path('company_team_tracking') }}">View team analytics <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </footer>
  </article>

  <article class="company-overview-card company-overview-card--purchases">
    <header class="company-overview-card__header">
      <div class="company-overview-card__heading">
        <span class="company-overview-card__icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
        <div>
          <span class="company-overview-card__kicker">Recent activity</span>
          <h2>Purchased courses</h2>
        </div>
      </div>
      <span class="company-overview-card__count">{{ enrollments|length }}</span>
    </header>

    <div class="company-overview-list">
      {% for enrollment in enrollments|slice(0, 3) %}
        <a href="{{ path('company_course_show', {id: enrollment.course.id}) }}" class="company-purchase-summary">
          <span class="company-purchase-summary__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
          <span class="company-purchase-summary__content">
            <strong>{{ enrollment.course.title }}</strong>
            <small>Purchased {{ enrollment.createdAt|date('d M Y · H:i') }}</small>
          </span>
          <span class="company-summary-arrow"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
        </a>
      {% else %}
        <div class="company-overview-empty">
          <i class="fa-solid fa-receipt" aria-hidden="true"></i>
          <strong>No purchases yet</strong>
          <span>Your latest company orders will appear here.</span>
        </div>
      {% endfor %}
    </div>

    <footer class="company-overview-card__footer">
      <a href="{{ path('app_co_transactions') }}">View transactions <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </footer>
  </article>
</section>

<section class="dashboard_bottom company-dashboard-team" aria-label="Recently added employees">
  <div class="card company-user-panel">
    <div class="company-user-panel__header">
      <div>
        <span><i class="fa-solid fa-users" aria-hidden="true"></i>Team overview</span>
        <h2>Recently added employees</h2>
        <p>A quick view of your company members and their account status.</p>
      </div>
      <a href="{{ path('company_colab') }}">Manage employees <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </div>

    <div class="table-container">
      <table class="employee-table company-user-table">
        <thead>
          <tr>
            <th class="checkbox-col"><input type="checkbox" class="main-checkbox" aria-label="Select all employees"></th>
            <th aria-label="Avatar"></th>
            <th>Member</th>
            <th class="hide-mobile">User ID</th>
            <th class="hide-tablet">Email</th>
            <th class="hide-mobile">Added</th>
            <th>Profile</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for collaboration in collaborations %}
            {% set employee = collaboration.employee %}
            <tr class="company-user-row">
              <td><input type="checkbox" class="row-checkbox" aria-label="Select {{ employee.username ?: employee.email }}"></td>
              <td>
                <img
                  class="user-avatar"
                  src="{{ asset(employee.avatar ? 'uploads/avatars/' ~ employee.avatar : 'images/User.svg') }}"
                  alt="{{ employee.username ?: employee.email }}">
              </td>
              <td class="name-cell">
                <div class="name-info">
                  <span class="name">{{ employee.username ?: employee.email }}</span>
                  <span class="mobile-info">ID {{ employee.id }}</span>
                </div>
              </td>
              <td class="hide-mobile">{{ employee.id }}</td>
              <td class="hide-tablet">{{ employee.email }}</td>
              <td class="hide-mobile">{{ collaboration.createdAt|date('d M Y') }}</td>
              <td>{{ employee.bio ?? 'No info' }}</td>
              <td><span class="status {{ employee.apiToken is not empty ? 'is-online' : 'is-offline' }}"></span></td>
              <td class="actions-cell">
                <a
                  href="{{ path('company_colab_delete', {id: collaboration.id}) }}"
                  class="action-btn delete-btn"
                  title="Delete"
                  onclick="return confirm('Are you sure you want to delete this collaborator?');">
                  <img src="{{ asset('images/Delete.svg') }}" alt="">
                </a>
                <a href="{{ path('company_employee_edit', {id: employee.id}) }}" class="action-btn edit-employee-btn" title="Edit">
                  <img src="{{ asset('images/edit.svg') }}" alt="">
                </a>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="9" class="empty-state">You don’t have any collaborators yet.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% endblock %}
