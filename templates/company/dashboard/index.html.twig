<style>
  .dashboard_bottom{
    display:grid; flex-wrap: wrap; grid-template-columns: 1fr;
  }
  .card {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--mint);
  }

  .card-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--black);
    margin: 0;
  }

  .view-all {
    color: var(--grey);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .view-all:hover {
    color: var(--teal);
  }

  .card-body {
    padding: 0;
  }

  .table-container {
    overflow-x: auto;
  }

  .employee-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 800px;
  }

  .employee-table th {
    background-color: var(--green);
    color: var(--white);
    padding: 16px 20px;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    border: none;
    white-space: nowrap;
  }

  .employee-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--mint);
    vertical-align: middle;
    color: var(--black);
  }

  .employee-table tbody tr:hover {
    background-color: #fafcfc;
  }

  .checkbox-col {
    width: 50px;
  }

  .main-checkbox,
  .row-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--teal);
  }

  .name-cell {
    min-width: 180px;
  }

  .name-info .name {
    font-weight: 600;
    color: var(--black);
    display: block;
  }

  .mobile-info {
    display: none;
    font-size: 12px;
    color: var(--grey);
    margin-top: 4px;
  }

  .status {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .status.completed {
    background-color: #e6f7f1;
    color: var(--green);
  }

  .status.in-learning {
    background-color: #fff4e6;
    color: #d97706;
  }

  .actions-cell {
    width: 100px;
    display:flex;
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin: 0 2px;
    border-radius: 6px;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .action-btn:hover {
    background-color: var(--mint);
    transform: translateY(-1px);
  }

  .delete-btn {
    color: #dc2626;
  }

  .delete-btn:hover {
    background-color: #fee2e2;
  }

  .edit-btn {
    color: var(--grey);
  }

  .edit-btn:hover {
    color: var(--teal);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .hide-tablet {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .card-header {
      padding: 20px 16px;
    }

    .card-title {
      font-size: 18px;
    }

    .employee-table {
      min-width: 600px;
    }

    .hide-mobile {
      display: none;
    }

    .mobile-info {
      display: block;
    }

    .employee-table th,
    .employee-table td {
      padding: 12px 16px;
      font-size: 13px;
    }

    .name-cell {
      min-width: 160px;
    }
  }

  @media (max-width: 480px) {
    .card-header {
      padding: 16px;
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }

    .employee-table {
      min-width: 500px;
    }

    .employee-table th,
    .employee-table td {
      padding: 10px 12px;
      font-size: 12px;
    }

    .action-btn {
      padding: 6px;
    }

    .action-btn svg {
      width: 14px;
      height: 14px;
    }
  }

  /* Amélioration de l'accessibilité */
  .action-btn:focus {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }

  .main-checkbox:focus,
  .row-checkbox:focus {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }

  /* Animation de chargement */
  .employee-table tbody tr {
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
  }

  .employee-table tbody tr:nth-child(1) { animation-delay: 0.1s; }
  .employee-table tbody tr:nth-child(2) { animation-delay: 0.15s; }
  .employee-table tbody tr:nth-child(3) { animation-delay: 0.2s; }
  .employee-table tbody tr:nth-child(4) { animation-delay: 0.25s; }
  .employee-table tbody tr:nth-child(5) { animation-delay: 0.3s; }
  .employee-table tbody tr:nth-child(6) { animation-delay: 0.35s; }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
{% endblock %}
