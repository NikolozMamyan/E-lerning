<script>
function openModal(id) {
  const modal = document.getElementById('modal-' + id);
  if (modal) {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
}

function closeModal(id) {
  const modal = document.getElementById('modal-' + id);
  if (modal) {
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }
}

// Fermer avec ESC
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    document.querySelectorAll('.modal.active').forEach(modal => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    });
  }
});

// Fermer en cliquant à l'extérieur
document.addEventListener('click', e => {
  if (e.target.classList.contains('modal-overlay')) {
    const modal = e.target.closest('.modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }
});

(function() {
  const PAGE_SIZE = 10;
  const tbody = document.getElementById('teamMembersTbody');
  const searchInput = document.getElementById('teamMemberSearch');
  const countElement = document.getElementById('teamMembersCount');
  const showMoreButton = document.getElementById('teamMembersShowMore');
  const noResultsRow = document.getElementById('teamMembersNoResults');

  if (!tbody || !searchInput || !countElement || !showMoreButton || !noResultsRow) return;

  const rows = Array.from(tbody.querySelectorAll('.employee-row')).map(row => ({
    element: row,
    searchText: normalizeSearchValue(row.dataset.search),
  }));
  let visibleLimit = PAGE_SIZE;

  function normalizeSearchValue(value) {
    return (value || '')
      .toString()
      .trim()
      .toLocaleLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function renderTeamMembers() {
    const query = normalizeSearchValue(searchInput.value);
    const matchingRows = rows.filter(row => !query || row.searchText.includes(query));
    const displayedCount = Math.min(visibleLimit, matchingRows.length);

    rows.forEach(row => {
      row.element.hidden = true;
    });

    matchingRows.slice(0, displayedCount).forEach(row => {
      row.element.hidden = false;
    });

    noResultsRow.hidden = matchingRows.length !== 0;

    if (query) {
      const resultLabel = matchingRows.length === 1 ? 'result' : 'results';
      countElement.textContent = `${displayedCount} / ${matchingRows.length} ${resultLabel} (${rows.length} total)`;
    } else {
      const memberLabel = rows.length === 1 ? 'member' : 'members';
      countElement.textContent = `${displayedCount} / ${rows.length} ${memberLabel}`;
    }

    const remainingCount = matchingRows.length - displayedCount;
    showMoreButton.hidden = remainingCount <= 0;
    showMoreButton.textContent = `Show ${Math.min(PAGE_SIZE, remainingCount)} more`;
  }

  searchInput.addEventListener('input', () => {
    visibleLimit = PAGE_SIZE;
    renderTeamMembers();
  });

  showMoreButton.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    renderTeamMembers();
  });

  renderTeamMembers();
})();

(function() {
  const data = Array.isArray(window.__COURSE_RESULTS__) ? window.__COURSE_RESULTS__ : [];

  const tbody = document.getElementById('resultsTbody');
  const filterUser = document.getElementById('filterUser');
  const filterCourse = document.getElementById('filterCourse');
  const filterPassed = document.getElementById('filterPassed');
  const sortBy = document.getElementById('sortBy');
  const exportBtn = document.getElementById('exportCsvBtn');

  if (!tbody || !filterUser || !filterCourse || !filterPassed || !sortBy || !exportBtn) return;

  function norm(s){ return (s || '').toString().trim().toLowerCase(); }
  function passedLabel(row){
    if (row.passed === true) return 'Yes';
    if (row.attempted === false) return 'No (Not started)';
    return 'No';
  }
  function passedRank(row){
    if (row.passed === true) return 2;
    if (row.attempted === false) return 0;
    return 1;
  }

  function applySort(rows) {
    const mode = sortBy.value;
    const byCourse = (a,b) => norm(a.courseTitle).localeCompare(norm(b.courseTitle));
    const byUser = (a,b) => norm(a.userName).localeCompare(norm(b.userName));
    const byPassed = (a,b) => passedRank(a) - passedRank(b);
    const byScore = (a,b) => (Number(a.score) || 0) - (Number(b.score) || 0);

    const copy = [...rows];

    switch (mode) {
      case 'course_desc': return copy.sort((a,b) => byCourse(b,a) || byUser(a,b));
      case 'user_asc':    return copy.sort((a,b) => byUser(a,b) || byCourse(a,b));
      case 'user_desc':   return copy.sort((a,b) => byUser(b,a) || byCourse(a,b));
      case 'passed_desc': return copy.sort((a,b) => byPassed(b,a) || byScore(b,a) || byCourse(a,b));
      case 'passed_asc':  return copy.sort((a,b) => byPassed(a,b) || byScore(b,a) || byCourse(a,b));
      case 'score_desc':  return copy.sort((a,b) => byScore(b,a) || byPassed(b,a) || byCourse(a,b));
      case 'score_asc':   return copy.sort((a,b) => byScore(a,b) || byPassed(b,a) || byCourse(a,b));
      case 'course_asc':
      default:            return copy.sort((a,b) => byCourse(a,b) || byUser(a,b));
    }
  }

  function getFilteredRows() {
    const userVal = norm(filterUser.value);
    const courseVal = filterCourse.value;
    const passedVal = filterPassed.value; // "", "1", "0"

    let rows = data.filter(r => {
      const matchesPassed =
        passedVal === ''
          ? true
          : (passedVal === '1' && r.passed === true)
            || (passedVal === '0' && (r.passed === false || r.attempted === false));

      const matchesUser =
        !userVal ||
        norm(r.userName).includes(userVal) ||
        norm(r.userEmail).includes(userVal);

      const matchesCourse = !courseVal || r.courseTitle === courseVal;

      return matchesUser && matchesCourse && matchesPassed;
    });

    return applySort(rows);
  }

  function render() {
    const rows = getFilteredRows();

    if (!rows.length) {
      tbody.innerHTML = `<tr><td colspan="5" class="empty-state">No results</td></tr>`;
      return;
    }

    tbody.innerHTML = rows.map(r => {
      const score = r.attempted ? `${(r.score ?? 0)}%` : '—';
      const passed = passedLabel(r);
      const badgeClass = r.passed ? 'completed' : (r.attempted === false ? 'not-started' : 'in-learning');

      return `
        <tr>
          <td class="name-cell">${r.userName || '—'}</td>
          <td class="hide-tablet">${r.userEmail || '—'}</td>
          <td>${r.courseTitle || '—'}</td>
          <td>${score}</td>
          <td><span class="status ${badgeClass}">${passed}</span></td>
        </tr>
      `;
    }).join('');
  }

  function csvCell(v) {
    const s = (v ?? '').toString().replaceAll('"', '""');
    return `"${s}"`;
  }

  function exportCsv() {
    const rows = getFilteredRows();
    const delimiter = ';';

    const header = ['User', 'Email', 'Course', 'Score', 'Passed'];
    const lines = [header.map(csvCell).join(delimiter)];

    rows.forEach(r => {
      lines.push([
        r.userName || '',
        r.userEmail || '',
        r.courseTitle || '',
        r.attempted ? `${(r.score ?? 0)}%` : '',
        passedLabel(r),
      ].map(csvCell).join(delimiter));
    });

    const csv = `\uFEFF${lines.join('\r\n')}`;
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);

    const a = document.createElement('a');
    a.href = url;
    a.download = `course-results-${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(a);
    a.click();
    a.remove();

    URL.revokeObjectURL(url);
  }

  [filterUser, filterCourse, filterPassed, sortBy].forEach(el => {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  exportBtn.addEventListener('click', exportCsv);

  render();
})();
</script>
