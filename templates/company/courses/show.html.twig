{% extends 'base.html.twig' %}

{% block title %}Course - {{ course.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .payment-layout {
            background: var(--bg);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        .main-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* COURSE PRESENTATION */
        .course-presentation {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .course-hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            padding: 2rem;
        }

        .course-thumbnail {
            position: relative;
            border-radius: var(--radius);
            overflow: hidden;
            aspect-ratio: 16/9;
        }

        .course-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .play-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 70px;
            height: 70px;
            background: var(--green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .play-overlay:hover {
            background: var(--teal);
            transform: translate(-50%, -50%) scale(1.1);
        }

        .play-overlay i {
            color: var(--white);
            font-size: 1.5rem;
            margin-left: 5px;
        }

        .course-details h1 {
            color: var(--black);
            font-size: 2rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .course-features {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        .course-feature {
            background: var(--mint);
            color: var(--green);
            padding: 0.5rem 1rem;
            border-radius: var(--radius);
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* COURSE DESCRIPTION */
        .course-description {
            padding: 2rem;
            border-top: 1px solid var(--mint);
        }

        .course-description h3 {
            color: var(--black);
            font-size: 1.3rem;
            margin-bottom: 1rem;
            margin-top: 2rem;
        }

        .course-description h3:first-child {
            margin-top: 0;
        }

        .course-description p {
            color: var(--grey);
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .course-description ul {
            list-style: none;
            padding: 0;
        }

        .course-description ul li {
            color: var(--grey);
            padding: 0.75rem 0;
            padding-left: 1.5rem;
            position: relative;
            border-bottom: 1px solid var(--mint);
        }

        .course-description ul li:last-child {
            border-bottom: none;
        }

        .course-description ul li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--green);
            font-weight: bold;
        }

        /* CUSTOMER SECTION */
        .customer-section {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 2rem;
        }

        .customer-section h3 {
            color: var(--black);
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
            font-weight: 600;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            background: var(--bg);
            border-radius: var(--radius);
            border: 1px solid var(--mint);
        }

        .info-item .icon {
            width: 40px;
            height: 40px;
            background: var(--mint);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .info-item .icon img {
            width: 20px;
            height: 20px;
            object-fit: contain;
        }

        .info-value {
            color: var(--black);
            font-weight: 500;
            font-size: 0.95rem;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .course-hero {
                grid-template-columns: 1fr;
            }

            .course-details h1 {
                font-size: 1.5rem;
            }

            .payment-layout {
                padding: 1rem 0.5rem;
            }

            .course-presentation,
            .customer-section {
                padding: 1.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="payment-layout">
    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- COURSE PRESENTATION -->
        <div class="course-presentation">
            <div class="course-hero">
                <div class="course-thumbnail">
                    <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="{{ course.title }}">
                    <div class="play-overlay">
                        <i class="fas fa-play"></i>
                    </div>
                </div>
                
                <div class="course-details">
                    <h1>{{ course.title }}</h1>
                    
                    <div class="course-features">
                        <span class="course-feature">Full access</span>
                        <span class="course-feature">Certificate of completion</span>
                        <span class="course-feature">24/7 Support</span>
                    </div>
                </div>
            </div>
            
            <div class="course-description">
                <h3>Course Description</h3>
                <p>{{ course.description }}</p>
                
                <h3>What you will learn</h3>
                <ul>
                    {% for video in course.videos %}
                        <li>{{ video.title }}</li>
                    {% else %}
                        <li>No videos available yet.</li>
                    {% endfor %}
                </ul>
                
                <h3>Requirements</h3>
                <p>No specific requirements. This course is suitable for both beginners and professionals who want to deepen their knowledge.</p>
            </div>
        </div>

        <!-- CUSTOMER INFORMATION -->
        <div class="customer-section">
            <h3>Company Information</h3>
            <div class="info-grid">
                <div class="info-item">
                    <div class="icon"><img class="icon" src="{{ asset('images/User.svg') }}" /></div>
                    <div class="info-value">
                        {{ app.user ? app.user.username|default('Sara Smith') : 'Sara Smith' }}
                    </div>
                </div>
                <div class="info-item">
                    <div class="icon"><img class="icon" src="{{ asset('images/email.svg') }}" /></div>
                    <div class="info-value">
                        {{ app.user ? app.user.email|default('user@example.com') : 'user@example.com' }}
                    </div>
                </div>
                <div class="info-item">
                    <div class="icon">
                        <img class="icon" src="{{ asset('images/co.svg') }}" />
                    </div>
                    <div class="info-value">
                        {{ app.user ? app.user.companyNameFromEmail : 'Saranco.' }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}