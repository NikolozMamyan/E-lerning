{% extends 'base.html.twig' %}
{% block title %}Available Courses{% endblock %}
{% block body %}

<section class="course-section"
  data-controller="assign"
  data-assign-has-collabs-value="{{ collaborations is not empty ? 'true' : 'false' }}"
  data-assign-rows-per-page-value="10">

  <h2 class="section-title">Available Courses</h2>

  <div class="course-grid">
    {% for course in courses %}
      <div class="course-card">
        <div class="course-thumbnail bg-aml">
          
            <img src="{{ asset('uploads/courses/' ~ course.thumb) }}" alt="{{ course.title }}">
          

          {% if course.videos|length > 0 %}
            <span class="duration-badge">
              {{ (course.videos|first.duration / 60)|round(0, 'floor') }}:
              {{ '%02d'|format(course.videos|first.duration % 60) }}
            </span>
          {% endif %}
        </div>

        <div class="course-info">
          <h3 class="course-title">{{ course.title }}</h3>
          <p class="course-subtitle">
            {{ course.description|slice(0, 120) }}{% if course.description|length > 120 %}...{% endif %}
          </p>

          <div class="course-footer">
            <button
              type="button"
              class="see-course-btn"
              data-action="assign#tryAssign"
              data-course-id="{{ course.id }}"
              data-course-title="{{ course.title|e('html_attr') }}">
              Buy & Assign
              <svg class="icon-plus" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" aria-hidden="true">
                <rect x="28" y="12" width="8" height="40" />
                <rect x="12" y="28" width="40" height="8" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <!-- Modal -->
<div id="assignModal"
     class="modal-overlay"
     data-assign-target="modal"
     data-action="click->assign#onOverlayClick keydown@window->assign#handleKeydown">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title">
        <svg class="modal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="8.5" cy="7" r="4"/>
          <line x1="20" y1="8" x2="20" y2="14"/>
          <line x1="23" y1="11" x2="17" y2="11"/>
        </svg>
        Assign Course
      </h3>
      <button type="button" class="modal-close" data-action="assign#close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="modal-body">
      <div class="course-info-banner">
        <svg class="banner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        <span data-assign-target="courseName"></span>
      </div>

      <!-- Tabs -->
      <div class="tabs-container">
        <button class="tab-btn active"
                data-assign-target="tabs"
                data-tab="team"
                data-action="assign#showTeamTab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Your Team ({{ collaborations|length }})
        </button>

        <button style="display:none" class="tab-btn"
                data-assign-target="tabs"
                data-tab="email"
                data-action="assign#showEmailTab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          Assign by Email
        </button>
      </div>

      <!-- Team Tab -->
      <div id="teamTab" class="tab-content active" data-assign-target="teamTab">
        {% if collaborations is not empty %}
          <div class="table-controls">
            <div class="search-box">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
              </svg>
              <input type="text"
                     placeholder="Search by name or email..."
                     data-assign-target="searchInput"
                     data-action="input->assign#filterTable">
            </div>
            <div class="results-info">
              <span data-assign-target="resultsCount">{{ collaborations|length }}</span> members
            </div>
          </div>

          <div class="table-wrapper" data-assign-target="tableWrapper">
            <table class="assign-table" data-assign-target="table">
              <thead>
                <tr>
                  <th>
                    <div class="th-content">
                      Member
                      <svg class="sort-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M7 10l5 5 5-5z"/>
                      </svg>
                    </div>
                  </th>
                  <th class="email-col">Email</th>
                  <th class="action-col">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for collab in collaborations %}
                  <tr class="user-row">
                    <td>
                      <div class="user-cell">
                        <div class="user-avatar">
                          <img class="user-avatar" src="{{ asset(collab.employee.avatar ? 'uploads/avatars/' ~ collab.employee.avatar : 'images/User.svg') }}" />
                        </div>
                        <span class="user-name">{{ collab.employee.username ?? '—' }}</span>
                      </div>
                    </td>
                    <td class="email-col">
                      <span class="user-email">{{ collab.employee.email ?? '—' }}</span>
                    </td>
                    <td class="action-col">
                      <button type="button"
                              class="assign-btn-quick"
                              title="Assign in 1 click"
                              data-action="assign#quickAssign"
                              data-email="{{ collab.employee.email }}"
                              data-username="{{ collab.employee.username|e('html_attr') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M5 12h14"/>
                          <path d="M12 5l7 7-7 7"/>
                        </svg>
                        Assign
                      </button>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <div class="no-results" style="display:none" data-assign-target="noResults">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <p>No members found</p>
          </div>

          <div class="pagination" data-assign-target="pagination"></div>
        {% else %}
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h4>No team members yet</h4>
            <p>Add collaborators to assign courses directly</p>
          </div>
        {% endif %}
      </div>

      <!-- Email Tab -->
      <div id="emailTab" class="tab-content" data-assign-target="emailTab">
        <form class="assign-form" method="POST" data-action="submit->assign#submitEmailForm">
          <div class="form-group">
            <label for="userEmail">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              Recipient Email
            </label>
            <input type="email"
                   id="userEmail"
                   name="email"
                   placeholder="collaborator@company.com"
                   required
                   autocomplete="email"
                   data-assign-target="userEmail">
            <div class="form-error" data-assign-target="emailError"></div>
          </div>

          <input type="hidden"
                 name="_token"
                 value="{{ csrf_token('company_checkout') }}"
                 data-assign-target="csrfToken">

          <div class="form-actions">
            <button type="button" class="btn-cancel" data-action="assign#close">
              Cancel
            </button>
            <button type="submit" class="btn-primary" data-assign-target="submitBtn">
              <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4"/>
                <path d="M12 8h.01"/>
              </svg>
              <span data-assign-target="btnText">Buy & Assign</span>
              <span class="spinner" style="display:none" data-assign-target="spinner"></span>
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>
</section>
{% endblock %}