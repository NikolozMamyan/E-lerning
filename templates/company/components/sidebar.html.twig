{% set currentRoute = app.request.attributes.get('_route') %}
{% set dashboardActive = currentRoute == 'company_dashboard' %}
{% set coursesActive = currentRoute starts with 'company_course' %}
{% set employeesActive = currentRoute starts with 'company_colab' or currentRoute == 'company_employee_edit' %}
{% set trackingActive = currentRoute == 'company_team_tracking' %}
{% set transactionsActive = currentRoute == 'app_co_transactions' or currentRoute starts with 'company_payment' %}

<aside class="sidebar sidebar--company" aria-label="Company navigation">
  <div class="sidebar-header">
    <a href="{{ path('company_dashboard') }}" class="sidebar-brand" aria-label="Go to company dashboard">
      <img src="{{ asset('images/logo.png') }}" class="sidebar-brand__logo" alt="Les Consultants">
    </a>
    <span class="sidebar-workspace-badge">
      <i class="fa-solid fa-building" aria-hidden="true"></i>
      Company workspace
    </span>
    <button class="close-btn" id="close-btn" type="button" aria-label="Close navigation">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
  </div>

  <nav class="sidebar-nav">
    <section class="nav-section" aria-labelledby="company-overview-label">
      <p class="nav-section__label" id="company-overview-label">Overview</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('company_dashboard') }}" class="nav-link {{ dashboardActive ? 'active' : '' }}" aria-current="{{ dashboardActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i></span>
            <span class="nav-link__label">Dashboard</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="company-team-label">
      <p class="nav-section__label" id="company-team-label">Team management</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('company_colab') }}" class="nav-link {{ employeesActive ? 'active' : '' }}" aria-current="{{ employeesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span>
            <span class="nav-link__label">Employees</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="{{ path('company_team_tracking') }}" class="nav-link {{ trackingActive ? 'active' : '' }}" aria-current="{{ trackingActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></span>
            <span class="nav-link__label">Team progress</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="company-learning-label">
      <p class="nav-section__label" id="company-learning-label">Learning</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('company_courses') }}" class="nav-link {{ coursesActive ? 'active' : '' }}" aria-current="{{ coursesActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
            <span class="nav-link__label">Available courses</span>
          </a>
        </li>
        <li class="nav-item">
          <a href="mailto:?subject=You're%20invited%20to%20join%20our%20Compliance%20E-learning%20Platform&amp;body=Hello,%0A%0AI%27d%20like%20to%20invite%20you%20to%20join%20the%20E-learning%20platform%20from%20Les%20Consultants.%0A%0AYou%20can%20sign%20up%20here:%20https://elearning-lesconsultants.com%0A%0ABest%20regards," class="nav-link nav-link--soft">
            <span class="nav-icon"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span>
            <span class="nav-link__label">Invite a learner</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="nav-section" aria-labelledby="company-billing-label">
      <p class="nav-section__label" id="company-billing-label">Billing</p>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="{{ path('app_co_transactions') }}" class="nav-link {{ transactionsActive ? 'active' : '' }}" aria-current="{{ transactionsActive ? 'page' : 'false' }}">
            <span class="nav-icon"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span>
            <span class="nav-link__label">Payment history</span>
          </a>
        </li>
      </ul>
    </section>

  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <img src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}" class="sidebar-user__avatar" alt="">
      <div class="sidebar-user__info">
        <small>Signed in as</small>
        <strong>{{ app.user.userName }}</strong>
      </div>
      <a href="" class="sidebar-user__logout" title="Log out" aria-label="Log out" data-controller="auth" data-action="click->auth#logout">
        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</aside>
