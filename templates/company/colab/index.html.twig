{% extends 'base.html.twig' %}

{% block body %}
<div class="employees-page">
  <div class="page-header">
    <h1 class="page-title">Employees</h1>
    <button class="btn-primary" id="openModalBtn">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      Add new
    </button>
  </div>

  <div class="card">
    <div class="table-container">
      <table class="employee-table">
        <thead>
          <tr>
            <th class="checkbox-col">
              <input type="checkbox" class="main-checkbox">
            </th>
            <th></th>
            <th>Nom</th>
            <th class="hide-mobile">User ID</th>
            <th class="hide-tablet">Email</th>
            <th class="hide-mobile">Date</th>
            <th>Rôle</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
  {% for collaboration in collaborations %}
    {% set employee = collaboration.employee %}
    <tr>
      <td><input type="checkbox" class="row-checkbox"></td>
        <td><img class="user-avatar" src="{{ asset(employee.avatar ? 'uploads/avatars/' ~ employee.avatar : 'images/User.svg') }}" /> </td>
      <td class="name-cell">
        <div class="name-info">
          <span class="name">{{ employee.username }}</span>
          <span class="mobile-info">{{ employee.id }}</span>
        </div>
      </td>
      <td class="hide-mobile">{{ employee.id }}</td>
      <td class="hide-tablet">{{ employee.email }}</td>
      <td class="hide-mobile"></td>
      <td>{{ employee.bachelorDegree ?? 'No info' }}</td>
      <td>
        <span class="status"></span>
      </td>
      <td class="actions-cell">
        <a href="{{ path('company_colab_delete', {id: collaboration.id}) }}"
           class="action-btn delete-btn"
           title="Delete"
           onclick="return confirm('Are you sure you want to delete this collaborator?');">
          <img src="{{ asset('images/Delete.svg') }}" alt="delete icon">
        </a>
        <a class="action-btn edit-btn" title="Modifier">
          <img src="{{ asset('images/edit.svg') }}" alt="edit icon">
        </a>
      </td>
    </tr>
  {% else %}
    <tr>
      <td colspan="8" class="empty-state">You don’t have any collaboration</td>
    </tr>
  {% endfor %}
</tbody>
 
      </table>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="addEmployeeModal" class="modal">
  <div class="modal-overlay" id="modalOverlay"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2>Add new employee</h2>
      <button class="modal-close" id="closeModalBtn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <form id="add-colab-form" class="modal-body">
      <div class="form-group">
        <label for="employeeEmail">Employee mail</label>
        <input 
          type="email" 
          id="employeeEmail"
          name="email" 
          placeholder="exemple@email.com" 
          required
          autocomplete="email">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="cancelBtn">Close</button>
        <button type="submit" class="btn-primary">Add</button>
      </div>
    </form>
  </div>
</div>

<style>
:root{
  --green:#1A6D55;
  --teal:#0D8383;
  --black:#071717;
  --mint:#E7F3F3;
  --grey:#606060;
  --white:#FFFFFF;
  --bg:#f4f9f8;
  --radius:12px;
  --shadow:0 4px 12px rgba(7,23,23,.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.employees-page {
  padding: 2rem;
  background: var(--bg);
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
}

.page-title {
  font-size: 2rem;
  color: var(--black);
  font-weight: 600;
}

.btn-primary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: var(--green);
  color: var(--white);
  border: none;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: var(--shadow);
}

.btn-primary:hover {
  background: var(--teal);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(7,23,23,.12);
}

.btn-secondary {
  padding: 0.75rem 1.5rem;
  background: transparent;
  color: var(--grey);
  border: 1px solid var(--mint);
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-secondary:hover {
  background: var(--mint);
  color: var(--black);
}

.card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.table-container {
  overflow-x: auto;
}

.employee-table {
  width: 100%;
  border-collapse: collapse;
}

.employee-table thead {
  background: var(--mint);
  border-bottom: 2px solid var(--green);
}

.employee-table th {
  padding: 1rem;
  text-align: left;
  font-weight: 600;
  color: var(--black);
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.employee-table td {
  padding: 1rem;
  border-bottom: 1px solid var(--mint);
  color: var(--grey);
}

.employee-table tbody tr {
  transition: background 0.2s ease;
}

.employee-table tbody tr:hover {
  background: var(--bg);
}

.checkbox-col {
  width: 50px;
}

.name-cell {
  font-weight: 500;
  color: var(--black);
}

.name-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.mobile-info {
  display: none;
  font-size: 0.75rem;
  color: var(--grey);
}

.status {
  display: inline-block;
  padding: 0.375rem 0.875rem;
  border-radius: 20px;
  font-size: 0.813rem;
  font-weight: 500;
}

.status.completed {
  background: rgba(26, 109, 85, 0.1);
  color: var(--green);
}

.status.in-learning {
  background: rgba(13, 131, 131, 0.1);
  color: var(--teal);
}

.actions-cell {
  display: flex;
  gap: 0.5rem;
  padding: 2rem !important;
}

.action-btn {
  padding: 0.5rem;
  background: transparent;
  border: none;
  cursor: pointer;
  border-radius: 8px;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn:hover {
  background: var(--mint);
}

.action-btn img {
  width: 18px;
  height: 18px;
}

.empty-state {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--grey);
  font-style: italic;
}

/* Modal Styles */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.modal.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(7, 23, 23, 0.5);
  backdrop-filter: blur(4px);
}

.modal-content {
  position: relative;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: 0 20px 60px rgba(7,23,23,.2);
  max-width: 500px;
  width: 90%;
  margin: 10vh auto;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid var(--mint);
}

.modal-header h2 {
  font-size: 1.5rem;
  color: var(--black);
  font-weight: 600;
}

.modal-close {
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 8px;
  color: var(--grey);
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
}

.modal-close:hover {
  background: var(--mint);
  color: var(--black);
}

.modal-body {
  padding: 1.5rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  color: var(--black);
  font-weight: 500;
  font-size: 0.938rem;
}

.form-group input {
  width: 100%;
  padding: 0.875rem;
  border: 2px solid var(--mint);
  border-radius: var(--radius);
  font-size: 1rem;
  color: var(--black);
  transition: all 0.3s ease;
  background: var(--bg);
}

.form-group input:focus {
  outline: none;
  border-color: var(--green);
  background: var(--white);
}

.form-group input::placeholder {
  color: var(--grey);
  opacity: 0.6;
}

.modal-footer {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding-top: 1rem;
  border-top: 1px solid var(--mint);
}

/* Responsive */
@media (max-width: 768px) {
  .hide-tablet {
    display: none;
  }
  
  .employees-page {
    padding: 1rem;
  }
  
  .page-header {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  
  .btn-primary {
    justify-content: center;
  }
}

@media (max-width: 480px) {
  .hide-mobile {
    display: none;
  }
  
  .mobile-info {
    display: block;
  }
  
  .actions-cell {
    flex-direction: column;
  }
  
  .modal-content {
    margin: 5vh auto;
  }
  
  .modal-footer {
    flex-direction: column;
  }
  
  .btn-secondary,
  .btn-primary {
    width: 100%;
  }
}
</style>

<script>
// Modal functionality
const modal = document.getElementById('addEmployeeModal');
const openBtn = document.getElementById('openModalBtn');
const closeBtn = document.getElementById('closeModalBtn');
const cancelBtn = document.getElementById('cancelBtn');
const overlay = document.getElementById('modalOverlay');

function openModal() {
  modal.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  modal.classList.remove('active');
  document.body.style.overflow = '';
  document.getElementById('add-colab-form').reset();
}

openBtn.addEventListener('click', openModal);
closeBtn.addEventListener('click', closeModal);
cancelBtn.addEventListener('click', closeModal);
overlay.addEventListener('click', closeModal);

// Close modal on Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && modal.classList.contains('active')) {
    closeModal();
  }
});

// Form submission
document.getElementById('add-colab-form').addEventListener('submit', async function (e) {
  e.preventDefault();
  
  const submitBtn = this.querySelector('button[type="submit"]');
  const originalText = submitBtn.textContent;
  submitBtn.textContent = 'Ajout en cours...';
  submitBtn.disabled = true;
  
  const formData = new FormData(this);

  try {
    const response = await fetch('{{ path("company_colab_add") }}', {
      method: 'POST',
      body: formData
    });

    const result = await response.json();
    
    if (result.success) {
      closeModal();
      location.reload();
    } else {
      alert(result.error || 'Une erreur est survenue');
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  } catch (error) {
    alert('Erreur de connexion');
    submitBtn.textContent = originalText;
    submitBtn.disabled = false;
  }
});

// Checkbox functionality
const mainCheckbox = document.querySelector('.main-checkbox');
const rowCheckboxes = document.querySelectorAll('.row-checkbox');

mainCheckbox?.addEventListener('change', function() {
  rowCheckboxes.forEach(checkbox => {
    checkbox.checked = this.checked;
  });
});

rowCheckboxes.forEach(checkbox => {
  checkbox.addEventListener('change', function() {
    const allChecked = Array.from(rowCheckboxes).every(cb => cb.checked);
    const someChecked = Array.from(rowCheckboxes).some(cb => cb.checked);
    mainCheckbox.checked = allChecked;
    mainCheckbox.indeterminate = someChecked && !allChecked;
  });
});
</script>
{% endblock %}