{% extends 'base.html.twig' %}

{% block title %}Payment Success{% endblock %}

{% block body %}

  <div class="card" style="border:1px solid #e5e7eb; border-radius:12px; padding:24px;">
    <h1 style="margin:0 0 8px; font-size:24px;">🎉 Thank you! Payment confirmed</h1>

    {% if hasSession %}
      <p style="margin:0 0 16px; color:#4b5563;">
        {% if context == 'company_single_seat' %}
          Your payment has been received. Access to the course for
          <strong>{{ targetEmail }}</strong>
          will be activated automatically within the next few minutes.
        {% else %}
          Your payment has been received. Your access to the course will be activated automatically within the next few minutes.
        {% endif %}
      </p>

      <div style="background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; padding:16px; margin-bottom:16px;">
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <span style="color:#6b7280;">Course</span>
          <strong>{{ courseTitle ?? '—' }}</strong>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
          <span style="color:#6b7280;">Amount</span>
          <strong>
            {% if amount is not null %}
              {{ amount|number_format(2, '.', ',') }} {{ currency }}
            {% else %}
              —
            {% endif %}
          </strong>
        </div>
        {% if context == 'company_single_seat' %}
          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
            <span style="color:#6b7280;">Employee</span>
            <strong>{{ targetEmail ?? '—' }}</strong>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#6b7280;">Buyer</span>
            <strong>{{ buyerEmail ?? '—' }}</strong>
          </div>
        {% else %}
          <div style="display:flex; justify-content:space-between;">
            <span style="color:#6b7280;">Buyer email</span>
            <strong>{{ buyerEmail ?? '—' }}</strong>
          </div>
        {% endif %}
      </div>

      {# Status note - reminder: webhook finalizes the enrollment #}
      {% if paymentStatus == 'paid' %}
        <div style="background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; padding:12px 14px; border-radius:8px; margin-bottom:16px;">
          Payment received ✅ —  Thank you!Your payment has been validated, access will be activated automatically.
        </div>
      {% else %}
        <div style="background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; padding:12px 14px; border-radius:8px; margin-bottom:16px;">
          Payment is being confirmed… Access will be activated automatically once confirmed.
        </div>
      {% endif %}
    {% else %}
      <p style="margin:0 0 12px; color:#4b5563;">
        Thank you! If your payment has been validated, access will be activated automatically. (No session details were provided.)
      </p>
    {% endif %}

    <div style="display:flex; gap:12px; margin-top:16px;">
      <a href="{{ path('company_courses') }}" class="btn" style="padding:10px 14px; border-radius:8px; background:#111827; color:white; text-decoration:none;">
        Back to courses
      </a>
    </div>
  </div>




<style>
.payment-success {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background-color: var(--bg);
}
.success-container {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 560px;
    width: 100%;
}
.success-icon { margin-bottom: 2rem; }
.success-icon img {
    width: 120px; height: 120px; object-fit: contain;
}
.success-title {
    color: var(--green);
    font-size: 2.2rem; font-weight: 700;
    margin-bottom: 1rem; line-height: 1.2;
}
.success-message {
    color: var(--grey);
    font-size: 1.05rem;
    margin-bottom: 1.5rem; line-height: 1.5;
}
.success-details {
    background: var(--mint);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2rem;
    text-align: left;
}
.detail-item {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 0.75rem;
}
.detail-item:last-child { margin-bottom: 0; }
.detail-label { color: var(--grey); font-weight: 500; }
.detail-value { color: var(--black); font-weight: 600; }
.success-actions {
    display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;
}
.btn {
    padding: 0.875rem 1.5rem; border-radius: var(--radius); text-decoration: none;
    font-weight: 600; transition: all 0.2s ease; border: 2px solid transparent;
    cursor: pointer; font-size: 1rem;
}
.btn-primary { background-color: var(--green); color: var(--white); }
.btn-primary:hover { background-color: var(--teal); transform: translateY(-1px); }
.btn-secondary { background-color: var(--white); color: var(--green); border-color: var(--green); }
.btn-secondary:hover { background-color: var(--mint); transform: translateY(-1px); }

@media (max-width: 768px) {
    .success-container { padding: 2rem 1.5rem; margin: 1rem; }
    .success-title { font-size: 1.8rem; }
    .success-actions { flex-direction: column; }
    .btn { width: 100%; }
}
</style>
{% endblock %}
