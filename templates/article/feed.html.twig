{# templates/article/feed.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Compliance Learning Community Feed | Luxembourg{% endblock %}
{% block meta_description %}Discover professional insights, regulatory updates and learner conversations about compliance, AML/CFT, risk and digital learning in Luxembourg.{% endblock %}
{% block meta_robots %}index, follow, max-image-preview:large, max-snippet:-1{% endblock %}
{% block canonical_url %}{{ url('article_feed') }}{% endblock %}

{% block structured_data %}
  {% set feedItems = [] %}
  {% for article in articles %}
    {% set feedItems = feedItems|merge([{
      '@type': 'ListItem',
      'position': loop.index,
      'url': url('app_public_article', {id: article.id, slug: article.slug}),
      'name': article.titre
    }]) %}
  {% endfor %}
  {% set feedData = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    'name': 'Les Consultants Learning Community Feed',
    'url': url('article_feed'),
    'description': 'Professional learning conversations about compliance, AML/CFT, risk and regulated industries.',
    'mainEntity': {
      '@type': 'ItemList',
      'itemListElement': feedItems
    }
  } %}
  <script type="application/ld+json">{{ feedData|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('styles/articleFeed.css') }}">
{% endblock %}
{% block body %}
<section class="community-feed" data-feed-filter="{{ activeFilter }}" data-authenticated="{{ app.user ? 'true' : 'false' }}">
  {% if not app.user %}
    <header class="community-feed__guest-nav">
      <a href="{{ path('app_landing_page') }}" class="guest-nav__brand" aria-label="Les Consultants home">
        <img src="{{ asset('images/logo.png') }}" alt="Les Consultants">
        <span><strong>Learning Community</strong><small>by Les Consultants</small></span>
      </a>
      <div class="guest-nav__message">
        <span><i class="fa-solid fa-globe" aria-hidden="true"></i>Public preview</span>
        <p>Discover what our learners are sharing.</p>
      </div>
      <nav class="guest-nav__actions" aria-label="Guest account actions">
        <a href="{{ path('app_public_catalog') }}" class="guest-nav__login">Catalogue</a>
        <a href="{{ path('show_login') }}" class="guest-nav__login">Sign in</a>
        <a href="{{ path('show_register') }}" class="guest-nav__register"><i class="fa-solid fa-star" aria-hidden="true"></i><span>Create free account</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </nav>
    </header>
  {% endif %}

  <header class="community-feed__hero">
    <div class="community-feed__hero-copy">
      <span class="community-feed__eyebrow">
        <i class="fa-solid fa-users" aria-hidden="true"></i>
        Learning community
      </span>
      <h1>Community feed</h1>
      <p>Share useful ideas, learn from your peers and keep the conversation moving.</p>
      <div class="community-feed__hero-meta">
        <span><i class="fa-solid fa-address-card" aria-hidden="true"></i>Real learner profiles</span>
        <span><i class="fa-solid fa-bolt" aria-hidden="true"></i>Live conversations</span>
      </div>
    </div>

    {% if is_granted('ROLE_USER') %}
      <button type="button" class="community-feed__create js-open-modal">
        <span class="community-feed__create-icon"><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
        <span>
          <small>Share with the community</small>
          <strong>Create a post</strong>
        </span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </button>
    {% else %}
      <a href="{{ path('show_register') }}" class="community-feed__create community-feed__create--guest">
        <span class="community-feed__create-icon"><i class="fa-solid fa-rocket" aria-hidden="true"></i></span>
        <span><small>Ready to participate?</small><strong>Join the learning community</strong></span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    {% endif %}
  </header>

  <nav class="community-feed__filters" aria-label="Feed filters">
    <div>
      <a href="{{ path('article_feed', {filter: 'latest'}) }}" class="{{ activeFilter == 'latest' ? 'is-active' : '' }}">
        <i class="fa-regular fa-clock" aria-hidden="true"></i>
        Latest
      </a>
      <a href="{{ path('article_feed', {filter: 'popular'}) }}" class="{{ activeFilter == 'popular' ? 'is-active' : '' }}">
        <i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i>
        Popular
      </a>
      {% if is_granted('ROLE_USER') %}
        <a href="{{ path('article_feed', {filter: 'mine'}) }}" class="{{ activeFilter == 'mine' ? 'is-active' : '' }}">
          <i class="fa-regular fa-user" aria-hidden="true"></i>
          My posts
        </a>
      {% endif %}
    </div>
    <span><i class="fa-solid fa-sliders" aria-hidden="true"></i>{{ activeFilter == 'mine' ? 'Your activity' : (activeFilter == 'popular' ? 'Most engaging' : 'Newest first') }}</span>
  </nav>

  {% set featuredTrendingArticle = trendingArticles|first %}
  {% set featuredJobOffer = jobOffers|first %}
  {% set nextCommunityEvent = upcomingEvents|first %}
  <nav class="community-feed__mobile-insights" aria-label="Community highlights">
    <a href="{{ featuredTrendingArticle ? path('app_public_article', {id: featuredTrendingArticle.id, slug: featuredTrendingArticle.slug}) : path('article_feed', {filter: 'popular'}) }}" class="mobile-insight mobile-insight--trending" aria-label="View the leading trending conversation">
      <span class="mobile-insight__icon"><i class="fa-solid fa-fire" aria-hidden="true"></i></span>
      <span class="mobile-insight__copy"><strong>Trending</strong><small>{{ trendingArticles|length }} hot topic{{ trendingArticles|length == 1 ? '' : 's' }}</small></span>
      <span class="mobile-insight__badge">{{ trendingArticles|length }}</span>
    </a>

    {% if featuredJobOffer %}
      <button type="button" class="mobile-insight mobile-insight--job" data-community-carousel-open="jobs" data-community-carousel-index="0" aria-label="Open current job opportunities">
        <span class="mobile-insight__icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
        <span class="mobile-insight__copy"><strong>Jobs</strong><small>{{ jobOffers|length }} live offer{{ jobOffers|length == 1 ? '' : 's' }}</small></span>
        <span class="mobile-insight__badge">{{ jobOffers|length }}</span>
      </button>
    {% else %}
      <span class="mobile-insight mobile-insight--job is-muted">
        <span class="mobile-insight__icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
        <span class="mobile-insight__copy"><strong>Jobs</strong><small>Coming soon</small></span>
      </span>
    {% endif %}

    {% if nextCommunityEvent %}
      <button type="button" class="mobile-insight mobile-insight--agenda" data-community-carousel-open="events" data-community-carousel-index="0" aria-label="Open upcoming community events">
        <span class="mobile-insight__icon"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>
        <span class="mobile-insight__copy"><strong>Agenda</strong><small>{{ upcomingEvents|length }} upcoming</small></span>
        <span class="mobile-insight__badge">{{ upcomingEvents|length }}</span>
      </button>
    {% else %}
      <span class="mobile-insight mobile-insight--agenda is-muted">
        <span class="mobile-insight__icon"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>
        <span class="mobile-insight__copy"><strong>Agenda</strong><small>No date yet</small></span>
      </span>
    {% endif %}
  </nav>

  <div class="community-feed__layout">
    <div class="community-feed__stream">
      {% if is_granted('ROLE_USER') %}
        {% include 'components/feed/_composer.html.twig' %}
      {% endif %}

      <section class="articles-list" id="articles-list" aria-live="polite">
        {% for article in articles %}
          {% include 'components/feed/_article_card.html.twig' with { article: article } %}
        {% else %}
          <div class="community-feed__empty">
            <span><i class="fa-regular fa-message" aria-hidden="true"></i></span>
            <h2>{{ activeFilter == 'mine' ? 'You have not posted yet' : 'No conversations yet' }}</h2>
            <p>{{ activeFilter == 'mine' ? 'Create your first post and start a conversation with the community.' : 'Be the first member to share something useful.' }}</p>
            {% if is_granted('ROLE_USER') %}
              <button type="button" class="js-open-modal">Create a post</button>
            {% else %}
              <a href="{{ path('show_register') }}">Join the community</a>
            {% endif %}
          </div>
        {% endfor %}
      </section>

      <div id="feed-loader" class="community-feed__loader">
        <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
        Loading more conversations...
      </div>
      <div id="feed-sentinel" class="community-feed__sentinel" aria-hidden="true"></div>
    </div>

    <aside class="community-feed__rail" aria-label="Community highlights">
      <section class="feed-widget feed-widget--trending">
        <div class="feed-widget__heading">
          <div>
            <span>Community picks</span>
            <h2>Trending now</h2>
          </div>
          <span class="feed-widget__heading-icon"><i class="fa-solid fa-fire" aria-hidden="true"></i></span>
        </div>

        <div class="feed-widget__trending-list">
          {% for trendingArticle in trendingArticles %}
            <a href="{{ path('app_public_article', {id: trendingArticle.id, slug: trendingArticle.slug}) }}" class="feed-widget__trend">
              <span class="feed-widget__rank">{{ '%02d'|format(loop.index) }}</span>
              <span class="feed-widget__trend-copy">
                <strong>{{ trendingArticle.titre }}</strong>
                <small>{{ trendingArticle.likesCount }} likes <span aria-hidden="true">&bull;</span> {{ trendingArticle.comments|length }} comments</small>
              </span>
              <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </a>
          {% else %}
            <p class="feed-widget__empty">Popular conversations will appear here.</p>
          {% endfor %}
        </div>
      </section>

      {% if is_granted('ROLE_USER') %}
        <section class="feed-widget feed-widget--profile">
          <div class="feed-widget__profile-head">
            <img src="{{ asset(app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}" alt="">
            <div>
              <span>Your community profile</span>
              <strong>{{ app.user.userName }}</strong>
            </div>
          </div>

          <div class="feed-widget__stats">
            <a href="{{ path('article_feed', {filter: 'mine'}) }}">
              <strong>{{ userStats.posts }}</strong>
              <span>Posts</span>
            </a>
            <div>
              <strong>{{ userStats.likesReceived }}</strong>
              <span>Likes</span>
            </div>
            <div>
              <strong>{{ userStats.commentsReceived }}</strong>
              <span>Comments</span>
            </div>
          </div>

          <button type="button" class="feed-widget__action js-open-modal">
            <i class="fa-solid fa-pen" aria-hidden="true"></i>
            Start a conversation
          </button>
        </section>
      {% else %}
        <section class="feed-widget feed-widget--guest">
          <span class="feed-widget__guest-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></span>
          <span class="feed-widget__guest-eyebrow">Your next step</span>
          <h2>Turn inspiration into progress.</h2>
          <p>Create your free account to join conversations, follow courses and showcase your certificates.</p>
          <ul>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i>React and exchange with learners</li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Track your learning journey</li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i>Build a verified profile</li>
          </ul>
          <a href="{{ path('show_register') }}" class="feed-widget__guest-cta"><span>Join for free</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
          <small>Already a member? <a href="{{ path('show_login') }}">Sign in</a></small>
        </section>
      {% endif %}

      <section class="feed-opportunity" id="job-offer" data-community-carousel data-carousel-autoplay="6500">
        <header class="feed-opportunity__header">
          <span class="feed-opportunity__icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
          <div><small>Featured opportunities</small><strong>Now hiring</strong></div>
          {% if jobOffers|length %}
            <div class="feed-mini-carousel__nav" aria-label="Browse job opportunities">
              <button type="button" data-carousel-prev aria-label="Previous opportunity"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
              <span><strong data-carousel-current>1</strong>/{{ jobOffers|length }}</span>
              <button type="button" data-carousel-next aria-label="Next opportunity"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            </div>
          {% endif %}
        </header>
        {% if jobOffers|length %}
          <div class="feed-mini-carousel__track" aria-live="polite">
            {% for jobOffer in jobOffers %}
              <article class="feed-mini-carousel__slide" data-carousel-slide data-carousel-index="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
                <button type="button" class="feed-opportunity__summary" data-community-carousel-open="jobs" data-community-carousel-index="{{ loop.index0 }}">
                  <span>{{ jobOffer.title }}</span>
                  <small>{{ jobOffer.description|striptags|slice(0, 125) }}{% if jobOffer.description|striptags|length > 125 %}&hellip;{% endif %}</small>
                  <em>View full opportunity <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></em>
                </button>
                <div class="feed-opportunity__actions">
                  {% if is_granted('ROLE_EMPLOYEE') %}
                    {% if jobOffer.id in appliedJobOfferIds %}
                      <span class="feed-opportunity__done"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>CV submitted</span>
                    {% else %}
                      <form method="post" action="{{ path('community_job_apply', {id: jobOffer.id}) }}" enctype="multipart/form-data" class="feed-cv-quick-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('job_apply_' ~ jobOffer.id) }}">
                        <input type="file" name="cv" id="quick-cv-{{ jobOffer.id }}" accept=".pdf,.doc,.docx" required hidden data-community-cv-input>
                        <label for="quick-cv-{{ jobOffer.id }}"><i class="fa-solid fa-paperclip" aria-hidden="true"></i>Submit my CV</label>
                      </form>
                    {% endif %}
                  {% else %}
                    <a href="{{ path('show_login') }}"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>Sign in to apply</a>
                  {% endif %}
                </div>
                <small class="feed-opportunity__file-note">PDF, DOC or DOCX &middot; 5 MB max</small>
              </article>
            {% endfor %}
          </div>
        {% else %}
          <div class="feed-opportunity__empty"><strong>New opportunities soon.</strong><span>Follow the feed to discover the next role.</span></div>
        {% endif %}
      </section>

      <section class="feed-agenda" id="community-agenda" data-community-carousel data-carousel-autoplay="7200">
        <header class="feed-agenda__header">
          <div><small>Advertisement</small><strong>Community agenda</strong></div>
          {% if upcomingEvents|length %}
            <div class="feed-mini-carousel__nav feed-mini-carousel__nav--agenda" aria-label="Browse upcoming events">
              <button type="button" data-carousel-prev aria-label="Previous event"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
              <span><strong data-carousel-current>1</strong>/{{ upcomingEvents|length }}</span>
              <button type="button" data-carousel-next aria-label="Next event"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            </div>
          {% else %}
            <span><i class="fa-solid fa-calendar-days" aria-hidden="true"></i></span>
          {% endif %}
        </header>
        <div class="feed-agenda__list feed-mini-carousel__track" aria-live="polite">
          {% for event in upcomingEvents %}
            <article class="feed-agenda__item feed-mini-carousel__slide" data-carousel-slide data-carousel-index="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
              <button type="button" class="feed-agenda__details" data-community-carousel-open="events" data-community-carousel-index="{{ loop.index0 }}">
                <time datetime="{{ event.startsAt|date('c') }}"><strong>{{ event.startsAt|date('d') }}</strong><span>{{ event.startsAt|date('M')|upper }}</span></time>
                <span><strong>{{ event.title }}</strong><small><i class="fa-solid {{ event.location ? 'fa-location-dot' : 'fa-video' }}" aria-hidden="true"></i>{{ event.location ?: 'Online event' }} &middot; {{ event.startsAt|date('H:i') }}</small></span>
              </button>
              <div class="feed-agenda__reservation">
                {% if is_granted('ROLE_EMPLOYEE') %}
                  {% if event.id in registeredEventIds %}
                    <span class="feed-agenda__registered"><i class="fa-solid fa-check" aria-hidden="true"></i>Registered</span>
                  {% else %}
                    <form method="post" action="{{ path('community_event_register', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}"><button type="submit">Reserve my place</button></form>
                  {% endif %}
                {% else %}
                  <a href="{{ path('show_login') }}">Sign in to register</a>
                {% endif %}
              </div>
            </article>
          {% else %}
            <div class="feed-agenda__empty"><i class="fa-regular fa-calendar" aria-hidden="true"></i><span><strong>The next event is on its way.</strong><small>New dates will appear here.</small></span></div>
          {% endfor %}
        </div>
      </section>
    </aside>
  </div>

  {% if is_granted('ROLE_USER') %}
    <button type="button" class="community-feed__mobile-create js-open-modal" aria-label="Create a post">
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
    </button>
    {% include 'components/feed/_modal_create.html.twig' %}
  {% endif %}

  {% if jobOffers|length %}
    <dialog class="community-info-modal" data-community-carousel data-community-carousel-modal="jobs" aria-label="Job opportunities">
      <div class="community-info-modal__accent community-info-modal__accent--job"></div>
      <button type="button" class="community-info-modal__close" data-community-modal-close aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <div class="community-info-modal__slides" aria-live="polite">
        {% for jobOffer in jobOffers %}
          <article class="community-info-modal__slide" data-carousel-slide data-carousel-index="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
            <header><span class="community-info-modal__icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span><div><small>Current opportunity</small><h2>{{ jobOffer.title }}</h2></div></header>
            <div class="community-info-modal__content">{% if jobOffer.description|striptags == jobOffer.description %}{{ jobOffer.description|e|nl2br }}{% else %}{{ jobOffer.description|sanitize_html('app.community_content_sanitizer') }}{% endif %}</div>
            <footer>
              <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Your CV is stored privately and only accessible to the recruitment administrator.</span>
              {% if is_granted('ROLE_EMPLOYEE') %}
                {% if jobOffer.id in appliedJobOfferIds %}<span class="community-info-modal__confirmed"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>CV already submitted</span>{% else %}<form method="post" action="{{ path('community_job_apply', {id: jobOffer.id}) }}" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf_token('job_apply_' ~ jobOffer.id) }}"><label>Choose your CV<input type="file" name="cv" accept=".pdf,.doc,.docx" required></label><button type="submit"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i>Submit my application</button></form>{% endif %}
              {% else %}
                <a href="{{ path('show_login') }}" class="community-info-modal__primary">Sign in to submit your CV <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
              {% endif %}
            </footer>
          </article>
        {% endfor %}
      </div>
      <nav class="community-info-modal__navigation" aria-label="Browse job opportunities">
        <button type="button" data-carousel-prev aria-label="Previous opportunity"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
        <span><strong data-carousel-current>1</strong><i>/</i>{{ jobOffers|length }}</span>
        <button type="button" data-carousel-next aria-label="Next opportunity"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
      </nav>
    </dialog>
  {% endif %}

  {% if upcomingEvents|length %}
    <dialog class="community-info-modal" data-community-carousel data-community-carousel-modal="events" aria-label="Upcoming community events">
      <div class="community-info-modal__accent community-info-modal__accent--event"></div>
      <button type="button" class="community-info-modal__close" data-community-modal-close aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <div class="community-info-modal__slides" aria-live="polite">
        {% for event in upcomingEvents %}
          <article class="community-info-modal__slide" data-carousel-slide data-carousel-index="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
            <header><span class="community-info-modal__date"><strong>{{ event.startsAt|date('d') }}</strong><small>{{ event.startsAt|date('M')|upper }}</small></span><div><small>Community event</small><h2>{{ event.title }}</h2></div></header>
            <div class="community-info-modal__facts"><span><i class="fa-regular fa-clock" aria-hidden="true"></i>{{ event.startsAt|date('l, d F Y · H:i') }}</span><span><i class="fa-solid {{ event.location ? 'fa-location-dot' : 'fa-video' }}" aria-hidden="true"></i>{{ event.location ?: 'Online event' }}</span><span><i class="fa-solid fa-users" aria-hidden="true"></i>{{ event.registrations|length }} member{{ event.registrations|length == 1 ? '' : 's' }} registered</span></div>
            <div class="community-info-modal__content">{% if event.description|striptags == event.description %}{{ event.description|e|nl2br }}{% else %}{{ event.description|sanitize_html('app.community_content_sanitizer') }}{% endif %}</div>
            <footer class="community-info-modal__reservation">
              {% if is_granted('ROLE_EMPLOYEE') %}
                {% if event.id in registeredEventIds %}<span class="community-info-modal__confirmed"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Your place is confirmed</span>{% else %}<form method="post" action="{{ path('community_event_register', {id: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_register_' ~ event.id) }}"><button type="submit"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i>Reserve my place</button></form>{% endif %}
              {% else %}<a href="{{ path('show_login') }}" class="community-info-modal__primary">Sign in to reserve your place <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>{% endif %}
            </footer>
          </article>
        {% endfor %}
      </div>
      <nav class="community-info-modal__navigation community-info-modal__navigation--event" aria-label="Browse upcoming events">
        <button type="button" data-carousel-prev aria-label="Previous event"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
        <span><strong data-carousel-current>1</strong><i>/</i>{{ upcomingEvents|length }}</span>
        <button type="button" data-carousel-next aria-label="Next event"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
      </nav>
    </dialog>
  {% endif %}
</section>

{# Scripts en bas de page #}
{% if is_granted('ROLE_USER') %}<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>{% endif %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const isAuthenticated = document.querySelector('.community-feed')?.dataset.authenticated === 'true';

  // =========================
  // ELEMENTS MODAL / COMPOSER
  // =========================
  const modal = document.getElementById('create-modal');
  const articleTitleInput = document.getElementById('article-title');
  const editorOutput = document.getElementById('editor-output');
  const publishBtn = document.getElementById('publish-btn');
  const fileInput = document.getElementById('modal-image-input');
  const imageBtn = document.getElementById('image-btn');
  const imagePreviewContainer = document.getElementById('image-preview-container');
  const videoInput = document.getElementById('modal-video-input');
  const videoPreviewContainer = document.getElementById('video-preview-container');
  const videoBtnModal = document.getElementById('video-btn-modal');
  const videoBtnComposer = document.getElementById('video-btn');

  const MAX_VIDEO_SIZE = 50 * 1024 * 1024; // 50MB

  // =========================
  // HELPERS
  // =========================
  function clearImageUpload() {
    if (fileInput) fileInput.value = '';
    if (imagePreviewContainer) {
      imagePreviewContainer.innerHTML = '';
      imagePreviewContainer.classList.remove('has-image');
    }
    if (imageBtn) imageBtn.classList.remove('active');
  }

  function clearVideoUpload() {
    if (videoInput) videoInput.value = '';
    if (videoPreviewContainer) videoPreviewContainer.innerHTML = '';
  }

  function openModal() {
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function openModalWithImage() {
    openModal();
    if (fileInput) setTimeout(() => fileInput.click(), 100);
  }

  function resetModal() {
    clearVideoUpload();
    clearImageUpload();

    if (articleTitleInput) articleTitleInput.value = '';
    if (quill) {
      quill.setContents([]);
      if (editorOutput) editorOutput.value = '';
    }
    updatePublishButton();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    resetModal();
  }

  // =========================
  // MODAL BINDINGS
  // =========================
  document.querySelectorAll('.js-open-modal').forEach(el => el.addEventListener('click', openModal));
  document.querySelectorAll('.js-open-modal-with-image').forEach(el => el.addEventListener('click', openModalWithImage));
  document.querySelectorAll('.js-close-modal').forEach(el => el.addEventListener('click', closeModal));

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  if (videoBtnComposer) {
    videoBtnComposer.addEventListener('click', () => {
      openModal();
      if (videoInput) setTimeout(() => videoInput.click(), 100);
    });
  }

  if (videoBtnModal && videoInput) {
    videoBtnModal.addEventListener('click', () => videoInput.click());
  }

  // =========================
  // QUILL
  // =========================
  let quill = null;
  const editorEl = document.getElementById('editor');

  if (editorEl) {
    quill = new Quill('#editor', {
      theme: 'snow',
      placeholder: 'Share your thoughts...',
      modules: {
        toolbar: [
          ['bold', 'italic', 'underline'],
          [{ header: [2, 3, false] }],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link']
        ]
      }
    });

    quill.on('text-change', () => {
      const html = quill.root.innerHTML;
      if (editorOutput) editorOutput.value = html;
      updatePublishButton();
    });
  }

  function updatePublishButton() {
    if (!publishBtn) return;
    const hasTitle = articleTitleInput && articleTitleInput.value.trim().length > 0;
    const hasText = quill && quill.getText().trim().length > 0;
    const enabled = hasTitle && hasText;

    publishBtn.disabled = !enabled;
    publishBtn.classList.toggle('enabled', enabled);
  }

  if (articleTitleInput) articleTitleInput.addEventListener('input', updatePublishButton);

  // =========================
  // IMAGE PREVIEW
  // =========================
  if (fileInput && imagePreviewContainer && imageBtn) {
    imageBtn.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', function () {
      const file = this.files[0];
      if (!file) {
        clearImageUpload();
        return;
      }

      clearVideoUpload();

      imagePreviewContainer.innerHTML = '';
      imagePreviewContainer.classList.add('has-image');
      imageBtn.classList.add('active');

      const wrapper = document.createElement('div');
      wrapper.className = 'image-preview-wrapper';

      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);

      const removeBtn = document.createElement('button');
      removeBtn.className = 'remove-image-btn';
      removeBtn.type = 'button';
      removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
      removeBtn.title = 'Remove image';

      removeBtn.addEventListener('click', () => clearImageUpload());

      wrapper.appendChild(img);
      wrapper.appendChild(removeBtn);
      imagePreviewContainer.appendChild(wrapper);
    });
  }

  // =========================
  // VIDEO PREVIEW
  // =========================
  if (videoInput && videoPreviewContainer) {
    videoInput.addEventListener('change', function () {
      const file = this.files[0];
      if (!file) {
        clearVideoUpload();
        return;
      }

      if (file.size > MAX_VIDEO_SIZE) {
        alert('Video too large! Maximum size is 50MB.');
        this.value = '';
        return;
      }

      const allowedTypes = ['video/mp4', 'video/webm', 'video/ogg'];
      if (!allowedTypes.includes(file.type)) {
        alert('Invalid video format. Allowed: MP4, WebM, OGG');
        this.value = '';
        return;
      }

      clearImageUpload();
      videoPreviewContainer.innerHTML = '';

      const wrapper = document.createElement('div');
      wrapper.className = 'video-preview-wrapper';

      const video = document.createElement('video');
      video.src = URL.createObjectURL(file);
      video.controls = true;
      video.style.maxWidth = '100%';

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'remove-image-btn';
      removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
      removeBtn.title = 'Remove video';

      removeBtn.addEventListener('click', () => clearVideoUpload());

      wrapper.appendChild(video);
      wrapper.appendChild(removeBtn);
      videoPreviewContainer.appendChild(wrapper);
    });
  }

  // =========================
  // LINK PREVIEW (GLOBAL)
  // =========================
  function initLinkPreviews(scopeCards = null) {
    if (!isAuthenticated) return;

    const bodies = scopeCards
      ? Array.from(scopeCards).map(card => card.querySelector('.article-body')).filter(Boolean)
      : Array.from(document.querySelectorAll('.article-body'));

    bodies.forEach(body => {
      if (body.dataset.previewDone === "1") return;

      let url = null;
      const quillLink = body.querySelector('a[href^="http://"], a[href^="https://"]');
      if (quillLink) url = quillLink.getAttribute('href');

      if (!url) {
        const match = body.textContent.match(/https?:\/\/[^\s<]+/);
        if (match) url = match[0];
      }

      if (!url) return;

      const articleId = body.id.replace('article-body-', '');
      body.dataset.previewDone = "1";

      fetch('/app/articles/link-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      })
        .then(r => r.json())
        .then(data => {
          if (data.error) return;
          const target = document.getElementById('link-preview-' + articleId);
          if (!target) return;

          target.innerHTML = `
            <a href="${url}" target="_blank" class="preview-card">
              ${data.image ? `<img src="${data.image}" alt="preview">` : ''}
              <div class="preview-content">
                <strong>${data.title || data.site || ''}</strong>
                <p>${data.description || ''}</p>
                <small title="${url}">${data.site || ''}</small>
              </div>
            </a>
          `;
        })
        .catch(() => {});
    });
  }

  // =========================
  // SEE MORE INIT (hide button if not needed)
  // =========================
  function initSeeMoreForCards(cards) {
    cards.forEach(card => {
      const btn = card.querySelector('.see-more-btn');
      const body = card.querySelector('.article-body');
      if (!btn || !body) return;

      const visibleHeight = 180;
      const fullHeight = body.scrollHeight;
      if (fullHeight <= visibleHeight + 10) btn.style.display = "none";
    });
  }

  function updateCommentCount(articleId, delta) {
    const actionCount = document.getElementById(`comment-count-${articleId}`);
    const currentCount = actionCount ? parseInt(actionCount.textContent || "0", 10) : 0;
    const nextCount = Math.max(0, currentCount + delta);

    [
      actionCount,
      document.getElementById(`comment-summary-${articleId}`),
      document.getElementById(`comment-response-count-${articleId}`)
    ].forEach(element => {
      if (element) element.textContent = nextCount;
    });
  }

  // =========================
  // EVENT DELEGATION (ALL CLICKS)
  // =========================
  document.addEventListener('click', async (e) => {

    const authRequired = e.target.closest('[data-auth-required="true"]');
    if (authRequired) {
      window.location.assign(authRequired.dataset.authUrl || '{{ path('show_login') }}');
      return;
    }

    // ---- COMMENT LIKE (optimistic)
    const commentLikeBtn = e.target.closest('.comment-like-btn');
    if (commentLikeBtn) {
      if (commentLikeBtn.dataset.loading === "1") return;
      commentLikeBtn.dataset.loading = "1";

      const commentId = commentLikeBtn.dataset.commentId;
      const countEl = document.getElementById(`comment-like-count-${commentId}`);
      const icon = commentLikeBtn.querySelector('i');

      const wasLiked = commentLikeBtn.classList.contains('active');
      const currentCount = countEl ? parseInt(countEl.textContent || "0", 10) : 0;

      const nextLiked = !wasLiked;
      const nextCount = Math.max(0, currentCount + (nextLiked ? 1 : -1));

      if (countEl) countEl.textContent = nextCount;
      commentLikeBtn.classList.toggle('active', nextLiked);
      commentLikeBtn.setAttribute('aria-pressed', nextLiked ? 'true' : 'false');
      if (icon) {
        icon.classList.toggle('fa-solid', nextLiked);
        icon.classList.toggle('fa-regular', !nextLiked);
      }

      try {
        const res = await fetch(`/app/articles/comment/${commentId}/like`, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (!res.ok) throw new Error('HTTP error');
        const data = await res.json();

        if (countEl) countEl.textContent = data.count;
        commentLikeBtn.classList.toggle('active', data.liked);
        commentLikeBtn.setAttribute('aria-pressed', data.liked ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('fa-solid', data.liked);
          icon.classList.toggle('fa-regular', !data.liked);
        }
      } catch (err) {
        if (countEl) countEl.textContent = currentCount;
        commentLikeBtn.classList.toggle('active', wasLiked);
        commentLikeBtn.setAttribute('aria-pressed', wasLiked ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('fa-solid', wasLiked);
          icon.classList.toggle('fa-regular', !wasLiked);
        }
        console.error(err);
      } finally {
        commentLikeBtn.dataset.loading = "0";
      }
      return;
    }

    // ---- ARTICLE LIKE (optimistic)
    const likeBtn = e.target.closest('.like-btn');
    if (likeBtn) {
      const articleId = likeBtn.dataset.articleId;
      if (!articleId) return;

      if (likeBtn.dataset.loading === "1") return;
      likeBtn.dataset.loading = "1";

      const icon = likeBtn.querySelector('i');
      const likeCountEl = document.getElementById(`like-count-${articleId}`);
      const likeSummaryEl = document.getElementById(`like-summary-${articleId}`);

      const wasLiked = likeBtn.classList.contains('active');
      const currentCount = likeCountEl ? parseInt(likeCountEl.textContent || "0", 10) : 0;

      const nextLiked = !wasLiked;
      const nextCount = Math.max(0, currentCount + (nextLiked ? 1 : -1));

      if (likeCountEl) likeCountEl.textContent = nextCount;
      if (likeSummaryEl) likeSummaryEl.textContent = nextCount;
      likeBtn.classList.toggle('active', nextLiked);
      likeBtn.setAttribute('aria-pressed', nextLiked ? 'true' : 'false');
      if (icon) {
        icon.classList.toggle('fa-solid', nextLiked);
        icon.classList.toggle('fa-regular', !nextLiked);
      }

      try {
        const res = await fetch(`/app/articles/${articleId}/like`, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!res.ok) throw new Error('HTTP error');

        const data = await res.json();
        if (likeCountEl) likeCountEl.textContent = data.likes;
        if (likeSummaryEl) likeSummaryEl.textContent = data.likes;
        likeBtn.classList.toggle('active', data.liked);
        likeBtn.setAttribute('aria-pressed', data.liked ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('fa-solid', data.liked);
          icon.classList.toggle('fa-regular', !data.liked);
        }
      } catch (err) {
        if (likeCountEl) likeCountEl.textContent = currentCount;
        if (likeSummaryEl) likeSummaryEl.textContent = currentCount;
        likeBtn.classList.toggle('active', wasLiked);
        likeBtn.setAttribute('aria-pressed', wasLiked ? 'true' : 'false');
        if (icon) {
          icon.classList.toggle('fa-solid', wasLiked);
          icon.classList.toggle('fa-regular', !wasLiked);
        }
        console.error(err);
      } finally {
        likeBtn.dataset.loading = "0";
      }
      return;
    }

    // ---- COPY DIRECT LINK
    const shareBtn = e.target.closest('.share-btn');
    if (shareBtn) {
      const articleId = shareBtn.dataset.articleId;
      if (!articleId) return;

      const directUrl = shareBtn.dataset.shareUrl || `${window.location.origin}${window.location.pathname}#article-${articleId}`;
      const label = shareBtn.querySelector('.btn-action__label');
      const icon = shareBtn.querySelector('.btn-action__icon i');

      try {
        await navigator.clipboard.writeText(directUrl);
        shareBtn.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        if (icon) icon.className = 'fa-solid fa-check';
        setTimeout(() => {
          shareBtn.classList.remove('is-copied');
          if (label) label.textContent = 'Share';
          if (icon) icon.className = 'fa-solid fa-arrow-up-from-bracket';
        }, 1800);
      } catch (err) {
        window.prompt('Copy this post link:', directUrl);
      }
      return;
    }

    // ---- TOGGLE COMMENTS SECTION
    const commentBtn = e.target.closest('.comment-btn');
    if (commentBtn) {
      const articleId = commentBtn.dataset.articleId;
      if (!articleId) return;

      const commentsSection = document.getElementById(`comments-${articleId}`);
      if (!commentsSection) return;

      commentsSection.classList.toggle('expanded');
      commentBtn.setAttribute('aria-expanded', commentsSection.classList.contains('expanded') ? 'true' : 'false');

      if (commentsSection.classList.contains('expanded')) {
        const input = commentsSection.querySelector('.comment-form .input-field');
        if (input) setTimeout(() => input.focus(), 300);
      }
      return;
    }

    // ---- SEE MORE
    const seeMoreBtn = e.target.closest('.see-more-btn');
    if (seeMoreBtn) {
      const id = seeMoreBtn.dataset.id;
      const body = document.getElementById(`article-body-${id}`);
      if (!body) return;

      body.classList.toggle('expanded');
      seeMoreBtn.textContent = body.classList.contains('expanded') ? "See less" : "See more";
      return;
    }

    // ---- EDIT COMMENT
    const editBtn = e.target.closest('.edit-comment-btn');
    if (editBtn) {
      const id = editBtn.dataset.id;
      const p = document.querySelector(`.comment-text[data-id="${id}"]`);
      if (!p) return;

      const input = document.createElement('input');
      input.type = 'text';
      input.value = p.textContent;
      input.classList.add('input-field');

      p.replaceWith(input);
      input.focus();

      input.addEventListener('blur', async () => {
        try {
          const res = await fetch(`/app/articles/comments/${id}/edit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `content=${encodeURIComponent(input.value)}`
          });
          const data = await res.json();
          if (data.success) {
            const newP = document.createElement('p');
            newP.className = 'comment-text';
            newP.dataset.id = id;
            newP.textContent = data.content;
            input.replaceWith(newP);
          }
        } catch (err) {
          console.error(err);
        }
      });
      return;
    }

    // ---- DELETE COMMENT
    const deleteBtn = e.target.closest('.delete-comment-btn');
    if (deleteBtn) {
      const id = deleteBtn.dataset.id;
      const commentElement = document.getElementById(`comment-${id}`);
      const articleId = commentElement?.closest('.article-card')?.dataset.articleId;
      if (!confirm('Delete this comment?')) return;

      fetch(`/app/articles/comments/${id}/delete`, { method: 'POST' })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            commentElement?.remove();
            if (articleId) updateCommentCount(articleId, -1);
          }
        })
        .catch(err => console.error(err));
      return;
    }
  });

  // Instagram-like double click: a double click can like, never unlike.
  document.addEventListener('dblclick', (e) => {
    const media = e.target.closest('.article-media--image');
    if (!media) return;

    const articleId = media.dataset.articleId;
    const likeBtn = document.querySelector(`.like-btn[data-article-id="${articleId}"]`);
    const burst = media.querySelector('.article-like-burst');

    if (burst) {
      burst.classList.remove('is-visible');
      void burst.offsetWidth;
      burst.classList.add('is-visible');
      setTimeout(() => burst.classList.remove('is-visible'), 650);
    }

    if (likeBtn && !likeBtn.classList.contains('active')) likeBtn.click();
  });

  // =========================
  // AJAX COMMENT SUBMISSION (delegation)
  // =========================
  document.addEventListener('submit', (e) => {
    const form = e.target.closest('.comment-form');
    if (!form) return;

    e.preventDefault();

    const articleId = form.dataset.articleId;
    if (!articleId) return;

    const input = form.querySelector('.input-field');
    if (!input) return;

    const content = input.value.trim();
    if (!content) return;

    if (content.length > 220) {
      alert('вљ пёЏ Your comment is too long! Maximum 220 characters allowed.');
      return;
    }

    fetch(`/app/articles/${articleId}/comment`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: new URLSearchParams({ comment: content })
    })
      .then(response => {
        if (!response.ok) {
          return response.json().then(data => { throw new Error(data.error || 'An error occurred'); });
        }
        return response.json();
      })
      .then(data => {
        const commentsSection = document.getElementById(`comments-${articleId}`);
        if (!commentsSection) return;

        const commentDiv = document.createElement('div');
        commentDiv.id = `comment-${data.id}`;
        commentDiv.classList.add('comment');

        // вљ пёЏ Ici on garde ton avatar via Twig dans la string (ok car ce JS est dans Twig)
        commentDiv.innerHTML = `
          <div class="user-avatar user-avatar--small">
            <img src="{{ asset(app.user and app.user.avatar ? 'uploads/avatars/' ~ app.user.avatar : 'images/User.svg') }}" alt="Avatar"/>
          </div>

          <div class="comment-content">
            <div class="comment-header">
              <div class="comment-author">
                <strong class="comment-author-name"></strong>
                <small class="comment-author__self">You</small>
                <span class="date"><i class="fa-regular fa-clock" aria-hidden="true"></i><span class="comment-date-value"></span></span>
              </div>

              <div class="comment-actions">
                <button class="edit-comment-btn" type="button" data-id="${data.id}" title="Edit comment" aria-label="Edit comment">
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                </button>
                <button class="delete-comment-btn" type="button" data-id="${data.id}" title="Delete comment" aria-label="Delete comment">
                  <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                </button>
              </div>
            </div>

            <p class="comment-text" data-id="${data.id}"></p>
            <div class="comment-like-row">
              <button class="comment-like-btn" type="button" data-comment-id="${data.id}" title="React to this comment" aria-label="React to this comment" aria-pressed="false">
                <i class="fa-regular fa-heart" aria-hidden="true"></i>
                <span class="comment-like-count" id="comment-like-count-${data.id}">0</span>
              </button>
            </div>
          </div>
        `;

        commentDiv.querySelector('.comment-author-name').textContent = '{{ app.user ? app.user.userName|e('js') : '' }}';
        commentDiv.querySelector('.comment-text').textContent = data.content;
        commentDiv.querySelector('.comment-date-value').textContent = data.date;

        commentsSection.insertBefore(commentDiv, form);
        updateCommentCount(articleId, 1);

        input.value = '';
      })
      .catch(err => {
        console.error('Error adding comment:', err);
        alert(`вќЊ Error: ${err.message}`);
      });
  });

  // =========================
  // INFINITE SCROLL (5 par 5)
  // =========================
  const listEl = document.getElementById('articles-list');
  const loaderEl = document.getElementById('feed-loader');
  const sentinelEl = document.getElementById('feed-sentinel');
  const activeFilter = document.querySelector('.community-feed')?.dataset.feedFilter || 'latest';

  let limit = 5;
  let offset = listEl ? listEl.querySelectorAll('.article-card').length : 0;
  let loadingMore = false;
  let noMore = false;

  async function loadMoreArticles() {
    if (loadingMore || noMore || !listEl) return;
    loadingMore = true;
    if (loaderEl) loaderEl.style.display = 'block';

    try {
      const res = await fetch(`/app/articles/load-more?limit=${limit}&offset=${offset}&filter=${encodeURIComponent(activeFilter)}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      if (!res.ok) throw new Error('HTTP error');

      const html = (await res.text()).trim();
      if (!html) {
        noMore = true;
        sentinelEl?.remove();
        return;
      }

      const temp = document.createElement('div');
      temp.innerHTML = html;

      const newCards = temp.querySelectorAll('.article-card');
      newCards.forEach(card => listEl.appendChild(card));

      offset += newCards.length;

      // init features on new cards
      initLinkPreviews(newCards);
      initSeeMoreForCards(Array.from(newCards));

      if (newCards.length < limit) {
        noMore = true;
        sentinelEl?.remove();
      }
    } catch (e) {
      console.error(e);
    } finally {
      loadingMore = false;
      if (loaderEl) loaderEl.style.display = 'none';
    }
  }

  if (sentinelEl) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some(en => en.isIntersecting)) loadMoreArticles();
    }, { rootMargin: '300px' });

    io.observe(sentinelEl);
  }

  // =========================
  // INIT initial page
  // =========================
  initLinkPreviews();
  initSeeMoreForCards(Array.from(document.querySelectorAll('.article-card')));
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const automaticCarousels = new Set();
  let automaticResumeTimer = null;

  const stopAutomaticCarousels = () => {
    if (automaticResumeTimer) window.clearTimeout(automaticResumeTimer);
    automaticResumeTimer = null;
    automaticCarousels.forEach((root) => root.communityCarousel?.stop());
  };

  const startAutomaticCarousels = () => {
    if (document.querySelector('.community-info-modal[open]')) return;
    const carouselIsBeingUsed = Array.from(automaticCarousels).some((root) => root.matches(':hover') || root.contains(document.activeElement));
    if (carouselIsBeingUsed) return;
    automaticCarousels.forEach((root) => root.communityCarousel?.start());
  };

  const pauseAutomaticCarousels = (duration = 0) => {
    stopAutomaticCarousels();
    if (duration > 0) {
      automaticResumeTimer = window.setTimeout(() => {
        automaticResumeTimer = null;
        startAutomaticCarousels();
      }, duration);
    }
  };

  const initialiseCarousel = (root) => {
    const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'))
      .filter((slide) => slide.closest('[data-community-carousel]') === root);
    const counters = root.querySelectorAll('[data-carousel-current]');
    const previousButton = root.querySelector('[data-carousel-prev]');
    const nextButton = root.querySelector('[data-carousel-next]');
    const autoplayDelay = Number.parseInt(root.dataset.carouselAutoplay || '0', 10);
    let currentIndex = 0;
    let timer = null;

    const render = (requestedIndex, animate = true) => {
      if (!slides.length) return;
      currentIndex = (requestedIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === currentIndex;
        slide.hidden = !active;
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        if (active && animate && slides.length > 1 && !reducedMotion) {
          slide.classList.remove('is-carousel-entering');
          void slide.offsetWidth;
          slide.classList.add('is-carousel-entering');
        }
      });
      counters.forEach((counter) => { counter.textContent = String(currentIndex + 1); });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = null;
    };
    const start = () => {
      stop();
      if (reducedMotion || slides.length < 2 || autoplayDelay < 2000) return;
      if (document.querySelector('.community-info-modal[open]')) return;
      if (root.matches(':hover') || root.contains(document.activeElement)) return;
      timer = window.setInterval(() => render(currentIndex + 1), autoplayDelay);
    };
    const move = (direction) => {
      render(currentIndex + direction);
      pauseAutomaticCarousels(8000);
    };

    previousButton?.addEventListener('click', () => move(-1));
    nextButton?.addEventListener('click', () => move(1));
    if (slides.length < 2) {
      if (previousButton) previousButton.disabled = true;
      if (nextButton) nextButton.disabled = true;
    }

    root.addEventListener('mouseenter', () => pauseAutomaticCarousels());
    root.addEventListener('mouseleave', startAutomaticCarousels);
    root.addEventListener('focusin', () => pauseAutomaticCarousels());
    root.addEventListener('focusout', (event) => { if (!root.contains(event.relatedTarget)) startAutomaticCarousels(); });

    root.communityCarousel = { goTo: (index) => render(index, false), stop, start };
    if (autoplayDelay >= 2000) automaticCarousels.add(root);
    render(0, false);
    start();
  };

  document.querySelectorAll('[data-community-carousel]').forEach(initialiseCarousel);

  document.querySelectorAll('[data-community-carousel-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const modal = document.querySelector(`[data-community-carousel-modal="${button.dataset.communityCarouselOpen}"]`);
      if (!modal) return;
      stopAutomaticCarousels();
      modal.communityCarousel?.goTo(Number.parseInt(button.dataset.communityCarouselIndex || '0', 10));
      if (!modal.open) modal.showModal();
    });
  });

  document.querySelectorAll('[data-community-modal-open]').forEach((button) => {
    button.addEventListener('click', () => document.getElementById(button.dataset.communityModalOpen)?.showModal());
  });
  document.addEventListener('click', (event) => {
    const closeButton = event.target.closest('[data-community-modal-close]');
    if (!closeButton) return;
    const dialog = closeButton.closest('dialog');
    if (!(dialog instanceof HTMLDialogElement)) return;
    event.preventDefault();
    event.stopPropagation();
    if (dialog.open) dialog.close();
  }, true);
  document.querySelectorAll('.community-info-modal').forEach((dialog) => {
    dialog.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((button) => {
      button.addEventListener('click', (event) => event.stopPropagation());
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', startAutomaticCarousels);
    dialog.addEventListener('cancel', stopAutomaticCarousels);
  });
  document.addEventListener('visibilitychange', () => document.hidden ? stopAutomaticCarousels() : startAutomaticCarousels());
  document.querySelectorAll('[data-community-cv-input]').forEach((input) => {
    input.addEventListener('change', () => { if (input.files?.length) input.form?.requestSubmit(); });
  });
});
</script>

{% endblock %}
