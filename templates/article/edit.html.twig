{% extends 'base.html.twig' %}

{% block head %}
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Quill Editor -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
{% endblock %}

{% block body %}

<style>
/* --- Même STYLE que ton feed --- */
:root {
    --green: #1A6D55;
    --teal: #0D8383;
    --black: #071717;
    --mint: #E7F3F3;
    --grey: #606060;
    --light-grey: #8b9499;
    --white: #FFFFFF;
    --bg: #f4f9f8;
    --radius: 16px;
    --radius-sm: 8px;
    --shadow: 0 2px 8px rgba(7, 23, 23, .06);
    --transition: .25s ease;
}

body {
    background: var(--bg);
    font-family: system-ui, sans-serif;
}

.edit-container {
    max-width: 850px;
    margin: 30px auto;
    background: var(--white);
    padding: 20px 24px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

h2 {
    margin-bottom: 20px;
    color: var(--black);
    font-weight: 700;
}

/* INPUT fields */
.input-field {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e0e0e0;
    border-radius: var(--radius-sm);
    margin-bottom: 18px;
    font-size: 15px;
    transition: var(--transition);
}

.input-field:focus {
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(13,131,131,0.1);
    outline: none;
}

/* QUILL */
#editor {
    background: white;
    min-height: 200px;
    border-radius: var(--radius-sm);
    margin-bottom: 20px;
}

.ql-toolbar {
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.ql-container {
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
}

/* Media preview */
.media-preview-wrapper {
    position: relative;
    display: inline-block;
    margin-top: 10px;
    margin-bottom: 15px;
    max-width: 100%;
}

.media-preview-wrapper img,
.media-preview-wrapper video {
    max-width: 100%;
    border-radius: var(--radius-sm);
    display: block;
}

.media-preview-wrapper video {
    max-height: 400px;
}

.remove-media-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(220, 53, 69, 0.9);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 10;
}

.remove-media-btn i {
    color: white;
    font-size: 16px;
}

.remove-media-btn:hover {
    background: rgba(220, 53, 69, 1);
    transform: scale(1.1);
}

.media-section {
    margin-bottom: 20px;
}

.media-section label {
    font-weight: 600;
    color: var(--grey);
    display: block;
    margin-bottom: 8px;
}

.upload-hint {
    font-size: 12px;
    color: var(--light-grey);
    margin-top: 5px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.upload-hint i {
    font-size: 14px;
    color: #0066cc;
}

/* Submit button */
.btn-submit {
    background: var(--green);
    border: none;
    padding: 12px 24px;
    color: white;
    font-weight: 600;
    border-radius: 24px;
    cursor: pointer;
    margin-top: 20px;
    font-size: 15px;
    transition: var(--transition);
}

.btn-submit:hover {
    background: var(--teal);
    transform: scale(1.02);
}
</style>

<div class="edit-container">

    <h2><i class="fa-solid fa-pen"></i> Modifier l'article</h2>

    <form action="{{ path('article_edit', {id: article.id}) }}" method="POST" enctype="multipart/form-data">

        <!-- TITRE -->
        <input type="text"
               name="title"
               value="{{ article.titre }}"
               class="input-field"
               placeholder="Titre de l'article"
               required>

        <!-- DESCRIPTION / QUILL -->
        <div id="editor"></div>
        <textarea id="editor-output" name="description" hidden>{{ article.description|raw }}</textarea>

        <!-- IMAGE SECTION -->
        <div class="media-section">
            <label><i class="fa-regular fa-image"></i> Image</label>
            <input type="file" 
                   name="image" 
                   accept="image/*" 
                   id="img-input" 
                   class="input-field">
            
            {% if article.image %}
                <div class="media-preview-wrapper" id="current-image">
                    <img src="{{ asset('uploads/articles/' ~ article.image) }}" alt="Current image">
                    <button type="button" class="remove-media-btn" id="remove-image-btn">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <input type="hidden" name="remove_image" id="remove-image-input" value="0">
            {% endif %}

            <div id="image-preview-container"></div>
        </div>

        <!-- VIDEO SECTION -->
        <div class="media-section">
            <label><i class="fa-solid fa-video"></i> Video</label>
            <input type="file" 
                   name="video" 
                   accept="video/mp4,video/webm,video/ogg" 
                   id="video-input" 
                   class="input-field">
            <div class="upload-hint">
                <i class="fa-solid fa-circle-info"></i>
                Max video size: 50MB (MP4, WebM, OGG)
            </div>
            
            {% if article.video %}
                <div class="media-preview-wrapper" id="current-video">
                    <video controls>
                        <source src="{{ asset('uploads/videos/' ~ article.video) }}" type="video/{{ article.video|split('.')|last }}">
                    </video>
                    <button type="button" class="remove-media-btn" id="remove-video-btn">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <input type="hidden" name="remove_video" id="remove-video-input" value="0">
            {% endif %}

            <div id="video-preview-container"></div>
        </div>

        <!-- SUBMIT -->
        <button type="submit" class="btn-submit">
            <i class="fa-solid fa-save"></i> Enregistrer les modifications
        </button>

    </form>

</div>

<script>
/* ========== CONSTANTES ========== */
const MAX_VIDEO_SIZE = 50 * 1024 * 1024; // 50MB

/* ========== QUILL INIT ========== */
const quill = new Quill('#editor', {
    theme: 'snow',
    placeholder: 'Modifier la description...',
    modules: {
        toolbar: [
            ['bold', 'italic', 'underline'],
            [{ 'header': [2, 3, false] }],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            ['link']
        ]
    }
});

// Insère la description existante dans Quill
quill.root.innerHTML = document.getElementById("editor-output").value;

// Synchronise Quill vers textarea
quill.on('text-change', function() {
    document.getElementById("editor-output").value = quill.root.innerHTML;
});

/* ========== FONCTIONS UTILITAIRES ========== */
function clearImagePreview() {
    const container = document.getElementById('image-preview-container');
    if (container) {
        container.innerHTML = '';
    }
}

function clearVideoPreview() {
    const container = document.getElementById('video-preview-container');
    if (container) {
        container.innerHTML = '';
    }
}

function hideCurrentImage() {
    const currentImage = document.getElementById('current-image');
    if (currentImage) {
        currentImage.style.display = 'none';
    }
}

function hideCurrentVideo() {
    const currentVideo = document.getElementById('current-video');
    if (currentVideo) {
        currentVideo.style.display = 'none';
    }
}

/* ========== SUPPRESSION IMAGE EXISTANTE ========== */
const removeImageBtn = document.getElementById('remove-image-btn');
if (removeImageBtn) {
    removeImageBtn.addEventListener('click', function() {
        if (confirm('Remove this image?')) {
            document.getElementById('remove-image-input').value = '1';
            hideCurrentImage();
        }
    });
}

/* ========== SUPPRESSION VIDEO EXISTANTE ========== */
const removeVideoBtn = document.getElementById('remove-video-btn');
if (removeVideoBtn) {
    removeVideoBtn.addEventListener('click', function() {
        if (confirm('Remove this video?')) {
            document.getElementById('remove-video-input').value = '1';
            hideCurrentVideo();
        }
    });
}

/* ========== IMAGE UPLOAD PREVIEW ========== */
const imgInput = document.getElementById("img-input");
if (imgInput) {
    imgInput.addEventListener("change", function(e) {
        const file = e.target.files[0];
        
        if (!file) {
            clearImagePreview();
            return;
        }

        // Cacher/supprimer la vidéo existante et nouveau preview
        hideCurrentVideo();
        clearVideoPreview();
        if (document.getElementById('video-input')) {
            document.getElementById('video-input').value = '';
        }

        clearImagePreview();

        const container = document.getElementById('image-preview-container');
        const wrapper = document.createElement('div');
        wrapper.className = 'media-preview-wrapper';

        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-media-btn';
        removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';

        removeBtn.addEventListener('click', () => {
            imgInput.value = '';
            clearImagePreview();
        });

        wrapper.appendChild(img);
        wrapper.appendChild(removeBtn);
        container.appendChild(wrapper);
    });
}

/* ========== VIDEO UPLOAD PREVIEW ========== */
const videoInput = document.getElementById("video-input");
if (videoInput) {
    videoInput.addEventListener("change", function(e) {
        const file = e.target.files[0];
        
        if (!file) {
            clearVideoPreview();
            return;
        }

        // Validation de la taille
        if (file.size > MAX_VIDEO_SIZE) {
            alert('Video too large! Maximum size is 50MB.');
            this.value = '';
            return;
        }

        // Validation du format
        const allowedTypes = ['video/mp4', 'video/webm', 'video/ogg'];
        if (!allowedTypes.includes(file.type)) {
            alert('Invalid video format. Allowed: MP4, WebM, OGG');
            this.value = '';
            return;
        }

        // Cacher/supprimer l'image existante et nouveau preview
        hideCurrentImage();
        clearImagePreview();
        if (document.getElementById('img-input')) {
            document.getElementById('img-input').value = '';
        }

        clearVideoPreview();

        const container = document.getElementById('video-preview-container');
        const wrapper = document.createElement('div');
        wrapper.className = 'media-preview-wrapper';

        const video = document.createElement('video');
        video.src = URL.createObjectURL(file);
        video.controls = true;
        video.style.maxWidth = '100%';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-media-btn';
        removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';

        removeBtn.addEventListener('click', () => {
            videoInput.value = '';
            clearVideoPreview();
        });

        wrapper.appendChild(video);
        wrapper.appendChild(removeBtn);
        container.appendChild(wrapper);
    });
}
</script>

{% endblock %}